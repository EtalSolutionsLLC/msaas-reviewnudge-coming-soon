#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -ne 1 ]; then
 echo "Usage: $0 <source.csv> <chunk_size>"
 exit 1
fi

SOURCE="$1"
CHUNK_SIZE="${2:-500000}"

if [ ! -f "$SOURCE" ]; then
 echo "Error: file not found: $SOURCE"
 exit 1
fi

if ! [[ "$CHUNK_SIZE" =~ ^[0-9]+$ ]] || [ "$CHUNK_SIZE" -lt 1 ]; then
 echo "Error: chunk_size must be a positive integer"
 exit 1
fi

BASENAME="${SOURCE%.csv}"
HEADER=$(head -n 1 "$SOURCE")

tmpdir=$(mktemp -d)

tail -n +2 "$SOURCE" | \
 split -l "$CHUNK_SIZE" -d -a 4 --additional-suffix=.part - "$tmpdir/chunk_"

for part in "$tmpdir"/*.part; do
 num=$(basename "$part" .part | sed 's/^chunk_//')
 outfile="${BASENAME}-${num}.csv"

 {
 echo "$HEADER"
 cat "$part"
 } > "$outfile"

 echo "Created $outfile"
done

rm -rf "$tmpdir"
