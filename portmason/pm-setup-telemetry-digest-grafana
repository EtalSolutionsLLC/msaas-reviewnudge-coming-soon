#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

telemetry_grafana_translate_report_schedule() {
  local expression="${1:?cron expression required}"
  local minute hour day_of_month month day_of_week
  read -r minute hour day_of_month month day_of_week <<<"$expression"

  [[ "$minute" =~ ^([0-5]?[0-9])$ && "$hour" =~ ^([01]?[0-9]|2[0-3])$ \
      && "$day_of_month" == "*" && "$month" == "*" \
      && "$day_of_week" =~ ^[0-6]$ ]] \
    || die "Grafana digest currently supports one weekly HH:MM cron schedule" 2

  TELEMETRY_DIGEST_GRAFANA_FREQUENCY=weekly
  TELEMETRY_DIGEST_GRAFANA_HOUR="$hour"
  TELEMETRY_DIGEST_GRAFANA_MINUTE="$minute"
  TELEMETRY_DIGEST_GRAFANA_DAY_OF_WEEK="$day_of_week"
  export TELEMETRY_DIGEST_GRAFANA_FREQUENCY TELEMETRY_DIGEST_GRAFANA_HOUR
  export TELEMETRY_DIGEST_GRAFANA_MINUTE TELEMETRY_DIGEST_GRAFANA_DAY_OF_WEEK
}

: "${TELEMETRY_DIGEST_REPORT_NAME:?TELEMETRY_DIGEST_REPORT_NAME required}"
: "${TELEMETRY_DIGEST_DASHBOARD_UID:?TELEMETRY_DIGEST_DASHBOARD_UID required}"
: "${TELEMETRY_DIGEST_DELIVERY_ADDRESS:?TELEMETRY_DIGEST_DELIVERY_ADDRESS required}"
: "${TELEMETRY_DIGEST_DELIVERY_SCHEDULE:?TELEMETRY_DIGEST_DELIVERY_SCHEDULE required}"
: "${TELEMETRY_DIGEST_TIME_ZONE:?TELEMETRY_DIGEST_TIME_ZONE required}"
telemetry_validate_email "$TELEMETRY_DIGEST_DELIVERY_ADDRESS"
telemetry_validate_cron5 "$TELEMETRY_DIGEST_DELIVERY_SCHEDULE"
telemetry_grafana_translate_report_schedule "$TELEMETRY_DIGEST_DELIVERY_SCHEDULE"
log INFO "Grafana digest definition ready" \
    "report=${TELEMETRY_DIGEST_REPORT_NAME}" \
    "dashboard=${TELEMETRY_DIGEST_DASHBOARD_UID}" \
    "schedule=${TELEMETRY_DIGEST_DELIVERY_SCHEDULE}" \
    "timezone=${TELEMETRY_DIGEST_TIME_ZONE}"
