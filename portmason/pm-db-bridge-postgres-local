#!/usr/bin/env bash
set -euo pipefail

pm-run-sql() {
    local sql="${1:?pm-run-sql: SQL statement required}"
    local legacy_format="${2:-}"

    (( $# <= 2 )) \
        || die "pm-run-sql accepts SQL and an optional legacy format argument" 2

    pm_db_postgres_run_sql "$sql" "$legacy_format"
}

db_rt() {
    local user="${PM_DB_RT_USER:-${DB_USER:?DB_USER required}}"
    local password="${PM_DB_RT_PASSWORD:-${DB_PASSWORD:?DB_PASSWORD required}}"
    local database="${PM_DB_RT_DATABASE:-${DB_NAME:?DB_NAME required}}"
    local service="${PM_DB_SERVICE:-}"

    if [[ -z "$service" ]]; then
        pm_compose_load_model
        service="$(pm_compose_service_for_role db)"
    fi

    [[ -n "$service" ]] \
        || die "db_rt: local db service could not be resolved" 2

    [[ ${#PM_COMPOSE_CMD[@]} -gt 0 ]] || pm_compose_init_command

    log DEBUG "executing psql" \
        "service=$service" \
        "user=$user" \
        "database=$database"

    PGPASSWORD="$password" PM_DB_SQL_SECRET="${PM_DB_SQL_SECRET:-}" \
        "${PM_COMPOSE_CMD[@]}" exec -T \
            -e PGPASSWORD \
            -e PM_DB_SQL_SECRET \
            "$service" \
            psql \
                --set=ON_ERROR_STOP=1 \
                --no-psqlrc \
                --username "$user" \
                --dbname "$database" \
                "$@"
}

reset_connections() {
    local token_variable="${1:?token variable required}"

    [[ "$token_variable" == "DB_PASSWORD" ]] \
        || die "postgres-local cannot reset connections for $token_variable" 2

    local service="${PM_DB_SERVICE:-}"

    if [[ -z "$service" ]]; then
        pm_compose_load_model
        service="$(pm_compose_service_for_role db)"
    fi

    [[ -n "$service" ]] \
        || die "postgres-local database service could not be resolved" 2

    [[ ${#PM_COMPOSE_CMD[@]} -gt 0 ]] || pm_compose_init_command

    log WARN "restarting local PostgreSQL service to revoke existing sessions" \
        "service=$service"

    "${PM_COMPOSE_CMD[@]}" restart "$service"

    log INFO "local PostgreSQL connections reset" \
        "service=$service"
}
