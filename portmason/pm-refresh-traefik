#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" --read-only
. "${PORTMASON_SHARE}/pm-helpers-db"

# Restart Traefik project and current project
docker compose -f ~/code/traefik/docker-compose.yml restart
pm_compose_init_command
"${PM_COMPOSE_CMD[@]}" restart
