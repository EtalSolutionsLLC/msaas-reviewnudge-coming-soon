#!/usr/bin/env python3
"""Run SOPS with Portmason's shared age key settings and all supplied arguments."""

import importlib.util
import os
from pathlib import Path
import sys


def main() -> int:
    share = Path(os.environ.get("PORTMASON_SHARE", Path(__file__).resolve().parent))
    sys.path.insert(0, str(share))
    spec = importlib.util.spec_from_file_location("pm_secret", share / "pm-secret.py")
    if spec is None or spec.loader is None:
        raise RuntimeError("unable to load pm-secret.py")
    secrets = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(secrets)
    secrets.harden_process()
    os.execvpe("sops", ["sops", *sys.argv[1:]], secrets.sops_environment())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError) as exc:
        print(f"pm-sops: {exc}", file=sys.stderr)
        sys.exit(1)
