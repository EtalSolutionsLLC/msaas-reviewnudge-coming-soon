#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"
. "${PORTMASON_SHARE}/pm-helpers-telemetry"

main(){
  local generated_env="${ENV_FILE:?ENV_FILE required}.generated"
  local overlay="${SITE_DIR:?SITE_DIR required}/docker-compose.telemetry.yml"
  local -a profiles=(--profile telemetry)

  [[ -r "$generated_env" && -r "$overlay" ]] || die "Telemetry Compose inputs are not readable" 2

  if [[ -n "${TELEMETRY_OTLP_PLATFORM:-}" ]]; then
    docker compose --project-directory "$SITE_DIR" --env-file "$generated_env" \
      -f "$overlay" --profile telemetry up -d "$@"
  fi
}

main "$@"