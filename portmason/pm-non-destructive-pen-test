#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-${0:-}}"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
INVOCATION_DIR="$(pwd -P)"

: "${PORTMASON_SHARE:=/home/davidomer/code/ops-and-sops/ops/portmason}"

resolve_path_from_invocation() {
  case "${1:?path required}" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "${INVOCATION_DIR}/${1}" ;;
  esac
}

find_project_root() {
  local explicit_root="${PORTMASON_PROJECT_ROOT:-${PM_APP_ROOT:-}}"

  if [[ -n "$explicit_root" ]]; then
    resolve_path_from_invocation "$explicit_root"
    return
  fi

  if command -v git >/dev/null 2>&1; then
    git -C "$INVOCATION_DIR" rev-parse --show-toplevel 2>/dev/null && return
  fi

  printf '%s\n' "$INVOCATION_DIR"
}

REQUESTED_PM_ENV_FILE=""
for arg in "$@"; do
  case "$arg" in
    PM_ENV_FILE=*)
      REQUESTED_PM_ENV_FILE="${arg#PM_ENV_FILE=}"
      ;;
    PM_ENV_FILE_OVERRIDE=*)
      REQUESTED_PM_ENV_FILE="${arg#PM_ENV_FILE_OVERRIDE=}"
      ;;
  esac
done

PROJECT_ROOT="$(find_project_root)"
PROJECT_ROOT="$(cd -- "$PROJECT_ROOT" && pwd -P)"
cd "$PROJECT_ROOT"

if [[ -n "$REQUESTED_PM_ENV_FILE" ]]; then
  REQUESTED_PM_ENV_FILE="$(resolve_path_from_invocation "$REQUESTED_PM_ENV_FILE")"
  if [[ "$REQUESTED_PM_ENV_FILE" == *.generated && -f "${REQUESTED_PM_ENV_FILE%.generated}" ]]; then
    export PM_ENV_FILE_OVERRIDE="${PM_ENV_FILE_OVERRIDE:-${REQUESTED_PM_ENV_FILE%.generated}}"
  else
    export PM_ENV_FILE_OVERRIDE="${PM_ENV_FILE_OVERRIDE:-$REQUESTED_PM_ENV_FILE}"
  fi
fi

. "${PORTMASON_SHARE}/pm-helpers" "$@"

COMPOSE_FILE="${ZAP_COMPOSE_FILE:-${PROJECT_ROOT}/zaproxy-docker-compose.yml}"

if [[ -n "${REQUESTED_PM_ENV_FILE:-}" && "$REQUESTED_PM_ENV_FILE" == *.generated ]]; then
  COMPOSE_ENV_FILE="$REQUESTED_PM_ENV_FILE"
elif [[ -r "${ENV_FILE}.generated" ]]; then
  COMPOSE_ENV_FILE="${ENV_FILE}.generated"
elif [[ -r "${PROJECT_ROOT}/.env.generated" ]]; then
  COMPOSE_ENV_FILE="${PROJECT_ROOT}/.env.generated"
else
  COMPOSE_ENV_FILE="${ENV_FILE}"
fi

: "${ZAP_REPORT_DIR:=${PROJECT_ROOT}/security-reports/zap}"
: "${APP_BASE_URL:=${WP_SITE_URL:-${APP_URL:-}}}"
: "${ZAP_STARTUP_TIMEOUT_SECONDS:=120}"
: "${ZAP_TOTAL_TIMEOUT_SECONDS:=600}"
: "${ZAP_HEARTBEAT_SECONDS:=15}"
: "${ZAP_SPIDER_MINUTES:=1}"
: "${ZAP_INTERNAL_TIMEOUT_MINUTES:=3}"
: "${ZAP_HTML_REPORT:=zap-baseline.html}"
: "${ZAP_JSON_REPORT:=zap-baseline.json}"

export APP_BASE_URL ZAP_REPORT_DIR

[[ -n "$APP_BASE_URL" ]] || die "APP_BASE_URL is required"
[[ -r "$COMPOSE_FILE" ]] || die "Cannot read ZAP compose file: $COMPOSE_FILE"
[[ -r "$COMPOSE_ENV_FILE" ]] || die "Cannot read compose env file: $COMPOSE_ENV_FILE"

pm_zap_require_positive_integer() {
  local name="${1:?name required}"
  local value="${2:-}"

  [[ "$value" =~ ^[1-9][0-9]*$ ]] \
    || die "$name must be a positive integer: ${value:-<empty>}"
}

pm_zap_container_ids() {
  docker ps -aq \
    --filter "label=com.docker.compose.project=pentest-${STACK}" \
    --filter "label=com.docker.compose.service=zap-baseline"
}

pm_zap_remove_stale_containers() {
  local -a container_ids=()
  mapfile -t container_ids < <(pm_zap_container_ids)
  ((${#container_ids[@]} == 0)) && return 0

  log WARN "removing stale ZAP scanner containers" \
    "stack=$STACK" \
    "count=${#container_ids[@]}"
  docker rm -f "${container_ids[@]}" >/dev/null
}

pm_zap_phase() {
  local container_name="${1:?container name required}"
  local process_list=""

  if [[ -s "${ZAP_REPORT_DIR}/${ZAP_JSON_REPORT}" && -s "${ZAP_REPORT_DIR}/${ZAP_HTML_REPORT}" ]]; then
    printf '%s\n' "report-ready"
    return 0
  fi

  process_list="$(docker top "$container_name" -eo pid,args 2>/dev/null || true)"
  if [[ "$process_list" == *"-addonupdate"* ]]; then
    printf '%s\n' "updating-addons"
  elif [[ "$process_list" == *"-autorun"* ]]; then
    printf '%s\n' "scanning"
  elif [[ "$process_list" == *"zap-baseline.py"* ]]; then
    printf '%s\n' "starting-zap"
  else
    printf '%s\n' "starting-container"
  fi
}

ZAP_CONTAINER_NAME="${ZAP_CONTAINER_NAME:-pentest-${STACK}-zap-baseline-run}"
ZAP_SCAN_PID=""

pm_zap_cleanup() {
  local rc=$?
  set +e
  if [[ -n "${ZAP_SCAN_PID:-}" ]] && kill -0 "$ZAP_SCAN_PID" 2>/dev/null; then
    kill "$ZAP_SCAN_PID" 2>/dev/null || true
  fi
  docker rm -f "$ZAP_CONTAINER_NAME" >/dev/null 2>&1 || true
  cleanup_tail || true
  return "$rc"
}

trap pm_zap_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

pm_zap_require_positive_integer ZAP_STARTUP_TIMEOUT_SECONDS "$ZAP_STARTUP_TIMEOUT_SECONDS"
pm_zap_require_positive_integer ZAP_TOTAL_TIMEOUT_SECONDS "$ZAP_TOTAL_TIMEOUT_SECONDS"
pm_zap_require_positive_integer ZAP_HEARTBEAT_SECONDS "$ZAP_HEARTBEAT_SECONDS"
pm_zap_require_positive_integer ZAP_SPIDER_MINUTES "$ZAP_SPIDER_MINUTES"
pm_zap_require_positive_integer ZAP_INTERNAL_TIMEOUT_MINUTES "$ZAP_INTERNAL_TIMEOUT_MINUTES"

mkdir -p "$ZAP_REPORT_DIR"

if [[ ! -w "$ZAP_REPORT_DIR" ]]; then
  sudo -n chown -R "$(id -u):$(id -g)" "$ZAP_REPORT_DIR" \
    || die "Cannot write $ZAP_REPORT_DIR; chown it to $(id -u):$(id -g) and rerun"
fi

chmod -R u+rwX,g+rwX,o-rwx "$ZAP_REPORT_DIR"

pm_zap_remove_stale_containers
rm -f \
  "${ZAP_REPORT_DIR}/${ZAP_HTML_REPORT}" \
  "${ZAP_REPORT_DIR}/${ZAP_JSON_REPORT}" \
  "${ZAP_REPORT_DIR}/zap.yaml"

log INFO "ZAP scan starting" \
  "target=$APP_BASE_URL" \
  "container=$ZAP_CONTAINER_NAME" \
  "startup_timeout_seconds=$ZAP_STARTUP_TIMEOUT_SECONDS" \
  "total_timeout_seconds=$ZAP_TOTAL_TIMEOUT_SECONDS" \
  "heartbeat_seconds=$ZAP_HEARTBEAT_SECONDS" \
  "report_dir=$ZAP_REPORT_DIR"

docker compose \
  --env-file "$COMPOSE_ENV_FILE" \
  -f "$COMPOSE_FILE" \
  run --rm -T \
  --name "$ZAP_CONTAINER_NAME" \
  zap-baseline \
  zap-baseline.py \
  -t "$APP_BASE_URL" \
  -m "$ZAP_SPIDER_MINUTES" \
  -j \
  --ajax-spider \
  -T "$ZAP_INTERNAL_TIMEOUT_MINUTES" \
  -z "-silent" \
  -r "$ZAP_HTML_REPORT" \
  -J "$ZAP_JSON_REPORT" &
ZAP_SCAN_PID=$!

scan_started_at="$(date +%s)"
container_seen=false
timed_out=false
timeout_kind=""

while kill -0 "$ZAP_SCAN_PID" 2>/dev/null; do
  now="$(date +%s)"
  elapsed_seconds=$((now - scan_started_at))

  if docker inspect "$ZAP_CONTAINER_NAME" >/dev/null 2>&1; then
    container_seen=true
  elif [[ "$container_seen" == false && "$elapsed_seconds" -ge "$ZAP_STARTUP_TIMEOUT_SECONDS" ]]; then
    timed_out=true
    timeout_kind="startup"
    break
  fi

  if [[ "$elapsed_seconds" -ge "$ZAP_TOTAL_TIMEOUT_SECONDS" ]]; then
    timed_out=true
    timeout_kind="total"
    break
  fi

  phase="$(pm_zap_phase "$ZAP_CONTAINER_NAME")"
  log INFO "ZAP scan heartbeat" \
    "phase=$phase" \
    "elapsed_seconds=$elapsed_seconds" \
    "container_seen=$container_seen"
  sleep "$ZAP_HEARTBEAT_SECONDS"
done

if [[ "$timed_out" == true ]]; then
  log ERROR "ZAP scan timed out" \
    "timeout_kind=$timeout_kind" \
    "elapsed_seconds=$elapsed_seconds" \
    "container=$ZAP_CONTAINER_NAME"
  docker rm -f "$ZAP_CONTAINER_NAME" >/dev/null 2>&1 || true
fi

scan_rc=0
if wait "$ZAP_SCAN_PID"; then
  scan_rc=0
else
  scan_rc=$?
fi
ZAP_SCAN_PID=""

if [[ "$timed_out" == true ]]; then
  die "ZAP scan exceeded its ${timeout_kind} timeout" 124
fi

[[ -s "${ZAP_REPORT_DIR}/${ZAP_HTML_REPORT}" ]] \
  || die "ZAP HTML report was not produced: ${ZAP_REPORT_DIR}/${ZAP_HTML_REPORT}"
[[ -s "${ZAP_REPORT_DIR}/${ZAP_JSON_REPORT}" ]] \
  || die "ZAP JSON report was not produced: ${ZAP_REPORT_DIR}/${ZAP_JSON_REPORT}"

case "$scan_rc" in
  0)
    result="pass"
    severity="INFO"
    ;;
  1)
    result="failures"
    severity="ERROR"
    ;;
  2)
    result="warnings"
    severity="WARN"
    ;;
  *)
    die "ZAP baseline scan could not complete" "$scan_rc"
    ;;
esac

log "$severity" "ZAP scan complete" \
  "result=$result" \
  "exit_code=$scan_rc" \
  "elapsed_seconds=$(( $(date +%s) - scan_started_at ))" \
  "html_report=${ZAP_REPORT_DIR}/${ZAP_HTML_REPORT}" \
  "json_report=${ZAP_REPORT_DIR}/${ZAP_JSON_REPORT}"

exit "$scan_rc"
