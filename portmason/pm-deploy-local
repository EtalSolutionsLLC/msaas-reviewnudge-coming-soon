#!/usr/bin/env bash
set -euo pipefail

: "${CUR_SCRIPT:=$(basename "${BASH_SOURCE[0]:-${0:-}}")}" 
export CUR_SCRIPT
: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_local_compose_up() {
    local max_attempts="${PM_REGISTRY_PULL_ATTEMPTS:-3}"
    local attempt rc=0 error_file delay_seconds
    for attempt in $(seq 1 "$max_attempts"); do
        error_file="$(mktemp)"
        if "${PM_COMPOSE_CMD[@]}" up "$@" 2> >(tee "$error_file" >&2); then
            rm -f -- "$error_file"
            return 0
        else
            rc=$?
        fi
        if ! grep -Eiq '(unexpected )?EOF|TLS handshake timeout|connection reset|i/o timeout|temporary failure|service unavailable' "$error_file" \
            || ((attempt >= max_attempts)); then
            rm -f -- "$error_file"
            return "$rc"
        fi
        rm -f -- "$error_file"
        delay_seconds=$((attempt * 3))
        log WARN "transient container registry failure; retrying Compose deployment" \
            "attempt=$attempt/$max_attempts" "delay_seconds=$delay_seconds"
        sleep "$delay_seconds"
    done
    return "$rc"
}


pm_deploy_runtime_platform() {
    [[ "${ADAPTER_CODE:-}" == "local" ]] \
        || die "pm-deploy-local runtime entrypoint requires ADAPTER_CODE=local" 2

    pm_compose_load_model
    [[ ${#PM_COMPOSE_CMD[@]} -gt 0 ]] || pm_compose_init_command

    log INFO "starting project containers" \
        "services=$(jq -r 'map(.service) | join(",")' <<<"${PROJECT_SERVICES:-[]}")"
    pm_local_compose_up -d --build --remove-orphans

    if [[ -n "${APP_URL:-}" ]]; then
        log INFO "runtime deployment complete" "app_url=$APP_URL"
    else
        warn "runtime is up, but APP_URL is unavailable"
    fi
}

main() {
    pm_deploy_runtime_platform "$@"
}

main "$@"
