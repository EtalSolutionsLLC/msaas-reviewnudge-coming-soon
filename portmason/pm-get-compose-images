#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)"}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

main() {
  local compose_file env_file="${ENV_FILE:-${PROJECT_ROOT}/.env}.generated"
  local -a compose_cmd

  [[ -z "${1:-}" ]] || : "${PM_COMPOSE_FILE:	=$PM_COMPOSE_FILE:-$1}"
  pm_compose_init_command
  pm_compose_control_file compose_file
  compose_cmd=("${PM_COMPOSE_CMD[@]}")

  have docker || fatal_error "docker is not installed or not on PATH"
  have jq     || fatal_error "jq is not installed or not on PATH"
  [[ -f "${compose_file}" ]] || fatal_error "${compose_file} not found"

  # If Compose supports --env-file and the active environment is rendered, use it.
  if [[ -f "${env_file}" ]] && docker compose --help 2>/dev/null | grep -q -- '--env-file'; then
    compose_cmd+=(--env-file "${env_file}")
  fi

  # Prefer JSON output if supported.
  if "${compose_cmd[@]}" config --help 2>/dev/null | grep -q -- '--format'; then
    # Some versions support --format but not json; try and fall back if it fails.
    if "${compose_cmd[@]}" config --format json >/dev/null 2>&1; then
      "${compose_cmd[@]}" config --format json \
        | jq -c '
            .services
            | to_entries
            | map(select(.value.image))
            | map({"service": .key, "image": .value.image})
          '
      return 0
    fi
  fi

  # Fallback: YAML output + yq parsing
  have yq || fatal_error "yq is required for fallback parsing (docker compose config --format json not available)"

  "${compose_cmd[@]}" config \
    | yq eval -o=json '
        (.services // {})
        | to_entries
        | map(select(.value.image))
        | map({"service": .key, "image": .value.image})
      ' -
}

main "$@"
