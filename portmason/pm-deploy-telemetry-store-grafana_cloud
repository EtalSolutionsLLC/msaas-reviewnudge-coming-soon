#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

[[ "${TELEMETRY_STORE_PROVIDER_CODE:-}" == grafana_cloud ]] \
    || die "grafana_cloud store deployment requires TELEMETRY_STORE_PROVIDER_PLATFORM_CODE=grafana_cloud-<platform>" 2
[[ "${TELEMETRY_STORE_PLATFORM_CODE:-}" != local ]] || return 0
pm_telemetry_require_compose_service store
: "${TELEMETRY_STORE_INTERNAL_URL:?Grafana Cloud OTLP endpoint required}"
: "${TELEMETRY_OTLP_INSTANCE_ID:?Grafana Cloud OTLP instance ID required}"
: "${TELEMETRY_OTLP_AUTH_TOKEN:?Grafana Cloud OTLP authentication token required}"
telemetry_hydrate_secret TELEMETRY_OTLP_AUTH_TOKEN
otlp_endpoint="${TELEMETRY_STORE_INTERNAL_URL%/}"
[[ "$otlp_endpoint" == */v1/metrics ]] || otlp_endpoint="${otlp_endpoint}/v1/metrics"
basic_credential="$(printf '%s' "${TELEMETRY_OTLP_INSTANCE_ID}:${TELEMETRY_OTLP_AUTH_TOKEN}" | base64 | tr -d '\n')"
http_code="$(printf 'header = "Authorization: Basic %s"\n' "$basic_credential" \
    | curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
        --request POST --header 'Content-Type: application/x-protobuf' --data-binary '' \
        --config - "$otlp_endpoint")"
[[ "$http_code" == 200 ]] \
    || die "Grafana Cloud OTLP authentication probe failed with HTTP $http_code" 2
unset basic_credential
log INFO "Grafana Cloud OTLP endpoint verified" "endpoint=$otlp_endpoint"
