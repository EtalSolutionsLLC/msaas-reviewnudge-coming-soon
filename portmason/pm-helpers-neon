pm_observability_neon_store_generated_role_password() {
    local password="${1:?provider-generated password required}"

    OBSERVABILITY_DB_PASSWORD="$password"
    export OBSERVABILITY_DB_PASSWORD

    if [[ "${DEPLOY_ENV:-dev}" == dev ]]; then
        env_init_set OBSERVABILITY_DB_PASSWORD "$OBSERVABILITY_DB_PASSWORD"
    elif declare -F pm_gcp_sync_secret_value >/dev/null 2>&1; then
        pm_gcp_sync_secret_value OBSERVABILITY_DB_PASSWORD "$OBSERVABILITY_DB_PASSWORD"
    else
        die "Neon generated a observability role password but no production secret synchronizer is available" 2
    fi

    log INFO "stored provider-generated observability role password" \
        "role=$OBSERVABILITY_DB_USER"
}

pm_observabilitobservabilitobservabilitobservability_db_platform_neon_prepare_runtime() {
    local PM_OBSERVABILITY_DB_RUNTIME_HOST=""
    local PM_OBSERVABILITY_DB_RUNTIME_PORT=""
    local PM_OBSERVABILITY_DB_RUNTIME_USER=""
    local PM_OBSERVABILITY_DB_RUNTIME_PASSWORD=""
    local PM_OBSERVABILITY_DB_RUNTIME_DATABASE=""

    if [[ "${DEPLOY_ENV:-dev}" != dev \
        && "${ADAPTER_CODE:-}" == gcp \
        && "$(type -t pm_gcp_get_secret_value)" == function ]]; then
        pm_gcp_get_secret_value OBSERVABILITY_DB_URL OBSERVABILITY_DB_URL \
            || die "Unable to load managed OBSERVABILITY_DB_URL" 2
        export OBSERVABILITY_DB_URL
    else
  #      pm_observability_hydrate_secret OBSERVABILITY_DB_URL
    fi
    [[ -n "${OBSERVABILITY_DB_URL:-}" ]] \
        || die "OBSERVABILITY_DB_URL is required for Neon observability runtime access" 2

    pm_db_postgres_parse_url_into PM_OBSERVABILITY_DB_RUNTIME "$OBSERVABILITY_DB_URL" \
        || die "Unable to parse managed OBSERVABILITY_DB_URL: ${PM_DB_POSTGRES_PARSE_ERROR:-unknown error}" 2

    OBSERVABILITY_DB_HOST="$PM_OBSERVABILITY_DB_RUNTIME_HOST"
    OBSERVABILITY_DB_PORT="$PM_OBSERVABILITY_DB_RUNTIME_PORT"
    OBSERVABILITY_DB_USER="$PM_OBSERVABILITY_DB_RUNTIME_USER"
    OBSERVABILITY_DB_PASSWORD="$PM_OBSERVABILITY_DB_RUNTIME_PASSWORD"
    OBSERVABILITY_DB_NAME="$PM_OBSERVABILITY_DB_RUNTIME_DATABASE"

    export OBSERVABILITY_DB_HOST OBSERVABILITY_DB_PORT OBSERVABILITY_DB_USER
    export OBSERVABILITY_DB_PASSWORD OBSERVABILITY_DB_NAME
}

pm_observability_neon_ensure_application_role() {
    local response matches count body created password
    local roles_path="/projects/${DB_PROJECT_ID:?DB_PROJECT_ID required}/branches/${DB_BRANCH_ID:?DB_BRANCH_ID required}/roles"

    neon_api_request response GET "$roles_path"
    matches="$(jq -c --arg name "${OBSERVABILITY_DB_USER:?OBSERVABILITY_DB_USER required}" \
        '[.roles[]? | select(.name == $name)]' <<<"$response")"
    count="$(jq 'length' <<<"$matches")"
    if (( count > 1 )); then
        die "multiple Neon roles named $OBSERVABILITY_DB_USER exist on the observability branch" 2
    fi
    if (( count == 1 )); then
        log INFO "using existing Neon observability role" \
            "role=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
        return 0
    fi

    body="$(jq -nc --arg name "$OBSERVABILITY_DB_USER" '{role:{name:$name}}')"
    log INFO "creating Neon observability role" \
        "role=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
    neon_api_request created POST "$roles_path" "$body" 409
    if [[ "$NEON_API_LAST_STATUS" == 409 ]]; then
        neon_api_request response GET "$roles_path"
        matches="$(jq -c --arg name "$OBSERVABILITY_DB_USER" \
            '[.roles[]? | select(.name == $name)]' <<<"$response")"
        count="$(jq 'length' <<<"$matches")"
        if (( count != 1 )); then
            die "observability role create conflicted but did not resolve a unique existing role" 2
            return 2
        fi
        log INFO "using existing Neon observability role after create conflict" \
            "role=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
        return 0
    fi

    neon_wait_for_operations "$created"
    password="$(jq -r '.role.password // empty' <<<"$created")"
    [[ -n "$password" ]] \
        || die "Neon created observability role $OBSERVABILITY_DB_USER without returning its password" 2
    pm_observability_neon_store_generated_role_password "$password"
    log INFO "Neon observability role created" \
        "role=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
}

pm_observability_neon_ensure_application_database() {
    local response matches count body created
    local databases_path="/projects/${DB_PROJECT_ID:?DB_PROJECT_ID required}/branches/${DB_BRANCH_ID:?DB_BRANCH_ID required}/databases"

    neon_api_request response GET "$databases_path"
    matches="$(jq -c --arg name "${OBSERVABILITY_DB_NAME:?OBSERVABILITY_DB_NAME required}" \
        '[.databases[]? | select(.name == $name)]' <<<"$response")"
    count="$(jq 'length' <<<"$matches")"
    if (( count > 1 )); then
        die "multiple Neon databases named $OBSERVABILITY_DB_NAME exist on the observability branch" 2
    fi
    if (( count == 1 )); then
        log INFO "using existing Neon observability database" \
            "database=$OBSERVABILITY_DB_NAME" "branch_id=$DB_BRANCH_ID"
        return 0
    fi

    body="$(jq -nc --arg name "$OBSERVABILITY_DB_NAME" --arg owner_name "$OBSERVABILITY_DB_USER" \
        '{database:{name:$name,owner_name:$owner_name}}')"
    log INFO "creating Neon observability database" \
        "database=$OBSERVABILITY_DB_NAME" "owner=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
    neon_api_request created POST "$databases_path" "$body" 409
    if [[ "$NEON_API_LAST_STATUS" == 409 ]]; then
        neon_api_request response GET "$databases_path"
        matches="$(jq -c --arg name "$OBSERVABILITY_DB_NAME" \
            '[.databases[]? | select(.name == $name)]' <<<"$response")"
        count="$(jq 'length' <<<"$matches")"
        if (( count != 1 )); then
            die "observability database create conflicted but did not resolve a unique existing database" 2
            return 2
        fi
        log INFO "using existing Neon observability database after create conflict" \
            "database=$OBSERVABILITY_DB_NAME" "branch_id=$DB_BRANCH_ID"
        return 0
    fi

    neon_wait_for_operations "$created"
    log INFO "Neon observability database created" \
        "database=$OBSERVABILITY_DB_NAME" "owner=$OBSERVABILITY_DB_USER" "branch_id=$DB_BRANCH_ID"
}

pm_observability_neon_rebuild_application_contract() {
    DB_NAME="${OBSERVABILITY_DB_NAME:?OBSERVABILITY_DB_NAME required}"
    local direct_url="" pooled_url="" application_url=""
    DB_USER="${OBSERVABILITY_DB_USER:?OBSERVABILITY_DB_USER required}"
    DB_PASSWORD="${OBSERVABILITY_DB_PASSWORD:?OBSERVABILITY_DB_PASSWORD required}"

    pm_db_postgres_build_url direct_url \
        "${NEON_DIRECT_HOST:?NEON_DIRECT_HOST required}" \
        "${DB_PORT:?DB_PORT required}" "$DB_NAME" "$DB_USER" "$DB_PASSWORD" require
    pm_db_postgres_build_url pooled_url \
        "${NEON_POOLED_HOST:?NEON_POOLED_HOST required}" \
        "$DB_PORT" "$DB_NAME" "$DB_USER" "$DB_PASSWORD" require
    DB_DIRECT_URL="$direct_url"
    DB_URL="$pooled_url"

    case "${NEON_USE_POOLER:-true}" in
        1|true|TRUE|yes|YES|on|ON)
            DB_HOST="$NEON_POOLED_HOST"
            application_url="$pooled_url"
            ;;
        0|false|FALSE|no|NO|off|OFF)
            DB_HOST="$NEON_DIRECT_HOST"
            DB_URL="$DB_DIRECT_URL"
            application_url="$direct_url"
            ;;
        *) die "NEON_USE_POOLER must be boolean" 2 ;;
    esac
    PM_OBSERVABILITY_NEON_APPLICATION_URL="$application_url"
    export PM_OBSERVABILITY_NEON_APPLICATION_URL
}

pm_observabilitobservabilitobservabilitobservability_db_platform_neon_provision() {
    local module_file="${PORTMASON_SHARE}/pm-provision-db-neon"
    local project_env="${ENV_FILE:?ENV_FILE required}" scratch_env
    local DB_PROVIDER_PLATFORM_CODE="" DB_PROVIDER_CODE="" DB_PLATFORM_CODE=""
    local DB_PROJECT_ID="" DB_PROJECT_NAME="" DB_BRANCH_ID="" DB_BRANCH_NAME=""
    local DB_REGION_ID="" DB_NAME="" DB_USER="" DB_PASSWORD="" DB_ORG_ID=""
    local DB_API_KEY="${DB_API_KEY:-}" NEON_API_KEY="${NEON_API_KEY:-}"
    local DB_HOST="" DB_PORT="" DB_SSL_MODE="" DB_URL="" DB_DIRECT_URL=""
    local DB_ADMIN_ROLE="" DB_ADMIN_HOST="" DB_ADMIN_PORT="" DB_ADMIN_USER=""
    local DB_ADMIN_PASSWORD="" DB_ADMIN_DATABASE="" NEON_ENDPOINT_ID=""
    local NEON_DIRECT_HOST="" NEON_POOLED_HOST=""

    [[ -r "$module_file" ]] || die "Neon provisioner is unavailable: $module_file" 2
    scratch_env="$(mktemp)"
    cp -- "$project_env" "$scratch_env"
    ENV_FILE="$scratch_env"
    export ENV_FILE

    pm_observability_neon_use_context
    log INFO "reusing Neon database provisioner" "module=pm-provision-db-neon"
    . "$module_file"
    # The reused provisioner sources the environment file; rehydrate managed
    # observability credentials before using them to rebuild the runtime contract.
    # pm_observability_hydrate_secret OBSERVABILITY_DB_USER
    # pm_observability_hydrate_secret OBSERVABILITY_DB_PASSWORD
    pm_observability_neon_ensure_application_role
    pm_observability_neon_ensure_application_database
    pm_observability_neon_rebuild_application_contract

    ENV_FILE="$project_env"
    export ENV_FILE
    rm -f -- "$scratch_env"
    pm_observability_neon_publish_context
}

pm_observabilitobservabilitobservabilitobservability_db_platform_neon_deploy() {
    local module_file="${PORTMASON_SHARE}/pm-deploy-db-neon"
    local DB_PROVIDER_PLATFORM_CODE="" DB_PROVIDER_CODE="" DB_PLATFORM_CODE=""
    local DB_PROJECT_ID="" DB_PROJECT_NAME="" DB_BRANCH_ID="" DB_BRANCH_NAME=""
