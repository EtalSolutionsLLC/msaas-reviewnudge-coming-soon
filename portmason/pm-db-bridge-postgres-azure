#!/usr/bin/env bash
set -euo pipefail

: "${POSTGRES_TOOL_IMAGE:=postgres:17-alpine}"
: "${DB_CONNECT_TIMEOUT_SECONDS:=20}"
export POSTGRES_TOOL_IMAGE DB_CONNECT_TIMEOUT_SECONDS


pm_db_bridge_provision() {
    : "${AZURE_POSTGRES_SERVER:?AZURE_POSTGRES_SERVER required after Azure provisioning}"
    env_init_set DB_HOST "${DB_HOST:-${AZURE_POSTGRES_SERVER}.postgres.database.azure.com}"
    env_init_set DB_PORT "${DB_PORT:-5432}"
    env_init_set DB_SSL_MODE require
    env_init_set DB_ADMIN_HOST "${DB_ADMIN_HOST:-$DB_HOST}"
    env_init_set DB_ADMIN_PORT "${DB_ADMIN_PORT:-$DB_PORT}"
    env_init_set DB_ADMIN_DATABASE "${DB_ADMIN_DATABASE:-postgres}"

    local runtime_url
    pm_db_postgres_build_url runtime_url "$DB_HOST" "$DB_PORT" "$DB_NAME" "$DB_USER" "$DB_PASSWORD" require
    env_init_set DB_URL "$runtime_url"
    env_init_set DB_DIRECT_URL "$runtime_url"
    pm_db_publish_generated_contract

    log INFO "pm-db-bridge-postgres-azure: provider/platform binding ready" \
        "server=$AZURE_POSTGRES_SERVER" "host=$DB_HOST" "database=$DB_NAME"
}

pm_db_bridge_deploy() {
    log INFO "pm-db-bridge-postgres-azure: verifying PostgreSQL execution path" \
        "host=${DB_HOST:-<unset>}"
    db_rt --command 'SELECT 1' >/dev/null
    log INFO "pm-db-bridge-postgres-azure: PostgreSQL execution path verified"
}

pm-run-sql() {
    local sql="${1:?pm-run-sql: SQL statement required}"
    local legacy_format="${2:-}"

    (( $# <= 2 )) || die "pm-run-sql accepts SQL and an optional legacy format argument" 2
    pm_db_postgres_run_sql "$sql" "$legacy_format"
}

db_rt() {
    local user="${PM_DB_RT_USER:-${DB_USER:?DB_USER required}}"
    local password="${PM_DB_RT_PASSWORD:-${DB_PASSWORD:?DB_PASSWORD required}}"
    local database="${PM_DB_RT_DATABASE:-${DB_NAME:?DB_NAME required}}"
    local host="${DB_HOST:?DB_HOST required}"
    local port="${DB_PORT:-5432}"

    have docker || die "db_rt: docker is required for containerized PostgreSQL access" 2
    log DEBUG "pm-db-bridge-postgres-azure: executing containerized psql" \
        "host=$host" "port=$port" "user=$user" "database=$database"
    docker run --rm \
        --env "PGHOST=$host" \
        --env "PGPORT=$port" \
        --env "PGDATABASE=$database" \
        --env "PGUSER=$user" \
        --env "PGPASSWORD=$password" \
        --env "PGSSLMODE=require" \
        --env "PGCONNECT_TIMEOUT=$DB_CONNECT_TIMEOUT_SECONDS" \
        --env "PM_DB_SQL_SECRET=${PM_DB_SQL_SECRET:-}" \
        "$POSTGRES_TOOL_IMAGE" \
        psql --set=ON_ERROR_STOP=1 --no-psqlrc "$@"
}
