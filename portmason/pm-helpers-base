#!/usr/bin/env bash
set -euo pipefail

begin_var_trace() {
  # If already set, reuse same file; otherwise create one.
  VAR_TRACE_START="${VAR_TRACE_START:-$(mktemp)}"
  declare -p | sort > "$VAR_TRACE_START"
}

canon_slug_19() {
  local raw="$1"
  local slug
  slug="$(printf '%s\n' "$raw" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9-]/-/g' \
    | sed 's/-\{2,\}/-/g' \
    | sed 's/^-//; s/-$//')"
  slug="${slug:0:19}"
  if [[ ! "$slug" =~ ^[a-z] ]]; then
    slug="p${slug}"
  fi
  printf '%s\n' "$slug"
}

end_var_trace() {
  # If no trace was started, do nothing (avoid set -u death)
  if [[ -z "${VAR_TRACE_START:-}" ]]; then
    log "variable changes: (no var trace started)" >&2
    return 0
  fi

  local end
  end="$(mktemp)"
  declare -p | sort > "$end"

  log "variable changes:"
  diff -u "$VAR_TRACE_START" "$end" || true

  rm -f "$VAR_TRACE_START" "$end"
  unset VAR_TRACE_START
}

is_env_dir() {
  local deploy_env="${DEPLOY_ENV:-}"
  local parent

  parent="$(basename "$(dirname "$PWD")")"

  # Empty DEPLOY_ENV and dev do not require deploy/ parent.
  if [[ -z "$deploy_env" || "$deploy_env" == "dev" ]]; then
    return 0
  fi

  # Anything else must run from deploy/<env>.
  [[ "$parent" == "deploy" ]]
}

# Identifier validation (applies to both PROJECT_ID and DEPLOYMENT_ID)
# - 6–30 chars
# - starts with [a-z]
# - only [a-z0-9-]
# - ends with [a-z0-9]
is_valid_project_identifier() {
  local id="${1-}"
  [[ ${#id} -ge 6 && ${#id} -le 30 ]] || return 1
  [[ "$id" =~ ^[a-z][a-z0-9-]*[a-z0-9]$ ]] || return 1
  return 0
}

persist_kv() {
    local key="$1"
    local value="$2"
    local file="${3:-${ENV_FILE}}"

    if [[ -z "${file}" || ! -f "${file}" ]]; then
        ok "Unable to find env file (file: '${file:-}')"
        return 0
    fi

    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        error "invalid env key: $key" >&2
        return 2
    fi

    local plaintext
    plaintext="$(sops --decrypt "$file")" || {
        log "ERROR: unable to decrypt env file: $file" >&2
        return 2
    }
    log "Successfully decrypted file $file"

    local esc_value
    esc_value="$(printf '%s' "$value" | sed 's/[\\&|]/\\&/g')"

    if grep -q "^${key}=" <<<"$plaintext"; then
        plaintext="$(
            printf '%s\n' "$plaintext" |
            sed -E "s|^${key}=.*$|${key}=${esc_value}|"
        )"
    else
        plaintext="${plaintext%$'\n'}"$'\n'"${key}=${value}"
    fi

    local plain_tmp
    local enc_tmp

    plain_tmp="$(mktemp)" || {
        log "ERROR: unable to create plaintext temp file" >&2
        return 2
    }

    enc_tmp="$(mktemp)" || {
        rm -f "$plain_tmp"
        log "ERROR: unable to create encrypted temp file" >&2
        return 2
    }

    chmod --reference="$file" "$enc_tmp" 2>/dev/null || true

    printf '%s\n' "$plaintext" > "$plain_tmp" || {
        rm -f "$plain_tmp" "$enc_tmp"
        log "ERROR: unable to write plaintext temp file" >&2
        return 2
    }

    sops \
        --encrypt \
        --age "$SOPS_AGE_RECIPIENTS" \
		--filename-override "$file" \
        --input-type dotenv \
        --output-type dotenv \
        "$plain_tmp" > "$enc_tmp" || {
            rm -f "$plain_tmp" "$enc_tmp"
            log "ERROR: unable to encrypt env file: $file" >&2
            return 2
        }

    rm -f "$plain_tmp"

    mv "$enc_tmp" "$file" || {
        rm -f "$enc_tmp"
        log "ERROR: unable to replace file: $file" >&2
        return 2
    }

    log "Successfully encrypted file $file"

    return 0
}

set-docker-env-file() {
    log "ERROR: set-docker-env-file is retired; configure env_file in the repository-root docker-compose.yml." >&2
    return 2
}

urldecode() {
  local s="${1//+/ }"
  printf '%b' "${s//%/\\x}"
}