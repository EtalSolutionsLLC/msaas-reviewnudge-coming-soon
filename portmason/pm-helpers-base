#!/usr/bin/env bash
set -euo pipefail

begin_var_trace() {
  # If already set, reuse same file; otherwise create one.
  VAR_TRACE_START="${VAR_TRACE_START:-$(mktemp)}"
  declare -p | sort > "$VAR_TRACE_START"
}

canon_slug_19() {
  local raw="$1"
  local slug
  slug="$(printf '%s\n' "$raw" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9-]/-/g' \
    | sed 's/-\{2,\}/-/g' \
    | sed 's/^-//; s/-$//')"
  slug="${slug:0:19}"
  if [[ ! "$slug" =~ ^[a-z] ]]; then
    slug="p${slug}"
  fi
  printf '%s\n' "$slug"
}

end_var_trace() {
  # If no trace was started, do nothing (avoid set -u death)
  if [[ -z "${VAR_TRACE_START:-}" ]]; then
    log "variable changes: (no var trace started)" >&2
    return 0
  fi

  local end
  end="$(mktemp)"
  declare -p | sort > "$end"

  log "variable changes:"
  diff -u "$VAR_TRACE_START" "$end" || true

  rm -f "$VAR_TRACE_START" "$end"
  unset VAR_TRACE_START
}

is_env_dir() {
  local deploy_env="${DEPLOY_ENV:-}"
  local parent

  parent="$(basename "$(dirname "$PWD")")"

  # Empty DEPLOY_ENV and dev do not require deploy/ parent.
  if [[ -z "$deploy_env" || "$deploy_env" == "dev" ]]; then
    return 0
  fi

  # Anything else must run from deploy/<env>.
  [[ "$parent" == "deploy" ]]
}

# Identifier validation (applies to both PROJECT_ID and DEPLOYMENT_ID)
# - 6–30 chars
# - starts with [a-z]
# - only [a-z0-9-]
# - ends with [a-z0-9]
is_valid_project_identifier() {
  local id="${1-}"
  [[ ${#id} -ge 6 && ${#id} -le 30 ]] || return 1
  [[ "$id" =~ ^[a-z][a-z0-9-]*[a-z0-9]$ ]] || return 1
  return 0
}

persist_kv() {
    local key="${1:?env key required}"
    local value="${2?env value required}"
    local file="${3:-${ENV_FILE:-}}"
    local router="${PORTMASON_SHARE:?PORTMASON_SHARE is required}/pm-secret.py"

    if [[ -z "$file" || ! -f "$file" ]]; then
        ok "Unable to find env file (file: '${file:-}')"
        return 0
    fi

    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        error "invalid env key: $key" >&2
        return 2
    fi

    local status=0
    python3 "$router" sops status -- "$file" >/dev/null || status=$?

    case "$status" in
        0|1) ;;
        *)
            log "ERROR: unable to check encryption status: $file" >&2
            return 2
            ;;
    esac

    local plaintext
    plaintext="$(python3 "$router" sops decrypt --stdout -- "$file")" || {
        log "ERROR: unable to read env file: $file" >&2
        return 2
    }

    local esc_value
    esc_value="$(printf '%s' "$value" | sed 's/[\\&|]/\\&/g')" || return 2

    if grep -q "^${key}=" <<<"$plaintext"; then
        plaintext="$(
            printf '%s\n' "$plaintext" |
                sed -E "s|^${key}=.*$|${key}=${esc_value}|"
        )" || return 2
    else
        plaintext="${plaintext:+${plaintext%$'\n'}$'\n'}${key}=${value}"
    fi

    # Stage beside the original so replacement stays on the same filesystem.
    local output_tmp
    output_tmp="$(mktemp -- "${file}.tmp.XXXXXX")" || {
        log "ERROR: unable to create output temp file: $file" >&2
        return 2
    }

    if [[ "$status" == 0 ]]; then
        # Plaintext travels through stdin; only ciphertext reaches the temp file.
        if ! printf '%s\n' "$plaintext" |
            python3 "$router" encrypt-file "$output_tmp" --format dotenv; then
            rm -f -- "$output_tmp"
            log "ERROR: unable to encrypt updated env file: $file" >&2
            return 2
        fi
    else
        if ! printf '%s\n' "$plaintext" > "$output_tmp"; then
            rm -f -- "$output_tmp"
            log "ERROR: unable to write updated env file: $file" >&2
            return 2
        fi
    fi
    unset plaintext

    if ! chmod --reference="$file" -- "$output_tmp"; then
        rm -f -- "$output_tmp"
        log "ERROR: unable to preserve env file permissions: $file" >&2
        return 2
    fi

    if ! mv -f -- "$output_tmp" "$file"; then
        rm -f -- "$output_tmp"
        log "ERROR: unable to replace env file: $file" >&2
        return 2
    fi

    if [[ "$status" == 0 ]]; then
        log "Updated encrypted env file: $file"
    else
        log "Updated plaintext env file: $file"
    fi
    return 0
}

set-docker-env-file() {
    log "ERROR: set-docker-env-file is retired; configure env_file in the repository-root docker-compose.yml." >&2
    return 2
}

urldecode() {
  local s="${1//+/ }"
  printf '%b' "${s//%/\\x}"
}