#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: ${0##*/} FROM_PREFIX TO_PREFIX [DIRECTORY]" >&2
  exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage

from_prefix="$1"
to_prefix="$2"
search_root="${3:-.}"

[[ -n "$from_prefix" && -n "$to_prefix" ]] || usage
[[ "$from_prefix" != "$to_prefix" ]] || {
  echo "FROM_PREFIX and TO_PREFIX must differ." >&2
  exit 2
}
[[ -d "$search_root" ]] || {
  echo "Directory not found: $search_root" >&2
  exit 2
}

mapfile -d '' matching_files < <(
  rg --files-with-matches --null --fixed-strings --hidden --no-ignore \
    --glob '!**/.git/**' \
    --glob '!**/node_modules/**' \
    --glob '!**/logs/**' \
    -- "$from_prefix" "$search_root"
)

if (( ${#matching_files[@]} == 0 )); then
  echo "No occurrences of $from_prefix found under $search_root."
  exit 0
fi

FROM_PREFIX="$from_prefix" TO_PREFIX="$to_prefix" \
  perl -pi -e 's/\Q$ENV{FROM_PREFIX}\E/$ENV{TO_PREFIX}/g' -- "${matching_files[@]}"

echo "Renamed $from_prefix to $to_prefix in ${#matching_files[@]} file(s) under $search_root."
