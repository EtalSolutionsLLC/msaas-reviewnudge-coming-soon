pm_telemetry_validate_local_realization() {
  command -v docker >/dev/null 2>&1 || die "docker is required to validate local telemetry" 2
  pm_telemetry_local_compose config --quiet
  log INFO "local telemetry realization validated" \
    "store=${TELEMETRY_STORE_PROVIDER_PLATFORM_CODE}" \
    "dashboard=${TELEMETRY_DASHBOARD_PROVIDER:-disabled}"
}

pm_telemetry_deploy_local_realization() {
  log INFO "deploying local telemetry realization" \
    "store=${TELEMETRY_STORE_PROVIDER_PLATFORM_CODE}" \
    "dashboard=${TELEMETRY_DASHBOARD_ENABLED:-false}"
  pm_telemetry_local_compose up -d --pull missing --remove-orphans --wait
  log INFO "local telemetry services started"
}

pm_telemetry_verify_local_realization() {
  local running required service dashboard_health attempt
  running="$(pm_telemetry_local_compose ps --status running --services)"
  required=$'telemetry_store\ntelemetry_collector'
  telemetry_is_true "${TELEMETRY_DASHBOARD_ENABLED:-false}" \
    && required+=$'\ntelemetry_dashboard'

  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    grep -Fxq "$service" <<<"$running" \
      || die "Telemetry service is not running after setup: $service" 2
  done <<<"$required"

  pm_telemetry_local_compose exec -T telemetry_store sh -ec 
#    'clickhouse-client --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --database "$CLICKHOUSE_DB" --query "SELECT 1" >/dev/null'

  if telemetry_is_true "${TELEMETRY_DASHBOARD_ENABLED:-false}"; then
    dashboard_health=""
    for attempt in $(seq 1 30); do
      dashboard_health="$(pm_telemetry_local_compose exec -T telemetry_dashboard \
        wget -qO- http://127.0.0.1:3000/api/health 2>/dev/null || true)"
      grep -q '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$dashboard_health" && break
      sleep 2
    done
    grep -q '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$dashboard_health" \
      || die "Telemetry dashboard did not become ready within 60 seconds" 2
  fi

  log INFO "local telemetry realization verified" "services=$(tr '\n' ',' <<<"$required" | sed 's/,$//')"
}

