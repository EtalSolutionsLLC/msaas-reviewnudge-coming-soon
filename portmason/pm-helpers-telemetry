telemetry_hydrate_secret() {
  local key="${1:?key required}" resolved_secret=""
  pm_secret_resolve_value resolved_secret "$key" "${!key:-}"
  printf -v "$key" '%s' "$resolved_secret"
  export "$key"
}

telemetry_run_database_module() {
  local module_name="${1:?module name required}"
  local module_file="${PORTMASON_SHARE}/${module_name}"
  [[ -r "$module_file" ]] || return 0
  log INFO "running telemetry database phase" "module=$module_name"
  . "$module_file"
}

telemetry_run_database_phases() {
  local platform="${TELEMETRY_DB_PLATFORM_CODE:?telemetry database platform required}"
  local provider="${TELEMETRY_DB_PROVIDER_CODE:?telemetry database provider required}"
  local provision_fn="telemetry_db_platform_${platform//-/_}_provision"
  local deploy_fn="telemetry_db_platform_${platform//-/_}_deploy"

  telemetry_hydrate_secret TELEMETRY_DB_USER
  telemetry_hydrate_secret TELEMETRY_DB_PASSWORD
  telemetry_hydrate_secret TELEMETRY_DB_API_KEY
  if declare -F "$provision_fn" >/dev/null 2>&1; then "$provision_fn"; else telemetry_run_database_module "pm-provision-telemetry-db-${platform}"; fi
  telemetry_run_database_module "pm-provision-telemetry-db-${provider}"
  if declare -F "$deploy_fn" >/dev/null 2>&1; then "$deploy_fn"; else telemetry_run_database_module "pm-deploy-telemetry-db-${platform}"; fi
  telemetry_run_database_module "pm-deploy-telemetry-db-${provider}"
}

telemetry_database_status() {
  local result database_name database_user
  [[ "${TELEMETRY_DB_PROVIDER_CODE:-}" == postgres ]] \
    || die "Telemetry database status is unsupported for provider: ${TELEMETRY_DB_PROVIDER_CODE:-<unset>}" 2
  result="$(telemetry_db_rt --tuples-only --no-align --command='SELECT current_database() || chr(124) || current_user;')"
  IFS='|' read -r database_name database_user <<<"$result"
  [[ "$database_name" == "${TELEMETRY_DB_NAME:?TELEMETRY_DB_NAME required}" ]] \
    || die "Telemetry database verification selected the wrong database: $database_name" 2
  [[ "$database_user" == "${TELEMETRY_DB_USER:?TELEMETRY_DB_USER required}" ]] \
    || die "Telemetry database verification selected the wrong user: $database_user" 2
  log INFO "telemetry database verification passed" "provider=postgres" "database=$database_name" "user=$database_user"
}

telemetry_usage() {
  printf '%s\n' 'Usage: pm-setup-telemetry [--refresh-from-root] [--env-file PATH]'
}

call_if_defined() {
  local function_name="${1:?function name required}"
  shift
  declare -F "$function_name" >/dev/null 2>&1 || return 0
  "$function_name" "$@"
}

is_deploy_snapshot_dir() {
  [[ "$(basename -- "$(dirname -- "$PWD")")" == "deploy" ]]
}

telemetry_db_rt() {
  local prepare_fn="telemetry_db_platform_${TELEMETRY_DB_PLATFORM_CODE:-}"

  [[ -n "${TELEMETRY_DB_PLATFORM_CODE:-}" ]] \
    && call_if_defined "${prepare_fn//-/_}_prepare_runtime"
  telemetry_hydrate_secret TELEMETRY_DB_USER
  telemetry_hydrate_secret TELEMETRY_DB_PASSWORD

  PM_DB_SERVICE=telemetry \
  PM_DB_RT_HOST="${TELEMETRY_DB_HOST:-}" \
  PM_DB_RT_PORT="${TELEMETRY_DB_PORT:-5432}" \
  PM_DB_RT_USER="${TELEMETRY_DB_USER:-}" \
  PM_DB_RT_PASSWORD="${TELEMETRY_DB_PASSWORD:-}" \
  PM_DB_RT_DATABASE="${TELEMETRY_DB_NAME:-}" \
    db_rt "$@"
}

telemetry_query_usage() {
  cat <<'USAGE'
Usage: pm-telemetry-query QUESTION.sql

Runs a telemetry workbench question. Portmason routes each statement according
to its portmason-target marker.
USAGE
}

telemetry_query_resolve_file() {
  local requested="${1:?question file required}"
  local candidate

  if [[ -r "$requested" ]]; then
    realpath "$requested"
    return 0
  fi

  candidate="${PROJECT_ROOT}/db/telemetry/workbench/queries/${requested}"
  [[ -r "$candidate" ]] \
    || die "Telemetry workbench question is not readable: $requested" 2
  realpath "$candidate"
}

telemetry_query_validate_target() {
  case "${1:-}" in
    telemetry-warehouse|telemetry-log-store) return 0 ;;
    *)
      die "Unsupported portmason-target: ${1:-<empty>}" 2
      return $?
      ;;
  esac
}

telemetry_query_record_block() {
  local target="${1:?target required}"
  local block_file="${2:?block file required}"
  local manifest="${3:?manifest required}"

  awk '!/^[[:space:]]*($|--)/ { found = 1 } END { exit !found }' "$block_file" \
    || die "portmason-target has no SQL statement: $target" 2
  printf '%s\t%s\n' "$target" "$block_file" >>"$manifest"
}

telemetry_query_parse() {
  local question_file="${1:?question file required}"
  local work_dir="${2:?work directory required}"
  local manifest="${3:?manifest required}"
  local line target="" block_file="" index=0

  : >"$manifest"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^--[[:space:]]*portmason-target:[[:space:]]*([A-Za-z0-9-]+)[[:space:]]*$ ]]; then
      if [[ -n "$target" ]]; then
        telemetry_query_record_block "$target" "$block_file" "$manifest"
      fi
      target="${BASH_REMATCH[1]}"
      telemetry_query_validate_target "$target" || return $?
      ((index += 1))
      block_file="${work_dir}/block-$(printf '%04d' "$index").sql"
      : >"$block_file"
      continue
    fi

    if [[ -n "$target" ]]; then
      printf '%s\n' "$line" >>"$block_file"
    elif [[ ! "$line" =~ ^[[:space:]]*$ && ! "$line" =~ ^[[:space:]]*-- ]]; then
      die "SQL appears before the first portmason-target marker" 2
    fi
  done <"$question_file"

  [[ -n "$target" ]] \
    || die "No portmason-target markers found in $question_file" 2
  telemetry_query_record_block "$target" "$block_file" "$manifest"
}

telemetry_query_cleanup() {
  local work_dir="${TELEMETRY_QUERY_WORK_DIR:-}"

  [[ -n "$work_dir" ]] || return 0
  case "$work_dir" in
    "${TMPDIR:-/tmp}"/pm-telemetry-query.*) ;;
    *) die "Refusing to remove unexpected telemetry query path: $work_dir" 2 ;;
  esac
  rm -rf -- "$work_dir"
  TELEMETRY_QUERY_WORK_DIR=""
}

telemetry_query_run() {
  local question_file="${1:?question file required}"
  local work_dir manifest target block_file step=0

  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/pm-telemetry-query.XXXXXX")"
  manifest="${work_dir}/manifest"
  TELEMETRY_QUERY_WORK_DIR="$work_dir"
  trap telemetry_query_cleanup EXIT

  telemetry_query_parse "$question_file" "$work_dir" "$manifest" || return $?

  while IFS=$'\t' read -r target block_file; do
    ((step += 1))
    log INFO "running telemetry workbench statement" \
      "question=$(basename -- "$question_file")" "step=$step" "target=$target"
    case "$target" in
      telemetry-warehouse)
        telemetry_db_rt --file=- <"$block_file"
        ;;
      telemetry-log-store)
        telemetry_log_store_run_file "$block_file"
        ;;
    esac
  done <"$manifest"

  telemetry_query_cleanup
  trap - EXIT
  log INFO "telemetry workbench question complete" \
    "question=$(basename -- "$question_file")" "statements=$step"
}

telemetry_query() {
  if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
    telemetry_query_usage
    return 0
  fi
  (($# == 1)) || die "Usage: pm-telemetry-query QUESTION.sql" 2

  local question_file
  question_file="$(telemetry_query_resolve_file "$1")"
  telemetry_query_run "$question_file"
}

# Initialize whenever pm-helpers-telemetry is sourced or executed. Inspection-only
# commands request a non-mutating bootstrap explicitly.
case "${1:-}" in
    --read-only) pm_telemetry_init ;;
    --minimal) : ;;
    *) pm_telemetry_init ;;
esac

telemetry_resolve_configuration
