#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" --minimal

pm_telemetry_init() {
  local invocation_dir requested_root requested_env_file active_dir

  invocation_dir="$(pwd -P)"
  pm_context_resolve_project_root requested_root
  pm_context_resolve_env_file requested_env_file "$requested_root"

  active_dir="$invocation_dir"
  case "$active_dir" in
    "$requested_root"|"$requested_root"/deploy/*) ;;
    "$requested_root"/*) active_dir="$requested_root" ;;
    *) die "Telemetry context escapes repository root: $active_dir" 2 ;;
  esac

  [[ -r "$requested_env_file" ]] \
    || die "Telemetry environment file is not readable: $requested_env_file" 2

  PROJECT_ROOT="$requested_root"
  REPO_ROOT="$requested_root"
  ORIG_PWD="$invocation_dir"
  SITE_DIR="$active_dir"
  SITE_ROOT="$active_dir"
  SCRIPT_DIR="$active_dir"
  ENV_FILE="$requested_env_file"
  LOG_DIR="${LOG_DIR:-$active_dir/logs}"
  LOG_FILE="${LOG_FILE:-$LOG_DIR/pm-setup-telemetry.log}"
  IN_CONTAINER="${IN_CONTAINER:-false}"
  export PROJECT_ROOT REPO_ROOT ORIG_PWD SITE_DIR SITE_ROOT SCRIPT_DIR
  export ENV_FILE LOG_DIR LOG_FILE IN_CONTAINER PORTMASON_SHARE

  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a

  mkdir -p -- "$LOG_DIR"
  setup_logging
}

telemetry_is_true() {
  case "${1,,}" in
    1|true|yes|on|enabled) return 0 ;;
    *) return 1 ;;
  esac
}

telemetry_resolve_configuration() {
  local master_enabled=false
  local store_selector="${TELEMETRY_STORE_PROVIDER_PLATFORM_CODE:-}"
  local store_provider="${store_selector%%-*}"
  local store_platform="${store_selector#*-}"
  local store_database="${TELEMETRY_STORE_NAME:-}"

  telemetry_is_true "${TELEMETRY_ENABLED:-false}" && master_enabled=true

  if [[ "$master_enabled" == true ]]; then
    [[ -n "$store_selector" ]] || die "TELEMETRY_STORE_PROVIDER_PLATFORM_CODE is required when telemetry is enabled" 2
    [[ "$store_selector" == *-* ]] || die "TELEMETRY_STORE_PROVIDER_PLATFORM_CODE must use provider-platform form" 2
    [[ "${TELEMETRY_STORE_EXTERNAL_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || die "TELEMETRY_STORE_EXTERNAL_URL is required and must be an HTTP or HTTPS URL" 2
    [[ "${TELEMETRY_STORE_INTERNAL_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || die "TELEMETRY_STORE_INTERNAL_URL is required and must be an HTTP or HTTPS URL" 2
  fi

  TELEMETRY_ENABLED="$master_enabled"
  TELEMETRY_STORE_PROVIDER_CODE="$store_provider"
  TELEMETRY_STORE_PLATFORM_CODE="$store_platform"
  if [[ "$master_enabled" == true ]]; then
    if [[ -z "$store_database" || "$store_database" == telemetry ]]; then
      store_database="${STACK:?STACK required for telemetry store isolation}"
      store_database="${store_database//-/_}_telemetry"
      log INFO "derived isolated telemetry store database" "database=$store_database" "stack=$STACK"
      env_init_set TELEMETRY_STORE_NAME "$store_database"
    fi
    [[ "$store_database" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "TELEMETRY_STORE_NAME must be a database identifier" 2
  fi
  export TELEMETRY_ENABLED TELEMETRY_STORE_PROVIDER_CODE TELEMETRY_STORE_PLATFORM_CODE
}

pm_telemetry_local_compose() {
  local generated_env="${ENV_FILE:?ENV_FILE required}.generated"
  local overlay="${SITE_DIR:?SITE_DIR required}/docker-compose.telemetry.yml"
  local -a profiles=(--profile telemetry)
  [[ -r "$generated_env" && -r "$overlay" ]] || die "Telemetry Compose inputs are not readable" 2
  telemetry_is_true "${TELEMETRY_DASHBOARD_ENABLED:-false}" \
    && profiles+=(--profile telemetry-dashboard)
  docker compose --project-directory "$SITE_DIR" --env-file "$generated_env" \
    -f "$overlay" "${profiles[@]}" "$@"
}

