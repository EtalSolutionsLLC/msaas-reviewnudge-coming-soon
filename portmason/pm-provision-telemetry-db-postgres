#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_telemetry_db_rt() {
    PM_DB_SERVICE=telemetry \
    PM_DB_RT_HOST="${PM_DB_RT_HOST:-${TELEMETRY_DB_HOST:-}}" \
    PM_DB_RT_PORT="${PM_DB_RT_PORT:-${TELEMETRY_DB_PORT:-5432}}" \
    PM_DB_RT_USER="${PM_DB_RT_USER:-${TELEMETRY_DB_USER:-}}" \
    PM_DB_RT_PASSWORD="${PM_DB_RT_PASSWORD:-${TELEMETRY_DB_PASSWORD:-}}" \
    PM_DB_RT_DATABASE="${PM_DB_RT_DATABASE:-${TELEMETRY_DB_NAME:-}}" \
        db_rt "$@"
}

pm_telemetry_postgres_psql_admin() {
    PM_DB_RT_HOST="${PM_TELEMETRY_DB_ADMIN_HOST:-${TELEMETRY_DB_HOST:?TELEMETRY_DB_HOST required}}" \
    PM_DB_RT_PORT="${PM_TELEMETRY_DB_ADMIN_PORT:-${TELEMETRY_DB_PORT:-5432}}" \
    PM_DB_RT_USER="${PM_TELEMETRY_DB_ADMIN_USER:-${TELEMETRY_DB_USER:?TELEMETRY_DB_USER required}}" \
    PM_DB_RT_PASSWORD="${PM_TELEMETRY_DB_ADMIN_PASSWORD:-${TELEMETRY_DB_PASSWORD:?TELEMETRY_DB_PASSWORD required}}" \
    PM_DB_RT_DATABASE="${PM_TELEMETRY_DB_ADMIN_NAME:-postgres}" \
        pm_telemetry_db_rt "$@"
}

pm_telemetry_postgres_ensure_role() {
    log INFO "ensuring application role" \
        "role=${TELEMETRY_DB_USER:?TELEMETRY_DB_USER required}"

    if [[ "${PM_TELEMETRY_DB_PLATFORM_CODE:-}" == neon ]]; then
        log INFO "Neon application role already provisioned by the Neon API" \
            "role=$TELEMETRY_DB_USER"
        return 0
    else
        # The application password travels through an inherited environment
        # value, never a command-line argument. psql imports it into a private
        # variable at execution time so neither Portmason logs nor process
        # listings expose it.
        PM_DB_SQL_SECRET="$TELEMETRY_DB_PASSWORD" \
            pm_telemetry_postgres_psql_admin --set=db_user="$TELEMETRY_DB_USER" --file=- <<'SQL'
\getenv db_password PM_DB_SQL_SECRET
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'db_user') \gexec
SELECT format('ALTER ROLE %I WITH LOGIN PASSWORD %L', :'db_user', :'db_password') \gexec
-- Managed-service administrators are not PostgreSQL superusers. Give the
-- administrator SET ROLE capability so it can assign database ownership while
-- preserving the application's non-inherited privilege boundary.
SELECT CASE
  WHEN current_setting('server_version_num')::integer >= 160000
    THEN format('GRANT %I TO %I WITH SET TRUE', :'db_user', current_user)
  ELSE format('GRANT %I TO %I', :'db_user', current_user)
END
WHERE current_user <> :'db_user' \gexec
SQL
    fi

    log INFO "application role ready" \
        "role=$TELEMETRY_DB_USER"
}

pm_telemetry_postgres_ensure_database() {
    log INFO "ensuring application database" \
        "database=${TELEMETRY_DB_NAME:?TELEMETRY_DB_NAME required}" "owner=$TELEMETRY_DB_USER"

    if [[ "${PM_TELEMETRY_DB_PLATFORM_CODE:-}" == neon ]]; then
        log INFO "Neon application database already provisioned by the Neon API" \
            "database=$TELEMETRY_DB_NAME" "owner=$TELEMETRY_DB_USER"
        return 0
    fi

    # psql variable interpolation and \gexec are client-side features. Feed the
    # script through --file=- so psql processes them before sending SQL to the
    # server. Passing the same text through --command sends :'name' verbatim.
    pm_telemetry_postgres_psql_admin \
        --set=db_name="$TELEMETRY_DB_NAME" \
        --set=db_user="$TELEMETRY_DB_USER" \
        --file=- <<'SQL'
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db_name') \gexec
SELECT format('ALTER DATABASE %I OWNER TO %I', :'db_name', :'db_user') \gexec
SQL

    log INFO "application database ready" \
        "database=$TELEMETRY_DB_NAME" "owner=$TELEMETRY_DB_USER"
}

pm_telemetry_postgres_apply_base_grants() {
    log INFO "applying base ownership and grants" \
        "database=$TELEMETRY_DB_NAME" "role=$TELEMETRY_DB_USER"
    PM_DB_RT_USER="$TELEMETRY_DB_USER" \
    PM_DB_RT_PASSWORD="$TELEMETRY_DB_PASSWORD" \
    PM_DB_RT_DATABASE="$TELEMETRY_DB_NAME" \
        pm_telemetry_db_rt --set=db_user="$TELEMETRY_DB_USER" --file=- <<'SQL'
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO %I', current_database(), :'db_user') \gexec
SELECT format('GRANT USAGE, CREATE ON SCHEMA public TO %I', :'db_user') \gexec
SQL
    log INFO "base ownership and grants ready" \
        "database=$TELEMETRY_DB_NAME" "role=$TELEMETRY_DB_USER"
}

pm_provision_telemetry_db_provider() {

    [[ "${PM_TELEMETRY_DB_PROVIDER_CODE:-}" == "postgres" ]] \
        || die "pm-provision-telemetry-db-postgres requires TELEMETRY_DB_PROVIDER_PLATFORM_CODE=postgres-<platform>" 2

    pm_telemetry_hydrate_secret TELEMETRY_DB_USER
    pm_telemetry_hydrate_secret TELEMETRY_DB_PASSWORD

    : "${TELEMETRY_DB_NAME:?TELEMETRY_DB_NAME required}"
    : "${TELEMETRY_DB_USER:?TELEMETRY_DB_USER required}"
    : "${TELEMETRY_DB_PASSWORD:?TELEMETRY_DB_PASSWORD required}"
    if [[ -n "${PM_TELEMETRY_DB_ADMIN_USER:-}" \
        && "$TELEMETRY_DB_USER" == "$PM_TELEMETRY_DB_ADMIN_USER" ]]; then
        die "TELEMETRY_DB_USER must be an application role, not the discovered database administrator" 2
    fi

    log INFO "starting provider provisioning" \
        "platform=${PM_TELEMETRY_DB_PLATFORM_CODE:-}" "database=$TELEMETRY_DB_NAME" "user=$TELEMETRY_DB_USER"

    pm_telemetry_postgres_ensure_role
    pm_telemetry_postgres_ensure_database
    pm_telemetry_postgres_apply_base_grants

    log INFO "provider provisioning complete" \
        "database=$TELEMETRY_DB_NAME" "user=$TELEMETRY_DB_USER"
}

main() {
    pm_provision_telemetry_db_provider "$@"
}

main "$@"
