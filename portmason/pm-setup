#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"

PM_COMPOSE_FILE=
export PM_COMPOSE_FILE

. "${PORTMASON_SHARE}/pm-helpers" "$@"

bootstrap_error() {
    printf 'ERROR: pm-setup bootstrap: %s\n' "$*" >&2
    exit 2
}

resolve_setup_context() {
    local invocation_dir="${1:?invocation directory required}"
    local repo_root relative deploy_tail deploy_env active_dir

    command -v git >/dev/null 2>&1 \
        || bootstrap_error "git is required to locate the repository root"

    repo_root="$(git -C "$invocation_dir" rev-parse --show-toplevel 2>/dev/null)" \
        || bootstrap_error "not inside a Git repository: $invocation_dir"

    repo_root="$(cd -- "$repo_root" && pwd -P)"
    invocation_dir="$(cd -- "$invocation_dir" && pwd -P)"

    case "$invocation_dir" in
        "$repo_root")
            active_dir="$repo_root"
            deploy_env=""
            ;;
        "$repo_root"/deploy/*)
            relative="${invocation_dir#"$repo_root"/}"
            deploy_tail="${relative#deploy/}"
            deploy_env="${deploy_tail%%/*}"
            [[ -n "$deploy_env" ]] \
                || bootstrap_error "unable to resolve deployment environment from $invocation_dir"
            active_dir="$repo_root/deploy/$deploy_env"
            [[ -d "$active_dir" ]] \
                || bootstrap_error "deployment directory does not exist: $active_dir"
            ;;
        "$repo_root"/*)
            active_dir="$repo_root"
            deploy_env=""
            ;;
        *)
            bootstrap_error "resolved directory escapes repository root: $invocation_dir"
            ;;
    esac

    export PM_SETUP_INVOKED_FROM="$invocation_dir"
    export PORTMASON_PROJECT_ROOT="$repo_root"
    export SCRIPT_DIR="$active_dir"
    export PM_COMPOSE_CONTROL_FILE="$repo_root/docker-compose.yml"
    export PM_COMPOSE_PROJECT_DIRECTORY="$active_dir"
    export MGT_SCRIPT_DIR="$active_dir/mgt-scripts"
    cd -- "$active_dir"
}

resolve_setup_context "$PWD"

if [[ "${1:-}" == "--bootstrap-context" ]]; then
    printf 'PROJECT_ROOT=%s\n' "$PORTMASON_PROJECT_ROOT"
    printf 'SCRIPT_DIR=%s\n' "$SCRIPT_DIR"
    printf 'PM_COMPOSE_CONTROL_FILE=%s\n' "$PM_COMPOSE_CONTROL_FILE"
    printf 'PM_COMPOSE_PROJECT_DIRECTORY=%s\n' "$PM_COMPOSE_PROJECT_DIRECTORY"
    printf 'DEPLOY_ENV=%s\n' "${DEPLOY_ENV:-}"
    printf 'PWD=%s\n' "$PWD"
    exit 0
fi

PM_SETUP_UPDATE_ARCHIVE="${PM_SETUP_UPDATE_ARCHIVE:-}"
PM_SETUP_UPDATE_SHA256="${PM_SETUP_UPDATE_SHA256:-}"
PM_SETUP_UPDATE_RECEIPT="${PM_SETUP_UPDATE_RECEIPT:-}"
PM_SETUP_UPDATE_STARTED_AT="${PM_SETUP_UPDATE_STARTED_AT:-}"
PM_SETUP_UPDATE_REENTERED="${PM_SETUP_UPDATE_REENTERED:-0}"
declare -a PM_SETUP_FORWARD_ARGS=()

pm_setup_resolve_update_archive() {
    local requested="${1:?archive path required}"
    local candidate=""

    if [[ "$requested" == /* ]]; then
        candidate="$requested"
    elif [[ -f "${PM_SETUP_INVOKED_FROM}/${requested}" ]]; then
        candidate="${PM_SETUP_INVOKED_FROM}/${requested}"
    else
        candidate="${PORTMASON_PROJECT_ROOT}/${requested}"
    fi

    [[ -f "$candidate" ]] \
        || bootstrap_error "update archive not found: $requested"
    realpath -- "$candidate"
}

pm_setup_prepare_update() {
    local requested="${1:?archive path required}"
    local archive_name receipt_dir

    command -v sha256sum >/dev/null 2>&1 \
        || bootstrap_error "sha256sum is required for --update"
    [[ -x "${PORTMASON_SHARE}/pm-extract-files-from-tar" ]] \
        || bootstrap_error "pm-extract-files-from-tar is unavailable or not executable"

    PM_SETUP_UPDATE_ARCHIVE="$(pm_setup_resolve_update_archive "$requested")"
    PM_SETUP_UPDATE_SHA256="$(sha256sum -- "$PM_SETUP_UPDATE_ARCHIVE" | awk '{print $1}')"
    PM_SETUP_UPDATE_STARTED_AT="$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
    archive_name="$(basename -- "$PM_SETUP_UPDATE_ARCHIVE")"
    receipt_dir="${PORTMASON_PROJECT_ROOT}/.portmason/updates"
    mkdir --parents -- "$receipt_dir"
    PM_SETUP_UPDATE_RECEIPT="${receipt_dir}/${PM_SETUP_UPDATE_SHA256}.json"

    (
        cd -- "$PORTMASON_PROJECT_ROOT"
        "${PORTMASON_SHARE}/pm-extract-files-from-tar" \
            "$PM_SETUP_UPDATE_ARCHIVE"
    )

    export PM_SETUP_UPDATE_ARCHIVE PM_SETUP_UPDATE_SHA256 \
        PM_SETUP_UPDATE_RECEIPT PM_SETUP_UPDATE_STARTED_AT
    printf '{"archive":"%s","sha256":"%s","startedAt":"%s","result":"extracted"}\n' \
        "$archive_name" "$PM_SETUP_UPDATE_SHA256" "$PM_SETUP_UPDATE_STARTED_AT" \
        > "$PM_SETUP_UPDATE_RECEIPT"
}

pm_setup_parse_bootstrap_args() {
    local arg
    while (($#)); do
        arg="$1"
        shift
        case "$arg" in
            --update)
                (($#)) || bootstrap_error "--update requires an archive path"
                [[ -z "$PM_SETUP_UPDATE_ARCHIVE" ]] \
                    || bootstrap_error "--update may be specified only once"
                pm_setup_prepare_update "$1"
                shift
                ;;
            --update=*)
                [[ -z "$PM_SETUP_UPDATE_ARCHIVE" ]] \
                    || bootstrap_error "--update may be specified only once"
                [[ -n "${arg#--update=}" ]] \
                    || bootstrap_error "--update requires an archive path"
                pm_setup_prepare_update "${arg#--update=}"
                ;;
            *)
                PM_SETUP_FORWARD_ARGS+=("$arg")
                ;;
        esac
    done
}

pm_setup_parse_bootstrap_args "$@"
set -- "${PM_SETUP_FORWARD_ARGS[@]}"

if [[ -n "${PM_SETUP_UPDATE_ARCHIVE:-}" ]] \
    && [[ "${PM_SETUP_UPDATE_REENTERED:-0}" != "1" ]]; then

    export PM_SETUP_UPDATE_REENTERED=1

    cd -- "${PM_SETUP_INVOKED_FROM}"
    exec "${PORTMASON_SHARE}/pm-setup" "$@"
fi

pm_error_summary_reset
PM_SETUP_HANDLED_FAILURE=0
PM_SETUP_RUN_FAILED=0
PM_SETUP_DEPLOYMENT_BLOCKED=0
PM_SETUP_ALLOCATED_BUILD=0
PM_SETUP_BUILD_FILE=""
PM_SETUP_PREVIOUS_BUILD_NUMBER=""
PM_SETUP_ALLOCATED_BUILD_NUMBER=""
PM_COMPOSE_LABELS_OVERRIDE_FILE=""
declare -Ag PM_SETUP_INVALID_SOURCE_FILES=()

pm_setup_cleanup_compose_labels() {
    if [[ -n "${PM_COMPOSE_LABELS_OVERRIDE_FILE:-}" \
        && -f "$PM_COMPOSE_LABELS_OVERRIDE_FILE" ]]; then
        rm -f -- "$PM_COMPOSE_LABELS_OVERRIDE_FILE"
    fi
    PM_COMPOSE_LABELS_OVERRIDE_FILE=""
}

pm_setup_exit() {
    local rc="$?"

    trap - EXIT
    set +e

    pm_setup_cleanup_compose_labels
    if declare -F cleanup_tail >/dev/null 2>&1; then
        cleanup_tail
    fi
    if declare -F pm_error_summary_print >/dev/null 2>&1; then
        pm_error_summary_print
    fi

    return "$rc"
}

trap pm_setup_exit EXIT

pm_setup_write_update_receipt() {
    local result="${1:?result required}"
    local rc="${2:-0}"
    local completed_at archive_name

    [[ -n "${PM_SETUP_UPDATE_RECEIPT:-}" ]] || return 0
    completed_at="$(date --utc +%Y-%m-%dT%H:%M:%SZ)"
    archive_name="$(basename -- "${PM_SETUP_UPDATE_ARCHIVE}")"

    printf '{"archive":"%s","sha256":"%s","startedAt":"%s","completedAt":"%s","result":"%s","exitCode":%s}\n' \
        "$archive_name" "$PM_SETUP_UPDATE_SHA256" "$PM_SETUP_UPDATE_STARTED_AT" \
        "$completed_at" "$result" "$rc" > "$PM_SETUP_UPDATE_RECEIPT"
}

pm_setup_report_error() {
    local rc="${1:-$?}"
    local command="${2:-${BASH_COMMAND:-<unknown>}}"
    local source_file="${3:-${BASH_SOURCE[1]:-${BASH_SOURCE[0]:-pm-setup}}}"
    local source_line="${4:-${BASH_LINENO[0]:-${LINENO:-0}}}"
    local function_name="${5:-${FUNCNAME[1]:-main}}"

    trap - ERR
    PM_SETUP_RUN_FAILED=1

    if [[ "${PM_SETUP_HANDLED_FAILURE:-0}" != 1 ]]; then
        if declare -F log >/dev/null 2>&1; then
            log ERROR "unhandled command failure" \
                "rc=${rc}" \
                "source=${source_file}" \
                "line=${source_line}" \
                "function=${function_name}" \
                "command=${command}"
        else
            printf 'ERROR: pm-setup failure rc=%s source=%s line=%s function=%s command=%s\n' \
                "$rc" "$source_file" "$source_line" "$function_name" "$command" >&2
        fi
    fi

    pm_setup_rollback_allocated_build
    pm_setup_write_update_receipt "failed" "$rc"
    exit "$rc"
}

set -E
trap 'pm_setup_report_error "$?" "$BASH_COMMAND" "${BASH_SOURCE[0]:-pm-setup}" "${LINENO:-0}" "${FUNCNAME[0]:-main}"' ERR

pm_setup_record_failure() {
    local message="${1:?message required}"
    shift

    PM_SETUP_RUN_FAILED=1
    log ERROR "$message" "$@"
}

pm_setup_allocate_build_number() {
    local build_file="${PROJECT_ROOT}/BUILD_NUMBER"
    local version_command=""
    local allocated=""

    PM_SETUP_BUILD_FILE=""
    PM_SETUP_PREVIOUS_BUILD_NUMBER=""
    PM_SETUP_ALLOCATED_BUILD_NUMBER=""
    PM_SETUP_ALLOCATED_BUILD=0

    if [[ ! -r "$build_file" ]]; then
        log WARN \
            "BUILD_NUMBER is missing or unreadable; continuing without build metadata"
        return 0
    fi

    version_command="$(command -v pm-version || true)"

    [[ -n "$version_command" ]] \
        || version_command="${PORTMASON_SHARE}/pm-version"

    if [[ ! -x "$version_command" ]]; then
        log WARN \
            "pm-version is unavailable; continuing without build metadata"
        return 0
    fi

    PM_SETUP_BUILD_FILE="$build_file"

    PM_SETUP_PREVIOUS_BUILD_NUMBER="$(
        tr -d '[:space:]' < "$build_file"
    )"

    log INFO "phase start" \
        "phase=build-allocation" \
        "previous_build=$PM_SETUP_PREVIOUS_BUILD_NUMBER"

    if ! allocated="$(
        PM_VERSION_ROOT="$PROJECT_ROOT" \
            "$version_command" build allocate --allow-local
    )"; then
        log WARN \
            "Unable to allocate BUILD_NUMBER; continuing without build metadata"
        return 0
    fi

    allocated="${allocated//[[:space:]]/}"

    if [[ -z "$allocated" ]]; then
        log WARN \
            "pm-version returned no BUILD_NUMBER; continuing without build metadata"
        return 0
    fi

    PM_SETUP_ALLOCATED_BUILD_NUMBER="$allocated"
    PM_SETUP_ALLOCATED_BUILD=1

    log INFO "phase complete" \
        "phase=build-allocation" \
        "build=$PM_SETUP_ALLOCATED_BUILD_NUMBER"
}

pm_setup_rollback_allocated_build() {
    local snapshot="" snapshot_build="" snapshot_version=""

    [[ "${PM_SETUP_ALLOCATED_BUILD:-0}" == 1 ]] || return 0
    [[ -n "${PM_SETUP_BUILD_FILE:-}" ]] || return 0
    [[ -n "${PM_SETUP_PREVIOUS_BUILD_NUMBER:-}" ]] || return 0

    if [[ -w "${PM_SETUP_BUILD_FILE:-/dev/null}" ]]; then
        printf '%s\n' \
            "$PM_SETUP_PREVIOUS_BUILD_NUMBER" \
            > "$PM_SETUP_BUILD_FILE"
    fi

    if [[ -d "${PROJECT_ROOT:-}/deploy" ]]; then
        while IFS= read -r -d '' snapshot; do
            snapshot_build="${snapshot}/BUILD_NUMBER"
            snapshot_version="${snapshot}/VERSION"

            if [[ -w "$snapshot_build" \
                && "$(tr -d '[:space:]' < "$snapshot_build")" == "$PM_SETUP_ALLOCATED_BUILD_NUMBER" ]]; then
                printf '%s\n' \
                    "$PM_SETUP_PREVIOUS_BUILD_NUMBER" \
                    > "$snapshot_build"
            fi

            if [[ -w "$snapshot_version" \
                && "$(tr -d '[:space:]' < "$snapshot_version")" == "$PM_SETUP_ALLOCATED_BUILD_NUMBER" ]]; then
                printf '%s\n' \
                    "$PM_SETUP_PREVIOUS_BUILD_NUMBER" \
                    > "$snapshot_version"
            fi
        done < <(
            find "${PROJECT_ROOT}/deploy" \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                -print0
        )
    fi

    if declare -F log >/dev/null 2>&1; then
        log WARN \
            "rolled back allocated build after failed setup" \
            "build=$PM_SETUP_ALLOCATED_BUILD_NUMBER" \
            "restored=$PM_SETUP_PREVIOUS_BUILD_NUMBER"
    fi
}

pm_setup_log_completion() {
    log INFO "workflow complete" \
        "deploy_env=${DEPLOY_ENV:-prd}" \
        "stack=${STACK:-<unset>}"

    ensure_app_url

    if [[ -n "${APP_URL:-}" ]]; then
        log INFO "application ready" "APP_URL=${APP_URL}"
    else
        warn "application URL unavailable" "APP_URL=<unset>"
    fi
}

main() {
    export PROJECT_SERVICES=

    local deploy_sync_active=0
    local deploy_sync_force=0
    local sync_owner_host=""
    local -a sync_args=(--prepare)

    pm_setup_allocate_build_number "$@"

    case "${PM_DEPLOY_SYNC_FORCE:-}" in
        1|true|TRUE|yes|YES|on|ON)
            deploy_sync_force=1
            ;;
    esac

    [[ ${REFRESH_FROM_ROOT:-0} == 1 || ${FORCE_DEPLOY_SYNC:-0} == 1 ]] && deploy_sync_force=1

    if is_deploy_snapshot_dir; then
        sync_owner_host="$(hostname 2>/dev/null || printf 'unknown')"
        if [[ "$deploy_sync_force" -eq 1 ]]; then
            sync_args+=(--force)
            log INFO "pm-setup: explicit deploy refresh requested"
        fi
        PM_DEPLOY_SYNC_OWNER_PID="$$" \
        PM_DEPLOY_SYNC_OWNER_HOST="$sync_owner_host" \
            "${PORTMASON_SHARE}/pm-sync-deploy-from-root" "${sync_args[@]}"
        deploy_sync_active=1
    elif [[ "$deploy_sync_force" -eq 1 ]]; then
        die "--refresh-from-root is only valid from deploy/<env>"
    fi

    log INFO "pm-setup: generating project configuration"
    log INFO "pm-setup: PROJECT_ROOT=${PROJECT_ROOT:-<unset>}"
    log INFO "pm-setup: SCRIPT_DIR=${SCRIPT_DIR:-<unset>}"
	log INFO "pm-setup: DEPLOY_ENV=${DEPLOY_ENV:-prd}"
    log INFO "pm-setup: ENV_FILE=${ENV_FILE:-<unset>}"
    log INFO "pm-setup: SITE_DIR=${SITE_DIR:-<unset>}"
    log INFO "pm-setup: generator=${PORTMASON_SHARE}/pm-generate-config"
    log INFO "pm-setup: RUNTIME_ADAPTER_CODE=${RUNTIME_ADAPTER_CODE:-<unset>}"
    log INFO "pm-setup: DB_PROVIDER_PLATFORM_CODE=${DB_PROVIDER_PLATFORM_CODE:-<unset>}"

    stage_portmason "archive" "cagent" "*cosign*" "*log"

    local file

    if pm_db_has_configuration; then
        file="${PORTMASON_SHARE}/pm-provision-db-${DB_PLATFORM_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

        file="${PORTMASON_SHARE}/pm-provision-db-${DB_PROVIDER_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

        file="${PORTMASON_SHARE}/pm-setup-db-${DB_PLATFORM_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

        file="${PORTMASON_SHARE}/pm-setup-db-${DB_PROVIDER_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

        file="${PORTMASON_SHARE}/pm-deploy-db-${DB_PLATFORM_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

        file="${PORTMASON_SHARE}/pm-deploy-db-${DB_PROVIDER_CODE}"
	    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }
    fi

	file="${PORTMASON_SHARE}/pm-provision-${ADAPTER_CODE}"
	[[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

	file="${PORTMASON_SHARE}/pm-provision-${RUNTIME_CODE}"
	[[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

    file="${PORTMASON_SHARE}/pm-setup-${ADAPTER_CODE}"
    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

    file="${PORTMASON_SHARE}/pm-setup-${RUNTIME_CODE}"
    [[ -r "$file" ]] && { log INFO "sourcing $file"; . "$file" "$@"; }

    file="${MGT_SCRIPT_DIR}/setup"
    if [[ -r "$file" ]]; then
        . "$file" "$@"
        local rc=$?

        case "$rc" in
            0)
                log INFO "project setup hook complete" "file=$file"
                ;;
            1)
                die "General error:" "$rc"
                ;;
            2)
                die "Misuse of shell builtins or command-specific code." "$rc"
                ;;
            *)
                fatal_error "Unexpected error code:" "$rc"
                ;;
        esac
    fi

    file="${PORTMASON_SHARE}/pm-deploy-${RUNTIME_CODE}"
    [[ -r "$file" ]] && {
        log INFO "sourcing $file"
        . "$file" "$@"
    }

    if declare -F pm_bridge_deploy >/dev/null 2>&1; then
        log INFO "pm-setup: using bridge deploy hook: pm_bridge_deploy"
        pm_bridge_deploy "$@"
    else
        file="${PORTMASON_SHARE}/pm-deploy-${ADAPTER_CODE}"
        [[ -r "$file" ]] && {
            log INFO "sourcing $file"
            . "$file" "$@"
        }
    fi

    if [[ "$deploy_sync_active" -eq 1 ]]; then
        PM_DEPLOY_SYNC_OWNER_PID="$$" \
        PM_DEPLOY_SYNC_OWNER_HOST="$sync_owner_host" \
            "${PORTMASON_SHARE}/pm-sync-deploy-from-root" --finalize
    fi

    if (( PM_SETUP_RUN_FAILED == 0 )); then
        pm_setup_log_completion
        pm_setup_write_update_receipt \
            "deployed" \
            0
    else
        log WARN \
            "workflow completed diagnostic collection with errors" \
            "action=review-error-summary"

        pm_setup_rollback_allocated_build
        pm_setup_write_update_receipt \
            "failed" \
            2
    fi

    return 0
}

pm_setup_arg \
    REFRESH_FROM_ROOT \
    "--refresh-from-root" \
    export

pm_setup_arg \
    FORCE_DEPLOY_SYNC \
    "--force-deploy-sync" \
    export

pm_commit_args "$@"

main "$@"
pm_error_summary_print

if (( PM_SETUP_RUN_FAILED != 0 )); then
    exit 2
fi