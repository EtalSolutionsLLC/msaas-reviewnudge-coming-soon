# fi

: "${POSTGRES_TOOL_IMAGE:=postgres:17-alpine}"
: "${DB_CONNECT_TIMEOUT_SECONDS:=20}"
: "${DB_VISIBILITY_MAX_ATTEMPTS:=15}"
: "${DB_VISIBILITY_RETRY_SECONDS:=2}"
export POSTGRES_TOOL_IMAGE DB_CONNECT_TIMEOUT_SECONDS
export DB_VISIBILITY_MAX_ATTEMPTS DB_VISIBILITY_RETRY_SECONDS


pm_neon_discover_admin_identity() {
    local roles=""
    local databases=""
    local selected=""

    : "${DB_PROJECT_ID:?DB_PROJECT_ID required}"
    : "${DB_BRANCH_ID:?DB_BRANCH_ID required}"

    pm_neon_api_request roles GET \
        "/projects/${DB_PROJECT_ID}/branches/${DB_BRANCH_ID}/roles"
    pm_neon_api_request databases GET \
        "/projects/${DB_PROJECT_ID}/branches/${DB_BRANCH_ID}/databases"

    if [[ -n "${DB_ADMIN_ROLE:-}" ]]; then
        jq -e --arg name "$DB_ADMIN_ROLE" \
            'any(.roles[]?; .name == $name)' >/dev/null <<<"$roles" \
            || die "pm-db-bridge-postgres-neon: configured DB_ADMIN_ROLE does not exist: $DB_ADMIN_ROLE" 2
    else
        selected="$(jq -r '
            ([.roles[]? | select(.name == "neondb_owner")][0].name)
            // ([.roles[]? | select((.protected // false) == true)][0].name)
            // .roles[0].name // empty' <<<"$roles")"
        [[ -n "$selected" ]] \
            || die "pm-db-bridge-postgres-neon: no administrative Neon role was discovered" 2
        DB_ADMIN_ROLE="$selected"
    fi

    if [[ -n "${DB_ADMIN_DATABASE:-}" ]]; then
        jq -e --arg name "$DB_ADMIN_DATABASE" \
            'any(.databases[]?; .name == $name)' >/dev/null <<<"$databases" \
            || die "pm-db-bridge-postgres-neon: configured DB_ADMIN_DATABASE does not exist: $DB_ADMIN_DATABASE" 2
    else
        selected="$(jq -r --arg owner "$DB_ADMIN_ROLE" '
            ([.databases[]? | select(.name == "neondb")][0].name)
            // ([.databases[]? | select(.owner_name == $owner)][0].name)
            // .databases[0].name // empty' <<<"$databases")"
        [[ -n "$selected" ]] \
            || die "pm-db-bridge-postgres-neon: no administrative Neon database was discovered" 2
        DB_ADMIN_DATABASE="$selected"
    fi

    export DB_ADMIN_ROLE DB_ADMIN_DATABASE
    log INFO "pm-db-bridge-postgres-neon: discovered administrative identity" \
        "role=$DB_ADMIN_ROLE" "database=$DB_ADMIN_DATABASE"
}

pm_neon_hydrate_application_secret() {
    local key="${1:?key required}"
    [[ -z "${!key:-}" ]] || pm_secret_value_is_sentinel "${!key}" || return 0

    local secret_path=""
    local value=""

    if secret_path="$(get_secret_path_by_ref "$key")" \
        && declare -F get_secret >/dev/null 2>&1; then
        if ! value="$(get_secret "$secret_path")"; then
            die "pm-db-bridge-postgres-neon: unable to retrieve $key from configured secret path" 2
        fi
        [[ -n "$value" ]] \
            || die "pm-db-bridge-postgres-neon: retrieved $key is empty" 2
        printf -v "$key" '%s' "$value"
        export "$key"
        log INFO "pm-db-bridge-postgres-neon: loaded application secret" \
            "key=$key" "path=$secret_path"
        return 0
    fi

    if [[ "${ADAPTER_CODE:-}" == gcp ]] \
        && declare -F pm_gcp_get_secret_value >/dev/null 2>&1; then
        if pm_gcp_get_secret_value value "$key"; then
            [[ -n "$value" ]] \
                || die "pm-db-bridge-postgres-neon: resolved $key is empty" 2
            printf -v "$key" '%s' "$value"
            export "$key"
            log INFO "pm-db-bridge-postgres-neon: loaded application secret from GCP Secret Manager" \
                "key=$key"
            return 0
        fi
    fi

    die "pm-db-bridge-postgres-neon: $key is required or must resolve through its configured secret path" 2
}

pm_neon_prepare_connection_contract() {
    local admin_direct_uri=""
    local admin_pooled_uri=""
    local NEON_ADMIN_DIRECT_HOST=""
    local NEON_ADMIN_DIRECT_PORT=""
    local NEON_ADMIN_DIRECT_USER=""
    local NEON_ADMIN_DIRECT_PASSWORD=""
    local NEON_ADMIN_DIRECT_DATABASE=""
    local NEON_ADMIN_POOLED_HOST=""
    local NEON_ADMIN_POOLED_PORT=""
    local NEON_ADMIN_POOLED_USER=""
    local NEON_ADMIN_POOLED_PASSWORD=""
    local NEON_ADMIN_POOLED_DATABASE=""

    : "${DB_NAME:?DB_NAME required}"
    : "${NEON_USE_POOLER:=true}"

    pm_neon_hydrate_application_secret DB_USER
    pm_neon_hydrate_application_secret DB_PASSWORD
    pm_neon_discover_admin_identity
    pm_neon_connection_uri admin_direct_uri "$DB_ADMIN_ROLE" "$DB_ADMIN_DATABASE" false
    pm_neon_connection_uri admin_pooled_uri "$DB_ADMIN_ROLE" "$DB_ADMIN_DATABASE" true

    pm_db_postgres_parse_url_into NEON_ADMIN_DIRECT "$admin_direct_uri" \
        || die "pm-db-bridge-postgres-neon: unable to parse direct administrative connection URI" 2
    pm_db_postgres_parse_url_into NEON_ADMIN_POOLED "$admin_pooled_uri" \
        || die "pm-db-bridge-postgres-neon: unable to parse pooled administrative connection URI" 2

    DB_ADMIN_HOST="$NEON_ADMIN_DIRECT_HOST"
    DB_ADMIN_PORT="$NEON_ADMIN_DIRECT_PORT"
    DB_ADMIN_USER="$NEON_ADMIN_DIRECT_USER"
    DB_ADMIN_PASSWORD="$NEON_ADMIN_DIRECT_PASSWORD"
    DB_ADMIN_DATABASE="$NEON_ADMIN_DIRECT_DATABASE"
    NEON_DIRECT_HOST="$NEON_ADMIN_DIRECT_HOST"
    NEON_POOLED_HOST="$NEON_ADMIN_POOLED_HOST"
    DB_PORT="$NEON_ADMIN_DIRECT_PORT"
    DB_SSL_MODE=require

    pm_db_postgres_build_url DB_DIRECT_URL \
        "$NEON_DIRECT_HOST" "$DB_PORT" "$DB_NAME" "$DB_USER" "$DB_PASSWORD" require
    pm_db_postgres_build_url DB_URL \
        "$NEON_POOLED_HOST" "$DB_PORT" "$DB_NAME" "$DB_USER" "$DB_PASSWORD" require

    case "$NEON_USE_POOLER" in
        1|true|TRUE|yes|YES|on|ON)
            DB_HOST="$NEON_POOLED_HOST"
            ;;
        0|false|FALSE|no|NO|off|OFF)
            DB_HOST="$NEON_DIRECT_HOST"
            DB_URL="$DB_DIRECT_URL"
            ;;
        *)
            die "pm-db-bridge-postgres-neon: NEON_USE_POOLER must be boolean" 2
            ;;
    esac

    export DB_ADMIN_HOST DB_ADMIN_PORT DB_ADMIN_USER DB_ADMIN_PASSWORD DB_ADMIN_DATABASE
    export NEON_DIRECT_HOST NEON_POOLED_HOST DB_HOST DB_PORT DB_SSL_MODE
    export DB_URL DB_DIRECT_URL

    log INFO "pm-db-bridge-postgres-neon: prepared canonical connection contract" \
        "admin_host=$DB_ADMIN_HOST" \
        "application_host=$DB_HOST" \
        "direct_host=$NEON_DIRECT_HOST" \
        "port=$DB_PORT" \
        "database=$DB_NAME" \
        "mode=$([[ "$DB_HOST" == "$NEON_POOLED_HOST" ]] && printf pooled || printf direct)"
}

pm_neon_database_is_visible() {
    local host="${1:?host required}"
    local port="${2:?port required}"
    local database="${3:?database required}"
    local user="${4:?user required}"
    local password="${5:?password required}"

    PGPASSWORD="$password" \
    docker run --rm \
        --env "PGHOST=$host" \
        --env "PGPORT=$port" \
        --env "PGDATABASE=$database" \
        --env "PGUSER=$user" \
        --env PGPASSWORD \
        --env "PGSSLMODE=require" \
        --env "PGCONNECT_TIMEOUT=$DB_CONNECT_TIMEOUT_SECONDS" \
        "$POSTGRES_TOOL_IMAGE" \
        psql --no-psqlrc --set ON_ERROR_STOP=1 \
            --tuples-only --no-align --command='SELECT 1;' \
        >/dev/null 2>&1
}

pm_neon_wait_for_database() {
    local host="${1:?host required}"
    local port="${2:?port required}"
    local database="${3:?database required}"
    local user="${4:?user required}"
    local password="${5:?password required}"
    local attempt=1

    while (( attempt <= DB_VISIBILITY_MAX_ATTEMPTS )); do
        if pm_neon_database_is_visible "$host" "$port" "$database" "$user" "$password"; then
            (( attempt == 1 )) || log INFO \
                "pm-db-bridge-postgres-neon: database became available" \
                "database=$database" "host=$host" "attempt=$attempt"
            return 0
        fi

        (( attempt == 1 )) && log INFO \
            "pm-db-bridge-postgres-neon: waiting for database visibility" \
            "database=$database" "host=$host" \
            "max_attempts=$DB_VISIBILITY_MAX_ATTEMPTS"

        sleep "$DB_VISIBILITY_RETRY_SECONDS"
        ((attempt += 1))
    done

    die "pm-db-bridge-postgres-neon: database did not become available: $database on $host" 2
}

pm-run-sql() {
    local sql="${1:?pm-run-sql: SQL statement required}"
    local legacy_format="${2:-}"

    (( $# <= 2 )) || die "pm-run-sql accepts SQL and an optional legacy format argument" 2
    pm_db_postgres_run_sql "$sql" "$legacy_format"
}

db_rt() {
    local host="${PM_DB_RT_HOST:-${DB_ADMIN_HOST:-${NEON_DIRECT_HOST:-${DB_HOST:-}}}}"
    local port="${PM_DB_RT_PORT:-${DB_ADMIN_PORT:-${DB_PORT:-5432}}}"
    local user="${PM_DB_RT_USER:-${DB_USER:-}}"
    local password="${PM_DB_RT_PASSWORD:-${DB_PASSWORD:-}}"
    local database="${PM_DB_RT_DATABASE:-${DB_NAME:-}}"

    [[ -n "$host" ]] || die "db_rt: database host is required" 2
    [[ -n "$port" ]] || die "db_rt: database port is required" 2
    [[ -n "$user" ]] || die "db_rt: database user is required" 2
    [[ -n "$password" ]] || die "db_rt: database password is required" 2
    [[ -n "$database" ]] || die "db_rt: database name is required" 2

    case "$port" in
        ''|*[!0-9]*) die "db_rt: database port must be numeric: $port" 2 ;;
    esac

    log DEBUG "pm-db-bridge-postgres-neon: executing PostgreSQL command" \
        "host=$host" "port=$port" "database=$database" "user=$user" \
        "image=$POSTGRES_TOOL_IMAGE"

    if [[ "$database" != "${DB_ADMIN_DATABASE:-}" ]]; then
        pm_neon_wait_for_database "$host" "$port" "$database" "$user" "$password"
    fi

    PGPASSWORD="$password" PM_DB_SQL_SECRET="${PM_DB_SQL_SECRET:-}" \
    docker run --rm --interactive \
        --env "PGHOST=$host" \
        --env "PGPORT=$port" \
        --env "PGDATABASE=$database" \
        --env "PGUSER=$user" \
        --env PGPASSWORD \
        --env "PGSSLMODE=require" \
        --env "PGCONNECT_TIMEOUT=$DB_CONNECT_TIMEOUT_SECONDS" \
        --env PM_DB_SQL_SECRET \
        "$POSTGRES_TOOL_IMAGE" \
        psql --no-psqlrc --set ON_ERROR_STOP=1 "$@"
}

reset_connections() {
    local token_variable="${1:?token variable required}"
    [[ "$token_variable" == "DB_PASSWORD" ]] \
        || die "postgres-neon cannot reset connections for $token_variable" 2
    : "${DB_PROJECT_ID:?DB_PROJECT_ID required}"
    : "${NEON_ENDPOINT_ID:?NEON_ENDPOINT_ID required}"

    local response=""
    log WARN "restarting Neon endpoint to revoke existing database sessions" \
        "endpoint_id=$NEON_ENDPOINT_ID"
    neon_api_request response POST \
        "/projects/${DB_PROJECT_ID}/endpoints/${NEON_ENDPOINT_ID}/restart"
    neon_wait_for_operations "$response"
    log INFO "Neon database connections reset" "endpoint_id=$NEON_ENDPOINT_ID"
}

pm_db_bridge_provision() {
    [[ "${DB_PROVIDER_CODE:-}" == postgres && "${DB_PLATFORM_CODE:-}" == neon ]] \
        || die "pm-db-bridge-postgres-neon requires postgres-neon" 2
    log INFO "pm-db-bridge-postgres-neon: starting provision binding"
    pm_neon_prepare_connection_contract
    log INFO "pm-db-bridge-postgres-neon: provision binding complete"
}

pm_db_bridge_deploy() {
    [[ "${DB_PROVIDER_CODE:-}" == postgres && "${DB_PLATFORM_CODE:-}" == neon ]] \
        || die "pm-db-bridge-postgres-neon requires postgres-neon" 2
    log INFO "pm-db-bridge-postgres-neon: starting deploy binding"
    pm_neon_prepare_connection_contract
    PM_DB_RT_HOST="$NEON_DIRECT_HOST" \
    PM_DB_RT_PORT="$DB_PORT" \
    PM_DB_RT_USER="$DB_USER" \
    PM_DB_RT_PASSWORD="$DB_PASSWORD" \
    PM_DB_RT_DATABASE="$DB_NAME" \
        db_rt --command 'SELECT 1' >/dev/null
    log INFO "pm-db-bridge-postgres-neon: deploy binding complete"
}
