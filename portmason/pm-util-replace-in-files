#!/usr/bin/env bash

set -euo pipefail

SEARCH_TERM="${1:-}"
REPLACEMENT="${2:-}"

if [[ -z "$SEARCH_TERM" || -z "$REPLACEMENT" ]]; then
    echo "Usage:"
    echo "  $(basename "$0") <search-term> <replacement>"
    echo
    echo "Example:"
    echo "  $(basename "$0") telemetry observability"
    exit 1
fi

exec 3</dev/tty

MATCH_FILE="$(mktemp)"

find . -type f \
    ! -path "*/.git/*" \
    ! -path "*/node_modules/*" \
    ! -path "*/.venv/*" \
    ! -path "*/venv/*" \
    ! -path "*/dist/*" \
    ! -path "*/build/*" \
    -exec grep -nHI -- "$SEARCH_TERM" {} + > "$MATCH_FILE"

if [[ ! -s "$MATCH_FILE" ]]; then
    echo "No matches found."
    rm -f "$MATCH_FILE"
    exit 0
fi

echo
echo "Search     : $SEARCH_TERM"
echo "Replacement: $REPLACEMENT"
echo "Matches    : $(wc -l < "$MATCH_FILE")"
echo

while IFS=: read -r file line rest; do

    [[ -f "$file" ]] || continue

    echo
    echo "================================================================="
    echo "FILE : $file"
    echo "LINE : $line"
    echo "================================================================="

    start=$(( line > 1 ? line - 1 : 1 ))
    end=$(( line + 1 ))

    nl -ba "$file" | sed -n "${start},${end}p"

    echo

    while true; do
        printf "[y] replace  [n] skip  [q] quit: "
        read -u 3 -r response

        case "$response" in

            y|Y)

                python3 - "$file" "$line" "$SEARCH_TERM" "$REPLACEMENT" <<'PY'
import sys

filename = sys.argv[1]
line_no = int(sys.argv[2])
search = sys.argv[3]
replacement = sys.argv[4]

with open(filename, "r", encoding="utf-8") as f:
    lines = f.readlines()

idx = line_no - 1

if idx < len(lines):
    lines[idx] = lines[idx].replace(search, replacement)

with open(filename, "w", encoding="utf-8") as f:
    f.writelines(lines)

print("UPDATED")
PY

                echo
                echo "Updated line:"
                sed -n "${line}p" "$file"

                break
                ;;

            n|N)
                echo "SKIPPED"
                break
                ;;

            q|Q)
                rm -f "$MATCH_FILE"
                exit 0
                ;;

            *)
                echo "Please enter y, n, or q."
                ;;
        esac
    done

done < "$MATCH_FILE"

rm -f "$MATCH_FILE"

echo
echo "Done."
