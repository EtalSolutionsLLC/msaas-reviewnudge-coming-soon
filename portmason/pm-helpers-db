pm_compose_control_file() {
    local out_var="${1:?output variable required}"
    local value="${PM_COMPOSE_CONTROL_FILE:-${PM_COMPOSE_FILE:-${PROJECT_ROOT:?PROJECT_ROOT required}/docker-compose.yml}}"
    [[ "$value" == /* ]] || value="${PROJECT_ROOT}/${value#./}"
    printf -v "$out_var" '%s' "$value"
}

pm_compose_project_directory() {
    local out_var="${1:?output variable required}"
    local default_directory="${PROJECT_ROOT:?PROJECT_ROOT required}"
    [[ -z "${ENV_FILE:-}" ]] || default_directory="$(dirname -- "$ENV_FILE")"
    local value="${PM_COMPOSE_PROJECT_DIRECTORY:-$default_directory}"
    [[ "$value" == /* ]] || value="${PROJECT_ROOT}/${value#./}"
    printf -v "$out_var" '%s' "$value"
}

pm_compose_override_file() {
    local out_var="${1:?output variable required}"
    local value="${PM_COMPOSE_OVERRIDE_FILE:-${PROJECT_ROOT:?PROJECT_ROOT required}/docker-compose.override.yml}"
    [[ "$value" == /* ]] || value="${PROJECT_ROOT}/${value#./}"
    printf -v "$out_var" '%s' "$value"
}

