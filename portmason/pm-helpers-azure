#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_adapter_requires_compose() {
    return 0
}

declare -ga PM_AZURE_CLI_CMD=()
declare -g PM_AZURE_CLI_CMD_READY=0
declare -g PM_AZURE_CLI_USING_WINDOWS=0

pm_azure_bool_enabled() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

pm_azure_windows_cli_path() {
    local out_var="${1:?output variable required}"
    local candidate
    for candidate in \
        "/mnt/c/Program Files/Microsoft SDKs/Azure/CLI2/wbin/az.cmd" \
        "/mnt/c/Program Files (x86)/Microsoft SDKs/Azure/CLI2/wbin/az.cmd"
    do
        if [[ -f "$candidate" ]]; then
            printf -v "$out_var" '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

pm_azure_set_windows_cli_cmd() {
    local path="${1:?Windows Azure CLI path required}"
    local windows_path="$path"
    if command -v wslpath >/dev/null 2>&1; then
        windows_path="$(wslpath -w "$path")"
    fi
    have cmd.exe || die "Windows Azure CLI requires cmd.exe to be available from WSL" 2
    PM_AZURE_CLI_CMD=(cmd.exe /C "$windows_path")
    PM_AZURE_CLI_USING_WINDOWS=1
    export PM_AZURE_CLI_USING_WINDOWS
}

pm_azure_cli_init() {
    (( PM_AZURE_CLI_CMD_READY == 1 )) && return 0

    local windows_cli=""
    if [[ -n "${AZURE_CLI_PATH:-}" ]]; then
        [[ -x "$AZURE_CLI_PATH" || -f "$AZURE_CLI_PATH" ]] \
            || die "Configured AZURE_CLI_PATH is not available: $AZURE_CLI_PATH" 2
        PM_AZURE_CLI_CMD=("$AZURE_CLI_PATH")
    elif pm_azure_bool_enabled "${PM_AZURE_CLI_USE_WINDOWS:-${AZURE_CLI_USE_WINDOWS:-}}"; then
        pm_azure_windows_cli_path windows_cli \
            || die "Windows Azure CLI requested, but az.cmd was not found" 2
        pm_azure_set_windows_cli_cmd "$windows_cli"
    elif have az; then
        PM_AZURE_CLI_CMD=(az)
        PM_AZURE_CLI_USING_WINDOWS=0
    elif pm_azure_windows_cli_path windows_cli; then
        pm_azure_set_windows_cli_cmd "$windows_cli"
    else
        die "Missing required command: az" 2
    fi

    PM_AZURE_CLI_CMD_READY=1
    export PM_AZURE_CLI_CMD_READY
}

pm_azure_cli() {
    pm_azure_cli_init
    if (( PM_AZURE_CLI_USING_WINDOWS == 1 )); then
        (
            cd "${PM_AZURE_WINDOWS_WORKDIR:-/mnt/c}" \
                || die "Windows Azure CLI work directory is unavailable: ${PM_AZURE_WINDOWS_WORKDIR:-/mnt/c}" 2
            "${PM_AZURE_CLI_CMD[@]}" "$@"
        )
    else
        "${PM_AZURE_CLI_CMD[@]}" "$@"
    fi
}

pm_azure_cli_require_account() {
    local output rc=0 windows_cli=""
    pm_azure_cli_init
    output="$(pm_azure_cli account show --only-show-errors 2>&1)" || rc=$?
    if (( rc == 0 )); then
        return 0
    fi

    if (( PM_AZURE_CLI_USING_WINDOWS == 0 )) \
        && pm_azure_windows_cli_path windows_cli; then
        log WARN "native Azure CLI is unavailable or blocked; trying Windows Azure CLI" \
            "windows_cli=$windows_cli"
        pm_azure_set_windows_cli_cmd "$windows_cli"
        output="$(pm_azure_cli account show --only-show-errors 2>&1)" || rc=$?
        if (( rc == 0 )); then
            return 0
        fi
    fi

    printf '%s\n' "$output" >&2
    die "Azure CLI is not logged in or has no active subscription" 2
}

