sync_runtime_secrets() {
    pm_azure_defaults
#    pm_azure_ensure_config_manager

    local service role image has_build source target value seen_key
    declare -A seen=()
    while IFS=$'\t' read -r service role image has_build; do
        [[ -n "$service" ]] || continue
        while IFS= read -r -d '' source; do
            IFS= read -r -d '' target || target="$source"
            IFS= read -r -d '' value || value=""
            seen_key="$source"
            [[ -z "${seen[$seen_key]+x}" ]] || continue
            seen["$seen_key"]=1
            pm_azure_sync_secret_value "$source" "$value"
        done < <(pm_config_secret_binding_nul_for_service "$service" "$role")
    done < <(pm_compose_deployable_services_tsv)
}

pm_azure_service_env_json() {
    local service="${1:?service required}"
    local role="${2:?role required}"
    local key value source target container_secret queue_name queue_delivery
    local tmp
    tmp="$(mktemp)"
#    pm_azure_ensure_config_manager

    while IFS= read -r -d '' key; do
        IFS= read -r -d '' value || value=""
        jq -cn --arg name "$key" --arg value "$value" '{name:$name,value:$value}' >> "$tmp"
    done < <(pm_config_var_kv_nul_for_service "$service" "$role")

    while IFS= read -r -d '' source; do
        IFS= read -r -d '' target || target="$source"
        IFS= read -r -d '' value || value=""
        pm_azure_container_secret_name_for_key container_secret "$target"
        jq -cn --arg name "$target" --arg secretRef "$container_secret" \
            '{name:$name,secretRef:$secretRef}' >> "$tmp"
    done < <(pm_config_secret_binding_nul_for_service "$service" "$role")

    queue_name="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .queue_consume // .queue_publish // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    if [[ -n "$queue_name" ]]; then
        jq -cn --arg name PM_QUEUE_PROVIDER --arg value service-bus '{name:$name,value:$value}' >> "$tmp"
        jq -cn --arg name PM_QUEUE_NAMESPACE --arg value "${AZURE_SERVICE_BUS_NAMESPACE:-}" '{name:$name,value:$value}' >> "$tmp"
        jq -cn --arg name PM_QUEUE_NAME --arg value "$queue_name" '{name:$name,value:$value}' >> "$tmp"
        jq -cn --arg name PM_IDENTITY_CLIENT_ID --arg value "${AZURE_IDENTITY_CLIENT_ID:-}" '{name:$name,value:$value}' >> "$tmp"
        queue_delivery="$(jq -r --arg queue "$queue_name" \
            '.[] | select(.service == $queue) | .queue_delivery // empty' \
            <<<"${PROJECT_SERVICES:-[]}")"
        if [[ ",$queue_delivery," == *,scheduled,* ]]; then
            jq -cn --arg name PM_SCHEDULED_WORK_PROVIDER --arg value service-bus '{name:$name,value:$value}' >> "$tmp"
            jq -cn --arg name PM_SCHEDULED_WORK_NAMESPACE --arg value "${AZURE_SERVICE_BUS_NAMESPACE:-}" '{name:$name,value:$value}' >> "$tmp"
            jq -cn --arg name PM_SCHEDULED_WORK_QUEUE --arg value "$queue_name" '{name:$name,value:$value}' >> "$tmp"
        fi
    fi
    jq -s '.' "$tmp"
    rm -f -- "$tmp"
}

pm_azure_service_secrets_json() {
    local service="${1:?service required}"
    local role="${2:?role required}"
    local source target value container_secret uri
    local tmp
    tmp="$(mktemp)"
#    pm_azure_ensure_config_manager

    while IFS= read -r -d '' source; do
        IFS= read -r -d '' target || target="$source"
        IFS= read -r -d '' value || value=""
        pm_azure_container_secret_name_for_key container_secret "$target"
        pm_azure_secret_uri_for_key uri "$source"
        jq -cn --arg name "$container_secret" --arg keyVaultUrl "$uri" \
            '{name:$name,keyVaultUrl:$keyVaultUrl}' >> "$tmp"
    done < <(pm_config_secret_binding_nul_for_service "$service" "$role")
    jq -s '.' "$tmp"
    rm -f -- "$tmp"
}

pm_azure_service_command_json() {
    local service="${1:?service required}"
    jq -c --arg service "$service" '
        .[] | select(.service == $service) |
        if (.run_command // "") != "" then [.run_command]
        elif (.entrypoint | type) == "array" then .entrypoint
        elif (.entrypoint | type) == "string" and .entrypoint != "" then [.entrypoint]
        else [] end
    ' <<<"${PROJECT_SERVICES:-[]}"
}

pm_azure_service_args_json() {
    local service="${1:?service required}"
    jq -c --arg service "$service" '
        .[] | select(.service == $service) |
        if (.run_args // "") != "" then [ .run_args ]
        elif (.command | type) == "array" then .command
        elif (.command | type) == "string" and .command != "" then [ .command ]
        else [] end
    ' <<<"${PROJECT_SERVICES:-[]}"
}

pm_azure_acr_login_server() {
    local out_var="${1:?output variable required}"
    local value="${AZURE_ACR_LOGIN_SERVER:-}"
    if [[ -z "$value" ]]; then
        value="$(pm_azure_cli acr show \
            --resource-group "${AZURE_RESOURCE_GROUP:?AZURE_RESOURCE_GROUP required}" \
            --name "${AZURE_ACR_NAME:?AZURE_ACR_NAME required}" \
            --query loginServer -o tsv --only-show-errors)"
    fi
    [[ -n "$value" ]] || die "Unable to resolve Azure Container Registry login server" 2
    env_init_set AZURE_ACR_LOGIN_SERVER "$value"
    printf -v "$out_var" '%s' "$value"
}
