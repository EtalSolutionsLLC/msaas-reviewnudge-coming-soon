#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"
. "${PORTMASON_SHARE}/pm-helpers-observability" "$@"


pm_notification_grafana_request() {
  local method="${1:?method required}"
  local path="${2:?path required}"
  local data_file="${3:-}"
  local response_file http_code rc response
  local attempt max_attempts sleep_seconds
  local -a args=(--silent --show-error --request "$method" --header 'Content-Type: application/json')

  [[ -z "$data_file" ]] || args+=(--data-binary "@$data_file")

  max_attempts=30
  sleep_seconds=10

  for ((attempt=1; attempt<=max_attempts; attempt++)); do
    response_file="$(mktemp)"

    set +e
    http_code="$(
      printf 'header = "Authorization: Bearer %s"\n' "$OBSERVABILITY_DASHBOARD_API_TOKEN" \
        | curl "${args[@]}" --config - --output "$response_file" --write-out '%{http_code}' \
            "${OBSERVABILITY_DASHBOARD_URL%/}${path}"
    )"
    rc=$?
    set -e

    if (( rc == 0 )) && [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      cat "$response_file"
      rm -f -- "$response_file"
      return 0
    fi

    response="$(tr '\r\n' '  ' < "$response_file" | cut -c1-1000)"

    if [[ "$http_code" == "503" ]] && grep -q '"code":"Loading"' <<<"$response"; then
      log WARN \
        "Grafana instance still loading" \
        "attempt=${attempt}/${max_attempts}" \
        "path=$path"

      rm -f -- "$response_file"

      if (( attempt < max_attempts )); then
        sleep "$sleep_seconds"
        continue
      fi
    fi

    log ERROR "Grafana API request failed" \
      "method=$method" \
      "path=$path" \
      "http_status=${http_code:-000}" \
      "response=$response"

    rm -f -- "$response_file"\

    (( rc != 0 )) && return "$rc"
    return 22
  done

  log ERROR "Grafana did not become ready" "path=$path"
  return 22
}

pm_setup_hosted_grafana_notification() {
  local alert_dir="${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR}}/observability/grafana/alerting"
  local rules_file="${alert_dir}/rules.json"
  local notifications_file="${alert_dir}/notifications.json"
  local folder_uid="${OBSERVABILITY_ALERT_FOLDER_UID:-reviewnudge-alerts}"
  local folder_title group_name contact_uid loki_uid prometheus_uid
  local tmp_dir folder_payload contact_payload policy_payload rules_payload datasources

  : "${OBSERVABILITY_DASHBOARD_URL:?OBSERVABILITY_DASHBOARD_URL required}"
  : "${OBSERVABILITY_DASHBOARD_API_TOKEN:?OBSERVABILITY_DASHBOARD_API_TOKEN required}"
#  observability_hydrate_secret OBSERVABILITY_DASHBOARD_API_TOKEN
#  observability_hydrate_secret MONITORING_FAILURE_EVENT_HTTP_BEARER_TOKEN
  [[ "${OBSERVABILITY_NOTIFICATION_PROVIDER:-}" == resend ]] \
    || die "Hosted ReviewNudge notifications require OBSERVABILITY_NOTIFICATION_PROVIDER=resend" 2
  observability_validate_email "${OBSERVABILITY_NOTIFICATION_DELIVERY_ADDRESS:?Notification address required}"
  : "${APP_BASE_URL:?APP_BASE_URL required}"
  : "${MONITORING_FAILURE_EVENT_HTTP_BEARER_TOKEN:?Monitoring bearer token required for hosted notifications}"
  [[ -r "$rules_file" ]] || die "Project Grafana alert rules are missing" 2
  [[ -r "$notifications_file" ]] || die "Project Grafana notification definitions are missing" 2

  folder_title="$(jq -er '.groups[0].folder | select(type == "string" and length > 0)' "$rules_file")" \
    || die "Grafana alert folder is missing" 2
  group_name="$(jq -er '.groups[0].name | select(type == "string" and length > 0)' "$rules_file")" \
    || die "Grafana alert rule group is missing" 2
  contact_uid="$(jq -er '.contactPoints[0].receivers[0].uid | select(type == "string" and length > 0)' "$notifications_file")" \
    || die "Grafana notification contact UID is missing" 2

  tmp_dir="$(mktemp -d)"
  folder_payload="${tmp_dir}/folder.json"
  contact_payload="${tmp_dir}/contact.json"
  policy_payload="${tmp_dir}/policy.json"
  rules_payload="${tmp_dir}/rules.json"
  datasources="${tmp_dir}/datasources.json"

  jq -n --arg uid "$folder_uid" --arg title "$folder_title" '{uid: $uid, title: $title}' > "$folder_payload"
  if ! pm_notification_grafana_request GET "/api/folders/${folder_uid}" >/dev/null 2>&1; then
    pm_notification_grafana_request POST '/api/folders' "$folder_payload" >/dev/null
    log INFO "Grafana alert folder created" "uid=$folder_uid"
  fi

  pm_notification_grafana_request GET '/api/datasources' > "$datasources"
  loki_uid="$(jq -er '[.[] | select(.type == "loki") | select((.name + " " + (.url // "")) | test("usage|alert-state"; "i") | not)] | (map(select((.url // "") | test("logs-prod"; "i")))[0] // .[0]).uid' "$datasources")" \
    || die "Grafana Cloud Loki data source was not found" 2
  prometheus_uid="$(jq -er '[.[] | select(.type == "prometheus") | select((.name + " " + (.url // "")) | test("usage|billing"; "i") | not)] | (map(select(.isDefault == true))[0] // .[0]).uid' "$datasources")" \
    || die "Grafana Cloud Prometheus data source was not found" 2

  jq --arg url "${APP_BASE_URL%/}/api/observability/notifications" \
    --arg credential "$MONITORING_FAILURE_EVENT_HTTP_BEARER_TOKEN" '
    .contactPoints[0] as $contact |
    $contact.receivers[0] + {
      name: $contact.name,
      type: "webhook",
      settings: {
        url: $url,
        httpMethod: "POST",
        authorization_scheme: "Bearer",
        authorization_credentials: $credential,
        maxAlerts: "20"
      }
    }
  ' "$notifications_file" > "$contact_payload"
  if pm_notification_grafana_request GET '/api/v1/provisioning/contact-points' \
      | jq -e --arg uid "$contact_uid" 'any(.[]; .uid == $uid)' >/dev/null; then
    pm_notification_grafana_request PUT "/api/v1/provisioning/contact-points/${contact_uid}" "$contact_payload" >/dev/null
  else
    pm_notification_grafana_request POST '/api/v1/provisioning/contact-points' "$contact_payload" >/dev/null
  fi
  pm_notification_grafana_request GET '/api/v1/provisioning/contact-points' \
    | jq -e --arg uid "$contact_uid" 'any(.[]; .uid == $uid)' >/dev/null \
    || die "Grafana notification contact point verification failed" 2
  log INFO "Grafana notification contact point deployed and verified" "uid=$contact_uid"

  jq '.policies[0] | del(.orgId)' "$notifications_file" > "$policy_payload"
  pm_notification_grafana_request PUT '/api/v1/provisioning/policies' "$policy_payload" >/dev/null
  pm_notification_grafana_request GET '/api/v1/provisioning/policies' \
    | jq -e --arg receiver "$(jq -r '.receiver' "$policy_payload")" '.receiver == $receiver' >/dev/null \
    || die "Grafana notification policy verification failed" 2
  log INFO "Grafana notification policy deployed and verified"

  jq --arg folder_uid "$folder_uid" --arg loki_uid "$loki_uid" --arg prometheus_uid "$prometheus_uid" \
    --arg stack "${STACK:?STACK required}" --arg deploy_env "${DEPLOY_ENV:?DEPLOY_ENV required}" '
    def interval_seconds:
      capture("^(?<count>[0-9]+)(?<unit>[smh])$") |
      (.count | tonumber) * (if .unit == "s" then 1 elif .unit == "m" then 60 else 3600 end);
    walk(
      if type == "string" then
        gsub("\\$\\{STACK\\}"; $stack) |
        gsub("\\$\\{DEPLOY_ENV\\}"; $deploy_env)
      else . end
    ) |
    .groups[0] as $group |
    {
      folderUid: $folder_uid,
      interval: ($group.interval | interval_seconds),
      title: $group.name,
      rules: [
        $group.rules[] |
        . + {folderUID: $folder_uid, ruleGroup: $group.name, orgID: ($group.orgId // 1)} |
        .data |= map(
          if .datasourceUid == "loki" then .datasourceUid = $loki_uid
          elif .datasourceUid == "prometheus" then .datasourceUid = $prometheus_uid
          else . end
        )
      ]
    }
  ' "$rules_file" > "$rules_payload"
  pm_notification_grafana_request PUT \
    "/api/v1/provisioning/folder/${folder_uid}/rule-groups/$(jq -rn --arg value "$group_name" '$value|@uri')" \
    "$rules_payload" >/dev/null
  pm_notification_grafana_request GET '/api/v1/provisioning/alert-rules' \
    | jq -e --argjson expected "$(jq '[.groups[0].rules[].uid]' "$rules_file")" \
        '([.[].uid] as $actual | all($expected[]; . as $uid | $actual | index($uid)))' >/dev/null \
    || die "Grafana alert rule verification failed" 2

  log INFO "Grafana Cloud alerting provisioned" \
    "rules=$(jq '.groups[0].rules | length' "$rules_file")" "notifications=true"
  rm -rf -- "$tmp_dir"
}

pm_setup_notification() {
  local enabled="${OBSERVABILITY_NOTIFICATION_ENABLED:-false}"
  [[ "${PM_OBSERVABILITY_NOTIFICATION_PREVIEW:-0}" != 1 ]] || enabled=false
  export OBSERVABILITY_NOTIFICATION_ENABLED="$enabled"

  if [[ "${OBSERVABILITY_STORE_PLATFORM_CODE:-}" != local ]]; then
    if observability_is_true "$enabled"; then
      [[ "${OBSERVABILITY_DASHBOARD_PROVIDER:-}" == grafana ]] \
        || die "Hosted notifications require the Grafana dashboard provider" 2
      pm_setup_hosted_grafana_notification
    else
      log INFO "Hosted notifications disabled"
    fi
    return 0
  fi

  if [[ ! -r "${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR}}/observability/grafana/alerting/rules.json" ]]; then
    if observability_is_true "$enabled"; then
      die "Project Grafana alert rules are missing" 2
    fi
    log INFO "Notifications disabled; no project alert definitions"
    return 0
  fi
  if observability_is_true "$enabled"; then
    [[ "${OBSERVABILITY_DASHBOARD_ENABLED:-false}" == true ]] || die "Notifications require the Grafana dashboard" 2
    observability_validate_email "${OBSERVABILITY_NOTIFICATION_DELIVERY_ADDRESS:?Notification address required}"
    if [[ -n "${SMTP_HOST:-}" ]]; then
#      observability_hydrate_secret SMTP_PASS
      export GF_SMTP_HOST="${SMTP_HOST}:${SMTP_PORT:-587}" GF_SMTP_USER="${SMTP_USER:-}" GF_SMTP_PASSWORD="${SMTP_PASS:-}"
    elif [[ "${BULKEMAILER_PROVIDER:-}" == resend ]]; then
#      observability_hydrate_secret BULKEMAILER_API_KEY
      export GF_SMTP_HOST=smtp.resend.com:587 GF_SMTP_USER=resend GF_SMTP_PASSWORD="${BULKEMAILER_API_KEY:?Resend API key required}"
    else
      die "Notifications require SMTP_HOST or the existing Resend mail provider" 2
    fi
    GF_SMTP_FROM_ADDRESS="$(python3 -c 'import os,email.utils; print(email.utils.parseaddr(os.environ.get("OBSERVABILITY_NOTIFICATION_SENDER_ADDRESS") or os.environ.get("BULKEMAILER_FROM", ""))[1])')"
    observability_validate_email "$GF_SMTP_FROM_ADDRESS"
    GF_SMTP_FROM_NAME="${APP_NAME:-${APP_SLUG:-${STACK}}} operations"
    export GF_SMTP_FROM_ADDRESS GF_SMTP_FROM_NAME GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
  fi
  python3 "${PORTMASON_SHARE}/observability/grafana/render-alerting.py"
  pm_observability_local_compose up -d --no-deps --force-recreate --wait dashboard
  log INFO "Grafana alerting provisioned" "notifications=$enabled"
}

pm_setup_notification "$@"
