#!/usr/bin/env bash
set -euo pipefail

# Source-safe GitHub Actions secret provider. GitHub does not expose stored
# secret values through its API, so the workflow must inject the named secret
# into the process environment before this provider resolves github:NAME.

get_github_secret() {
    local secret_name="${1:?GitHub Actions secret name required}"
    local secret_value=""

    [[ "$secret_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        die "Invalid GitHub Actions secret environment name: ${secret_name}" 2
        return 2
    }
    [[ "${GITHUB_ACTIONS:-false}" == "true" ]] || {
        die "github:${secret_name} may be resolved only inside GitHub Actions" 2
        return 2
    }

    secret_value="$(printenv "$secret_name" 2>/dev/null)" || {
        die "GitHub Actions secret ${secret_name} was not injected into the environment" 2
        return 2
    }
    [[ -n "$secret_value" ]] || {
        die "GitHub Actions secret ${secret_name} is empty" 2
        return 2
    }

    printf '%s' "$secret_value"
}

get_github_secret_name_from_path() {
    local secret_name="${1:?GitHub Actions secret name required}"
    printf '%s' "$secret_name"
}
