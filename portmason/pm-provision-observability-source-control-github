#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

: "${OBSERVABILITY_SOURCE_CONTROL_REPOSITORY:?OBSERVABILITY_SOURCE_CONTROL_REPOSITORY required}"
: "${OBSERVABILITY_SOURCE_CONTROL_TOKEN:?OBSERVABILITY_SOURCE_CONTROL_TOKEN required}"
: "${OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_SECRET:?OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_SECRET required}"
: "${OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_URL:?OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_URL required}"
log INFO "GitHub source-control observability provisioning contract ready" \
    "repository=${OBSERVABILITY_SOURCE_CONTROL_REPOSITORY}" \
    "webhook=${OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_URL}"
