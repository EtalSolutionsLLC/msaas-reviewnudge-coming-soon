#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

main() {
    : "${OBSERVABILITY_DB_NAME:?OBSERVABILITY_DB_NAME required}"
    : "${OBSERVABILITY_DB_USER:?OBSERVABILITY_DB_USER required}"
    : "${OBSERVABILITY_DB_PASSWORD:?OBSERVABILITY_DB_PASSWORD required}"

    pm_compose_load_model

    local service
    service=observability

    env_init_set OBSERVABILITY_DB_HOST "${OBSERVABILITY_DB_HOST:-$service}"
    env_init_set OBSERVABILITY_DB_PORT "${OBSERVABILITY_DB_PORT:-5432}"

    local url
    pm_db_postgres_build_url \
        url \
        "$OBSERVABILITY_DB_HOST" \
        "$OBSERVABILITY_DB_PORT" \
        "$OBSERVABILITY_DB_NAME" \
        "$OBSERVABILITY_DB_USER" \
        "$OBSERVABILITY_DB_PASSWORD" \
        "${OBSERVABILITY_DB_SSL_MODE:-disable}"

    env_init_set OBSERVABILITY_DB_URL "$url"

    log INFO "pm-provision-observability-db-local: starting database service" \
        "service=$service"

    "${PM_COMPOSE_CMD[@]}" up -d "$service"

    local attempt
    local max_attempts="${PM_DB_READY_ATTEMPTS:-30}"
    local wait_seconds="${PM_DB_READY_INTERVAL_SECONDS:-1}"

    for ((attempt = 1; attempt <= max_attempts; attempt++)); do
        if "${PM_COMPOSE_CMD[@]}" exec -T "$service" \
            pg_isready \
                --host localhost \
                --port "$OBSERVABILITY_DB_PORT" \
                --username "$OBSERVABILITY_DB_USER" \
                >/dev/null 2>&1; then
            log INFO "pm-provision-observability-db-local: database service ready" \
                "service=$service" \
                "attempt=$attempt"
            break
        fi

        if (( attempt == max_attempts )); then
            log ERROR "pm-provision-observability-db-local: database service readiness failed" \
                "service=$service" \
                "attempts=$max_attempts"

            "${PM_COMPOSE_CMD[@]}" ps "$service" >&2 || true
            "${PM_COMPOSE_CMD[@]}" logs --tail 100 "$service" >&2 || true

            die "pm-provision-observability-db-local: database service did not become ready: $service" 2
        fi

        sleep "$wait_seconds"
    done

    log INFO "pm-provision-observability-db-local: database platform ready" \
        "service=$service" \
        "host=$OBSERVABILITY_DB_HOST" \
        "port=$OBSERVABILITY_DB_PORT"
}

main "$@"
