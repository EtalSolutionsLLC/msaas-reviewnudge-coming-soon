#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

[[ "${TELEMETRY_STORE_PROVIDER_CODE:-}" == grafana_cloud ]] \
    || die "grafana_cloud store dependency requires TELEMETRY_STORE_PROVIDER_PLATFORM_CODE=grafana_cloud-<platform>" 2
: "${TELEMETRY_STORE_NAME:?TELEMETRY_STORE_NAME required}"
if [[ "${TELEMETRY_STORE_PLATFORM_CODE:-}" == local ]]; then
    [[ "${TELEMETRY_STORE_INTERNAL_URL:-}" =~ ^https?://[^[:space:]]+$ ]] \
        || die "Local telemetry store requires a valid internal URL" 2
else
    : "${TELEMETRY_STORE_INTERNAL_URL:?Grafana Cloud OTLP endpoint required}"
    : "${TELEMETRY_OTLP_INSTANCE_ID:?Grafana Cloud OTLP instance ID required}"
    : "${TELEMETRY_OTLP_AUTH_TOKEN:?Grafana Cloud OTLP authentication token required}"
fi
log INFO "Grafana Cloud store contract ready" \
    "platform=${TELEMETRY_STORE_PLATFORM_CODE}" "store=${TELEMETRY_STORE_NAME}"
