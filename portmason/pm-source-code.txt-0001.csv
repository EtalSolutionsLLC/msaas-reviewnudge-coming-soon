[[ "$first_count" -ge 3 ]]
[[ "$first_count" == "$second_count" ]]
[[ -f "$MOCK_GCP_ROOT/$DEPLOYMENT_ID/reviewnudge-prd-db-password.value" ]]
! grep -Fq 'super-secret-value-062' "$TEST_LOG"

