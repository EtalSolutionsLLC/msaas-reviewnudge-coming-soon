ensure_env_file() {
    # DEPLOY_ENV is required for all runs.
    # It may come from runtime-injected env vars (e.g., container) OR from ENV_FILE (if provided+exists).
    # ENV_FILE is optional and is only sourced when it exists. Missing/empty ENV_FILE is OK if DEPLOY_ENV is already set.
    [[ "${IN_CONTAINER}" == true ]] && return 0
    [[ "${__ENVFILE_LOADED:-}" == true ]] && return 0

	echo "Entered ensure_env_file" >&2

    local injected_deploy_env_is_set=false
    local injected_deploy_env=""
    if [[ -v DEPLOY_ENV ]]; then
        injected_deploy_env_is_set=true
        injected_deploy_env="${DEPLOY_ENV}"
    fi

    local env_path="${ENV_FILE:-}"
    local env_example=".env.example"
	local requiresDecryption=true

    # If no .env exists, but .env.example does exist, copy it to .env
    if [[ ! -f ".env" && -f "$env_example" ]]; then
        cp "$env_example" ".env"
        echo "ensure_env_file: copied $env_example -> .env" >&2
		requiresDecryption=false
    fi

    # If no .env exists, and no .env.example exist, copy .env.example from $PORTMASON_SHARE/templates--copy it.
    if [[ ! -f ".env" && -f "$ENV_EXAMPLE_SRC" ]]; then
        cp "$ENV_EXAMPLE_SRC" ".env"
        echo "ensure_env_file: copied $ENV_EXAMPLE_SRC -> .env" >&2
		requiresDecryption=false
    fi

    # If env_path exists, allow it to define/override DEPLOY_ENV.
	if [[ "$requiresDecryption" == true ]]; then
		local pm_env_plaintext
		pm_decrypt_file "$env_path" pm_env_plaintext \
			|| die "unable to decrypt environment file"
		set -a
		echo "evaluating the decrypted file '$env_path'"
		eval "$pm_env_plaintext" || {
			set +a
			unset pm_env_plaintext
			die "unable to load decrypted environment"
		}
		set +a
		unset pm_env_plaintext
	else
		set -a
		source "$env_path" || {
			set +a
			die "unable to source environment file '${env_path}'"
		}
		set +a
	fi

	echo "sourced ENV_FILE='$env_path'" >&2

    # If env file did not set DEPLOY_ENV, fall back to injected value, even when
    # that value is intentionally empty. Undefined DEPLOY_ENV is an error; empty
    # DEPLOY_ENV is allowed and means production.
    if [[ ! -v DEPLOY_ENV && "$injected_deploy_env_is_set" == true ]]; then
        DEPLOY_ENV="$injected_deploy_env"
        export DEPLOY_ENV
    fi

    if [[ ! -v DEPLOY_ENV ]]; then
        die "ensure_env_file: DEPLOY_ENV is required (set it in ENV_FILE or inject it in the runtime). Use empty DEPLOY_ENV or 'prd' for production."
    fi

    local runtime_adapter_effective="${RUNTIME_ADAPTER_CODE:--}"
    : "${RUNTIME_CODE:=${runtime_adapter_effective%%-*}}"
    : "${ADAPTER_CODE:=${runtime_adapter_effective#*-}}"

    env_init_set ADAPTER_CODE         "${ADAPTER_CODE:-}"
    env_init_set RUNTIME_CODE         "${RUNTIME_CODE:-}"

    local db_platform_provider_effective="${DB_PROVIDER_PLATFORM_CODE:--}"
    : "${DB_PROVIDER_CODE:=${db_platform_provider_effective%%-*}}"
    : "${DB_PLATFORM_CODE:=${db_platform_provider_effective#*-}}"

    env_init_set DB_PROVIDER_CODE         "${DB_PROVIDER_CODE:-}"
    env_init_set DB_PLATFORM_CODE         "${DB_PLATFORM_CODE:-}"

    export __ENVFILE_LOADED=true

    echo "ensure_env_file: DEPLOY_ENV='$DEPLOY_ENV'" >&2

    local renderer="${PORTMASON_SHARE:?PORTMASON_SHARE required}/pm-util-render-env"
    local generated_env="${ENV_FILE:?ENV_FILE required}.generated"
    local generated_json="${SITE_DIR:?SITE_DIR required}/config.generated.json"

    python3 "${PORTMASON_SHARE}/pm-secret.py" write-resolved-env \
        "$generated_env" "$generated_json" \
        || die "unable to serialize resolved environment" 2
}

ensure_jq(){
    if have jq; then
        log "jq already installed: $(jq --version)"
        return 0;
    fi

    log "jq not found. Installing..."

    if [[ "$OSTYPE" == "darwin"* ]]; then
        if ! have brew; then
            fatal_error "Error: Homebrew is required on macOS but not found."
        fi
        brew install jq
    elif have apt-get; then
        as_root apt-get update -y
        as_root apt-get install -y jq
    elif have dnf; then
        as_root dnf install -y jq
    elif have yum; then
        as_root yum install -y jq
    elif have apk; then
        # Alpine Linux
        as_root apk add --no-cache jq
    else
        fatal_error "Error: Unsupported OS. Please install jq manually."
    fi

    echo "jq installed successfully: $(jq --version)" >&2
}

ensure_path() {
    local path="${1:-}"
    local silent=0
    [[ "${2:-}" == "-s" ]] && silent=1

    [[ -n "$path" ]] || { die "ensure_path: path is required" 2; }
    [[ -d "$path" ]] && { (( silent )) || log "ensure_path: exists '$path'"; return 0; }
    [[ -e "$path" ]] && { die "ensure_path: '$path' exists but is not a directory" 2; }

    if can_mkdir_p "$path"; then
        mkdir -p "$path"
        (( silent )) || log "ensure_path: created '$path'"
        return 0
    fi

    (( silent )) || log "ensure_path: no permission; attempting sudo mkdir -p '$path'"
    if have sudo; then
        sudo mkdir -p "$path" || { (( silent )) || log "ensure_path: sudo mkdir failed; continuing without creating '$path'"; return 0; }
        (( silent )) || log "ensure_path: created (sudo) '$path'"
        return 0
    fi

    # no sudo available (common in containers) â€” don't die; just continue
    (( silent )) || log "ensure_path: sudo not available; continuing without creating '$path'"
    return 0
}

# Ensure PROJECT_ID or DEPLOYMENT_ID:
# - accepts: kind (PROJECT|DEPLOYMENT), file (.env default), value (optional)
# - if provided or existing env var is valid -> export + persist
# - else derive from STACK + .project_timestamp -> validate -> export + persist
ensure_project_identifier() {
    local kind="${1:?must be PROJECT or DEPLOYMENT}"
    local file="${2:-.env}"
    local provided="${3-}"

    kind="${kind^^}"
    if [[ "$kind" != "PROJECT" && "$kind" != "DEPLOYMENT" ]]; then
        die "ERROR: kind must be PROJECT or DEPLOYMENT (got: $kind)"
        return 2
    fi

    local var_name="${kind}_ID"
    local var_value

    log "Ensuring $var_name..."

    # Candidate: explicit arg > existing env var
    var_value="${provided:-${!var_name-}}"

    # If we already have a valid value, keep it
    if [[ -n "${var_value:-}" ]] && is_valid_project_identifier "$var_value"; then
        printf -v "$var_name" '%s' "$var_value"
        export "$var_name"
#        touch "$file"
        persist_kv "$var_name" "$var_value" "$file"
        return 0
    fi

    # Derive a value
    if [[ -z "${STACK:-}" ]]; then
        if [[ "${DEPLOY_ENV:-}" == "sys" ]]; then
            log "STACK is not set to derive ${var_name}, but we can continue anyway due to DEPLOY_ENV=sys"
            return 0
        else
            die "STACK is not set, but is required to derive ${var_name}."
            return 2
        fi
    fi

    local ts_file="${DEPLOYMENT_TS_FILE:-$REPO_ROOT/.project_timestamp}"
    if [[ ! -r "$ts_file"  ]]; then
        if [[ "${DEPLOY_ENV:-}" == "sys" ]]; then
            log "No timestamp file found to derive ${var_name}, but we can continue anyway due to DEPLOY_ENV=sys"
            return 0
        else
            write_project_timestamp $ts_file
            die "ERROR: timestamp file '$ts_file' not found or not readable" >&2
            return 2
        fi
    fi

	local raw_ts ts base normalized suffix base_budget env_len var_value
	raw_ts="$(<"$ts_file")"
	ts="${raw_ts//[^0-9]/}"

	if [[ -z "$ts" ]]; then
		log "ERROR: timestamp in '$ts_file' is empty or non-numeric" >&2
		return 2
	fi

	suffix="${ts:(-10)}"
	env_len=${#DEPLOY_ENV}

	# 30 total: base + two separators + environment + timestamp.
	base_budget=$((30 - env_len - ${#suffix} - 2))

	normalized="$(normalize_token "$STACK" --max 19	 --replace -)"
	base="${normalized:0:$base_budget}"
	base="${base%-}"

	var_value="${base}-${DEPLOY_ENV}-${suffix}"

    if ! is_valid_project_identifier "$var_value"; then
        log "ERROR: derived ${var_name} is invalid: $var_value" >&2
        return 2
    fi

    printf -v "$var_name" '%s' "$var_value"
    export "$var_name"
    persist_kv "$var_name" "$var_value" "$file"
    return 0
}

ensure_stack() {
    [[ -n "${STACK:-}" ]] && { log "STACK already set from environment or files: ${STACK}"; return 0; }

    if [[ -n "${APP_SLUG:-}" ]]; then
        STACK="${APP_SLUG}${DEPLOY_ENV:+-${DEPLOY_ENV}}"
        env_init_set STACK "${STACK}"         # sets + exports + registers for injection
        persist_kv "STACK" "${STACK}"
        log "Derived STACK: ${STACK}"
        return 0
    fi

    [[ "${DEPLOY_ENV:-}" == "sys" ]] && { log "Skipping STACK requirement due to DEPLOY_ENV==sys"; return 0; }

    log "ERROR: STACK is not set." >&2
    log "Define APP_SLUG or STACK in ${ENV_FILE:-<unset>} or inject it to the environment and rerun." >&2
    return 1
}

pm_deploy_env_is_production() {
    case "${DEPLOY_ENV:-}" in
        ""|prd|prod|production) return 0 ;;
        *) return 1 ;;
    esac
}

pm_decrypt_file() {
    local pm_input_file="${1:?file required}"
    local pm_output_variable="${2:?output variable required}"
    local pm_decrypted_content pm_input_format=dotenv

    [[ "$pm_input_file" == *.json ]] && pm_input_format=json

	cipher_line_count=$(wc -l < "$pm_input_file")
	echo "Starting file decryption on '$pm_input_file' containing $cipher_line_count lines ..."
    pm_decrypted_content="$(
        sops --decrypt \
            --input-type "$pm_input_format" \
            --output-type "$pm_input_format" \
            "$pm_input_file"
    )" || {
        printf 'ERROR: unable to decrypt configuration file: %s
' "$pm_input_file" >&2
        return 2
    }

	plaintext_line_count=$(printf '%s\n' "$pm_decrypted_content" | wc -l)
	echo "Successfully decrypted '$pm_input_file' with $plaintext_line_count lines. It is normal for the plaintext line count to be less than the cipher line count." >&2

    printf -v "$pm_output_variable" '%s' "$pm_decrypted_content"
}

pm_public_uri_scheme() {
    local scheme="${URI_SCHEME:-}"
    scheme="${scheme,,}"
    scheme="${scheme%://}"
    scheme="${scheme%:}"

    case "$scheme" in
        http|https)
            ;;
        *)
            if pm_deploy_env_is_production; then
                scheme="https"
            else
                case "${TRAEFIK_TLS:-false}" in
                    1|true|TRUE|yes|YES|on|ON) scheme="https" ;;
                    *) scheme="http" ;;
                esac
            fi
            ;;
    esac

    printf '%s:' "$scheme"
}

ensure_public_host_identity() {
    pm_deploy_env_is_production || return 0

    # The environment file is authoritative when it defines the canonical URL.
    # A generic APP_HOST may still contain STACK's production suffix, so it must
    # not bypass the production host derivation below.
    if [[ -n "${APP_URL:-}" ]]; then
        log DEBUG "Configured production APP_URL retained" \
            "APP_URL=${APP_URL}"
        return 0
    fi

    local app_slug="${APP_SLUG:-}"
    local domain="${BASE_DOMAIN:-${LOCAL_DOMAIN:-}}"
    [[ -n "$app_slug" && -n "$domain" ]] || return 0

    local canonical_host="${app_slug}.${domain}"
    local scheme
    scheme="$(pm_public_uri_scheme)"

    env_init_set APP_HOST "$canonical_host"
    env_init_set APP_URL "${scheme}//${canonical_host}"

    [[ -v APP_BASE_URL ]] && env_init_set APP_BASE_URL "${scheme}//${canonical_host}"
    [[ -v SITE_URL ]] && env_init_set SITE_URL "${scheme}//${canonical_host}"
    [[ -v WP_SITE_URL ]] && env_init_set WP_SITE_URL "${scheme}//${canonical_host}"

    log DEBUG "Canonical production public host resolved"         "deploy_env=${DEPLOY_ENV:-prd}" "APP_HOST=${APP_HOST}"
}

pm_upsert_env_file_value() {
    local key="${1:?key required}"
    local value="${2-}"
    local target="${3:?target environment file required}"
    local temp_file

    temp_file="$(mktemp "${target}.XXXXXX")"
    awk -F= -v key="$key" -v value="$value" '
        BEGIN { replaced = 0 }
        $1 == key && replaced == 0 { print key "=" value; replaced = 1; next }
        { print }
        END { if (replaced == 0) print key "=" value }
    ' "$target" > "$temp_file"
    chmod --reference="$target" "$temp_file" 2>/dev/null || chmod 600 "$temp_file"
    mv -- "$temp_file" "$target"
}

persist_public_host_identity() {
    local target="${1:?target environment file required}"

    ensure_public_host_identity
    pm_deploy_env_is_production || return 0
    [[ -n "${APP_HOST:-}" ]] || return 0

    pm_upsert_env_file_value APP_HOST "$APP_HOST" "$target"
    pm_upsert_env_file_value APP_URL "$APP_URL" "$target"
    [[ -v APP_BASE_URL ]] && pm_upsert_env_file_value APP_BASE_URL "$APP_BASE_URL" "$target"
    [[ -v SITE_URL ]] && pm_upsert_env_file_value SITE_URL "$SITE_URL" "$target"
    [[ -v WP_SITE_URL ]] && pm_upsert_env_file_value WP_SITE_URL "$WP_SITE_URL" "$target"
    return 0
}


ensure_app_url() {
    ensure_public_host_identity

    # APP_URL is Portmason's canonical public application URL.
    #
    # Compatibility inputs are accepted in this order:
    #   APP_URL, APP_BASE_URL, SITE_URL, WP_SITE_URL, APP_HOST
    #
    # Only APP_URL is normalized and registered for subsequent workflow steps.
    # Existing aliases remain untouched so application-specific integrations keep
    # their original semantics while shared pm-* tooling has one value to use.
    local candidate=""
    local source=""
    local scheme="${URI_SCHEME:-}"

    if [[ -n "${APP_URL:-}" ]]; then
        candidate="${APP_URL}"
        source="APP_URL"
    elif [[ -n "${APP_BASE_URL:-}" ]]; then
        candidate="${APP_BASE_URL}"
        source="APP_BASE_URL"
    elif [[ -n "${SITE_URL:-}" ]]; then
        candidate="${SITE_URL}"
        source="SITE_URL"
    elif [[ -n "${WP_SITE_URL:-}" ]]; then
        candidate="${WP_SITE_URL}"
        source="WP_SITE_URL"
    elif [[ -n "${APP_HOST:-}" ]]; then
        candidate="${APP_HOST}"
        source="APP_HOST"
    else
        return 0
    fi

    # Remove accidental CR/LF characters from environment-file values.
    candidate="${candidate//$'\r'/}"
    candidate="${candidate//$'\n'/}"

    scheme="${scheme,,}"
    scheme="${scheme%://}"
    scheme="${scheme%:}"

    case "${scheme}" in
        http|https)
            ;;
        *)
            case "${TRAEFIK_TLS:-false}" in
                1|true|TRUE|yes|YES|on|ON)
                    scheme="https"
                    ;;
                *)
                    scheme="http"
                    ;;
            esac
            ;;
    esac

    case "${candidate}" in
        http://*|https://*)
            ;;
        //*)
            candidate="${scheme}:${candidate}"
            ;;
        *://*)
            ;;
        *)
            candidate="${scheme}://${candidate}"
            ;;
    esac

    # Canonicalize the root URL without changing any path/query semantics.
    while [[ "${candidate}" == */ && "${candidate}" != *:// ]]; do
        candidate="${candidate%/}"
    done

    env_init_set APP_URL "${candidate}"
    log DEBUG "Canonical APP_URL resolved from ${source}: ${APP_URL}"
}

###############################################################################
# Environment Injection (Preschool Edition)
#
# Sources (in order):
#   1) ENV_FILE   â€” authoritative bulk config
#   2) init vars  â€” explicitly registered via env_init_set
#
# Explicitly excluded:
#   - Secrets (*_TOKEN, *_SECRET, *_KEY, *_PASSWORD, ENV_FILE, DEBUG, VERBOSE)
#   - Runtime noise (PATH, HOME, etc.)

ENV_INIT_VARS=()

ENV_EXCLUDE_GLOBS=(
  '*_TOKEN'
  '*_SECRET'
  '*_KEY'
  '*_PASSWORD'
  'ENV_FILE'
  'DB_USER'
  'DB_ADMIN_USER'
  'DB_URL'
  'DB_DIRECT_URL'
  'DEBUG'
  'VERBOSE'
  'PM_ENTRY_SCRIPT'
  'APP_HOST'
  'PATH'
  'HOME'
  'PWD'
  'OLDPWD'
  'SHELL'
  'SHLVL'
  'USER'
  'LOGNAME'
  'LANG'
  'LANGUAGE'
  'LC_*'
  'TERM'
  'XDG_*'
  'PORT'
)

env_file_to_kv_nul() {
  local env_file="${1:?env file required}"
  [[ -r "$env_file" ]] || return 0
  local pm_reader_plaintext
  pm_decrypt_file "$env_file" pm_reader_plaintext || return 2

  (
    set -euo pipefail
    set -a
    # shellcheck disable=SC1090
    eval "$pm_reader_plaintext" || exit 2
    set +a

    awk '
      function ltrim(s){ sub(/^[ \t\r\n]+/, "", s); return s }
      function rtrim(s){ sub(/[ \t\r\n]+$/, "", s); return s }
      function trim(s){ return rtrim(ltrim(s)) }

      {
        line = trim($0)
        if (line == "" || line ~ /^#/) next

        # allow "export KEY=VAL"
        if (line ~ /^export[ \t]+/) {
          sub(/^export[ \t]+/, "", line)
          line = trim(line)
        }

        # only accept KEY=... (no spaces before '=')
        if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) next

        key = line
        sub(/=.*/, "", key)

        val = ENVIRON[key]
        printf "%s\0%s\0", key, val
      }
    ' <<< "$pm_reader_plaintext"
  )
}

env_filter_secrets() {
  local k v pat
  while IFS= read -r -d '' k; do
    IFS= read -r -d '' v || v=""

    for pat in "${ENV_EXCLUDE_GLOBS[@]}"; do
      [[ "$k" == $pat ]] && continue 2
    done

    printf '%s\0%s\0' "$k" "$v"
  done
}

env_init_set() {
  local k="${1:?key required}"
  local v="${2-}"

  printf -v "$k" '%s' "$v"
  export "$k"

  for existing in "${ENV_INIT_VARS[@]}"; do
    [[ "$existing" == "$k" ]] && return 0
  done
  ENV_INIT_VARS+=("$k")
}

env_init_to_kv_nul() {
  local k
  for k in "${ENV_INIT_VARS[@]}"; do
    printf '%s\0%s\0' "$k" "${!k-}"
  done
}

env_kv_for_injection() {
  (
    [[ -n "${ENV_FILE-}" ]] && env_file_to_kv_nul "${ENV_FILE}.generated"
    env_init_to_kv_nul
  ) | env_filter_secrets | env_merge_first_wins
}

env_merge_first_wins() {
  declare -A seen=()
  local k v
  while IFS= read -r -d '' k; do
    IFS= read -r -d '' v || v=""
    [[ -n "${seen[$k]+x}" ]] && continue
    seen["$k"]=1
    printf '%s\0%s\0' "$k" "$v"
  done
}
#
# END Env injection section
######################################

error() { log ERROR "$@"; }

fatal() {
    local msg="Process terminated"
    local rc="1"

    case "${1:-}" in
        "")
            ;;
        *[!0-9]*)
            msg="$1"
            rc="${2:-1}"
            ;;
        *)
            rc="$1"
            ;;
    esac

    case "$rc" in
        ""|*[!0-9]*) rc="1" ;;
    esac

    log CRITICAL "$msg" "exit_code=$rc"
    exit "$rc"
}

fatal_error() {
    local msg="${1:-Fatal error}"
    local rc="${2:-1}"

    case "$rc" in
        ""|*[!0-9]*) rc="1" ;;
    esac

    error "$msg" "exit_code=$rc"
    exit "$rc"
}

get_deploy_env_value() {
  local short="${1:?pm_env_get requires: <short> <field> [map_file]}"
  local field="${2:?pm_env_get requires: <short> <field> [map_file]}"
  local map_file="${3:-${PORTMASON_SHARE}/pm-deploy-env-mapping.json}"

  have jq || { fatal_error "jq is required" 1; }
  [[ -f "$map_file" ]] || { fatal_error "mapping file not found: '$map_file'" 1; }

  short="$(printf '%s' "$short" | tr '[:upper:]' '[:lower:]')"
  field="$(printf '%s' "$field" | tr '[:upper:]' '[:lower:]')"

  case "$field" in
    short|long|gcp_tag)
      ;;
    *)
      error "unknown field '$field' (allowed: short,long,gcp_tag)"
      return 1
      ;;
  esac

  local val
  val="$(jq -r --arg s "$short" --arg f "$field" '
    .envs[$s][$f] // empty
  ' "$map_file")"

  if [[ -z "$val" ]]; then
    error "unknown env '$short' or missing field '$field'"
    return 1
  fi

  printf '%s\n' "$val"
}

godaddy_upsert_cname() {
    local target_url="${1:?target_url required (e.g., https://web-702605617368.us-central1.run.app)}"

  : "${GODADDY_API_KEY:?GODADDY_API_KEY is required for DNS updates}"
  : "${GODADDY_API_SECRET:?GODADDY_API_SECRET is required for DNS updates}"
  : "${GODADDY_API_BASE:=https://api.godaddy.com}"
  : "${GODADDY_API_TTL:=600}"

  # Normalize input
  target_url="${target_url#http://}"
  target_url="${target_url#https://}"
  target_url="${target_url%%/*}"
  target_url="${target_url%.}"

  # PUT replaces the CNAME for this (type,name). Payload is an array of records.
  # Endpoint family: /v1/domains/{domain}/records/{type}/{name} :contentReference[oaicite:1]{index=1}
  curl -sS -X PUT \
    -H "Authorization: sso-key ${GODADDY_API_KEY}:${GODADDY_API_SECRET}" \

    -H "Content-Type: application/json" \
    "${GODADDY_API_BASE}/v1/domains/${LOCAL_DOMAIN}/records/CNAME/${STACK}" \
    --data "[{\"data\":\"${tar
    get_url}\",\"ttl\":${GODADDY_API_TTL}}]"
}

secret_spec_parts() {
    # Usage: secret_spec_parts SPEC PROVIDER_OUT SECRET_ID_OUT
    local spec="${1:?secret spec required}"
    local provider_out="${2:?provider output variable required}"
    local secret_id_out="${3:?secret id output variable required}"

    local parsed_provider=""
    local parsed_secret_id=""

    if [[ "$spec" == *":"* ]]; then
        parsed_provider="${spec%%:*}"
        parsed_secret_id="${spec#*:}"
    else
        parsed_provider="${DEFAULT_SECRET_PROVIDER:-gcp}"
        parsed_secret_id="$spec"
    fi

    [[ -n "$parsed_provider" ]] \
        || parsed_provider="${DEFAULT_SECRET_PROVIDER:-gcp}"

    [[ "$parsed_provider" == "gcs" ]] \
        && parsed_provider="gcp"

    [[ -n "$parsed_secret_id" ]] \
        || die "Secret identifier is empty in spec: ${spec}" 2

    printf -v "$provider_out" '%s' "$parsed_provider"
    printf -v "$secret_id_out" '%s' "$parsed_secret_id"
}


pm_secret_python() {
    local router="${PORTMASON_SHARE}/pm-secret.py"
    have python3 || die "python3 is required for secret handling" 2
    [[ -r "$router" ]] \
        || die "Python secret router is unavailable: $router" 2
    python3 "$router" "$@"
}

get_secret() {
    local spec="${1:?secret spec required}"
    pm_secret_python get-secret "$spec"
}

pm_secret_value_is_sentinel() {
    local value="${1-}"
    [[ "${value,,}" == "secret" ]]
}

pm_secret_resolve_value() {
    local out_var="${1:?output variable required}"
    local key="${2:?secret key required}"
    local value="${3-}"
    local secret_path=""
    if secret_path="$(get_secret_path_by_ref "$key" 2>/dev/null)"; then
        value="$(get_secret "$secret_path")" \
            || die "unable to resolve configured secret path for $key" 2
        [[ -n "$value" ]] || die "configured secret path resolved empty for $key" 2
    elif pm_secret_value_is_sentinel "$value"; then
        die "secret sentinel for $key requires a SECRET_PATHS mapping" 2
    fi
    printf -v "$out_var" '%s' "$value"
}


set_secret() {
    local spec="${1:?secret spec required}"
    local value="${2-}"
    printf '%s' "$value" | pm_secret_python set-secret "$spec"
}

load_secret_provider_helper() {
    local provider="${1:?secret provider required}"
    local file="${PORTMASON_SHARE}/pm-secret-provider-${provider}"
    if [[ ! -r "$file" ]]; then
        file="${PORTMASON_SHARE}/pm-helpers-${provider}"
    fi
    [[ -r "$file" ]] || return 0
    # shellcheck disable=SC1090
    . "$file"
}

get_secret_name_from_path(){
    local spec="${1:?secret path required}"
    local provider secret_id fn
    secret_spec_parts "$spec" provider secret_id
    fn="get_${provider}_secret_name_from_path"
    if ! declare -F "$fn" >/dev/null 2>&1; then
        load_secret_provider_helper "$provider"
    fi
    declare -F "$fn" >/dev/null 2>&1 || die "get_secret_name_from_path: unsupported secret provider '$provider' for spec '$spec'"
    "$fn" "${secret_id}"
}

get_secret_name_by_ref() {
  local path
  path="$(get_secret_path_by_ref "$1")" || return 1
  get_secret_name_from_path "$path" #secret_name is the provider's secret_name
}

get_secret_path_by_ref() {
  local want="${1:-}"
  [[ -z "$want" ]] && bail "get_secret_path_by_ref: missing ref key" 2
  : "${SECRET_PATHS:=}" #secret_path consists of [secret_provider (gcp, azure, github, etc)]:[secret_id]

  local line ref path
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    [[ "$line" != *"|"* ]] && bail "get_secret_path_by_ref: invalid entry (expected 'REF|PATH'): '$line'" 2

    ref="${line%%|*}"
    path="${line#*|}"

    [[ -n "$ref" && -n "$path" ]] || bail "get_secret_path_by_ref: invalid entry (empty ref/path): '$line'" 2

    if [[ "$ref" == "$want" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done <<< "$SECRET_PATHS"

  return 1
}

get_secret_names_list() {
  local spec secret_path secret_name
  for spec in "${SECRET_PATHS[@]}"; do
    [[ -z "$spec" ]] && continue
    [[ "$spec" != *"|"* ]] && die "secret_names_list: invalid entry (expected 'REF|PATH'): '$spec'"

    secret_path="${spec#*|}"
    [[ -n "$secret_path" ]] || die "secret_names_list: empty path in '$spec'"

    secret_name="$(get_secret_name_from_path "$secret_path")" || die "secret_names_list: failed to derive secret name from '$secret_path'"
    [[ -n "$secret_name" ]] || die "secret_names_list: empty secret name derived from '$secret_path'"

    printf '%s\n' "$secret_name"
  done
}

get_secret_paths_list() {
  local spec secret_path
  for spec in "${SECRET_PATHS[@]}"; do
    [[ -z "$spec" ]] && continue
    [[ "$spec" != *"|"* ]] && die "secret_paths_list: invalid entry (expected 'REF|PATH'): '$spec'"
    secret_path="${spec#*|}"
    [[ -n "$secret_path" ]] || die "secret_paths_list: empty path in '$spec'"
    printf '%s\n' "$secret_path"
  done
}

have() {
  # have <command>
  command -v "$1" >/dev/null 2>&1
}

info() { log INFO "$@"; }

live_tail_autostart() {
    : "${LIVE_TAIL:=1}"
    [[ "${LIVE_TAIL}" == "1" ]] || return 0
    [[ -n "${LOG_FILE:-}" ]] || return 0
    [[ "${__HAS_TTY_BEFORE_REDIRECT:-0}" == "1" ]] || return 0
    [[ -w /dev/tty ]] || return 0

    if [[ -n "${__LIVE_TAIL_GUARD_PID:-}" ]] &&
       kill -0 "${__LIVE_TAIL_GUARD_PID}" 2>/dev/null; then
        return 0
    fi

    unset __LIVE_TAIL_PID __LIVE_TAIL_GUARD_PID

    export __LIVE_TAIL_OWNER_BASHPID="${BASHPID}"

    local parent_pid="$$"

    (
        set +e

        tail -n 200 -F "$LOG_FILE" > /dev/tty 2>&1 &
        tail_pid=$!

        pidfile="/tmp/pm-live-tail.${parent_pid}.pid"
        printf '%s\n' "$tail_pid" > "$pidfile" 2>/dev/null || true

        while kill -0 "$parent_pid" 2>/dev/null; do
            sleep 0.25
        done

        kill -- "-$tail_pid" 2>/dev/null || true
        kill "$tail_pid" 2>/dev/null || true
        wait "$tail_pid" 2>/dev/null || true

        rm -f "$pidfile" 2>/dev/null || true
        exit 0
    ) &

    guard_pid=$!
    export __LIVE_TAIL_GUARD_PID="$guard_pid"

    pidfile="/tmp/pm-live-tail.${parent_pid}.pid"

    for _ in 1 2 3 4 5; do
        if [[ -s "$pidfile" ]]; then
            __LIVE_TAIL_PID="$(cat "$pidfile" 2>/dev/null || true)"
            export __LIVE_TAIL_PID
            break
        fi

        sleep 0.05
    done

    return 0
}

live_tail_stop() {
    local owner="${__LIVE_TAIL_OWNER_BASHPID:-}"

    if [[ -n "$owner" && "$owner" != "${BASHPID}" ]]; then
        return 0
    fi

    local guard="${__LIVE_TAIL_GUARD_PID:-}"
    local tailp="${__LIVE_TAIL_PID:-}"

    unset \
        __LIVE_TAIL_OWNER_BASHPID \
        __LIVE_TAIL_GUARD_PID \
        __LIVE_TAIL_PID

    if [[ -n "$guard" ]] && kill -0 "$guard" 2>/dev/null; then
        kill "$guard" 2>/dev/null || true
        wait "$guard" 2>/dev/null || true
    fi

    if [[ -n "$tailp" ]] && kill -0 "$tailp" 2>/dev/null; then
        kill -- "-$tailp" 2>/dev/null || true
        kill "$tailp" 2>/dev/null || true
        wait "$tailp" 2>/dev/null || true
    fi

    return 0
}

