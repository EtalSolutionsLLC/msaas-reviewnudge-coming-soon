#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_postgres_psql_admin() {
    PM_DB_RT_USER="${DB_ADMIN_USER:?DB_ADMIN_USER required}" \
    PM_DB_RT_PASSWORD="${DB_ADMIN_PASSWORD:?DB_ADMIN_PASSWORD required}" \
    PM_DB_RT_DATABASE="${DB_ADMIN_DATABASE:-postgres}" \
        db_rt "$@"
}

pm_postgres_ensure_role() {
    log INFO "ensuring application role" \
        "role=${DB_USER:?DB_USER required}"

    # The application password travels through an inherited environment value,
    # never a command-line argument. psql imports it into a private variable at
    # execution time so neither Portmason logs nor process listings expose it.
    PM_DB_SQL_SECRET="$DB_USER_PASSWORD" \
        pm_postgres_psql_admin --set=db_user="$DB_USER" --file=- <<'SQL'
\getenv db_password PM_DB_SQL_SECRET
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'db_user') \gexec
SQL

    log INFO "application role ready" \
        "role=$DB_USER"
}

pm_postgres_ensure_database() {
    log INFO "ensuring application database" \
        "database=${DB_NAME:?DB_NAME required}" "owner=$DB_ADMIN_USER"

    # psql variable interpolation and \gexec are client-side features. Feed the
    # script through --file=- so psql processes them before sending SQL to the
    # server. Passing the same text through --command sends :'name' verbatim.
    pm_postgres_psql_admin \
        --set=db_name="$DB_NAME" \
        --set=db_user="$DB_ADMIN_USER" \
        --file=- <<'SQL'
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db_name') \gexec
SELECT format('ALTER DATABASE %I OWNER TO %I', :'db_name', :'db_user') \gexec
SQL

    log INFO "application database ready" \
        "database=$DB_NAME" "owner=$DB_ADMIN_USER"
}

pm_postgres_ensure_extensions() {
    local extension
    [[ -n "${DB_EXTENSIONS:-}" ]] || return 0

    IFS=',' read -r -a _pm_extensions <<<"$DB_EXTENSIONS"
    for extension in "${_pm_extensions[@]}"; do
        extension="${extension#${extension%%[![:space:]]*}}"
        extension="${extension%${extension##*[![:space:]]}}"
        [[ -n "$extension" ]] || continue
        [[ "$extension" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] \
            || die "Invalid PostgreSQL extension name: $extension" 2
        log INFO "ensuring extension" "extension=$extension"
        PM_DB_RT_USER="$DB_ADMIN_USER" \
        PM_DB_RT_PASSWORD="$DB_ADMIN_PASSWORD" \
        PM_DB_RT_DATABASE="$DB_NAME" \
            db_rt --set=extension="$extension" --file=- <<'SQL'
SELECT format('CREATE EXTENSION IF NOT EXISTS %I', :'extension') \gexec
SQL
        log INFO "extension ready" "extension=$extension"
    done
}

pm_postgres_apply_base_grants() {
    log INFO "applying base ownership and grants" \
        "database=$DB_NAME" "role=$DB_USER"
    PM_DB_RT_USER="$DB_ADMIN_USER" \
    PM_DB_RT_PASSWORD="$DB_ADMIN_PASSWORD" \
    PM_DB_RT_DATABASE="$DB_NAME" \
		db_rt --set=db_user="$DB_USER" --set=db_admin="$DB_ADMIN_USER" --file=- <<'SQL'
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', current_database(), :'db_user') \gexec
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
SELECT format('REVOKE CREATE ON SCHEMA public FROM %I', :'db_user') \gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'db_user') \gexec

SELECT format('GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO %I', :'db_user') \gexec
SELECT format('GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO %I', :'db_user') \gexec

SELECT format('ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO %I', :'db_admin', :'db_user') \gexec
SELECT format('ALTER DEFAULT PRIVILEGES FOR ROLE %I IN SCHEMA public GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO %I', :'db_admin', :'db_user') \gexec
SQL
    log INFO "base ownership and grants ready" \
        "database=$DB_NAME" "role=$DB_USER"
}

pm_provision_db_provider() {

    [[ "${DB_PROVIDER_CODE:-}" == "postgres" ]] \
        || die "pm-provision-db-postgres requires DB_PROVIDER_CODE=postgres" 2

    : "${DB_NAME:?DB_NAME required}"
    : "${DB_USER:?DB_USER required}"
    : "${DB_USER_PASSWORD:?DB_USER_PASSWORD required}"
    : "${DB_ADMIN_USER:?DB_ADMIN_USER required}"
    : "${DB_ADMIN_PASSWORD:?DB_ADMIN_PASSWORD required}"

    log INFO "starting provider provisioning" \
        "platform=${DB_PLATFORM_CODE:-}" "database=$DB_NAME" "user=$DB_USER"

    pm_postgres_ensure_role
    pm_postgres_ensure_database
    pm_postgres_ensure_extensions
    pm_postgres_apply_base_grants

    log INFO "provider provisioning complete" \
        "database=$DB_NAME" "user=$DB_USER"
}

main() {
    pm_provision_db_provider "$@"
}

main "$@"


================================================================================
FILE: ./pm-provision-gcp
================================================================================
#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)"}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_gcp_load_deployable_services() {
    if [[ "${PM_GCP_DEPLOYABLE_SERVICES_LOADED:-0}" == "1" ]]; then
        return 0
    fi

    local compose_json=""
    pm_compose_init_command
    compose_json="$("${PM_COMPOSE_CMD[@]}" config \
        --no-interpolate \
        --no-env-resolution \
        --format json 2>&1)" || {
        log ERROR "Compose services could not be inspected without interpolation" \
            "detail=$(pm_compose_render_failure_message "$compose_json")"
        return 1
    }

    if ! jq -e '.services and (.services | type == "object")' >/dev/null 2>&1 \
        <<<"$compose_json"; then
        log ERROR "Unresolved Compose model is not valid service JSON" \
            "detail=$(pm_compose_render_failure_message "$compose_json" 10)"
        return 1
    fi

    compose_json="$(
        jq -c '
            def key_value_array_to_object:
                if type != "array" then .
                else reduce .[] as $item ({};
                    ($item | index("=")) as $split
                    | if $split == null then .[$item] = null
                      else .[$item[0:$split]] = $item[($split + 1):]
                      end
                )
                end;
            .services |= with_entries(
                .value.labels = ((.value.labels // {}) | key_value_array_to_object)
                | .value.environment = ((.value.environment // {}) | key_value_array_to_object)
            )
        ' <<<"$compose_json"
    )" || {
        log ERROR "Unresolved Compose service metadata could not be normalized"
        return 1
    }

    PM_GCP_DEPLOYABLE_SERVICES_TSV="$(
        PM_COMPOSE_MODEL_JSON="$compose_json"
        PROJECT_SERVICES=""
        export PM_COMPOSE_MODEL_JSON PROJECT_SERVICES
        pm_compose_load_model
        pm_compose_deployable_services_tsv
    )" || return 1
    PM_GCP_DEPLOYABLE_SERVICES_LOADED=1
}

bind_permissions() {
    pm_gcp_load_deployable_services || return 1
    local service role service_account
    log INFO "pm-provision-gcp: binding runtime service permissions"
    while IFS=$'\t' read -r service role _image _has_build; do
        [[ -n "$service" ]] || continue
        service_account="$(format_sa_email "$service")"
        bind_service_account "$service_account" "$role"
    done <<<"$PM_GCP_DEPLOYABLE_SERVICES_TSV"
    log INFO "pm-provision-gcp: runtime service permission binding complete"
}

bind_service_account() {
    local sa_email="${1:?service account email required}"
    local role="${2:-app}"

    if [[ -n "${GCS_BUCKET:-}" ]]; then
        log INFO "pm-provision-gcp: ensuring GCS access" \
            "service_account=$sa_email" "bucket=$GCS_BUCKET"
        gcloud storage buckets add-iam-policy-binding "gs://${GCS_BUCKET}" \
            --member="serviceAccount:${sa_email}" \
            --role="roles/storage.objectAdmin" \
            --quiet >/dev/null
    fi

    log DEBUG "pm-provision-gcp: base service permissions complete" \
        "service_account=$sa_email" "role=$role"
}

ensure_apis() {
    log "Verify/Enable required APIs"

    if [[ -z "${GCLOUD_ENABLED_SERVICE_NAMES:-}" ]]; then
        if ! GCLOUD_ENABLED_SERVICE_NAMES="$(gcloud services list --enabled --project "${DEPLOYMENT_ID}" --format='value(config.name)')"; then
            GCLOUD_ENABLED_SERVICE_NAMES=""
        fi
        export GCLOUD_ENABLED_SERVICE_NAMES
        log "GCLOUD_ENABLED_SERVICE_NAMES=${GCLOUD_ENABLED_SERVICE_NAMES}"
    fi

    for api in \
        run.googleapis.com \
        cloudbuild.googleapis.com \
        artifactregistry.googleapis.com \
        sqladmin.googleapis.com \
        secretmanager.googleapis.com \
        iamcredentials.googleapis.com \
        pubsub.googleapis.com \
        cloudtasks.googleapis.com \
        cloudscheduler.googleapis.com \
        cloudresourcemanager.googleapis.com
    do
        if ! printf '%s\n' "$GCLOUD_ENABLED_SERVICE_NAMES" | grep -Fxq "$api"; then
            log "Enabling API: $api"
            if gcloud services enable "$api" --project "$DEPLOYMENT_ID" >/dev/null 2>&1; then
                if [[ -z "${GCLOUD_ENABLED_SERVICE_NAMES:-}" ]]; then
                    GCLOUD_ENABLED_SERVICE_NAMES="$api"
                else
                    GCLOUD_ENABLED_SERVICE_NAMES+=$'\n'"$api"
                fi
            fi
        else
            log "API already enabled: $api"
        fi
    done
}

ensure_repo() {
    if [[ -z "${AR_REPO:-}" ]]; then
        log "AR_REPO is undefined; skipping repo creation"
        return 0
    fi

    # 6) Ensure AR repo (with short retry for propagation)
    log "Ensure repo '${AR_REPO}' in ${REGION}"
    for i in {1..3}; do
        if gcloud artifacts repositories describe "${AR_REPO}" --location "${REGION}" >/dev/null 2>&1; then break; fi
        if gcloud artifacts repositories create "${AR_REPO}" --repository-format=docker --location="${REGION}" --description="Containers for ${APP_SLUG}" >/dev/null 2>&1; then break; fi
        log "Repo creation attempt $i failed; waiting 10sâ€¦"; sleep 10
    done

    return 0
}


ensure_bucket() {
  if [[ -z "${GCS_BUCKET:-}" ]]; then
     log "GCS_BUCKET is undefined; skipping bucket creation"
    return 0
  fi

  if gcloud storage buckets describe "gs://${GCS_BUCKET}" >/dev/null 2>&1; then
    log "Bucket exists: gs://${GCS_BUCKET}"
    return 0
  fi

  log "Creating bucket: gs://${GCS_BUCKET} (region=${REGION})"
  gcloud storage buckets create "gs://${GCS_BUCKET}" --location="$REGION" >/dev/null

  return 0
}

ensure_env_tag() {
    local base_project_id=${GLOBAL_REFERENCE_DEPLOYMENT_ID}
    local base_parent="projects/$base_project_id"
    local keyname='environment'
    local keyvalue="$(get_deploy_env_value "$DEPLOY_ENV" long)" || die "get_deploy_env_value failed with '$DEPLOY_ENV'"
    keyvalue="${keyvalue^}"

    local target_project_number="$(jq -er '.projectNumber' <<<"$GCLOUD_PROJECT_INFO_JSON")"
    local target_parent="//cloudresourcemanager.googleapis.com/projects/$target_project_number"

    log "Ensuring project has an '$keyname' tag"

    # ---- Find Tag Key NAME (tagKeys/<id>) scoped to base project ----
    # IMPORTANT: Use the base project scope to avoid collisions.
    local tag_key_name="$(
    gcloud resource-manager tags keys list \
        --parent="$base_parent" \
        --filter="shortName=$keyname" \
        --format='value(name)' \
        --limit=1
    )"

    [[ -n "$tag_key_name" ]] || { error "Tag Key '${keyname}' not found under ${base_parent}"; return 1; }
    [[ "$(printf '%s\n' "$tag_key_name" | grep -c .)" -le 1 ]] || { error "Multiple Tag Keys matched '${keyname}' under ${base_parent}"; return 2; }

    # ---- Find Tag Value NAME (tagValues/<id>) under the key ----
    local tag_value_name="$(
    gcloud resource-manager tags values list     \
        --parent="$tag_key_name" \
        --filter="shortName=$keyvalue" \
        --format='value(name)' \
        --limit=1
    )"

    if [[ -z "$tag_value_name" ]]; then
        tag_value_name="$(
            gcloud resource-manager tags values create "${keyvalue}" \
                --parent="${tag_key_name}" \
                --format="value(name)"
        )" || { error "Failed to create tag value ${keyvalue}"; return 3; }
    fi

    [[ -n "$tag_value_name" ]] || { error "Tag Value '${keyvalue}' not found under Tag Key '${keyname}'"; return 3; }
    [[ "$(printf '%s\n' "$tag_value_name" | grep -c .)" -le 1 ]] || { error "Multiple Tag Values matched '${keyvalue}' under ${tag_key_name}"; return 4; }

    # Bindings list returns tagValue (tagValues/...). To figure out if that value belongs to TAG_KEY_NAME,
    # we have to look up each value's parent (which is tagKeys/<id>).

    local existing_tag_values="$(
        gcloud resource-manager tags bindings list \
        --parent="$target_parent" \
        --format='value(tagValue)' 2>/dev/null || true
    )"

    if printf '%s\n' "$existing_tag_values" | grep -Fxq "$tag_value_name"; then
        log "Tag already bound: $tag_value_name"
        return 0
    fi

    local existing_parent_key
    if [[ -n "$existing_tag_values" ]]; then
        while IFS= read -r existing_tv; do
            [[ -z "$existing_tv" ]] && continue

            # Determine which key this tag value belongs to
            existing_parent_key="$(
                gcloud resource-manager tags values describe "$existing_tv" --format='value(parent)' 2>/dev/null || true
            )"

            if [[ "$existing_parent_key" = "$tag_key_name" && "$existing_tv" != "$tag_value_name" ]]; then
                log "Unbinding old value for key '$keyname': $existing_tv"
                # Delete needs both parent + tag-value
                gcloud resource-manager tags bindings delete \
                --parent="$target_parent" \
                --tag-value="$existing_tv" >/dev/null
            fi
        done <<< "$existing_tag_values"
    fi

    # ---- Create binding (treat ALREADY_EXISTS as success) ----
    set +e
    local out="$(gcloud resource-manager tags bindings create \
        --tag-value="$tag_value_name" \
        --parent="$target_parent" 2>&1
    )"
    local rc=$?
    set -e

    if [[ $rc -eq 0 ]] || printf '%s' "$out" | grep -qiE 'ALREADY_EXISTS|already exists'; then
      log "Tag ensured: ${keyname}=${keyvalue}"
      return 0
    fi

    error "failed to create tag binding (rc=$rc): $out" >&2
    return "$rc"
}

ensure_project(){
    # 1) Create or check project + billing
    log "Checking if project '${DEPLOYMENT_ID}' already exists"

	export GCLOUD_BILLING_JSON="{}"
    export GCLOUD_CONFIG_JSON="{}"
    export GCLOUD_PROJECT_INFO_JSON="$(gcloud projects describe "${DEPLOYMENT_ID}" --format=json 2>/dev/null || echo '{}')"

    if [[ -n "${GCLOUD_PROJECT_INFO_JSON:-}" && "${GCLOUD_PROJECT_INFO_JSON}" != "{}" ]]; then
        local state="$(jq -er '.lifecycleState' <<<"$GCLOUD_PROJECT_INFO_JSON")"
        if [[ "$state" == "DELETE_REQUESTED" ]]; then
            die "project ${DEPLOYMENT_ID} is in DELETE_REQUESTED. Wait for deletion to finish or choose a new ID." 3
        fi

        GCLOUD_BILLING_JSON="$(gcloud billing projects describe "${DEPLOYMENT_ID}" --format=json 2>/dev/null || echo '{}')"
        local billing_enabled="$(jq -r '.billingEnabled // false' <<<"$GCLOUD_BILLING_JSON")"

        if [[ "$billing_enabled" != "true" ]]; then
            log "linking to ${BILLING_ACCOUNT}"
            gcloud billing projects link "${DEPLOYMENT_ID}" --billing-account "${BILLING_ACCOUNT}"
        else
            log "Project '${DEPLOYMENT_ID}' already exists and is linked to billing account '${BILLING_ACCOUNT}'"
        fi
    else
        log "creating ${DEPLOYMENT_ID}"
        gcloud projects create "${DEPLOYMENT_ID}" --name="${STACK}"
        log "linking to ${BILLING_ACCOUNT}"
        gcloud billing projects link "${DEPLOYMENT_ID}" --billing-account "${BILLING_ACCOUNT}"

        GCLOUD_PROJECT_INFO_JSON="$(gcloud projects describe "${DEPLOYMENT_ID}" --format=json)"
        log "GCLOUD_PROJECT_INFO_JSON=${GCLOUD_PROJECT_INFO_JSON}"

        GCLOUD_BILLING_JSON="$(gcloud billing projects describe "${DEPLOYMENT_ID}" --format=json)"
#    else
#        die "unknown (auth/perm/config issue)" 2
    fi
    log "GCLOUD_PROJECT_INFO_JSON=${GCLOUD_PROJECT_INFO_JSON}"
    log "GCLOUD_BILLING_JSON=${GCLOUD_BILLING_JSON}"

    if [[ -z "${GCLOUD_POLICY_JSON:-}" ]]; then
        GCLOUD_POLICY_JSON="$(gcloud projects get-iam-policy "${DEPLOYMENT_ID}" --format=json 2>/dev/null || echo '{}')"
    fi
    log "GCLOUD_POLICY_JSON=${GCLOUD_POLICY_JSON}"

    ensure_env_tag

    if [[ -z "${GCLOUD_CONFIG_JSON:-}" ]]; then
        GCLOUD_CONFIG_JSON="$(gcloud config list --format=json 2>/dev/null || echo '{}')"
    fi
    log "GCLOUD_CONFIG_JSON=${GCLOUD_CONFIG_JSON}"

    # 2) Verify/Set ADC quota project EARLY (silences warnings)
    log "Verify/Set ADC quota project â†’ ${DEPLOYMENT_ID}"
    local adc_file="${XDG_CONFIG_HOME:-$HOME/.config}/gcloud/application_default_credentials.json"
    local adc_quota_project="$(jq -r '.quota_project_id // empty' "$adc_file" 2>/dev/null || true)"
    if [[ "${adc_quota_project:-}" != "$DEPLOYMENT_ID" ]]; then
        gcloud auth application-default set-quota-project "$DEPLOYMENT_ID" >/dev/null
        # Patch cached value (no extra file read)
        adc_quota_project="$DEPLOYMENT_ID"
    fi

    local adc_quota_project="$(jq -r '.quota_project_id // empty' "$adc_file" 2>/dev/null || true)"
    [[ "$(grep -o '"quota_project_id":[^,]*' "${XDG_CONFIG_HOME:-$HOME/.config}/gcloud/application_default_credentials.json" 2>/dev/null | awk -F\" '{print $4}' || true)" != "$DEPLOYMENT_ID" ]] \
        && gcloud auth application-default set-quota-project "$DEPLOYMENT_ID" >/dev/null
    
    # 3) gcloud defaults (GCLOUD_CONFIG_JSON is a cached `gcloud config list --format=json` result)

    log "Verify/Set project â†’ ${DEPLOYMENT_ID}"
    local cur_project
    cur_project="$(jq -r '.core.project // empty' <<<"$GCLOUD_CONFIG_JSON")"
    if [[ "$cur_project" != "$DEPLOYMENT_ID" ]]; then
        gcloud config set project "$DEPLOYMENT_ID" >/dev/null
        GCLOUD_CONFIG_JSON="$(jq -c --arg v "$DEPLOYMENT_ID" '.core.project = $v' <<<"$GCLOUD_CONFIG_JSON")"
    fi

    log "Verify/Set region â†’ $REGION"
    local cur_run_region
    cur_run_region="$(jq -r '.run.region // empty' <<<"$GCLOUD_CONFIG_JSON")"
    if [[ "$cur_run_region" != "$REGION" ]]; then
        gcloud config set run/region "$REGION" >/dev/null
        GCLOUD_CONFIG_JSON="$(jq -c --arg v "$REGION" '.run.region = $v' <<<"$GCLOUD_CONFIG_JSON")"
    fi

    log "Verify/Set artifacts.location â†’ $REGION"
    local cur_ar_loc
    cur_ar_loc="$(jq -r '.artifacts.location // empty' <<<"$GCLOUD_CONFIG_JSON")"
    if [[ "$cur_ar_loc" != "$REGION" ]]; then
        gcloud config set artifacts/location "$REGION" >/dev/null
        GCLOUD_CONFIG_JSON="$(jq -c --arg v "$REGION" '.artifacts.location = $v' <<<"$GCLOUD_CONFIG_JSON")"
    fi

    return 0
}

ensure_project_role() {
    local role="${1:?role required}"
    local member="user:${GCLOUD_ACTIVE_USER:?GCLOUD_ACTIVE_USER required}"

    # Normalize role to avoid INVALID_ARGUMENT from stray whitespace/CR
    role="${role//$'\r'/}"
    role="$(xargs <<<"$role")"

    if [[ ! "$role" =~ ^(roles|projects/[a-z0-9-]+/roles|organizations/[0-9]+/roles)/[A-Za-z0-9_.-]+$ ]]; then
        die "Bad role string (expected roles/foo or projects/*/roles/foo or organizations/*/roles/foo): '$role'"
    fi

    # Fetch IAM policy once for performance (JSON, stable for parsing)
    if [[ -z "${GCLOUD_POLICY_JSON:-}" ]]; then
        if ! GCLOUD_POLICY_JSON="$(gcloud projects get-iam-policy "${DEPLOYMENT_ID}" --format=json 2>/dev/null)"; then
            GCLOUD_POLICY_JSON='{}'
        fi
        export GCLOUD_POLICY_JSON
        log "GCLOUD_POLICY_JSON loaded"
    fi

    # Exact membership check
    if jq -e --arg r "$role" --arg m "$member" \
        'any(.bindings[]?; .role == $r and any(.members[]?; . == $m))' \
        >/dev/null 2>&1 <<<"$GCLOUD_POLICY_JSON"; then
        log "  = already has ${role}"
        return 0
    fi

    # Fast path: try add-iam-policy-binding
    if gcloud projects add-iam-policy-binding "${DEPLOYMENT_ID}" \
        --member="$member" \
        --role="$role" >/dev/null 2>&1; then
        log "  + granted ${role} (add-iam-policy-binding)"
    else
        # Slow-but-reliable path for conditional policies:
        # Update cached policy JSON and set it back.
        log "  ! add-iam-policy-binding failed; applying via set-iam-policy"

        GCLOUD_POLICY_JSON="$(
        jq -c --arg r "$role" --arg m "$member" '
            .bindings = (.bindings // [])
            | (if any(.bindings[]?; .role == $r) then .
            else .bindings += [{role:$r, members:[]}] | .
            end)
            | .bindings = (
                .bindings
                | map(
                    if .role != $r then .
                    else .members = ((.members // []) | (if index($m) then . else . + [$m] end))
                    end
                )
            )
        ' <<<"$GCLOUD_POLICY_JSON" 2>/dev/null || printf '%s' '{}'
        )"

        local tmp_policy
        tmp_policy="$(mktemp)"
        printf '%s\n' "$GCLOUD_POLICY_JSON" >"$tmp_policy"

        gcloud projects set-iam-policy "${DEPLOYMENT_ID}" "$tmp_policy" >/dev/null \
        || { rm -f "$tmp_policy"; die "Failed to set IAM policy for ${DEPLOYMENT_ID}"; }

        rm -f "$tmp_policy"
        export GCLOUD_POLICY_JSON
        log "  + granted ${role} (set-iam-policy)"
    fi

    # Keep cache accurate for the rest of this run (manual patch is harmless even on fast path)
    GCLOUD_POLICY_JSON="$(
        jq -c --arg r "$role" --arg m "$member" '
        .bindings = (.bindings // [])
        | (if any(.bindings[]?; .role == $r) then .
            else .bindings += [{role:$r, members:[]}] | .
            end)
        | .bindings = (
            .bindings
            | map(
                if .role != $r then .
                else .members = ((.members // []) | (if index($m) then . else . + [$m] end))
                end
                )
            )
        ' <<<"$GCLOUD_POLICY_JSON" 2>/dev/null || printf '%s' '{}'
    )"
    export GCLOUD_POLICY_JSON

    return 0
}

ensure_project_roles() {
    log INFO "pm-provision-gcp: ensuring operator roles" \
        "user=$GCLOUD_ACTIVE_USER" "project=$DEPLOYMENT_ID"

    local role
    for role in \
        roles/artifactregistry.admin \
        roles/run.admin \
        roles/iam.serviceAccountAdmin \
        roles/iam.serviceAccountUser \
        roles/serviceusage.serviceUsageAdmin \
        roles/secretmanager.admin \
        roles/cloudsql.admin
    do
        ensure_project_role "$role"
    done

    log INFO "pm-provision-gcp: operator roles ready"
}

ensure_service_accounts() {
    pm_gcp_load_deployable_services || return 1
    local service role email

    if [[ -z "${GCLOUD_SERVICE_ACCOUNT_EMAILS:-}" ]]; then
        GCLOUD_SERVICE_ACCOUNT_EMAILS="$(
            gcloud iam service-accounts list \
                --project "$DEPLOYMENT_ID" \
                --format='value(email)' 2>/dev/null || true
        )"
        export GCLOUD_SERVICE_ACCOUNT_EMAILS
    fi

    log INFO "pm-provision-gcp: ensuring runtime service accounts"
    while IFS=$'\t' read -r service role _image _has_build; do
        [[ -n "$service" ]] || continue
        email="$(format_sa_email "$service")"
        ensure_service_account "$email" "${email%@*}" \
            "Portmason ${role} service account for ${STACK}"
    done <<<"$PM_GCP_DEPLOYABLE_SERVICES_TSV"
    log INFO "pm-provision-gcp: runtime service accounts ready"
}

ensure_service_account() {
    local sa_email="$1"
    local sa_name="${2:-"${sa_email%@*}"}"
    local sa_desc="${3:-"Service account for ${sa_name}"}"

    if grep -Fxq "$sa_email" <<< "${GCLOUD_SERVICE_ACCOUNT_EMAILS:-}"; then
        log "Service account exists: ${sa_email}"
        return 0
    fi

    log "Creating service account: ${sa_email}"
    gcloud iam service-accounts create "$sa_name" --description="$sa_desc" >/dev/null
    GCLOUD_SERVICE_ACCOUNT_EMAILS="${GCLOUD_SERVICE_ACCOUNT_EMAILS}"$'\n'"$sa_email"

    return 0
}

ensure_sql() {
    if [[ -z "${CLOUD_SQL_INSTANCE:-}" ]]; then
        log "CLOUD_SQL_INSTANCE is undefined; skipping cloud sql creation"
        return 0
    fi

    local stack
    if [[ -n "${DB_NAME:-}" ]]; then
        . "${PORTMASON_SHARE}/pm-ensure-sqlinstance-gcp"

        if [[ "${CLOUD_SQL_INSTANCE_CREATED_ANEW:-0}" == 1 ]]; then
            log ""
            log "Updating password for root user..."
            gcloud sql users set-password root \
                --instance='${CLOUD_SQL_INSTANCE}' \
                --host="${DB_HOST}" \
                --password="${DB_ROOT_USER}" \
                --quiet
        fi

        if [[ -n "${DB_NAME:-}" ]]; then
            log "Checking if database '${DB_NAME}' already exists..."
            if ! gcloud sql databases describe ${DB_NAME} --instance=${CLOUD_SQL_INSTANCE} >/dev/null 2>&1; then
                log "Creating database '${DB_NAME}' on instance '${CLOUD_SQL_INSTANCE}'..."
                gcloud sql databases create ${DB_NAME} \
                    --instance="${CLOUD_SQL_INSTANCE}" \
                    --charset="${CLOUD_SQL_DB_CHARSET}" \
                    --collation="${CLOUD_SQL_DB_COLLATE}" \
                    --quiet
            fi
        fi

        if [[ -n "${DB_USER:-}" ]]; then
            log "Checking if user '${DB_USER}' already exists..."
            if ! gcloud sql users list --instance="${CLOUD_SQL_INSTANCE}" --format="value(name,host)" | grep -qx "${DB_USER} ${DB_HOST}"; then
                log "Creating user '${DB_USER}' on instance '${CLOUD_SQL_INSTANCE}'..."
                gcloud sql users create ${DB_USER} \
                    --instance="${CLOUD_SQL_INSTANCE}" \
                    --host-"${DB_HOST}" \
                    --quiet
            fi

            log "Updating password for user '${DB_USER}'..."
            gcloud sql users set-password "${DB_USER}" \
                --instance='${CLOUD_SQL_INSTANCE}' \
                --host="${DB_HOST}" \
                --password=NEW_PASSWORD \
                --quiet
        fi
    fi
}

iam_cache_add_binding() {
  local role="${1:?role required}"       # e.g. roles/storage.objectAdmin
  local member="${2:?member required}"   # e.g. user:... serviceAccount:...

  # Ensure cache is at least an object
  if [[ -z "${GCLOUD_POLICY_JSON:-}" ]]; then
    GCLOUD_POLICY_JSON='{}'
  fi

  # Normalize to valid JSON object; if invalid, reset
  if ! jq -e 'type=="object"' >/dev/null 2>&1 <<<"$GCLOUD_POLICY_JSON"; then
    GCLOUD_POLICY_JSON='{}'
  fi

  GCLOUD_POLICY_JSON="$(
    jq -c --arg r "$role" --arg m "$member" '
      .bindings = (.bindings // [])

      # ensure role binding exists
      | (if any(.bindings[]?; .role == $r) then .
         else .bindings += [{role:$r, members:[]}] | .
         end)

      # ensure member exists in that role binding
      | .bindings = (
          .bindings
          | map(
              if .role != $r then .
              else .members = ((.members // []) | (if index($m) then . else . + [$m] end)) | .
              end
            )
        )
    ' <<<"$GCLOUD_POLICY_JSON" 2>/dev/null || printf '%s' '{}'
  )"

  export GCLOUD_POLICY_JSON
}

iam_cache_has_binding() {
  local member="${1:?member required}"   # e.g. user:..., serviceAccount:...
  local role="${2:?role required}"       # e.g. roles/storage.objectAdmin

  jq -e --arg m "$member" --arg r "$role" '
    any(.bindings[]?; .role == $r and any(.members[]?; . == $m))
  ' >/dev/null 2>&1 <<<"${GCLOUD_POLICY_JSON:-{}}"
}

pm_provision_runtime_platform() {
    local missing_command_count=0
    local compose_file
    pm_compose_control_file compose_file

    have gcloud || {
        log "Missing required command: gcloud"
        ((missing_command_count += 1))
    }

    if [[ -f "$compose_file" ]]; then
        have docker || {
            log "Missing required command: docker"
            ((missing_command_count += 1))
        }
    fi

    have jq || {
        log "Missing required command: jq"
        ((missing_command_count += 1))
    }

    if ((missing_command_count > 0)); then
        die "$missing_command_count missing required command(s)"
    fi
 
    export GCLOUD_ACTIVE_USER="$(gcloud auth list --filter=status:ACTIVE --format='value(account)')"

    ensure_project

    ensure_project_roles

    ensure_apis

    if [[ ! -f "$compose_file" ]]; then
        log INFO "GCP project setup complete; no Compose file found" "compose_file=$compose_file"
        return 0
    fi

    ensure_bucket

    ensure_repo

    confirm_and_publish_mgt_scripts_artifact

    ensure_service_accounts

    log DEBUG "pm-provision-gcp: legacy ensure_sql skipped; database lifecycle is coordinated separately"

    bind_permissions

    log "Done."
}


pm_gcp_cloud_sql_instance_name() {
    local out_var="${1:?output variable required}"
    local value="${CLOUD_SQL_INSTANCE:-${STACK:-portmason}-postgres}"
    value="${value,,}"
    value="$(printf '%s' "$value" | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
    [[ "$value" =~ ^[a-z] ]] || value="p-${value}"
    printf -v "$out_var" '%s' "${value:0:63}"
}

pm_gcp_ensure_postgres_instance() {
    local instance="${1:?instance required}"
    local version="${CLOUD_SQL_DATABASE_VERSION:-POSTGRES_16}"
    local tier="${CLOUD_SQL_TIER:-db-f1-micro}"
    local storage="${CLOUD_SQL_STORAGE_GB:-10}"

    log INFO "pm-provision-gcp: checking Cloud SQL PostgreSQL instance" \
        "instance=$instance" "project=$DEPLOYMENT_ID" "region=$REGION"

    if gcloud sql instances describe "$instance" \
        --project "$DEPLOYMENT_ID" >/dev/null 2>&1; then
        log INFO "pm-provision-gcp: Cloud SQL instance already exists" \
            "instance=$instance"
    else
        log INFO "pm-provision-gcp: creating Cloud SQL PostgreSQL instance" \
            "instance=$instance" "version=$version" "tier=$tier" \
            "storage_gb=$storage"
        gcloud sql instances create "$instance" \
            --project "$DEPLOYMENT_ID" \
            --region "$REGION" \
            --database-version "$version" \
            --tier "$tier" \
            --storage-size "$storage" \
            --storage-auto-increase \
            --availability-type "${CLOUD_SQL_AVAILABILITY_TYPE:-zonal}" \
            --backup-start-time "${CLOUD_SQL_BACKUP_START_TIME:-03:00}" \
            --maintenance-window-day "${CLOUD_SQL_MAINTENANCE_DAY:-SUN}" \
            --maintenance-window-hour "${CLOUD_SQL_MAINTENANCE_HOUR:-4}" \
            --quiet
        log INFO "pm-provision-gcp: Cloud SQL instance created" \
            "instance=$instance"
    fi
}

pm_gcp_resolve_cloud_sql_connection() {
    local instance="${1:?instance required}"
    local connection
    connection="$(gcloud sql instances describe "$instance" \
        --project "$DEPLOYMENT_ID" \
        --format='value(connectionName)')"
    [[ -n "$connection" ]] || die "Unable to resolve Cloud SQL connection name for $instance" 2
    env_init_set CLOUD_SQL_CONNECTION_NAME "$connection"
    log INFO "pm-provision-gcp: resolved Cloud SQL connection" \
        "instance=$instance" "connection=$connection"
}

pm_gcp_observability_database_requested() {
    [[ -n "${OBSERVABILITY_DB_NAME:-}" \
        || -n "${OBSERVABILITY_DB_USER:-}" \
        || -n "${OBSERVABILITY_DB_PASSWORD:-}" \
        || -n "${OBSERVABILITY_CLOUD_SQL_INSTANCE:-}" ]]
}

pm_gcp_observability_cloud_sql_instance_name() {
    local out_var="${1:?output variable required}"
    local value="${OBSERVABILITY_CLOUD_SQL_INSTANCE:-${STACK:-portmason}-observability-postgres}"
    value="${value,,}"
    value="$(printf '%s' "$value" | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
    [[ "$value" =~ ^[a-z] ]] || value="p-${value}"
    printf -v "$out_var" '%s' "${value:0:63}"
}

pm_gcp_resolve_observability_cloud_sql_connection() {
    local instance="${1:?instance required}"
    local connection
    connection="$(gcloud sql instances describe "$instance" \
        --project "$DEPLOYMENT_ID" \
        --format='value(connectionName)')"
    [[ -n "$connection" ]] \
        || die "Unable to resolve Cloud SQL connection name for observability instance $instance" 2
    env_init_set OBSERVABILITY_CLOUD_SQL_CONNECTION_NAME "$connection"
    log INFO "pm-provision-gcp: resolved observability Cloud SQL connection" \
        "instance=$instance" "connection=$connection"
}

pm_gcp_provision_observability_database_platform() {
    pm_gcp_observability_database_requested || return 0

    local key hydrated
    for key in OBSERVABILITY_DB_USER OBSERVABILITY_DB_PASSWORD; do
        if { [[ -z "${!key:-}" ]] || pm_secret_value_is_sentinel "${!key}"; } && pm_config_secret_override_exists "$key"; then
            pm_gcp_get_secret_value hydrated "$key" \
                || die "Unable to load observability database secret override: $key" 2
            env_init_set "$key" "$hydrated"
            log INFO "pm-provision-gcp: loaded observability database value from secret override" \
                "key=$key"
        fi
    done

    : "${OBSERVABILITY_DB_NAME:?OBSERVABILITY_DB_NAME required when observability database is configured}"
    : "${OBSERVABILITY_DB_USER:?OBSERVABILITY_DB_USER required when observability database is configured}"
    : "${OBSERVABILITY_DB_PASSWORD:?OBSERVABILITY_DB_PASSWORD required when observability database is configured}"
    : "${DB_ADMIN_USER:?DB_ADMIN_USER required before observability database provisioning}"
    : "${DB_ADMIN_PASSWORD:?DB_ADMIN_PASSWORD required before observability database provisioning}"

    local instance
    pm_gcp_observability_cloud_sql_instance_name instance
    env_init_set OBSERVABILITY_CLOUD_SQL_INSTANCE "$instance"

    pm_gcp_ensure_postgres_instance "$instance"

    log INFO "pm-provision-gcp: ensuring observability PostgreSQL administrative password" \
        "instance=$instance" "user=$DB_ADMIN_USER"
    gcloud sql users set-password "$DB_ADMIN_USER" \
        --project "$DEPLOYMENT_ID" \
        --instance "$instance" \
        --password "$DB_ADMIN_PASSWORD" \
        --quiet >/dev/null

    pm_gcp_resolve_observability_cloud_sql_connection "$instance"
    env_init_set OBSERVABILITY_DB_PORT "${OBSERVABILITY_DB_PORT:-5432}"

    log INFO "pm-provision-gcp: observability database platform provisioning complete" \
        "instance=$OBSERVABILITY_CLOUD_SQL_INSTANCE" \
        "connection=$OBSERVABILITY_CLOUD_SQL_CONNECTION_NAME"
}

pm_provision_db_platform() {
    [[ "${DB_PLATFORM_CODE:-}" == "gcp" ]] \
        || die "pm-provision-gcp database entrypoint requires DB_PLATFORM_CODE=gcp" 2
    [[ "${DB_PROVIDER_CODE:-}" == "postgres" ]] \
        || die "pm-provision-gcp currently supports DB_PROVIDER_CODE=postgres; received ${DB_PROVIDER_CODE:-<unset>}" 2

    have gcloud || die "Missing required command: gcloud" 2
    have jq || die "Missing required command: jq" 2

    export GCLOUD_ACTIVE_USER="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' | head -n 1)"
    [[ -n "$GCLOUD_ACTIVE_USER" ]] || die "No active gcloud account is configured" 2

    log INFO "pm-provision-gcp: starting database platform provisioning" \
        "project=$DEPLOYMENT_ID" "region=$REGION" \
        "provider=$DB_PROVIDER_CODE"

    ensure_project
    ensure_apis

    local key hydrated
    for key in DB_USER DB_PASSWORD; do
        if { [[ -z "${!key:-}" ]] || pm_secret_value_is_sentinel "${!key}"; } && pm_config_secret_override_exists "$key"; then
            pm_gcp_get_secret_value hydrated "$key"                 || die "Unable to load required database secret override: $key" 2
            env_init_set "$key" "$hydrated"
            log INFO "pm-provision-gcp: loaded canonical database value from secret override"                 "key=$key"
        fi
    done

    local instance admin_password
    pm_gcp_cloud_sql_instance_name instance
    env_init_set CLOUD_SQL_INSTANCE "$instance"

    pm_gcp_get_or_create_internal_secret admin_password DB_ADMIN_PASSWORD
    env_init_set DB_ADMIN_USER "${DB_ADMIN_USER:-postgres}"
    env_init_set DB_ADMIN_PASSWORD "$admin_password"

    pm_gcp_ensure_postgres_instance "$instance"

    log INFO "pm-provision-gcp: ensuring PostgreSQL administrative password" \
        "instance=$instance" "user=$DB_ADMIN_USER"
    gcloud sql users set-password "$DB_ADMIN_USER" \
        --project "$DEPLOYMENT_ID" \
        --instance "$instance" \
        --password "$DB_ADMIN_PASSWORD" \
        --quiet >/dev/null

    pm_gcp_resolve_cloud_sql_connection "$instance"
    env_init_set DB_PORT "${DB_PORT:-5432}"

    pm_gcp_provision_observability_database_platform

    log INFO "pm-provision-gcp: database platform provisioning complete" \
        "instance=$CLOUD_SQL_INSTANCE" \
        "connection=$CLOUD_SQL_CONNECTION_NAME"
}

main() {
    pm_provision_runtime_platform "$@"
}

main "$@"


