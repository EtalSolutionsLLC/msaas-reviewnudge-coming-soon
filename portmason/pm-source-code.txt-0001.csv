assert_contains "$manifest_result" "[PM027]" "PM027 rejects incomplete preservation schema"

TGF="${REPO_ROOT}/sops/TGF-v1.12.docx"
[[ -r "$TGF" ]] || fail "TGF v1.12 is missing"
