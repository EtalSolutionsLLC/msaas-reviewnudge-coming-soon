cat > "$project/.env" <<'ENV'
APP_SLUG=reviewnudge
DEPLOY_ENV=prd
RUNTIME_ADAPTER_CODE=bash-env
STACK=reviewnudge-prd
APP_HOST=reviewnudge.example.com
APP_URL=https://reviewnudge.example.com
SITE_URL=https://reviewnudge.example.com
