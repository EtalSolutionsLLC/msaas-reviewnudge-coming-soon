FILE: ./pm-sync-deploy-from-root
================================================================================
#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)"}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

STATE_VERSION="1"
STATE_FILE_NAME=".pm-deploy-sync.state"
MANIFEST_FILE_NAME=".pm-deploy-sync.manifest"
IN_PROGRESS_FILE_NAME=".pm-deploy-sync.in-progress"

# Canonical deployment-sync exclusion policy.
#
# Rules are rsync-compatible globs. A leading slash anchors a rule to the
# repository root. A trailing slash limits a rule to directories; patterns
# without a slash apply to either files or directories. The same list drives
# root copy-forward, manifest traversal, and drift hashing.
readonly -a PM_SYNC_EXCLUDE_PATTERNS=(
  ".git/"
  ".github/"
  "deploy/"
  "logs/"
  "capture/"
  "archive/"
  "/portmason/"
  "tests/"
  "node_modules/"
  "coverage/"
  "security-reports/"
  ".tmp/"
  "/observability/"
  ".artifacts/"
  "__pycache__/"
  ".pm-deploy-sync.*"
  ".project_timestamp"
  ".htaccess"
  "*.env"
  "*.env.example"
  "*.env.generated"
  "config.generated.json"
  "Dockerfile*"
  "*.pyc"
  "*.bak"
  "*:Zone.Identifier"
  ".DS_Store"
  "Thumbs.db"
  "secrets.yaml"
)

usage() {
  cat <<'USAGE'
Usage: pm-sync-deploy-from-root [--prepare|--finalize|--status] [--force]

Safely refresh a deploy/<env> snapshot from the authoritative repository root.

Lifecycle:
  --prepare   Validate deploy drift, refresh from root when safe or required,
              and mark setup in progress. This is the default action.
  --finalize  Record the root and deploy baselines after setup succeeds.
  --status    Report synchronization state without changing files.

Refresh rules:
  - No state file: refresh from root.
  - --force explicitly reconstructs the managed deploy surface from root
    without requiring synchronization state to be deleted first.
  - State exists and deploy matches its baseline: refresh automatically when
    the authoritative root changed.
  - State exists and deploy differs from its baseline: do not copy from root,
    report added, modified, and removed managed paths, and return status 3 so
    pm-setup can continue against the existing environment snapshot.
  - A stale in-progress marker means the previous setup did not finish; refresh
    from root and retry.

Compatibility:
  -o, --overwrite, -f, and --force explicitly authorize a refresh from root.

Environment-local files, generated configuration, logs, staged Portmason files,
and synchronization state are excluded from both copying and drift hashes.
USAGE
}

is_deploy_snapshot_dir() {
  [[ "$(basename -- "$(dirname -- "$PWD")")" == "deploy" ]]
}

log_info() {
  log INFO "$@"
}

log_error() {
  error "$@"
}

detect_repo_root() {
  local env_dir="$PWD"

  if git -C "$env_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$env_dir" rev-parse --show-toplevel
    return 0
  fi

  (cd -- "$env_dir/../.." && pwd -P)
}

state_path() {
  printf '%s/%s\n' "$PWD" "$STATE_FILE_NAME"
}

manifest_path() {
  printf '%s/%s\n' "$PWD" "$MANIFEST_FILE_NAME"
}

in_progress_path() {
  printf '%s/%s\n' "$PWD" "$IN_PROGRESS_FILE_NAME"
}

owner_pid() {
  printf '%s\n' "${PM_DEPLOY_SYNC_OWNER_PID:-$$}"
}

owner_host() {
  if [[ -n "${PM_DEPLOY_SYNC_OWNER_HOST:-}" ]]; then
    printf '%s\n' "$PM_DEPLOY_SYNC_OWNER_HOST"
  else
    hostname 2>/dev/null || printf 'unknown\n'
  fi
}

iso_utc_now() {
  date -u +'%Y-%m-%dT%H:%M:%SZ'
}

ensure_git_local_ignore() {
  local root_dir="$1"
  local exclude_file pattern

  if ! git -C "$root_dir" rev-parse --git-dir >/dev/null 2>&1; then
    return 0
  fi

  exclude_file="$(git -C "$root_dir" rev-parse --git-path info/exclude)"
  if [[ "$exclude_file" != /* ]]; then
    exclude_file="$root_dir/$exclude_file"
  fi
  pattern='/deploy/*/.pm-deploy-sync.*'

  mkdir -p -- "$(dirname -- "$exclude_file")"
  touch -- "$exclude_file"

  if ! grep -Fqx -- "$pattern" "$exclude_file"; then
    {
      printf '\n# Portmason deploy synchronization state (local only).\n'
      printf '%s\n' "$pattern"
    } >> "$exclude_file"
  fi
}

is_excluded_entry() {
  local local_rel="$1"
  local base_name="$2"
  local entry_type="$3"
  local pattern candidate

  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    if [[ "$pattern" == /* ]]; then
      candidate="${pattern#/}"

      if [[ "$local_rel" == $candidate ]]; then
        return 0
      fi

      if [[ "$entry_type" == "directory" && "$local_rel/" == $candidate ]]; then
        return 0
      fi

      continue
    fi

    if [[ "$base_name" == $pattern ]]; then
      return 0
    fi

    if [[ "$entry_type" == "directory" && "$base_name/" == $pattern ]]; then
      return 0
    fi
  done

  return 1
}

build_rsync_args() {
  local -n output_ref="$1"
  local pattern

  output_ref=()
  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    output_ref+=("--exclude=$pattern")
  done
}

build_find_args() {
  local -n output_ref="$1"
  local pattern directory_pattern
  local has_pattern=0

  output_ref=(. -mindepth 1 "(" -type d "(")

  # rsync basename patterns without a slash match files and directories. Prune
  # every matching directory so its descendants cannot enter the manifest.
  # Directory-only rules use a trailing slash, which find does not need.
  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    directory_pattern="${pattern%/}"
    if [[ "$has_pattern" -eq 1 ]]; then
      output_ref+=(-o)
    fi
    if [[ "$pattern" == /* ]]; then
      output_ref+=(-path ".${directory_pattern}")
    else
      output_ref+=(-name "$directory_pattern")
    fi

    has_pattern=1    
  done

  if [[ "$has_pattern" -eq 0 ]]; then
    output_ref=(. -mindepth 1 -print0)
    return 0
  fi

  output_ref+=(")" -prune ")" -o -print0)
}

generate_manifest() {
  local tree_root="$1"
  local output_file="$2"
  local temp_file
  local -a find_args

  if [[ ! -d "$tree_root" ]]; then
    log_error "manifest root does not exist: $tree_root"
    return 1
  fi

  temp_file="$(mktemp "${output_file}.tmp.XXXXXX")"
  build_find_args find_args

  (
    cd -- "$tree_root"

    find "${find_args[@]}" \
    | LC_ALL=C sort -z \
    | while IFS= read -r -d '' entry; do
        local_rel="${entry#./}"
        base_name="$(basename -- "$local_rel")"

        if [[ -L "$entry" ]]; then
          entry_type="link"
        elif [[ -f "$entry" ]]; then
          entry_type="file"
        elif [[ -d "$entry" ]]; then
          entry_type="directory"
        else
          continue
        fi

        if is_excluded_entry "$local_rel" "$base_name" "$entry_type"; then
          continue
        fi

        mode="$(stat -c '%a' -- "$entry")"

        case "$entry_type" in
          link)
            target="$(readlink -- "$entry")"
            digest="$(printf '%s' "$target" | sha256sum | awk '{print $1}')"
            printf '%s\tl\t%s\t%s\n' "$local_rel" "$mode" "$digest"
            ;;
          file)
            digest="$(sha256sum -- "$entry" | awk '{print $1}')"
            printf '%s\tf\t%s\t%s\n' "$local_rel" "$mode" "$digest"
            ;;
          directory)
            printf '%s\td\t%s\t-\n' "$local_rel" "$mode"
            ;;
        esac
      done
  ) > "$temp_file"

  mv -f -- "$temp_file" "$output_file"
}

manifest_hash() {
  sha256sum -- "$1" | awk '{print $1}'
}

read_state_value() {
  local state_file="$1"
  local key="$2"

  awk -F= -v wanted="$key" '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$state_file"
}

write_in_progress_marker() {
  local root_dir="$1"
  local marker temp

  marker="$(in_progress_path)"
  temp="$(mktemp "${marker}.tmp.XXXXXX")"

  {
    printf 'version=%s\n' "$STATE_VERSION"
    printf 'owner_pid=%s\n' "$(owner_pid)"
    printf 'owner_host=%s\n' "$(owner_host)"
    printf 'started_at=%s\n' "$(iso_utc_now)"
    printf 'root_dir=%s\n' "$root_dir"
    printf 'env_dir=%s\n' "$PWD"
  } > "$temp"

  # The marker is fully replaceable local state. Remove any malformed stale
  # path first so a prior interrupted run cannot leave a directory or symlink
  # that prevents the next atomic marker write.
  rm -rf -- "$marker"
  mv -f -- "$temp" "$marker"
}

marker_owner_is_active() {
  local marker pid host current_host

  marker="$(in_progress_path)"
  [[ -f "$marker" ]] || return 1

  pid="$(read_state_value "$marker" owner_pid)"
  host="$(read_state_value "$marker" owner_host)"
  current_host="$(owner_host)"

  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$host" || "$host" == "$current_host" ]] || return 1

  kill -0 "$pid" 2>/dev/null
}

sync_root_to_deploy() {
  local root_dir="$1"
  local env_dir="$PWD"
  local -a excludes

  build_rsync_args excludes

  log_info "Refreshing deploy snapshot from authoritative root"
  log_info "Repo root:  $root_dir"
  log_info "Env folder: $env_dir"

  rsync -a --checksum --delete \
    "${excludes[@]}" \
    "$root_dir/" \
    "$env_dir/"
}

report_manifest_drift() {
  local baseline="$1"
  local current="$2"
  local work_dir added modified removed

  work_dir="$(mktemp -d)"
  added="$work_dir/added"
  modified="$work_dir/modified"
  removed="$work_dir/removed"
  : > "$added"
  : > "$modified"
  : > "$removed"

  awk -F '\t' -v added="$added" -v modified="$modified" -v removed="$removed" '
    NR == FNR {
      old[$1] = $0
      next
    }
    {
      current[$1] = $0
      if (!($1 in old)) {
        print $1 >> added
      } else if (old[$1] != $0) {
        print $1 >> modified
      }
    }
    END {
      for (path in old) {
        if (!(path in current)) {
          print path >> removed
        }
      }
    }
  ' "$baseline" "$current"

  LC_ALL=C sort -o "$added" "$added"
  LC_ALL=C sort -o "$modified" "$modified"
  LC_ALL=C sort -o "$removed" "$removed"

  printf '\nDeployment drift detected in %s.\n' "$PWD" >&2

  if [[ -s "$modified" ]]; then
    printf '\nModified:\n' >&2
    sed 's/^/  /' "$modified" >&2
  fi

  if [[ -s "$added" ]]; then
    printf '\nAdded:\n' >&2
    sed 's/^/  /' "$added" >&2
  fi

  if [[ -s "$removed" ]]; then
    printf '\nRemoved:\n' >&2
    sed 's/^/  /' "$removed" >&2
  fi

  printf '\nRoot synchronization was not performed.\n' >&2
  printf 'pm-setup may continue against the existing deployment snapshot.\n' >&2
  printf 'Reconcile the managed deploy changes, or run pm-setup --refresh-from-root\n' >&2
  printf 'to authorize one explicit reconstruction from the repository root.\n' >&2

  rm -rf -- "$work_dir"
}

prepare_sync() {
  local force_refresh="$1"
  local root_dir state_file baseline_manifest marker_file
  local current_manifest current_deploy_hash baseline_deploy_hash
  local current_root_manifest current_root_hash baseline_root_hash
  local refresh_reason=""

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

  root_dir="$(detect_repo_root)"
  state_file="$(state_path)"
  baseline_manifest="$(manifest_path)"
  marker_file="$(in_progress_path)"

  if [[ ! -d "$root_dir" ]]; then
    log_error "repo root '$root_dir' not found"
    return 1
  fi

  ensure_git_local_ignore "$root_dir"

  if [[ -f "$marker_file" ]] && marker_owner_is_active; then
    log_error "another pm-setup process is already active for '$PWD'"
    return 4
  fi

  if [[ "$force_refresh" -eq 1 ]]; then
    refresh_reason="explicit force/overwrite request"
  elif [[ ! -f "$state_file" ]]; then
    refresh_reason="state file is absent"
  elif [[ -f "$marker_file" ]]; then
    refresh_reason="previous setup did not finalize"
  else
    current_manifest="$(mktemp)"
    generate_manifest "$PWD" "$current_manifest"
    current_deploy_hash="$(manifest_hash "$current_manifest")"
    baseline_deploy_hash="$(read_state_value "$state_file" deploy_hash)"

    if [[ -z "$baseline_deploy_hash" ]]; then
      rm -f -- "$current_manifest"
      log_error "state file is invalid or missing deploy_hash: $state_file"
      return 2
    fi

    if [[ "$current_deploy_hash" != "$baseline_deploy_hash" ]]; then
      if [[ -f "$baseline_manifest" ]]; then
        report_manifest_drift "$baseline_manifest" "$current_manifest"
      else
        log_error "deployment drift detected, but the baseline manifest is missing"
        log_error "run pm-setup --refresh-from-root to reconstruct from root"
      fi
      rm -f -- "$current_manifest"
      return 3
    fi

    rm -f -- "$current_manifest"

    current_root_manifest="$(mktemp)"
    generate_manifest "$root_dir" "$current_root_manifest"
    current_root_hash="$(manifest_hash "$current_root_manifest")"
    baseline_root_hash="$(read_state_value "$state_file" root_hash)"
    rm -f -- "$current_root_manifest"

    if [[ -z "$baseline_root_hash" ]]; then
      log_error "state file is invalid or missing root_hash: $state_file"
      return 2
    fi

    if [[ "$current_root_hash" != "$baseline_root_hash" ]]; then
      refresh_reason="authoritative root changed"
    fi
  fi

  if [[ -n "$refresh_reason" ]]; then
    log_info "Refresh authorized: $refresh_reason"
    sync_root_to_deploy "$root_dir"
  else
    log_info "Deploy snapshot matches its baseline and the authoritative root is unchanged"
  fi

  write_in_progress_marker "$root_dir"
  log_info "Deploy synchronization preflight complete"
}

finalize_sync() {
  local root_dir state_file baseline_manifest marker_file
  local root_manifest deploy_manifest root_hash deploy_hash temp_state

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

  root_dir="$(detect_repo_root)"
  state_file="$(state_path)"
  baseline_manifest="$(manifest_path)"
  marker_file="$(in_progress_path)"

  if [[ ! -f "$marker_file" ]]; then
    log_error "cannot finalize because no in-progress marker exists"
    return 2
  fi

  root_manifest="$(mktemp)"
  deploy_manifest="$(mktemp)"
  generate_manifest "$root_dir" "$root_manifest"
  generate_manifest "$PWD" "$deploy_manifest"
  root_hash="$(manifest_hash "$root_manifest")"
  deploy_hash="$(manifest_hash "$deploy_manifest")"

  temp_state="$(mktemp "${state_file}.tmp.XXXXXX")"
  {
    printf 'version=%s\n' "$STATE_VERSION"
    printf 'root_hash=%s\n' "$root_hash"
    printf 'deploy_hash=%s\n' "$deploy_hash"
    printf 'recorded_at=%s\n' "$(iso_utc_now)"
    printf 'root_dir=%s\n' "$root_dir"
    printf 'env_dir=%s\n' "$PWD"
  } > "$temp_state"

  mv -f -- "$deploy_manifest" "$baseline_manifest"
  mv -f -- "$temp_state" "$state_file"
  rm -f -- "$root_manifest" "$marker_file"

  log_info "Recorded successful deploy baseline"
  log_info "Root hash:   $root_hash"
  log_info "Deploy hash: $deploy_hash"
}

show_status() {
  local state_file baseline_manifest marker_file current_manifest current_hash baseline_hash

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

  state_file="$(state_path)"
  baseline_manifest="$(manifest_path)"
  marker_file="$(in_progress_path)"

  printf 'Environment: %s\n' "$PWD"
  printf 'State:       %s\n' "$([[ -f "$state_file" ]] && echo present || echo absent)"
  printf 'Manifest:    %s\n' "$([[ -f "$baseline_manifest" ]] && echo present || echo absent)"
  printf 'In progress: %s\n' "$([[ -f "$marker_file" ]] && echo yes || echo no)"

  if [[ ! -f "$state_file" ]]; then
    printf 'Action:      next prepare will refresh from root\n'
    return 0
  fi

  current_manifest="$(mktemp)"
  generate_manifest "$PWD" "$current_manifest"
  current_hash="$(manifest_hash "$current_manifest")"
  baseline_hash="$(read_state_value "$state_file" deploy_hash)"

  if [[ "$current_hash" == "$baseline_hash" ]]; then
    printf 'Drift:       none\n'
  else
    printf 'Drift:       detected\n'
    if [[ -f "$baseline_manifest" ]]; then
      report_manifest_drift "$baseline_manifest" "$current_manifest"
    fi
  fi

  rm -f -- "$current_manifest"
}

main() {
  local action="prepare"
  local force_refresh=0
  local arg

  for arg in "$@"; do
    case "$arg" in
      --prepare)
        action="prepare"
        ;;
      --finalize)
        action="finalize"
        ;;
      --status)
        action="status"
        ;;
      -o|--overwrite|-f|--force)
        force_refresh=1
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        log_error "unknown argument: $arg"
        usage >&2
        return 2
        ;;
    esac
  done

  case "$action" in
    prepare)
      prepare_sync "$force_refresh"
      ;;
    finalize)
      if [[ "$force_refresh" -eq 1 ]]; then
        log_error "--force is not valid with --finalize"
        return 2
      fi
      finalize_sync
      ;;
    status)
      if [[ "$force_refresh" -eq 1 ]]; then
        log_error "--force is not valid with --status"
        return 2
      fi
      show_status
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi


================================================================================
FILE: ./pm-sync-observability-deploy-from-root
================================================================================
#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)"}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"
. "${PORTMASON_SHARE}/pm-helpers-observability" "$@"

STATE_VERSION="1"
STATE_FILE_NAME=".pm-deploy-observability-sync.state"
MANIFEST_FILE_NAME=".pm-deploy-observability-sync.manifest"
IN_PROGRESS_FILE_NAME=".pm-deploy-observability-sync.in-progress"

# Canonical observability-deployment-sync exclusion policy.
#
# Rules are rsync-compatible globs. A leading slash anchors a rule to the
# repository root. A trailing slash limits a rule to directories; patterns
# without a slash apply to either files or directories. The same list drives
# root copy-forward, manifest traversal, and drift hashing.
readonly -a PM_SYNC_EXCLUDE_PATTERNS=(
  ".git/"
  ".github/"
  "deploy/"
  "logs/"
  "capture/"
  "archive/"
  "/portmason/"
  "tests/"
  "node_modules/"
  "coverage/"
  "security-reports/"
  ".tmp/"
  ".artifacts/"
  "__pycache__/"
  ".pm-deploy-sync.*"
  ".project_timestamp"
  ".htaccess"
  "*.env"
  "*.env.example"
  "*.env.generated"
  "config.generated.json"
  "/Dockerfile*"
  "*.pyc"
  "*.bak"
  "*:Zone.Identifier"
  ".DS_Store"
  "Thumbs.db"
  "secrets.yaml"
)

readonly -a PM_SYNC_ROOT_FILES=(
  "docker-compose.observability.yml"
)

usage() {
  cat <<'USAGE'
Usage: pm-sync-observability-deploy-from-root [--prepare|--finalize|--status] [--force]

Safely refresh a deploy/<env> snapshot from the authoritative repository root.

Lifecycle:
  --prepare   Validate deploy drift, refresh from root when safe or required,
              and mark setup in progress. This is the default action.
  --finalize  Record the root and deploy baselines after setup succeeds.
  --status    Report synchronization state without changing files.

Refresh rules:
  - No state file: refresh from root.
  - --force explicitly reconstructs the managed deploy surface from root
    without requiring synchronization state to be deleted first.
  - State exists and deploy matches its baseline: refresh automatically when
    the authoritative root changed.
  - State exists and deploy differs from its baseline: do not copy from root,
    report added, modified, and removed managed paths, and return status 3 so
    pm-setup-observability can continue against the existing environment snapshot.
  - A stale in-progress marker means the previous setup did not finish; refresh
    from root and retry.

Compatibility:
  -o, --overwrite, -f, and --force explicitly authorize a refresh from root.

Environment-local files, generated configuration, logs, staged Portmason files,
and synchronization state are excluded from both copying and drift hashes.
USAGE
}

is_deploy_snapshot_dir() {
  [[ "$(basename -- "$(dirname -- "$PWD")")" == "deploy" ]]
}

log_info() {
  log INFO "$@"
}

log_error() {
  error "$@"
}

detect_repo_root() {
  local env_dir="$PWD"

  if git -C "$env_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$env_dir" rev-parse --show-toplevel
    return 0
  fi

  (cd -- "$env_dir/../.." && pwd -P)
}

state_path() {
  printf '%s/%s\n' "$PWD" "$STATE_FILE_NAME"
}

manifest_path() {
  printf '%s/%s\n' "$PWD" "$MANIFEST_FILE_NAME"
}

in_progress_path() {
  printf '%s/%s\n' "$PWD" "$IN_PROGRESS_FILE_NAME"
}

owner_pid() {
  printf '%s\n' "${PM_DEPLOY_SYNC_OWNER_PID:-$$}"
}

owner_host() {
  if [[ -n "${PM_DEPLOY_SYNC_OWNER_HOST:-}" ]]; then
    printf '%s\n' "$PM_DEPLOY_SYNC_OWNER_HOST"
  else
    hostname 2>/dev/null || printf 'unknown\n'
  fi
}

iso_utc_now() {
  date -u +'%Y-%m-%dT%H:%M:%SZ'
}

ensure_git_local_ignore() {
  local observability_dir="$1"
  local exclude_file pattern

  if ! git -C "$observability_dir" rev-parse --git-dir >/dev/null 2>&1; then
    return 0
  fi

  exclude_file="$(git -C "$observability_dir" rev-parse --git-path info/exclude)"
  if [[ "$exclude_file" != /* ]]; then
    exclude_file="$observability_dir/$exclude_file"
  fi
  pattern='/deploy/*/.pm-deploy-sync.*'

  mkdir -p -- "$(dirname -- "$exclude_file")"
  touch -- "$exclude_file"

  if ! grep -Fqx -- "$pattern" "$exclude_file"; then
    {
      printf '\n# Portmason deploy synchronization state (local only).\n'
      printf '%s\n' "$pattern"
    } >> "$exclude_file"
  fi
}

is_excluded_entry() {
  local local_rel="$1"
  local base_name="$2"
  local entry_type="$3"
  local pattern candidate

  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    if [[ "$pattern" == /* ]]; then
      candidate="${pattern#/}"

      if [[ "$local_rel" == $candidate ]]; then
        return 0
      fi

      if [[ "$entry_type" == "directory" && "$local_rel/" == $candidate ]]; then
        return 0
      fi

      continue
    fi

    if [[ "$base_name" == $pattern ]]; then
      return 0
    fi

    if [[ "$entry_type" == "directory" && "$base_name/" == $pattern ]]; then
      return 0
    fi
  done

  return 1
}

build_rsync_args() {
  local -n output_ref="$1"
  local pattern

  output_ref=()
  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    output_ref+=("--exclude=$pattern")
  done
}

build_find_args() {
  local -n output_ref="$1"
  local pattern directory_pattern
  local has_pattern=0

  output_ref=(. -mindepth 1 "(" -type d "(")

  # rsync basename patterns without a slash match files and directories. Prune
  # every matching directory so its descendants cannot enter the manifest.
  # Directory-only rules use a trailing slash, which find does not need.
  for pattern in "${PM_SYNC_EXCLUDE_PATTERNS[@]}"; do
    directory_pattern="${pattern%/}"
    if [[ "$has_pattern" -eq 1 ]]; then
      output_ref+=(-o)
    fi
    if [[ "$pattern" == /* ]]; then
      output_ref+=(-path ".${directory_pattern}")
    else
      output_ref+=(-name "$directory_pattern")
    fi

    has_pattern=1    
  done

  if [[ "$has_pattern" -eq 0 ]]; then
    output_ref=(. -mindepth 1 -print0)
    return 0
  fi

  output_ref+=(")" -prune ")" -o -print0)
}

generate_manifest() {
  local tree_root="$1"
  local output_file="$2"
  local temp_file root_file root_path mode digest
  local -a find_args

  if [[ ! -d "$tree_root" ]]; then
    log_error "manifest root does not exist: $tree_root"
    return 1
  fi

  temp_file="$(mktemp "${output_file}.tmp.XXXXXX")"
  build_find_args find_args

  (
    cd -- "$tree_root"

    find "${find_args[@]}" \
    | LC_ALL=C sort -z \
    | while IFS= read -r -d '' entry; do
        local_rel="${entry#./}"
        base_name="$(basename -- "$local_rel")"

        if [[ -L "$entry" ]]; then
          entry_type="link"
        elif [[ -f "$entry" ]]; then
          entry_type="file"
        elif [[ -d "$entry" ]]; then
          entry_type="directory"
        else
          continue
        fi

        if is_excluded_entry "$local_rel" "$base_name" "$entry_type"; then
          continue
        fi

        mode="$(stat -c '%a' -- "$entry")"

        case "$entry_type" in
          link)
            target="$(readlink -- "$entry")"
            digest="$(printf '%s' "$target" | sha256sum | awk '{print $1}')"
            printf '%s\tl\t%s\t%s\n' "$local_rel" "$mode" "$digest"
            ;;
          file)
            digest="$(sha256sum -- "$entry" | awk '{print $1}')"
            printf '%s\tf\t%s\t%s\n' "$local_rel" "$mode" "$digest"
            ;;
          directory)
            printf '%s\td\t%s\t-\n' "$local_rel" "$mode"
            ;;
        esac
      done
  ) > "$temp_file"

  for root_file in "${PM_SYNC_ROOT_FILES[@]}"; do
    root_path="$(dirname -- "$tree_root")/$root_file"
    [[ -f "$root_path" ]] || continue
    mode="$(stat -c '%a' -- "$root_path")"
    digest="$(sha256sum -- "$root_path" | awk '{print $1}')"
    printf '@root/%s\tf\t%s\t%s\n' "$root_file" "$mode" "$digest" >> "$temp_file"
  done

  mv -f -- "$temp_file" "$output_file"
}

manifest_hash() {
  sha256sum -- "$1" | awk '{print $1}'
}

read_state_value() {
  local state_file="$1"
  local key="$2"

  awk -F= -v wanted="$key" '$1 == wanted { sub(/^[^=]*=/, ""); print; exit }' "$state_file"
}

write_in_progress_marker() {
  local observability_dir="$1"
  local marker temp

  marker="$(in_progress_path)"
  temp="$(mktemp "${marker}.tmp.XXXXXX")"

  {
    printf 'version=%s\n' "$STATE_VERSION"
    printf 'owner_pid=%s\n' "$(owner_pid)"
    printf 'owner_host=%s\n' "$(owner_host)"
    printf 'started_at=%s\n' "$(iso_utc_now)"
    printf 'observability_dir=%s\n' "$observability_dir"
    printf 'env_dir=%s\n' "$PWD"
  } > "$temp"

  # The marker is fully replaceable local state. Remove any malformed stale
  # path first so a prior interrupted run cannot leave a directory or symlink
  # that prevents the next atomic marker write.
  rm -rf -- "$marker"
  mv -f -- "$temp" "$marker"
}

marker_owner_is_active() {
  local marker pid host current_host

  marker="$(in_progress_path)"
  [[ -f "$marker" ]] || return 1

  pid="$(read_state_value "$marker" owner_pid)"
  host="$(read_state_value "$marker" owner_host)"
  current_host="$(owner_host)"

  [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -z "$host" || "$host" == "$current_host" ]] || return 1

  kill -0 "$pid" 2>/dev/null
}

sync_observability_to_deploy() {
  local source_dir="$1"
  local destination_dir="$2"
  local root_file source_root destination_root
  local -a excludes

  [[ -d "$source_dir" ]] || {
    log_error "observability source does not exist: $source_dir"
    return 1
  }

  mkdir -p -- "$destination_dir"
  build_rsync_args excludes

  rsync -a --checksum --delete \
    "${excludes[@]}" \
    "$source_dir/" \
    "$destination_dir/"

  source_root="$(dirname -- "$source_dir")"
  destination_root="$(dirname -- "$destination_dir")"
  for root_file in "${PM_SYNC_ROOT_FILES[@]}"; do
    [[ -r "$source_root/$root_file" ]] \
      || die "managed observability root file is not readable: $source_root/$root_file" 2
    rsync -a --checksum "$source_root/$root_file" "$destination_root/$root_file"
  done
}

report_manifest_drift() {
  local baseline="$1"
  local current="$2"
  local work_dir added modified removed

  work_dir="$(mktemp -d)"
  added="$work_dir/added"
  modified="$work_dir/modified"
  removed="$work_dir/removed"
  : > "$added"
  : > "$modified"
  : > "$removed"

  awk -F '\t' -v added="$added" -v modified="$modified" -v removed="$removed" '
    NR == FNR {
      old[$1] = $0
      next
    }
    {
      current[$1] = $0
      if (!($1 in old)) {
        print $1 >> added
      } else if (old[$1] != $0) {
        print $1 >> modified
      }
    }
    END {
      for (path in old) {
        if (!(path in current)) {
          print path >> removed
        }
      }
    }
  ' "$baseline" "$current"

  LC_ALL=C sort -o "$added" "$added"
  LC_ALL=C sort -o "$modified" "$modified"
  LC_ALL=C sort -o "$removed" "$removed"

  printf '\nDeployment drift detected in %s.\n' "$PWD" >&2

  if [[ -s "$modified" ]]; then
    printf '\nModified:\n' >&2
    sed 's/^/  /' "$modified" >&2
  fi

  if [[ -s "$added" ]]; then
    printf '\nAdded:\n' >&2
    sed 's/^/  /' "$added" >&2
  fi

  if [[ -s "$removed" ]]; then
    printf '\nRemoved:\n' >&2
    sed 's/^/  /' "$removed" >&2
  fi

  printf '\nRoot synchronization was not performed.\n' >&2
  printf 'pm-setup-observability may continue against the existing deployment snapshot.\n' >&2
  printf 'Reconcile the managed deploy changes, or run pm-setup-observability --refresh-from-root\n' >&2
  printf 'to authorize one explicit reconstruction from the repository root.\n' >&2

  rm -rf -- "$work_dir"
}

prepare_sync() {
  local force_refresh="$1"
  local observability_dir state_file baseline_manifest marker_file
  local current_manifest current_deploy_hash baseline_deploy_hash
  local current_root_manifest current_root_hash baseline_root_hash
  local refresh_reason=""

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

local root_dir source_dir destination_dir

root_dir="$(detect_repo_root)"
observability_dir="${root_dir}/observability"
destination_dir="${PWD}/observability"
state_file="$(state_path)"
baseline_manifest="$(manifest_path)"
marker_file="$(in_progress_path)"

[[ -d "$observability_dir" ]] || {
  log_error "observability source not found: $observability_dir"
  return 1
}


  if [[ -f "$marker_file" ]] && marker_owner_is_active; then
    log_error "another pm-setup-observability process is already active for '$PWD'"
    return 4
  fi

  if [[ "$force_refresh" -eq 1 ]]; then
    refresh_reason="explicit force/overwrite request"
  elif [[ ! -f "$state_file" ]]; then
    refresh_reason="state file is absent"
  elif [[ -f "$marker_file" ]]; then
    refresh_reason="previous setup did not finalize"
  else
    current_manifest="$(mktemp)"
    generate_manifest "$destination_dir" "$current_manifest"
    current_deploy_hash="$(manifest_hash "$current_manifest")"
    baseline_deploy_hash="$(read_state_value "$state_file" deploy_hash)"

    if [[ -z "$baseline_deploy_hash" ]]; then
      rm -f -- "$current_manifest"
      log_error "state file is invalid or missing deploy_hash: $state_file"
      return 2
    fi

    if [[ "$current_deploy_hash" != "$baseline_deploy_hash" ]]; then
      if [[ -f "$baseline_manifest" ]]; then
        report_manifest_drift "$baseline_manifest" "$current_manifest"
      else
        log_error "deployment drift detected, but the baseline manifest is missing"
        log_error "run pm-setup-observability --refresh-from-root to reconstruct from root"
      fi
      rm -f -- "$current_manifest"
      return 3
    fi

    rm -f -- "$current_manifest"

    current_root_manifest="$(mktemp)"
    generate_manifest "$observability_dir" "$current_root_manifest"
    current_root_hash="$(manifest_hash "$current_root_manifest")"
    baseline_root_hash="$(read_state_value "$state_file" root_hash)"
    rm -f -- "$current_root_manifest"

    if [[ -z "$baseline_root_hash" ]]; then
      log_error "state file is invalid or missing root_hash: $state_file"
      return 2
    fi

    if [[ "$current_root_hash" != "$baseline_root_hash" ]]; then
      refresh_reason="authoritative root changed"
    fi
  fi

  if [[ -n "$refresh_reason" ]]; then
    log_info "Refresh authorized: $refresh_reason"
    sync_observability_to_deploy "$observability_dir" "$destination_dir"
  else
    log_info "Deploy snapshot matches its baseline and the authoritative root is unchanged"
  fi

  write_in_progress_marker "$observability_dir"
  log_info "Deploy synchronization preflight complete"
}

finalize_sync() {
  local observability_dir state_file baseline_manifest marker_file
  local root_manifest deploy_manifest root_hash deploy_hash temp_state

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

  root_dir="$(detect_repo_root)"
  observability_dir="${root_dir}/observability"
  destination_dir="${PWD}/observability"
  state_file="$(state_path)"
  baseline_manifest="$(manifest_path)"
  marker_file="$(in_progress_path)"

  if [[ ! -f "$marker_file" ]]; then
    log_error "cannot finalize because no in-progress marker exists"
    return 2
  fi

  root_manifest="$(mktemp)"
  deploy_manifest="$(mktemp)"
  generate_manifest "$observability_dir" "$root_manifest"
  generate_manifest "$destination_dir" "$deploy_manifest"
  root_hash="$(manifest_hash "$root_manifest")"
  deploy_hash="$(manifest_hash "$deploy_manifest")"

  temp_state="$(mktemp "${state_file}.tmp.XXXXXX")"
  {
    printf 'version=%s\n' "$STATE_VERSION"
    printf 'root_hash=%s\n' "$root_hash"
    printf 'deploy_hash=%s\n' "$deploy_hash"
    printf 'recorded_at=%s\n' "$(iso_utc_now)"
    printf 'observability_dir=%s\n' "$observability_dir"
    printf 'env_dir=%s\n' "$PWD"
  } > "$temp_state"

  mv -f -- "$deploy_manifest" "$baseline_manifest"
  mv -f -- "$temp_state" "$state_file"
  rm -f -- "$root_manifest" "$marker_file"

  log_info "Recorded successful deploy baseline"
  log_info "Root hash:   $root_hash"
  log_info "Deploy hash: $deploy_hash"
}

show_status() {
  local state_file baseline_manifest marker_file current_manifest current_hash baseline_hash

  if ! is_deploy_snapshot_dir; then
    log_error "must run from deploy/<env>; current directory is '$PWD'"
    return 1
  fi

  root_dir="$(detect_repo_root)"
  observability_dir="${root_dir}/observability"
  destination_dir="${PWD}/observability"
  state_file="$(state_path)"
  baseline_manifest="$(manifest_path)"
  marker_file="$(in_progress_path)"

  printf 'Environment: %s\n' "$destination_dir"
  printf 'State:       %s\n' "$([[ -f "$state_file" ]] && echo present || echo absent)"
  printf 'Manifest:    %s\n' "$([[ -f "$baseline_manifest" ]] && echo present || echo absent)"
  printf 'In progress: %s\n' "$([[ -f "$marker_file" ]] && echo yes || echo no)"

  if [[ ! -f "$state_file" ]]; then
    printf 'Action:      next prepare will refresh from root\n'
    return 0
  fi

  current_manifest="$(mktemp)"
  generate_manifest "$destination_dir" "$current_manifest"
  current_hash="$(manifest_hash "$current_manifest")"
  baseline_hash="$(read_state_value "$state_file" deploy_hash)"

  if [[ "$current_hash" == "$baseline_hash" ]]; then
    printf 'Drift:       none\n'
  else
    printf 'Drift:       detected\n'
    if [[ -f "$baseline_manifest" ]]; then
      report_manifest_drift "$baseline_manifest" "$current_manifest"
    fi
  fi

  rm -f -- "$current_manifest"
}

main() {
  local action="prepare"
  local force_refresh=0
  local arg

  for arg in "$@"; do
    case "$arg" in
      --prepare)
        action="prepare"
        ;;
      --finalize)
        action="finalize"
        ;;
      --status)
        action="status"
        ;;
      -o|--overwrite|-f|--force)
        force_refresh=1
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        log_error "unknown argument: $arg"
        usage >&2
        return 2
        ;;
    esac
  done

  case "$action" in
    prepare)
      prepare_sync "$force_refresh"
      ;;
    finalize)
      if [[ "$force_refresh" -eq 1 ]]; then
        log_error "--force is not valid with --finalize"
        return 2
      fi
      finalize_sync
      ;;
    status)
      if [[ "$force_refresh" -eq 1 ]]; then
        log_error "--force is not valid with --status"
        return 2
      fi
      show_status
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi


