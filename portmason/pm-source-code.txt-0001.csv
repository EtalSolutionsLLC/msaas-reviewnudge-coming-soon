html.pm-dialog-open,
body.pm-dialog-open {
  overflow: hidden;
}

.pm-dialog {
  width: min(32.5rem, calc(100vw - 2rem));
  max-width: none;
  padding: 0;
  border: 0;
  color: #15262b;
  background: transparent;
}

.pm-dialog::backdrop {
  background: rgb(20 35 40 / 58%);
  backdrop-filter: blur(4px);
}

.pm-dialog__frame {
  position: relative;
  overflow: hidden;
  padding: 2.25rem 2rem 1.75rem;
  border: 1px solid #899ca2;
  border-radius: 1.25rem;
  background: linear-gradient(145deg, #f8faf9 0%, #e7eeef 100%);
  box-shadow: 0 1.5rem 4rem rgb(10 27 33 / 34%);
}

.pm-dialog__frame::before {
  position: absolute;
  inset: 0 0 auto;
  height: 0.5rem;
  background: linear-gradient(90deg, #314a52 0%, #b9c5c8 48%, #2d716f 100%);
  content: '';
}

.pm-dialog__kicker {
  margin: 0 0 0.75rem;
  color: #397574;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.pm-dialog__message {
  margin: 0;
  color: #15262b;
  font: inherit;
  font-size: clamp(1.08rem, 2.7vw, 1.32rem);
  font-weight: 700;
  line-height: 1.45;
}

.pm-dialog__actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  margin-top: 1.75rem;
}

.pm-dialog__button {
  min-height: 2.75rem;
  padding: 0.65rem 1.1rem;
  border: 1px solid #61767d;
  border-radius: 0.7rem;
  font: inherit;
  font-weight: 750;
  cursor: pointer;
}

.pm-dialog__button--cancel {
  color: #283c42;
  background: #f7f9f8;
}

.pm-dialog__button--confirm {
  border-color: #245c5a;
  color: #fff;
  background: linear-gradient(145deg, #397b78, #285f5d);
}

.pm-dialog[data-tone='danger'] .pm-dialog__button--confirm {
  border-color: #853c3c;
  background: linear-gradient(145deg, #aa5353, #873c3c);
}

.pm-dialog__button:hover {
  filter: brightness(0.96);
}

.pm-dialog__button:focus-visible {
  outline: 3px solid rgb(43 113 111 / 35%);
  outline-offset: 3px;
}

@media (max-width: 34rem) {
  .pm-dialog__frame {
    padding: 2rem 1.25rem 1.25rem;
  }

  .pm-dialog__actions {
    flex-direction: column-reverse;
  }

  .pm-dialog__button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pm-dialog::backdrop {
    backdrop-filter: none;
  }
}


