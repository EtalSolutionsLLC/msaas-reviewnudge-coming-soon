    }

    const action = event.target.closest?.('[data-pm-consent-action]')?.dataset.pmConsentAction;
    if (action === 'accept') saveConsent(ANALYTICS_GRANTED);
    if (action === 'reject') saveConsent(ANALYTICS_DENIED);
