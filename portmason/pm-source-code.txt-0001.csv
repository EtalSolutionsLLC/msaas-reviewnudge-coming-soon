load_runtime_helper() {
  local runtime_adapter_effective="${RUNTIME_ADAPTER_CODE:--}"
  : "${RUNTIME_CODE:=${runtime_adapter_effective%%-*}}"

  if [[ "$RUNTIME_CODE" == *+* ]]; then
    : "${FRONT_END_CODE:="${RUNTIME_CODE%%+*}"}"  # everything before first +
    : "${BACK_END_CODE:="${RUNTIME_CODE#*+}"}"    # everything after first +
  else
    : "${FRONT_END_CODE:=}"
    : "${BACK_END_CODE:=}"
  fi

  local file="${PORTMASON_SHARE}/pm-helpers-${RUNTIME_CODE}"
  # shellcheck disable=SC1090
  [[ -f "$file" ]] && . "$file" "$@"

  if [[ -n "${FRONT_END_CODE:-}" ]]; then
    file="${PORTMASON_SHARE}/pm-helpers-${FRONT_END_CODE}"
    # shellcheck disable=SC1090
    [[ -f "$file" ]] && . "$file" "$@"
  fi

  if [[ -n "${BACK_END_CODE:-}" ]]; then
    file="${PORTMASON_SHARE}/pm-helpers-${BACK_END_CODE}"
    # shellcheck disable=SC1090
    [[ -f "$file" ]] && . "$file" "$@"
  fi

  return 0
}

