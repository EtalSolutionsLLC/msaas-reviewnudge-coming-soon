        printf 'FAIL: application service is missing MONITORING_FAILURE_EVENT_HTTP_TIMEOUT_MS\n' >&2
        exit 1
    }
done

printf 'PASS: Better Stack heartbeats and runtime-neutral failure events are scoped correctly\n'


