FILE: ./pm-util-render-env
================================================================================
#!/usr/bin/env python3
import os
import re
import sys
import json
import fnmatch
import subprocess
from pathlib import Path

USAGE = """pm-util-render-env [--dotenv|--json] [--keys KEY[,KEY...]] [--print-exports] [--out FILE] [FILE|-]

Renders environment-style expansions in text:
  ${VAR}
  ${VAR:-default}   default if VAR unset OR empty
  ${VAR-default}    default if VAR unset only
  ${VAR:=default}   default if VAR unset OR empty AND records an assignment
  $VAR              simple expansion (VAR must be [A-Za-z_][A-Za-z0-9_]*)

Options:
  --dotenv          Treat input as a .env file: parse KEY=VALUE lines top-to-bottom,
                    updating an internal environment map so later lines can reference
                    earlier assignments in the same file.
  --json            Treat input as a .env file and emit a public-safe JSON object.
                    Secret-bearing keys are excluded by default.
  --keys KEYS       With --json, emit only these comma/space-separated keys.
  --print-exports   Print export statements for := assignments to STDERR.
  --out FILE        Write rendered output to FILE instead of STDOUT.
                    (Diagnostics still go to STDERR.)

Notes:
- This utility cannot modify the parent shell's environment.
- With --print-exports, assignments from := are printed as export statements to STDERR.
"""

# Matches ${VAR}, ${VAR:-default}, ${VAR-default}, ${VAR:=default}
PAT_BRACED = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?:(:-|:=|-)(.*?))?\}")

# Matches $VAR (but not \$VAR); does not match $1, $$, $- etc.
PAT_DOLLAR = re.compile(r"(?<!\\)\$([A-Za-z_][A-Za-z0-9_]*)")

# .env assignment lines (supports optional leading "export ")
ENV_LINE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$")

PUBLIC_JSON_EXCLUDE_GLOBS = (
    "*_TOKEN",
    "*_SECRET",
    "*_KEY",
    "*_PASSWORD",
    "SECRET_PATHS",
    "ENV_FILE",
    "DEBUG",
    "VERBOSE",
    "PM_ENTRY_SCRIPT",
    "PATH",
    "HOME",
    "PWD",
    "OLDPWD",
    "SHELL",
    "SHLVL",
    "USER",
    "LOGNAME",
    "LANG",
    "LANGUAGE",
    "LC_*",
    "TERM",
    "XDG_*",
    "PORT",
)


def _is_public_json_key(key: str) -> bool:
    return not any(fnmatch.fnmatchcase(key, pat) for pat in PUBLIC_JSON_EXCLUDE_GLOBS)


def _strip_inline_comment(value: str) -> str:
    # Remove unquoted comments. This is intentionally conservative and only
    # treats # as a comment when it is outside quotes and preceded by whitespace.
    in_single = False
    in_double = False
    escaped = False

    for i, ch in enumerate(value):
        if escaped:
            escaped = False
            continue

        if ch == "\\" and in_double:
            escaped = True
            continue

        if ch == "'" and not in_double:
            in_single = not in_single
            continue

        if ch == '"' and not in_single:
            in_double = not in_double
            continue

        if (
            ch == "#"
            and not in_single
            and not in_double
            and (i == 0 or value[i - 1].isspace())
        ):
            return value[:i].rstrip()

    return value.rstrip()


def shell_quote(value: str) -> str:
    # single-quote safe for bash: ' -> '"'"'
    return "'" + value.replace("'", "'\"'\"'") + "'"


def _strip_outer_quotes(s: str) -> str:
    s = s.strip()

    if len(s) >= 2 and (
        (s[0] == s[-1] == '"')
        or (s[0] == s[-1] == "'")
    ):
        return s[1:-1]

    return s


def render_text(
    text: str,
    env: dict[str, str],
    assignments: dict[str, str],
) -> str:
    """
    Render Bash-like environment expansions using 'env'.

    Supported forms:
      ${VAR}
      ${VAR:-default}
      ${VAR-default}
      ${VAR:=default}
      ${VAR:+alternate}
      $VAR

    Defaults/alternates may themselves contain expansions, including nested
    ${...}. Command substitution is intentionally not evaluated.

    Rendering is repeated until the value converges, up to eight passes.
    This is important when one expansion reveals another expansion.
    """

    def find_matching_brace(src: str, open_index: int) -> int:
        depth = 1
        i = open_index + 1

        while i < len(src):
            if (
                src[i] == "$"
                and i + 1 < len(src)
                and src[i + 1] == "{"
            ):
                depth += 1
                i += 2
                continue

            if src[i] == "}":
                depth -= 1
                if depth == 0:
                    return i

            i += 1

        return -1

    def expand_expr(expr: str) -> str:
        m = re.match(
            r"^([A-Za-z_][A-Za-z0-9_]*)(.*)$",
            expr,
            re.DOTALL,
        )

        if not m:
            return "${" + expr + "}"

        key = m.group(1)
        rest = m.group(2)
        val = env.get(key)

        if rest == "":
            return "" if val is None else val

        op = None
        default = ""

        for candidate in (":-", ":=", ":+", "-"):
            if rest.startswith(candidate):
                op = candidate
                default = rest[len(candidate):]
                break

        if op is None:
            return "${" + expr + "}"

        if op == ":-":
            if val is None or val == "":
                return render_text(default, env, assignments)
            return val

        if op == "-":
            if val is None:
                return render_text(default, env, assignments)
            return val

        if op == ":=":
            if val is None or val == "":
                assigned = render_text(
                    default,
                    env,
                    assignments,
                )
                env[key] = assigned
                assignments[key] = assigned
                return assigned

            return val

        if op == ":+":
            if val is not None and val != "":
                return render_text(
                    default,
                    env,
                    assignments,
                )

            return ""

        return "${" + expr + "}"

    def repl_dollar(m: re.Match) -> str:
        key = m.group(1)
        val = env.get(key)
        return "" if val is None else val

    def render_once(src: str) -> str:
        out_parts: list[str] = []
        i = 0

        while i < len(src):
            if (
                src[i] == "$"
                and i + 1 < len(src)
                and src[i + 1] == "{"
                and (i == 0 or src[i - 1] != "\\")
            ):
                close = find_matching_brace(src, i + 1)

                if close == -1:
                    out_parts.append(src[i])
                    i += 1
                    continue

                out_parts.append(
                    expand_expr(src[i + 2:close])
                )
                i = close + 1
                continue

            out_parts.append(src[i])
            i += 1

        return PAT_DOLLAR.sub(
            repl_dollar,
            "".join(out_parts),
        )

    # Expand repeatedly until stable.
    #
    # Example:
    #
    #   APP_URL -> https://${APP_HOST}
    #
    # The first pass resolves APP_URL and exposes ${APP_HOST}. The second pass
    # resolves APP_HOST. This occurs within this invocation rather than
    # requiring another pm-setup execution.
    out = text

    for _ in range(8):
        rendered = render_once(out)

        if rendered == out:
            return rendered

        out = rendered

    return out


def render_dotenv(
    text: str,
    base_env: dict[str, str],
    print_exports: bool,
) -> str:
    env = dict(base_env)
    assignments: dict[str, str] = {}

    out_lines: list[str] = []

    for raw_line in text.splitlines(keepends=True):
        m = ENV_LINE.match(raw_line)

        if not m:
            out_lines.append(
                render_text(
                    raw_line,
                    env,
                    assignments,
                )
            )
            continue

        key = m.group(1)
        rhs = m.group(2)

        rendered_rhs = render_text(
            _strip_inline_comment(rhs),
            env,
            assignments,
        )

        new_line = f"{key}={rendered_rhs}"

        if raw_line.endswith("\n") and not new_line.endswith("\n"):
            new_line += "\n"

        out_lines.append(new_line)

        # Update env for later lines.
        env[key] = _strip_outer_quotes(rendered_rhs)

    if print_exports and assignments:
        for k, v in assignments.items():
            sys.stderr.write(
                f"export {k}={shell_quote(v)}\n"
            )

    return "".join(out_lines)


def _parse_key_allowlist(
    raw: str | None,
) -> set[str] | None:
    if raw is None:
        return None

    keys = {
        part
        for part in re.split(r"[\s,]+", raw.strip())
        if part
    }

    return keys


def render_dotenv_map(
    text: str,
    base_env: dict[str, str],
    print_exports: bool,
    only_keys: set[str] | None = None,
) -> dict[str, str]:
    env = dict(base_env)
    assignments: dict[str, str] = {}
    out: dict[str, str] = {}
    in_array_key: str | None = None

    for raw_line in text.splitlines():
        stripped = raw_line.strip()

        # Skip multiline Bash arrays entirely. They are operator-side config,
        # not public browser config.
        if in_array_key is not None:
            if stripped == ")":
                in_array_key = None
            continue

        if not stripped or stripped.startswith("#"):
            continue

        m = ENV_LINE.match(raw_line)

        if not m:
            continue

        key = m.group(1)
        rhs = m.group(2).strip()

        if rhs == "(":
            in_array_key = key
            continue

        rendered_rhs = render_text(
            _strip_inline_comment(rhs),
            env,
            assignments,
        )

        value = _strip_outer_quotes(rendered_rhs)
        env[key] = value

        if only_keys is not None:
            if key in only_keys:
                out[key] = value
        elif _is_public_json_key(key):
            out[key] = value

    if print_exports and assignments:
        for k, v in assignments.items():
            sys.stderr.write(
                f"export {k}={shell_quote(v)}\n"
            )

    return out


def render_generic(
    text: str,
    print_exports: bool,
) -> str:
    assignments: dict[str, str] = {}
    env = dict(os.environ)

    out = render_text(
        text,
        env,
        assignments,
    )

    if print_exports and assignments:
        for k, v in assignments.items():
            sys.stderr.write(
                f"export {k}={shell_quote(v)}\n"
            )

    return out


def _parse_args(argv: list[str]):
    dotenv_mode = False
    json_mode = False
    print_exports = False
    out_path: str | None = None
    only_keys_raw: str | None = None

    args = argv[1:]

    if not args or args[0] in ("-h", "--help"):
        return (
            None,
            None,
            None,
            None,
            None,
            None,
            2,
        )

    i = 0

    while i < len(args):
        a = args[i]

        if a == "--dotenv":
            dotenv_mode = True
            i += 1
            continue

        if a == "--json":
            json_mode = True
            dotenv_mode = True
            i += 1
            continue

        if a == "--print-exports":
            print_exports = True
            i += 1
            continue

        if a == "--keys":
            if i + 1 >= len(args):
                sys.stderr.write(
                    "ERROR: --keys requires a comma/space-separated key list\n"
                )
                sys.stderr.write(USAGE)

                return (
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    2,
                )

            only_keys_raw = args[i + 1]
            i += 2
            continue

        if a.startswith("--keys="):
            only_keys_raw = a.split("=", 1)[1]

            if not only_keys_raw.strip():
                sys.stderr.write(
                    "ERROR: --keys requires a comma/space-separated key list\n"
                )
                sys.stderr.write(USAGE)

                return (
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    2,
                )

            i += 1
            continue

        if a == "--out":
            if i + 1 >= len(args):
                sys.stderr.write(
                    "ERROR: --out requires a filename\n"
                )
                sys.stderr.write(USAGE)

                return (
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    2,
                )

            out_path = args[i + 1]
            i += 2
            continue

        if a.startswith("--out="):
            out_path = a.split("=", 1)[1]

            if not out_path:
                sys.stderr.write(
                    "ERROR: --out requires a filename\n"
                )
                sys.stderr.write(USAGE)

                return (
                    None,
                    None,
                    None,
                    None,
                    None,
                    None,
                    2,
                )

            i += 1
            continue

        if a in ("-h", "--help"):
            sys.stderr.write(USAGE)

            return (
                None,
                None,
                None,
                None,
                None,
                None,
                2,
            )

        src = a
        rest = args[i + 1:]

        if rest:
            sys.stderr.write(
                "ERROR: unexpected extra arguments\n"
            )
            sys.stderr.write(USAGE)

            return (
                None,
                None,
                None,
                None,
                None,
                None,
                2,
            )

        return (
            dotenv_mode,
            json_mode,
            print_exports,
            out_path,
            src,
            only_keys_raw,
            0,
        )

    sys.stderr.write(USAGE)

    return (
        None,
        None,
        None,
        None,
        None,
        None,
        2,
    )

def sops_decrypt_file(filename):
    try:
        result = subprocess.run(
            ["sops", "-d", filename],
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout

    except (subprocess.CalledProcessError, OSError):
        raise RuntimeError("Unable to decrypt configuration file") from None

def main(argv: list[str]) -> int:
    (
        dotenv_mode,
        json_mode,
        print_exports,
        out_path,
        src,
        only_keys_raw,
        code,
    ) = _parse_args(argv)

    if code != 0:
        return code

    assert src is not None
    assert dotenv_mode is not None
    assert json_mode is not None
    assert print_exports is not None

    try:
        if src == "-":
            text = sops_decrypt_file(sys.stdin)
        else:
            text = sops_decrypt_file(src)
    except Exception as e:
        sys.stderr.write(
            f"ERROR: failed to read/decrypt {src!r}: {e}\n"
        )
        return 1

    try:
        if json_mode:
            rendered = (
                json.dumps(
                    render_dotenv_map(
                        text,
                        dict(os.environ),
                        print_exports,
                        _parse_key_allowlist(
                            only_keys_raw
                        ),
                    ),
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            )

        elif dotenv_mode:
            rendered = render_dotenv(
                text,
                dict(os.environ),
                print_exports,
            )

        else:
            rendered = render_generic(
                text,
                print_exports,
            )

    except Exception as e:
        sys.stderr.write(
            f"ERROR: render failed: {e}\n"
        )
        return 1

    try:
        if out_path:
            env_file = os.environ.get("ENV_FILE")

            import subprocess

            subprocess.run(
                ["sops", "--encrypt", "/dev/stdin"],
                input=rendered,
                text=True,
                stdout=open(out_path, "w"),
                check=True,
            )
        else:
             sys.stdout.write(rendered)

    except Exception as e:
        target = (
            out_path
            if out_path
            else "<stdout>"
        )

        sys.stderr.write(
            f"ERROR: failed to write output to {target!r}: {e}\n"
        )

        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))


