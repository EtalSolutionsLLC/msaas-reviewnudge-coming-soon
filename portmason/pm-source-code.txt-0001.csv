#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
: "${PORTMASON_SHARE:=$SCRIPT_DIR}"
export PORTMASON_SHARE

# shellcheck disable=SC1091
. "${PORTMASON_SHARE}/pm-helpers" --read-only
# shellcheck disable=SC1091
. "${PORTMASON_SHARE}/pm-helpers-lint"

pm_lint_usage() {
    cat <<'USAGE'
Usage:
  pm-lint [--changed [BASE_REF] | --all] [options] [PATH ...]
  pm-lint --list-rules

Modes:
  --changed [BASE_REF]   Lint changed, staged, and untracked files. When a base
                         ref is supplied, include committed changes since it.
                         This is the default when no paths are supplied.
  --all                  Lint all tracked and unignored files.
  PATH ...               Lint only the supplied files or directories.

Options:
  --root PATH            Repository root. Defaults to the current Git root or PWD.
  --format FORMAT        text, github, or json. Default: text.
  --strict               Treat warnings as failures.
  --fail-on-review       Treat review findings as failures.
  --rule PM###           Run one rule only.
  --exceptions PATH      Override .pm-lint-exceptions location.
  --rules PATH           Load an additional custom rule directory (repeatable).
  --list-rules           Print the rule catalog and exit.
  -h, --help             Show this help.

Exit codes:
  0  No blocking findings.
  2  One or more errors, strict warnings, or requested review failures.
USAGE
}

pm_lint_default_root() {
    local out_var="${1:?output variable required}"
    local resolved_root=""
    resolved_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    printf -v "$out_var" '%s' "$resolved_root"
}

main() {
    local root=""
    local list_rules=false
    local explicit_mode=false
    local changed_base=""
    local -a paths=()

    pm_lint_default_root root

    while (( $# > 0 )); do
        case "$1" in
            --root)
                [[ $# -ge 2 ]] || die "pm-lint: --root requires a path" 2
                root="$2"
                shift 2
                ;;
            --format)
                [[ $# -ge 2 ]] || die "pm-lint: --format requires a value" 2
                PM_LINT_FORMAT="$2"
                shift 2
                ;;
            --strict)
                PM_LINT_STRICT=true
                shift
                ;;
            --fail-on-review)
                PM_LINT_FAIL_ON_REVIEW=true
                shift
                ;;
            --rule)
                [[ $# -ge 2 ]] || die "pm-lint: --rule requires PM###" 2
                PM_LINT_SELECTED_RULE="$2"
                shift 2
                ;;
            --exceptions)
                [[ $# -ge 2 ]] || die "pm-lint: --exceptions requires a path" 2
                PM_LINT_EXCEPTION_FILE="$2"
                shift 2
                ;;
            --rules)
                [[ $# -ge 2 ]] || die "pm-lint: --rules requires a directory" 2
                PM_LINT_EXTRA_RULE_DIRS+=("$2")
                shift 2
                ;;
            --all)
                PM_LINT_MODE=all
                explicit_mode=true
                shift
                ;;
            --changed)
                PM_LINT_MODE=changed
                explicit_mode=true
                shift
                if (( $# > 0 )) && [[ "$1" != -* ]] && git rev-parse --verify "$1^{commit}" >/dev/null 2>&1; then
                    changed_base="$1"
                    shift
                fi
                ;;
            --list-rules)
                list_rules=true
                shift
                ;;
            -h|--help)
                pm_lint_usage
                return 0
                ;;
            --)
                shift
                paths+=("$@")
                break
                ;;
            -*)
                die "pm-lint: unknown option: $1" 2
                ;;
            *)
                paths+=("$1")
                shift
                ;;
        esac
    done

    case "$PM_LINT_FORMAT" in
        text|github|json) ;;
        *) die "pm-lint: --format must be text, github, or json" 2 ;;
    esac
    [[ -z "$PM_LINT_SELECTED_RULE" || "$PM_LINT_SELECTED_RULE" =~ ^PM[0-9]{3}$ ]] \
        || die "pm-lint: --rule must use PM###" 2

    pm_lint_normalize_root "$root"
    pm_lint_load_rules

    if [[ "$list_rules" == true ]]; then
        pm_lint_list_rules
        return 0
    fi
    if [[ -n "$PM_LINT_SELECTED_RULE" && -z "${PM_LINT_RULE_FUNCTION[$PM_LINT_SELECTED_RULE]+x}" ]]; then
        die "pm-lint: unknown rule: $PM_LINT_SELECTED_RULE" 2
    fi

    pm_lint_reset_results
    pm_lint_load_exceptions

    if (( ${#paths[@]} > 0 )); then
        PM_LINT_TARGET_FILES=()
        local path
        for path in "${paths[@]}"; do
            pm_lint_collect_path "$path"
        done
        pm_lint_unique_targets
    elif [[ "$PM_LINT_MODE" == all ]]; then
        pm_lint_collect_all
    else
        pm_lint_collect_changed "$changed_base"
    fi

    log INFO "pm-lint: running EPC/TGF checks" \
        "root=$PM_LINT_ROOT" \
        "mode=$PM_LINT_MODE" \
        "files=${#PM_LINT_TARGET_FILES[@]}" \
        "format=$PM_LINT_FORMAT"

    pm_lint_run_rules
    pm_lint_output_results
    pm_lint_exit_code
}

main "$@"


================================================================================
FILE: ./pm-lint-ci
================================================================================
#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
: "${PORTMASON_SHARE:=$SCRIPT_DIR}"
export PORTMASON_SHARE

# shellcheck disable=SC1091
. "${PORTMASON_SHARE}/pm-helpers" --read-only

pm_lint_ci_base_ref() {
    local out_var="${1:?output variable required}"
    local value="${PM_LINT_BASE_REF:-}"

    if [[ -z "$value" && -n "${GITHUB_BASE_REF:-}" ]]; then
        value="origin/${GITHUB_BASE_REF}"
    fi
    if [[ -z "$value" && -n "${GITHUB_EVENT_BEFORE:-}" \
        && ! "$GITHUB_EVENT_BEFORE" =~ ^0+$ ]]; then
        value="$GITHUB_EVENT_BEFORE"
    fi
    if [[ -z "$value" ]] && git rev-parse --verify HEAD^ >/dev/null 2>&1; then
        value="HEAD^"
    fi
    printf -v "$out_var" '%s' "$value"
}

main() {
    local root="${PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)}"
    local base_ref=""
    local -a args=(--root "$root" --changed --format github)

    pm_lint_ci_base_ref base_ref
    [[ -n "$base_ref" ]] && args+=("$base_ref")
    [[ "${PM_LINT_CI_STRICT:-false}" == true ]] && args+=(--strict)
    [[ "${PM_LINT_CI_FAIL_ON_REVIEW:-false}" == true ]] && args+=(--fail-on-review)

    if command -v shellcheck >/dev/null 2>&1; then
        log INFO "pm-lint-ci: ShellCheck is available"
    elif [[ "${PM_LINT_REQUIRE_SHELLCHECK:-true}" == true ]]; then
        die "pm-lint-ci: ShellCheck is required but not installed" 2
    else
        warn "pm-lint-ci: ShellCheck is unavailable; PM020 will be skipped"
    fi

    exec "${PORTMASON_SHARE}/pm-lint" "${args[@]}"
}

main "$@"


================================================================================
FILE: ./pm-log
================================================================================
#!/usr/bin/env bash
set -euo pipefail

pm_log_value_is_true() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|y|Y|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

pm_log_detect_adapter() {
    local output_var="${1:?output variable required}"
    local adapter="local"
    local override="${PM_LOG_ADAPTER_OVERRIDE:-}"

    override="${override,,}"
    case "$override" in
        local|ci|github-actions|aws|azure|gcp|kubernetes|container)
            adapter="$override"
            ;;
        "")
            if pm_log_value_is_true "${GITHUB_ACTIONS:-}"; then
                adapter="github-actions"
            elif [[ -n "${K_SERVICE:-}" \
                || -n "${K_REVISION:-}" \
                || -n "${K_CONFIGURATION:-}" \
                || -n "${CLOUD_RUN_JOB:-}" \
                || -n "${CLOUD_RUN_EXECUTION:-}" \
                || -n "${GAE_SERVICE:-}" ]]; then
                adapter="gcp"
            elif [[ -n "${AWS_EXECUTION_ENV:-}" \
                || -n "${AWS_LAMBDA_FUNCTION_NAME:-}" \
                || -n "${AWS_LAMBDA_RUNTIME_API:-}" \
                || -n "${ECS_CONTAINER_METADATA_URI:-}" \
                || -n "${ECS_CONTAINER_METADATA_URI_V4:-}" \
                || -n "${AWS_BATCH_JOB_ID:-}" ]]; then
                adapter="aws"
            elif [[ -n "${WEBSITE_INSTANCE_ID:-}" \
                || -n "${WEBSITE_SITE_NAME:-}" \
                || -n "${CONTAINER_APP_NAME:-}" \
                || -n "${CONTAINER_APP_REVISION:-}" \
                || -n "${FUNCTIONS_WORKER_RUNTIME:-}" ]]; then
                adapter="azure"
            elif [[ -n "${KUBERNETES_SERVICE_HOST:-}" ]]; then
                adapter="kubernetes"
            elif pm_log_value_is_true "${CI:-}" \
                || pm_log_value_is_true "${GITLAB_CI:-}" \
                || pm_log_value_is_true "${TF_BUILD:-}" \
                || [[ -n "${BUILDKITE:-}" \
                    || -n "${CIRCLECI:-}" \
                    || -n "${JENKINS_URL:-}" \
                    || -n "${TEAMCITY_VERSION:-}" \
                    || -n "${BITBUCKET_BUILD_NUMBER:-}" \
                    || -n "${CODEBUILD_BUILD_ID:-}" ]]; then
                adapter="ci"
            fi
            ;;
        *)
            # Logging setup is best-effort. An invalid operator override must
            # never prevent the application from starting.
            adapter="local"
            ;;
    esac

    printf -v "$output_var" '%s' "$adapter"
}

pm_log_adapter_uses_platform_sink() {
    case "${1:-local}" in
        ci|github-actions|aws|azure|gcp|kubernetes|container) return 0 ;;
        *) return 1 ;;
    esac
}

pm_log_adapter_prefers_json() {
    case "${1:-local}" in
        aws|azure|gcp|kubernetes) return 0 ;;
        *) return 1 ;;
    esac
}

setup_logging() {
    # Safe adapter-friendly logging setup.
    #
    # Goals:
    # - Never require sudo.
    # - Never break if log dir/file canâ€™t be created/opened.
    # - Only redirect stdout/stderr to a file if we successfully opened the file.
    # - Use the platform collector in CI, managed cloud, and container adapters.
    # - If archiving occurs, ALWAYS truncate current log afterwards (fresh session file).
    #
    # Knobs:
    #   PM_NO_REDIRECT=1        -> never redirect (always leave stdout/stderr unchanged)
    #   PM_FORCE_REDIRECT=1     -> force a file even when a platform collector is detected
    #   PM_LOG_LOCAL_TEE=0      -> local file-only compatibility mode
    #   PM_LOG_ADAPTER_OVERRIDE -> local, ci, github-actions, aws, azure, gcp,
    #                              kubernetes, or container
    #   LOG_DIR=/path           -> preferred log dir
    #   LOG_FILE_CONFIGURE=/p   -> explicit log file path
    #   LOG_TRUNCATE=1          -> truncate LOG_FILE at start (even if no archive)
    #
    # Exports:
    #   LOG_DIR, LOG_FILE, PM_LOG_ADAPTER, PM_LOG_SINK,
    #   __HAS_TTY_BEFORE_REDIRECT, IN_CONTAINER
    #
    # Notes:
    # - This function must never hard-fail. It always returns 0.
    #
    # Functions:
    # log [<severity: INFO, WARN, etc. (defaults to INFO)>] <message> -> logs message based on log level
    # ok <message>                                            -> calls log() then returns code 0
    # bail [<message>] [<return code (defaults to 1)>]        -> logs an optional error and returns/exits
    # die [<message>] [<return code (defaults to 1)>]         -> logs CRITICAL and returns/exits
    # warn <message>                                          -> calls log() with severity WARN
    # error <message>                                         -> calls log() with severity ERROR
    # fatal [<message>] [<return code (defaults to 1)>]       -> logs CRITICAL and exits
    # fatal_error <message> [<return code (defaults to 1)>]   -> calls error() then exits with return code

    # ---- small internal helpers (must not depend on your log()/warn()) ----
    _sl_stderr() { printf '%s\n' "$*" >&2 || true; }
    _sl_can_write_dir() { [[ -d "$1" && -w "$1" ]]; }
    _sl_can_mkdir() { mkdir -p "$1" >/dev/null 2>&1; }
    _sl_file_open_append() { # sets FD 3 if succeeds
        exec 3>>"$1" 2>/dev/null
    }
    _sl_is_ro_rootfs() {
        # Read-only rootfs detection WITHOUT writing to /
        # Returns 0 if root appears read-only, 1 otherwise.
        #
        # /proc/mounts format: <src> <target> <fstype> <opts> ...
        # We find the line where target == "/" and check if opts contains "ro".
        local line opts
        line="$(awk '$2=="/"{print; exit}' /proc/mounts 2>/dev/null || true)"
        [[ -n "$line" ]] || return 1
        opts="$(awk '$2=="/"{print $4; exit}' /proc/mounts 2>/dev/null || true)"
        echo "$opts" | grep -qE '(^|,)ro(,|$)' >&2
    }
    _sl_detect_container() {
        # Return 0 if container-ish, 1 otherwise.
        # Priority: explicit adapter vars -> /.dockerenv -> cgroup -> ro rootfs -> pid1 comm
        # informed directly from var
        case "${IN_CONTAINER:-}" in
            1|true|TRUE|yes|YES|y|Y|on|ON) return 0 ;;
            0|false|FALSE|no|NO|n|N|off|OFF) return 1 ;;
        esac
        # Cloud Run / Knative / K8s hints
        if [[ -n "${K_REVISION:-}" || -n "${K_SERVICE:-}" || -n "${K_CONFIGURATION:-}" ]]; then return 0; fi
        if [[ -n "${CLOUD_RUN_JOB:-}" || -n "${CLOUD_RUN_EXECUTION:-}" || -n "${CLOUD_RUN_TASK_INDEX:-}" ]]; then return 0; fi
        if [[ -n "${KUBERNETES_SERVICE_HOST:-}" ]]; then return 0; fi

        # Classic Docker marker
        if [[ -f "/.dockerenv" ]]; then return 0; fi

        # cgroup markers (works for docker/containerd/k8s)
        local cg=""
        if [[ -r /proc/1/cgroup ]]; then
            cg="$(cat /proc/1/cgroup 2>/dev/null || true)"
            if echo "$cg" | grep -qiE 'docker|containerd|kubepods|crio' >&2; then return 0; fi
        elif [[ -r /proc/self/cgroup ]]; then
            cg="$(cat /proc/self/cgroup 2>/dev/null || true)"
            if echo "$cg" | grep -qiE 'docker|containerd|kubepods|crio' >&2; then return 0; fi
        fi

        # Read-only rootfs is a strong signal in managed container adapters
        if _sl_is_ro_rootfs; then return 0; fi

        # PID 1 name (weak hint)
        if [[ -r /proc/1/comm ]]; then
            local comm
            comm="$(cat /proc/1/comm 2>/dev/null || true)"
            if echo "$comm" | grep -qiE 'tini|docker-init|pause' >&2; then return 0; fi
        fi

        return 1
    }

    # ---- determine caller for default log name ----
    local top_caller="<interactive>"
    for (( i=${#BASH_SOURCE[@]}-1; i>=0; i-- )); do
        [[ -n "${BASH_SOURCE[$i]:-}" ]] && { top_caller="${BASH_SOURCE[$i]}"; break; }
    done
    top_caller="$(basename "$top_caller")"

    # ---- tty state ----
    __HAS_TTY_BEFORE_REDIRECT=0
    [[ -t 0 && -t 1 ]] && __HAS_TTY_BEFORE_REDIRECT=1
    export __HAS_TTY_BEFORE_REDIRECT

    # ---- adapter and container detection ----
    pm_log_detect_adapter PM_LOG_ADAPTER
    if _sl_detect_container; then IN_CONTAINER=true; fi
    if [[ "${IN_CONTAINER:-false}" == true \
        && "$PM_LOG_ADAPTER" == "local" \
        && -z "${PM_LOG_ADAPTER_OVERRIDE:-}" ]]; then
        PM_LOG_ADAPTER="container"
    fi

    if [[ -z "${LOG_FORMAT:-}" ]]; then
        if pm_log_adapter_prefers_json "$PM_LOG_ADAPTER"; then
            LOG_FORMAT="json"
        else
            LOG_FORMAT="text"
        fi
    fi

    export IN_CONTAINER LOG_FORMAT PM_LOG_ADAPTER

    # ---- explicit overrides ----
    if [[ "${PM_NO_REDIRECT:-0}" == "1" ]]; then
        : "${LOG_FILE:=${LOG_FILE_CONFIGURE:-}}"
        if pm_log_adapter_uses_platform_sink "$PM_LOG_ADAPTER"; then
            PM_LOG_SINK="platform"
        else
            PM_LOG_SINK="console"
        fi
        export LOG_FILE PM_LOG_SINK
        _sl_stderr "[setup_logging] adapter=${PM_LOG_ADAPTER} sink=${PM_LOG_SINK}; leaving stdout/stderr unchanged (PM_NO_REDIRECT=1)"
        return 0
    fi

    local force_file_only=0
    if [[ "${PM_FORCE_REDIRECT:-0}" == "1" ]]; then
        force_file_only=1
    fi

    # Managed-adapter behavior:
    # - CI and cloud/container platforms capture stdout/stderr themselves.
    # - Local docker (ADAPTER_CODE=local): prefix every line with "[container]" (text logs only),
    #   but STILL do not redirect unless PM_FORCE_REDIRECT=1.
    if pm_log_adapter_uses_platform_sink "$PM_LOG_ADAPTER"; then
        local adapter="${ADAPTER_CODE:-}"

        # Forced redirect remains available as an operator escape hatch.
        if [[ "${PM_FORCE_REDIRECT:-0}" == "1" ]]; then
            _sl_stderr "[setup_logging] WARNING: PM_FORCE_REDIRECT=1 for adapter=${PM_LOG_ADAPTER} may bypass platform log capture"
            # fall through to file-redirect logic below
        else
            : "${LOG_FILE:=${LOG_FILE_CONFIGURE:-}}"
            PM_LOG_SINK="platform"
            export LOG_FILE PM_LOG_SINK

            # Prefix only in local docker and only for text logs (prefix would break JSON).
            if [[ "$PM_LOG_ADAPTER" == "container" \
                && "${adapter}" == "local" \
                && "${LOG_FORMAT:-text}" != "json" ]]; then
                if [[ "${__PM_CONTAINER_PREFIXED:-0}" != "1" ]]; then
                export __PM_CONTAINER_PREFIXED=1
                exec > >(sed -u 's/^/[container] /')
                exec 2> >(sed -u 's/^/[container] /' >&2)
                fi
                _sl_stderr "[setup_logging] local container detected (ADAPTER_CODE=local); prefixing stdout/stderr with [container]"
            else
                _sl_stderr "[setup_logging] adapter=${PM_LOG_ADAPTER} sink=platform format=${LOG_FORMAT}; leaving stdout/stderr attached to the platform collector"
            fi

            # Platform-owned persistence is the default in managed adapters.
            return 0
        fi
    fi

    # ---- choose log dir (must never fail) ----
    # Precedence:
    # 1) Existing LOG_DIR, if specified
    # 2) REPO_ROOT/logs
    # 3) Adapter fallback

    if [[ -z "${LOG_DIR:-}" ]]; then
        LOG_DIR="${REPO_ROOT:-$(pwd -P)}/logs"
    fi

    if ! _sl_can_mkdir "$LOG_DIR"; then
        local fallback=""
        if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
            fallback="${XDG_RUNTIME_DIR%/}/logs"
        else
            fallback="/tmp/logs"
        fi

        _sl_can_mkdir "$fallback" || true
        LOG_DIR="$fallback"
    fi
    export LOG_DIR

    LOG_FILE="${LOG_FILE_CONFIGURE:-$LOG_DIR/$top_caller.log}"
    export LOG_FILE

    # ---- optional archive (must never fail) ----
    local did_archive=0
    if declare -F archive_log_on_session_start >/dev/null 2>&1; then
        if [[ -s "$LOG_FILE" ]]; then
            archive_log_on_session_start "$LOG_FILE" >/dev/null 2>&1 || true
            did_archive=1
        else
            archive_log_on_session_start "$LOG_FILE" >/dev/null 2>&1 || true
        fi
    fi

    # ---- truncate (must never fail) ----
    if [[ "${LOG_TRUNCATE:-0}" == "1" || "$did_archive" == "1" ]]; then
        : >"$LOG_FILE" 2>/dev/null || true
    fi

    # ---- open file; redirect only if open succeeded ----
    if ! _sl_file_open_append "$LOG_FILE"; then
        PM_LOG_SINK="console"
        export PM_LOG_SINK
        _sl_stderr "[setup_logging] could not open log file; leaving stdout/stderr unchanged: $LOG_FILE"
        return 0
    fi

    # Local development defaults to both visible console output and durable
    # file output. Managed adapters never reach this branch unless an operator
    # explicitly forced file-only behavior.
    if [[ "$force_file_only" -eq 0 ]] \
        && pm_log_value_is_true "${PM_LOG_LOCAL_TEE:-1}" \
        && command -v tee >/dev/null 2>&1; then
        exec 3>&-
        exec 4>&1
        exec > >(tee -a "$LOG_FILE" >&4) 2>&1
        PM_LOG_SINK="console+file"
    else
        exec 1>&3 2>&3
        PM_LOG_SINK="file"
    fi
    export PM_LOG_SINK

    # xtrace follows the selected sink.
    if [[ "${DEBUG:-0}" == "1" ]]; then
        if [[ "$PM_LOG_SINK" == "console+file" ]]; then
            export BASH_XTRACEFD=2
        else
            export BASH_XTRACEFD=3
        fi
        export PS4='+ ${BASH_SOURCE##*/}:${LINENO}:${FUNCNAME[0]:-MAIN}(): '
        set -x
    fi

    # Now itâ€™s safe to use your structured logger if it exists.
    if declare -F log >/dev/null 2>&1; then
        log INFO "SESSION START" \
        "caller=${top_caller}" "pid=$$" "ppid=${PPID:-}" "user=${USER:-}" \
        "host=$(hostname 2>/dev/null || echo unknown >&2)" "cwd=$(pwd -P)" \
        "redirect=${PM_LOG_SINK}" "log_file=${LOG_FILE}" "archived=${did_archive}" \
        "debug=${DEBUG:-0}" "verbose=${VERBOSE:-0}" "IN_CONTAINER=${IN_CONTAINER}" \
        "log_adapter=${PM_LOG_ADAPTER}" "log_sink=${PM_LOG_SINK}"
    fi

    # Optional live tail (must tolerate no /dev/tty)
    if [[ "$PM_LOG_SINK" == "file" ]] \
        && declare -F live_tail_autostart >/dev/null 2>&1; then
        live_tail_autostart >/dev/null 2>&1 || true
    fi

    return 0
}

# Internal: should we emit this severity at current LOG_LEVEL?
should_log() {
  local severity="${1:-INFO}"
  local threshold="${LOG_LEVEL:-INFO}"
  local sev_n=20 thr_n=20

  severity="${severity^^}"
  threshold="${threshold^^}"

  case "${severity}" in
    DEBUG)   sev_n=10 ;;
    INFO)    sev_n=20 ;;
    WARNING|WARN) sev_n=30 ;;
    ERROR)   sev_n=40 ;;
    CRITICAL|FATAL|PANIC) sev_n=50 ;;
    *)       sev_n=20 ;;
  esac

  case "$threshold" in
    DEBUG)   thr_n=10 ;;
    INFO)    thr_n=20 ;;
    WARNING|WARN) thr_n=30 ;;
    ERROR)   thr_n=40 ;;
    CRITICAL|FATAL|PANIC) thr_n=50 ;;
    *)       thr_n=20 ;;
  esac

  [[ "$sev_n" -ge "$thr_n" ]]
}

log_callsite() {
    local index
    local function_name
    local source_file

    for ((index = 1; index < ${#FUNCNAME[@]}; index++)); do
        function_name="${FUNCNAME[$index]}"
        source_file="${BASH_SOURCE[$index]##*/}"

        case "$function_name" in
            log|die|pm_log_callsite|pm_format_log)
                continue
                ;;
        esac

        printf '%s\t%s\n' "$source_file" "$function_name"
        return 0
    done

    printf '%s\t%s\n' "$PM_ENTRY_SCRIPT" "main"
}

log() {
    local severity
    local msg
    local -a extra_fields=()

    case "$#" in
        0)
            severity="INFO"
            msg=""
            ;;
        1)
            severity="INFO"
            msg="${1:-}"
            shift
            ;;
        *)
            severity="${1:-}"
            msg="${2:-}"
            shift 2
            extra_fields=("$@")
            ;;
    esac

    severity="${severity^^}"

    case "$severity" in
        ERROR|CRITICAL|FATAL|PANIC)
            pm_error_record "$severity" "$msg" "${extra_fields[@]}"
            ;;
    esac

    should_log "${severity}" || return 0

    # Timestamp (RFC3339 UTC)
    local ts
    ts="$(date -u +'%Y-%m-%dT%H:%M:%S.%3NZ')"

    if [[ "${LOG_FORMAT:-text}" == "json" ]]; then
        local adapter="${PM_LOG_ADAPTER:-local}"
        local cloud_provider=""
        local service="${K_SERVICE:-}"
        local revision="${K_REVISION:-${AWS_LAMBDA_FUNCTION_VERSION:-${CONTAINER_APP_REVISION:-${GAE_VERSION:-}}}}"
        local execution="${CLOUD_RUN_EXECUTION:-${AWS_BATCH_JOB_ID:-}}"
        local task_index="${CLOUD_RUN_TASK_INDEX:-${AWS_BATCH_JOB_ARRAY_INDEX:-}}"
        local instance="${GAE_INSTANCE:-${WEBSITE_INSTANCE_ID:-${CONTAINER_APP_REPLICA_NAME:-}}}"
        local deployment_id="${PM_DEPLOYMENT_ID:-${DEPLOYMENT_ID:-}}"
        local correlation_id="${PM_CORRELATION_ID:-${CORRELATION_ID:-}}"
        local script_name="${PM_ENTRY_SCRIPT:-}"

        [[ -n "$service" ]] || service="${CLOUD_RUN_SERVICE:-}"
        [[ -n "$service" ]] || service="${AWS_LAMBDA_FUNCTION_NAME:-}"
        [[ -n "$service" ]] || service="${CONTAINER_APP_NAME:-}"
        [[ -n "$service" ]] || service="${WEBSITE_SITE_NAME:-}"
        [[ -n "$service" ]] || service="${GAE_SERVICE:-}"
        [[ -n "$service" ]] || service="${APP_SLUG:-${STACK:-}}"

        case "$adapter" in
            aws|azure|gcp) cloud_provider="$adapter" ;;
        esac

        local esc_msg="${msg//\\/\\\\}"
        esc_msg="${esc_msg//\"/\\\"}"

        service="${service//\\/\\\\}"; service="${service//\"/\\\"}"
        revision="${revision//\\/\\\\}"; revision="${revision//\"/\\\"}"
        execution="${execution//\\/\\\\}"; execution="${execution//\"/\\\"}"
        task_index="${task_index//\\/\\\\}"; task_index="${task_index//\"/\\\"}"
        instance="${instance//\\/\\\\}"; instance="${instance//\"/\\\"}"
        deployment_id="${deployment_id//\\/\\\\}"; deployment_id="${deployment_id//\"/\\\"}"
        correlation_id="${correlation_id//\\/\\\\}"; correlation_id="${correlation_id//\"/\\\"}"

        local extras_json=""
        local k v kv
        for kv in "${extra_fields[@]}"; do
            if [[ "$kv" == *"="* ]]; then
                k="${kv%%=*}"
                v="${kv#*=}"
                v="${v//\\/\\\\}"
                v="${v//\"/\\\"}"
                extras_json+=",\"${k}\":\"${v}\""
            fi
        done

        local json
        json="{\"severity\":\"${severity}\",\"timestamp\":\"${ts}\",\"message\":\"${esc_msg}\""
        [[ -n "${runtime:-}"     ]] && json+=",\"runtime\":\"${runtime}\""
        [[ -n "${cloud_provider:-}" ]] && json+=",\"cloud_provider\":\"${cloud_provider}\""
        [[ -n "${service:-}"     ]] && json+=",\"service\":\"${service}\""
        [[ -n "${script_name:-}" ]] && json+=",\"script\":\"${script_name}\""
        [[ -n "${revision:-}"    ]] && json+=",\"revision\":\"${revision}\""
        [[ -n "${execution:-}"   ]] && json+=",\"execution\":\"${execution}\""
        [[ -n "${task_index:-}"  ]] && json+=",\"task_index\":\"${task_index}\""
        [[ -n "${instance:-}"    ]] && json+=",\"instance\":\"${instance}\""
        [[ -n "${deployment_id:-}" ]] && json+=",\"deployment_id\":\"${deployment_id}\""
        [[ -n "${correlation_id:-}" ]] && json+=",\"correlation_id\":\"${correlation_id}\""
        json+="${extras_json}"
        json+="}"

        printf '%s\n' "$json" >&2
    else
        # Text mode mirrors JSON mode by appending the structured fields after
        # the human-readable message. This keeps local logs complete while
        # preserving the existing message text and callsite prefix.
        local callsite
        local implementation_script
        local implementation_function
        local extras=""

        if (( ${#extra_fields[@]} > 0 )); then
            extras=" ${extra_fields[*]}"
        fi

        callsite="$(log_callsite)"
        IFS=$'\t' read -r implementation_script implementation_function \
            <<< "$callsite"

        printf '[%s][%s][%s][%s:%s] %s%s\n' \
            "$ts" "$severity" "$PM_ENTRY_SCRIPT" \
            "$implementation_script" "$implementation_function" \
            "$msg" "$extras" >&2
    fi
}


