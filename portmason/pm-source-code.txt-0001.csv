    "file": "fixture_2026-07-08T00-00-00-0700.tar.gz",
    "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "preserved": {
    "services": ["web"],
    "volumes": ["data"],
