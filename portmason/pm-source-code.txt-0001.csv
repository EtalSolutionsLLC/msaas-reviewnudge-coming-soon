pm_decrypt_file() {
    local pm_input_file="${1:?file required}"
    local pm_output_variable="${2:?output variable required}"
    local pm_decrypted_content pm_input_format=dotenv

    [[ "$pm_input_file" == *.json ]] && pm_input_format=json

	cipher_line_count=$(wc -l < "$pm_input_file")
	echo "Starting file decryption on '$pm_input_file' containing $cipher_line_count lines ..."
    pm_decrypted_content="$(
        sops --decrypt \
            --input-type "$pm_input_format" \
            --output-type "$pm_input_format" \
            "$pm_input_file"
    )" || {
        printf 'ERROR: unable to decrypt configuration file: %s
' "$pm_input_file" >&2
        return 2
    }

	plaintext_line_count=$(printf '%s\n' "$pm_decrypted_content" | wc -l)
	echo "Successfully decrypted '$pm_input_file' with $plaintext_line_count lines. It is normal for the plaintext line count to be less than the cipher line count." >&2

    printf -v "$pm_output_variable" '%s' "$pm_decrypted_content"
}

pm_public_uri_scheme() {
    local scheme="${URI_SCHEME:-}"
    scheme="${scheme,,}"
    scheme="${scheme%://}"
    scheme="${scheme%:}"

    case "$scheme" in
        http|https)
            ;;
        *)
            if pm_deploy_env_is_production; then
                scheme="https"
            else
                case "${TRAEFIK_TLS:-false}" in
                    1|true|TRUE|yes|YES|on|ON) scheme="https" ;;
                    *) scheme="http" ;;
                esac
            fi
            ;;
    esac

    printf '%s:' "$scheme"
}

ensure_public_host_identity() {
    pm_deploy_env_is_production || return 0

    # The environment file is authoritative when it defines the canonical URL.
    # A generic APP_HOST may still contain STACK's production suffix, so it must
    # not bypass the production host derivation below.
    if [[ -n "${APP_URL:-}" ]]; then
