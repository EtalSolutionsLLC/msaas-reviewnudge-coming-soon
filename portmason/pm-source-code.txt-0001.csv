.pm-build-palette,
.pm-build-dialog {
  width: min(92vw, 42rem);
  max-height: min(88vh, 48rem);
  padding: 0;
  border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
  border-radius: 1rem;
  background: Canvas;
  color: CanvasText;
  box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.28);
}

.pm-build-palette::backdrop,
.pm-build-dialog::backdrop {
  background: rgb(8 16 24 / 0.68);
  backdrop-filter: blur(5px);
}

.pm-build-palette-frame,
.pm-build-dialog-frame {
  display: grid;
}

.pm-build-palette-frame {
  gap: 0.9rem;
  padding: 1.1rem;
}

.pm-build-palette h2,
.pm-build-dialog h2 {
  margin: 0;
  font: inherit;
  font-size: clamp(1.25rem, 2vw, 1.7rem);
  font-weight: 750;
}

.pm-build-command {
  display: grid;
  gap: 0.25rem;
  width: 100%;
  padding: 0.9rem 1rem;
  border: 1px solid color-mix(in srgb, CanvasText 16%, transparent);
  border-radius: 0.75rem;
  background: color-mix(in srgb, Canvas 94%, CanvasText 6%);
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.pm-build-command:hover,
.pm-build-command:focus-visible {
  border-color: color-mix(in srgb, Highlight 66%, CanvasText 34%);
  outline: 3px solid color-mix(in srgb, Highlight 24%, transparent);
  outline-offset: 2px;
}

.pm-build-command-title {
  font-weight: 750;
}

.pm-build-command small,
.pm-build-keyboard-hint,
.pm-build-intro,
.pm-build-status {
  color: color-mix(in srgb, CanvasText 68%, transparent);
}

.pm-build-keyboard-hint {
  margin: 0;
  font-size: 0.82rem;
}

.pm-build-dialog-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
}

.pm-build-close {
  display: grid;
  place-items: center;
  width: 2.2rem;
  height: 2.2rem;
  padding: 0;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: inherit;
  font-size: 1.5rem;
  cursor: pointer;
}

.pm-build-close:hover,
.pm-build-close:focus-visible {
  background: color-mix(in srgb, CanvasText 10%, transparent);
  outline: 2px solid Highlight;
}

.pm-build-dialog-body {
  display: grid;
  gap: 0.85rem;
  padding: 1.2rem;
  overflow: auto;
}

.pm-build-eyebrow {
  margin: 0;
  color: color-mix(in srgb, CanvasText 65%, transparent);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.pm-build-intro,
.pm-build-status {
  margin: 0;
  line-height: 1.5;
}

.pm-build-grid {
  display: grid;
  grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
  margin: 0;
  border: 1px solid color-mix(in srgb, CanvasText 14%, transparent);
  border-radius: 0.85rem;
  overflow: hidden;
}

.pm-build-grid dt,
.pm-build-grid dd {
  margin: 0;
  padding: 0.7rem 0.8rem;
  border-bottom: 1px solid color-mix(in srgb, CanvasText 11%, transparent);
  overflow-wrap: anywhere;
}

.pm-build-grid dt {
  background: color-mix(in srgb, Canvas 94%, CanvasText 6%);
  font-weight: 700;
}

.pm-build-grid dt:last-of-type,
.pm-build-grid dd:last-of-type {
  border-bottom: 0;
}

.pm-build-grid dd {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.88rem;
}

.pm-build-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.65rem;
  padding-top: 0.2rem;
}

.pm-build-actions button {
  min-height: 2.6rem;
  padding: 0.65rem 0.95rem;
  border: 1px solid color-mix(in srgb, CanvasText 18%, transparent);
  border-radius: 0.65rem;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.pm-build-copy {
  background: transparent;
  color: inherit;
}

.pm-build-done {
  background: Highlight;
  color: HighlightText;
}

@media (max-width: 38rem) {
  .pm-build-grid {
    grid-template-columns: 1fr;
  }

  .pm-build-grid dt {
    padding-bottom: 0.2rem;
    border-bottom: 0;
  }

  .pm-build-grid dd {
    padding-top: 0.2rem;
  }

  .pm-build-actions {
    flex-direction: column-reverse;
  }

  .pm-build-actions button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pm-build-palette::backdrop,
  .pm-build-dialog::backdrop {
    backdrop-filter: none;
  }
}


