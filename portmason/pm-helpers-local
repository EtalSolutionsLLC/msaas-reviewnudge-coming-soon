#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

sourceloc=

if [[ "${IN_CONTAINER:-}" != true ]]; then
    sourceloc="${PORTMASON_SHARE}"
else
	sourceloc="${REPO_ROOT}/portmason"
fi

$sourceloc/pm-ensure-external-networks "$@"


if command -v docker >/dev/null 2>&1; then
    echo "'docker' command is installed and available."
else
    echo "'docker' command is not installed or not available. Cannot continue."
    exit 1
fi

env_init_set TRAEFIK_DIR "${TRAEFIK_DIR:-$HOME/code/traefik}"
env_init_set LOCAL_EXEC_MODE "${LOCAL_EXEC_MODE:-container}"
env_init_set LOCAL_CONTAINER_ENGINE "${LOCAL_CONTAINER_ENGINE:-docker}"

pm_adapter_requires_compose() {
    return 0
}


local_exec_mode() {
  printf '%s' "${LOCAL_EXEC_MODE:-container}"
}

local_exec_is_container() {
  [[ "$(local_exec_mode)" == "container" ]]
}

local_exec_is_native() {
  [[ "$(local_exec_mode)" == "native" ]]
}

local_exec_is_venv() {
  [[ "$(local_exec_mode)" == "venv" ]]
}

get_gcp_secret() {
    local id="$1"                          # github-archive-480721:cosign-private-key
    local project_id="${id%%:*}"           # github-archive-480721
    local secret_name="${id#*:}"           # cosign-private-key

    local secret_value
    secret_value="$(
        gcloud secrets versions access latest \
        --secret="${secret_name}" \
        --project="${project_id}"
    )" || die 1

    # Return via stdout
    printf '%s' "${secret_value}"

    unset secret_value
}


