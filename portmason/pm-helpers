archive_log_on_session_start() {
  # Usage: archive_log_on_session_start "$LOG_FILE"
  #
  # Behavior:
  # - If LOG_FILE exists and non-empty: append to LOG_FILE._archive, then truncate LOG_FILE.
  # - If LOG_FILE._archive exceeds PM_LOG_ARCHIVE_MAX_BYTES: rotate it to numbered suffixes.
  #
  # Knobs:
  #   PM_LOG_ARCHIVE_MAX_BYTES (default 10 MiB)
  #   PM_LOG_ARCHIVE_KEEP      (default 5)

  local log_file="${1:?log_file required}"
  local archive="${log_file}_archive"

  local max_bytes="${PM_LOG_ARCHIVE_MAX_BYTES:-10485760}" # 10 MiB
  local keep="${PM_LOG_ARCHIVE_KEEP:-5}"

  [[ -e "$log_file" ]] || return 0
  [[ -s "$log_file" ]] || return 0

  # Ensure archive exists (best-effort)
  : > "$archive" 2>/dev/null || true

  # Append current into archive (best-effort)
  cat "$log_file" >> "$archive" 2>/dev/null || true

  # Truncate current (best-effort)
  : > "$log_file" 2>/dev/null || true

  rotate_archive_if_needed "$archive" "$max_bytes" "$keep" || true
}

as_root() {
  if have sudo; then
    sudo "$@"
  else
    "$@"
  fi
}

bail() {
    local message=""
    local rc="1"

    case "${1:-}" in
        "")
            ;;
        *[!0-9]*)
            message="$1"
            rc="${2:-1}"
            ;;
        *)
            rc="$1"
            ;;
    esac

    case "$rc" in
        ""|*[!0-9]*) rc="1" ;;
    esac

    if [[ -n "$message" ]]; then
        if declare -F log >/dev/null 2>&1; then
            log ERROR "$message" "exit_code=$rc"
        else
            printf 'ERROR: %s (exit_code=%s)\n' "$message" "$rc" >&2
        fi
    fi

    return "$rc" 2>/dev/null || exit "$rc"
}

can_mkdir_p() {
  local target="${1:?path required}"
  local p="$target"
  while [[ ! -d "$p" ]]; do
    p="$(dirname "$p")"
    [[ "$p" == "/" ]] && break
  done
  [[ -d "$p" ]] || return 1
  [[ -w "$p" && -x "$p" ]]
}

cleanup_tail() {
    local owner="${__LIVE_TAIL_OWNER_BASHPID:-}"

    # An executed child pm-* script inherits the PIDs but does not own them.
    if [[ -n "$owner" && "$owner" != "${BASHPID}" ]]; then
        return 0
    fi

    if declare -F live_tail_stop >/dev/null 2>&1; then
        live_tail_stop || true
    else
        local pid="${__LIVE_TAIL_PID:-${PM_TAIL_PID:-${TAIL_PID:-}}}"

        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            kill -- "-${pid}" 2>/dev/null || true
            kill "${pid}" 2>/dev/null || true
        fi
    fi

    unset \
        __LIVE_TAIL_OWNER_BASHPID \
        __LIVE_TAIL_PID \
        __LIVE_TAIL_GUARD_PID \
        PM_TAIL_PID \
        TAIL_PID
}

trap cleanup_tail EXIT INT TERM

die() {
    local msg="${1:-Process terminated}"
    local rc="${2:-1}"

    if [[ "$msg" != *[!0-9]* && $# -eq 1 ]]; then
        rc="$msg"
        msg="Process terminated"
    fi

    case "$rc" in
        ""|*[!0-9]*) rc="1" ;;
    esac

    log CRITICAL "$msg" "exit_code=$rc"
    bail "$rc"
}

