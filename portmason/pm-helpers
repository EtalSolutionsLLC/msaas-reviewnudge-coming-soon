pm_portmason_project_references_staged_copy() {
    local root="${REPO_ROOT:-${PROJECT_ROOT:-$(pwd -P)}}"
    local file

    for file in \
        "$root/Dockerfile" \
        "$root/Containerfile"
    do
        [[ -f "$file" ]] || continue
        if grep -Eq '^[[:space:]]*(COPY|ADD)[[:space:]].*(^|[[:space:]])(\./)?portmason([[:space:]/]|$)' "$file"; then
            return 0
        fi
    done

    for file in \
        "$root/docker-compose.yml" \
        "$root/docker-compose.yaml" \
        "$root/compose.yml" \
        "$root/compose.yaml"
    do
        [[ -f "$file" ]] || continue
        if grep -Eq '^[[:space:]]*-[[:space:]]*["'\'']?\./portmason(:|/)' "$file"; then
            return 0
        fi
    done

    return 1
}

pm_portmason_staging_required() {
    local policy="${PM_STAGE_PORTMASON:-auto}"
    policy="${policy,,}"

    case "$policy" in
        1|true|yes|y|on|always|required|force)
            return 0
            ;;
        0|false|no|n|off|never|skip|none)
            return 1
            ;;
        ""|auto)
            ;;
        *)
            warn "unknown PM_STAGE_PORTMASON value; using auto" "value=$PM_STAGE_PORTMASON"
            ;;
    esac

    # Once already inside a container, staging from host tooling is not useful.
    [[ "${IN_CONTAINER:-false}" == "true" ]] && return 1

    # Local container execution may need a project-local Portmason payload.
    if [[ "${ADAPTER_CODE:-}" == "local" && "${LOCAL_EXEC_MODE:-container}" == "container" ]]; then
        return 0
    fi

    # Some projects explicitly package or mount ./portmason. Honor that, but do
    # not infer staging from unrelated paths such as /var/log/portmason.
    pm_portmason_project_references_staged_copy
}

stage_portmason() {
    # Usage:
    #   stage_portmason [exclude_pattern...]
    #
    # Exclude patterns are rsync-style, relative to the source root:
    #   "cache/"          (exclude subdir)
    #   "secrets.env"     (exclude file)
    #   "*.log"           (exclude glob)
    #
    # Example:
    #   stage_portmason "cache/" "*.tmp" "node_modules/"

    local src="${PORTMASON_SHARE}"
#    local dest="$(determine_dest_root)/portmason"
    local dest="${REPO_ROOT}/portmason"

    log "Staging portmason -> ${dest} (from ${PORTMASON_SHARE})"

    [[ -d "$src" ]] || die "Missing directory: ${src}"
    mkdir -p "$dest"

    # -a = archive; -L = copy the symlink targets as real files/dirs
    local -a rsync_cmd=(rsync -aL --delete)

    # Add excludes (if any)
    local pat
    for pat in "$@"; do
        [[ -n "$pat" ]] || continue
        rsync_cmd+=(--exclude "$pat")
    done

    rsync_cmd+=("${src}/" "${dest}/")

    # Optional: log the exact command
    local _print
    printf -v _print '%q ' "${rsync_cmd[@]}"
    log DEBUG "CMD: ${_print}"

    "${rsync_cmd[@]}"
}


resolve_project_root_candidate() {
    local invocation_dir="${1:-$(pwd -P)}"
    local requested_root=""

    if [[ -n "${PORTMASON_PROJECT_ROOT:-}" ]]; then
        requested_root="${PORTMASON_PROJECT_ROOT}"
    elif command -v git >/dev/null 2>&1; then
        requested_root="$(
            git -C "${invocation_dir}" rev-parse --show-toplevel 2>/dev/null || true
        )"
    fi

    requested_root="${requested_root:-${invocation_dir}}"

    [[ -d "${requested_root}" ]] \
        || die "Project root does not exist: ${requested_root}"

    (
        cd -- "${requested_root}"
        pwd -P
    )
}

resolve_project_root() {
    PROJECT_ROOT="$(resolve_project_root_candidate "${ORIG_PWD}")"
    export PROJECT_ROOT
}

