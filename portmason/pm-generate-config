#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)"}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

: "${ENV_FILE:?ENV_FILE is required}"
: "${SITE_DIR:?SITE_DIR is required}"

generated_file="${ENV_FILE}.generated"
# Generated plaintext stays in memory until encryption succeeds.

pm_generate_config_write_dotenv_pair() {
    local key="${1:?key required}"
    local value="${2-}"

    # .env.generated is consumed by both Docker Compose and Portmason.
    # Bash printf %q is shell replay syntax, not dotenv encoding. It escapes
    # punctuation such as commas, causing Compose to pass the backslashes to
    # the application literally.
    case "$value" in
        *$'\n'*|*$'\r'*)
            die "pm-generate-config: multiline value is not supported for generated key $key" 2
            ;;
    esac

    # Keep simple values unquoted. Quote values containing shell/Compose
    # significant characters such as spaces, angle brackets, dollar signs,
    # or backslashes.
    if [[ "$value" =~ ^[A-Za-z0-9_./:@%+,=?-]*$ ]]; then
        printf '%s=%s\n' "$key" "$value"
        return 0
    fi

    # .env.generated is currently consumed by both Bash and Compose. There is
    # no portable common single-quote representation between those two parsers,
    # so refuse the ambiguous case instead of corrupting the value.
    if [[ "$value" == *"'"* ]]; then
        die "pm-generate-config: single quote is not supported in generated value for key $key" 2
    fi

    printf "%s='%s'\n" "$key" "$value"
}

#
# .env.generated is a disposable snapshot of the CURRENT resolved
# Portmason/project configuration.
#
# Provenance:
#   - keys explicitly declared by .env
#   - keys intentionally introduced by env_init_set()
#
# Values are always taken from the current process environment, not
# reconstructed from the original RHS in .env.
#

project_keys="${__PM_HELPERS_PROJECT_ENV_KEYS:-}"
source_keys=""

local_source=""
pm_decrypt_file "$ENV_FILE" local_source \
    || die "unable to decrypt source configuration" 2
source_keys="$(
    printf '%s\n' "$local_source" |
    awk '
        /^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/ {
            line=$0
            sub(/^[[:space:]]*/, "", line)
            sub(/^export[[:space:]]+/, "", line)
            sub(/[[:space:]]*=.*/, "", line)
            printf "%s%s", separator, line
            separator=":"
        }
    '
)"
unset local_source

if [[ -n "$source_keys" ]]; then
    if [[ -n "$project_keys" ]]; then
        project_keys="${project_keys}:${source_keys}"
    else
        project_keys="$source_keys"
    fi
fi

for key in "${ENV_INIT_VARS[@]}"; do
    pm_context_append_key project_keys "$key"
done

[[ -n "$project_keys" ]] \
    || die "pm-generate-config: no project configuration keys registered" 2

declare -A emitted=()
IFS=':' read -r -a keys <<< "$project_keys"

generated_plaintext="$(
for key in "${keys[@]}"; do
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    [[ -z "${emitted[$key]+x}" ]] || continue
    emitted["$key"]=1

    value="${!key-}"
    pm_generate_config_write_dotenv_pair "$key" "$value"
done
)" || die "unable to serialize generated configuration" 2

#
# Replace the generated state completely on every run. This prevents deleted
# or changed source values from surviving from a prior invocation.
#
printf '%s\n' "$generated_plaintext" |
    python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file "$generated_file" \
    || die "unable to encrypt generated configuration" 2

#
# From this point onward .env.generated is the canonical resolved project
# configuration snapshot.
#
# Current process values are already resolved; do not source ciphertext.

#
# Generate browser-safe public configuration from the resolved generated state.
#
public_config_keys="${PUBLIC_BROWSER_CONFIG_KEYS:-${PUBLIC_CONFIG_KEYS:-${PM_PUBLIC_BROWSER_CONFIG_DEFAULT_KEYS:-SITE_URL APP_URL APP_HOST}}}"
public_config_path="${PUBLIC_BROWSER_CONFIG_PATH:-${PUBLIC_CONFIG_PATH:-${SITE_DIR}/config.public.json}}"

mkdir -p "$(dirname "$public_config_path")"

public_json="$(
    printf '%s\n' "$generated_plaintext" |
        "${PORTMASON_SHARE}/pm-util-render-env" \
            --json --keys "$public_config_keys" -
)" || die "unable to render public configuration" 2

printf '%s\n' "$public_json" |
    python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
        "$public_config_path" --format json \
    || die "unable to encrypt public configuration artifact" 2

unset generated_plaintext public_json

log INFO \
    "generated configuration refreshed" \
    "env_file=$generated_file" \
    "public_config=$public_config_path"
