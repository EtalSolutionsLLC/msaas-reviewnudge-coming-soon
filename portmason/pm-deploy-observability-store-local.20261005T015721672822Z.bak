#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"
. "${PORTMASON_SHARE}/pm-helpers-observability" "$@"

main() {
  log INFO "deploying local observability realization" \
    "store=${OBSERVABILITY_STORE_PROVIDER_PLATFORM_CODE}" \
    "dashboard=${OBSERVABILITY_DASHBOARD_ENABLED:-false}"
  pm_observability_prepare_local_paths
  pm_observability_ensure_external_volumes
  pm_observability_local_compose up -d --pull missing --remove-orphans --wait
  log INFO "local observability services started"
}

verify() {
  local running required service dashboard_health attempt
  running="$(pm_observability_local_compose ps --status running --services)"
  required="$(pm_observability_local_compose config --services)"
  [[ -n "$required" ]] || die "Telemetry Compose model declares no active services" 2

  while IFS= read -r service; do
    [[ -n "$service" ]] || continue
    grep -Fxq "$service" <<<"$running" \
      || die "Telemetry service is not running after setup: $service" 2
  done <<<"$required"

  pm_observability_local_compose exec -T store test -f /tmp/ready

  if observability_is_true "${OBSERVABILITY_DASHBOARD_ENABLED:-false}"; then
    dashboard_health=""
    for attempt in $(seq 1 30); do
      dashboard_health="$(pm_observability_local_compose exec -T dashboard \
        wget -qO- http://127.0.0.1:3000/api/health 2>/dev/null || true)"
      grep -q '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$dashboard_health" && break
      sleep 2
    done
    grep -q '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$dashboard_health" \
      || die "Telemetry dashboard did not become ready within 60 seconds" 2
  fi

  local project_verifier="${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR}}/mgt-scripts/verify-observability"
  if [[ "${DEPLOY_ENV:-}" == dev && -x "$project_verifier" ]]; then
    "$project_verifier" || die "Project observability ingestion verification failed" 2
  fi

  log INFO "local observability realization verified" "services=$(tr '\n' ',' <<<"$required" | sed 's/,$//')"
}

main "$@"

verify "$@"
