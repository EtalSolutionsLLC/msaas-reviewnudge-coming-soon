#!/usr/bin/env bash
set -Eeuo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
# shellcheck disable=SC1090
. "${PORTMASON_SHARE}/pm-helpers" "$@"

usage() {
    printf 'Usage: pm-rotate-token VARIABLE_NAME\n' >&2
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

(( $# == 1 )) || {
    usage
    die "pm-rotate-token requires exactly one .env variable name" 2
}

token_variable="$1"
[[ "$token_variable" =~ ^[A-Z][A-Z0-9_]*$ ]] \
    || die "Invalid .env variable name: $token_variable" 2
[[ "$token_variable" == *_* ]] \
    || die "Variable name does not declare a Portmason domain: $token_variable" 2

token_domain="${token_variable%%_*}"
rotate_function="${token_domain,,}_rotate_token"
log "token_domain=${token_domain}, rotate_function=${rotate_function}"

declare -F "$rotate_function" >/dev/null 2>&1 \
    || die "Database provider does not implement $rotate_function for $token_variable" 2

"$rotate_function" "$token_variable"
