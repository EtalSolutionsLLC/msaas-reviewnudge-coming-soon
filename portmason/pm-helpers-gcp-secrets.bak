#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

# GCP Secret Manager synchronization and Cloud Run secret-argument helpers.
# Secret values are never logged.

declare -gA PM_GCP_PROJECT_NUMBER_BY_ID=()

pm_gcp_project_number_for_id() {
    local out_var="${1:?output variable required}"
    local project_id="${2:?project ID required}"
    local resolved_project_number=""

    if [[ "$project_id" =~ ^[0-9]+$ ]]; then
        resolved_project_number="$project_id"
    elif [[ -n "${PM_GCP_PROJECT_NUMBER_BY_ID[$project_id]:-}" ]]; then
        resolved_project_number="${PM_GCP_PROJECT_NUMBER_BY_ID[$project_id]}"
    else
        if ! declare -F get_gcp_project_number >/dev/null 2>&1; then
            # shellcheck disable=SC1090
            . "${PORTMASON_SHARE}/pm-secret-provider-gcp"
        fi

        resolved_project_number="$(get_gcp_project_number "$project_id")" \
            || die "pm-gcp-secrets: unable to resolve project number for $project_id" 2

        [[ -n "$resolved_project_number" ]] \
            || die "pm-gcp-secrets: resolved project number is empty for $project_id" 2

        PM_GCP_PROJECT_NUMBER_BY_ID["$project_id"]="$resolved_project_number"
    fi

    printf -v "$out_var" '%s' "$resolved_project_number"
}

pm_gcp_secret_name_for_key() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local base="${STACK:?STACK required}-${key}"
    base="${base,,}"
    base="${base//_/-}"
    base="$(printf '%s' "$base" | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
    [[ -n "$base" ]] || base="portmason-secret"
    printf -v "$out_var" '%s' "${base:0:255}"
}

pm_gcp_secret_override_parts() {
    local out_project="${1:?project output required}"
    local out_secret="${2:?secret output required}"
    local key="${3:?key required}"
    local line ref path override_project="" override_secret=""

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" == *"|"* ]] || continue
        ref="${line%%|*}"
        path="${line#*|}"
        [[ "$ref" == "$key" ]] || continue

        path="${path#gcs:}"
        path="${path#gcp:}"
        case "$path" in
            projects/*/secrets/*)
                override_project="${path#projects/}"
                override_project="${override_project%%/*}"
                override_secret="${path##*/}"
                ;;
            *:*)
                override_project="${path%%:*}"
                override_secret="${path#*:}"
                ;;
            *)
                override_project="${DEPLOYMENT_ID:-}"
                override_secret="$path"
                ;;
        esac
        printf -v "$out_project" '%s' "$override_project"
        printf -v "$out_secret" '%s' "$override_secret"
        return 0
    done <<<"${SECRET_PATHS:-}"

    return 1
}

pm_gcp_secret_location_for_key() {
    local out_project="${1:?project output required}"
    local out_secret="${2:?secret output required}"
    local key="${3:?key required}"
    local result_project="" result_secret=""

    if pm_gcp_secret_override_parts result_project result_secret "$key"; then
        :
    else
        result_project="${DEPLOYMENT_ID:?DEPLOYMENT_ID required}"
        pm_gcp_secret_name_for_key result_secret "$key"
    fi

    pm_gcp_project_number_for_id result_project "$result_project"
    printf -v "$out_project" '%s' "$result_project"
    printf -v "$out_secret" '%s' "$result_secret"
}

pm_gcp_secret_resource_for_key() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local project secret
    pm_gcp_secret_location_for_key project secret "$key"
    printf -v "$out_var" '%s' "projects/${project}/secrets/${secret}"
}   

pm_gcp_ensure_secret_container() {
    local project="${1:?project required}"
    local secret="${2:?secret required}"

    if gcloud secrets describe "$secret" --project "$project" >/dev/null 2>&1; then
        log DEBUG "pm-gcp-secrets: secret container exists" \
            "project=$project" "secret=$secret"
        return 0
    fi

    log INFO "pm-gcp-secrets: creating secret container" \
        "project=$project" "secret=$secret"
    gcloud secrets create "$secret" \
        --project "$project" \
        --replication-policy=automatic \
        >/dev/null
}

pm_gcp_secret_latest_matches() {
    local project="${1:?project required}"
    local secret="${2:?secret required}"
    local value="${3-}"
    local tmp current_hash wanted_hash

    tmp="$(mktemp)"
    chmod 600 "$tmp"
    if ! gcloud secrets versions access latest \
        --secret "$secret" \
        --project "$project" \
        --out-file "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp"
        return 1
    fi

    current_hash="$(sha256sum "$tmp" | awk '{print $1}')"
    wanted_hash="$(printf '%s' "$value" | sha256sum | awk '{print $1}')"
    rm -f "$tmp"
    [[ "$current_hash" == "$wanted_hash" ]]
}

pm_gcp_sync_secret_value() {
    local key="${1:?key required}"
    local value="${2-}"
    local project secret

    pm_gcp_secret_location_for_key project secret "$key"
    pm_gcp_ensure_secret_container "$project" "$secret"

    if [[ -z "$value" ]]; then
        log INFO "pm-gcp-secrets: using existing externally managed secret" \
            "key=$key" "project=$project" "secret=$secret"
        gcloud secrets versions access latest \
            --secret "$secret" --project "$project" >/dev/null 2>&1 \
            || die "Secret override for $key has no accessible version: projects/$project/secrets/$secret" 2
        return 0
    fi

    if pm_gcp_secret_latest_matches "$project" "$secret" "$value"; then
        log INFO "pm-gcp-secrets: secret value is current" \
            "key=$key" "project=$project" "secret=$secret"
        return 0
    fi

    log INFO "pm-gcp-secrets: adding secret version" \
        "key=$key" "project=$project" "secret=$secret"
    printf '%s' "$value" \
        | gcloud secrets versions add "$secret" \
            --project "$project" \
            --data-file=- \
            >/dev/null
}

pm_gcp_get_secret_value() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local project secret result
    pm_gcp_secret_location_for_key project secret "$key"
    result="$(gcloud secrets versions access latest \
        --secret "$secret" --project "$project")" \
        || return 1
    printf -v "$out_var" '%s' "$result"
}

pm_gcp_get_or_create_internal_secret() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local value="${!key:-}"
    local project secret

    pm_gcp_secret_location_for_key project secret "$key"
    if [[ -z "$value" ]] && gcloud secrets versions access latest \
        --secret "$secret" --project "$project" >/dev/null 2>&1; then
        pm_gcp_get_secret_value value "$key"
        log INFO "pm-gcp-secrets: loaded existing internal secret" \
            "key=$key" "project=$project" "secret=$secret"
    fi

    if [[ -z "$value" ]]; then
        have openssl || die "openssl is required to generate internal secret $key" 2
        value="$(openssl rand -base64 48 | tr -d '\r\n')"
        log INFO "pm-gcp-secrets: generated internal secret" \
            "key=$key" "project=$project" "secret=$secret"
    fi

    pm_gcp_sync_secret_value "$key" "$value"
    printf -v "$out_var" '%s' "$value"
}

pm_gcp_operator_direct_secret_values_nul() {
    local env_file="${ENV_FILE:-}"
    [[ -r "$env_file" ]] || return 0

    (
        set -euo pipefail
        set -a
        # shellcheck disable=SC1090
        . "$env_file"
        set +a

        awk '
            function trim(s) {
                sub(/^[ \t\r\n]+/, "", s)
                sub(/[ \t\r\n]+$/, "", s)
                return s
            }
            {
                line = trim($0)
                if (line == "" || line ~ /^#/) next
                if (line ~ /^export[ \t]+/) {
                    sub(/^export[ \t]+/, "", line)
                    line = trim(line)
                }
                if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) next

                key = line
                sub(/=.*/, "", key)
                value_source = line
                sub(/^[^=]*=/, "", value_source)

                # Interpolated values are generated contracts, not independent
                # operator-authored secret values. Keep the current hydrated
                # value for those keys (for example DB_URL).
                if (index(value_source, "$") != 0) next

                printf "%s%c%s%c", key, 0, ENVIRON[key], 0
            }
        ' "$env_file"
    )
}

pm_gcp_sync_project_runtime_secrets() {
    [[ "${DEPLOY_ENV:-dev}" != "dev" ]] || {
        log DEBUG "pm-gcp-secrets: development environment; platform secret synchronization skipped"
        return 0
    }

    local key value operator_key operator_value
    declare -A seen=()
    declare -A operator_values=()
    declare -A operator_values_present=()
    log INFO "pm-gcp-secrets: synchronizing runtime secret contract"    

    while IFS= read -r -d '' operator_key; do
        IFS= read -r -d '' operator_value || operator_value=""
        operator_values_present["$operator_key"]=1
        operator_values["$operator_key"]="$operator_value"
    done < <(pm_gcp_operator_direct_secret_values_nul)

    while IFS= read -r key; do
        [[ -n "$key" && -z "${seen[$key]+x}" ]] || continue
        seen["$key"]=1
        if [[ -n "${operator_values_present[$key]+x}" ]]; then
            value="${operator_values[$key]}"
        else
            value="${!key:-}"
        fi
        pm_secret_value_is_sentinel "$value" && continue
        pm_gcp_sync_secret_value "$key" "$value"
    done < <(pm_gcp_secret_path_keys)

    log INFO "pm-gcp-secrets: runtime secret synchronization complete" \
        "count=${#seen[@]}"
}

pm_gcp_secret_path_keys() {
    local line key
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" == *"|"* ]] || continue
        key="${line%%|*}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        printf '%s\n' "$key"
    done <<<"${SECRET_PATHS:-}"
}

pm_gcp_runtime_secret_bindings_nul() {
    local key project secret resource
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        pm_gcp_secret_location_for_key project secret "$key"
        resource="projects/${project}/secrets/${secret}"
        printf '%s\0%s\0' "$key" "$resource"
    done < <(pm_gcp_secret_path_keys)
}

pm_gcp_runtime_secret_bindings_for_service_nul() {
    local service="${1:?service required}"
    local component key resource allowed_key
    declare -A allowed=()

    component="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | (.observability_component // .observability_component // empty)' \
        <<<"${PROJECT_SERVICES:-[]}")"

    while IFS= read -r allowed_key; do
        [[ -n "$allowed_key" ]] && allowed["$allowed_key"]=1
    done < <(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .secret_keys[]?' \
        <<<"${PROJECT_SERVICES:-[]}")

    if ((${#allowed[@]} == 0)); then
        pm_gcp_runtime_secret_bindings_nul
        return 0
    fi

    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "${allowed[$key]+x}" ]] || continue
        printf '%s\0%s\0' "$key" "$resource"
    done < <(pm_gcp_runtime_secret_bindings_nul)
}

pm_gcp_secret_args_for_service() {
    local service="${1:?service required}"
    local role="${2:?service role required}"
    local key resource
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "$key" && -n "$resource" ]] || continue
        printf '%s\0%s\0' "--set-secrets" "${key}=${resource}:latest"
    done < <(pm_gcp_runtime_secret_bindings_for_service_nul "$service")
}

pm_gcp_secret_args_for_role() {
    local role="${1:?service role required}"
    pm_gcp_secret_args_for_service "$role" "$role"
}

pm_gcp_env_args_for_service() {
    local service="${1:?service required}"
    local role="${2:?service role required}"
    local key value
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' value || value=""
        printf '%s\0%s\0' "--set-env-vars" "${key}=${value}"
    done < <(pm_gcp_all_env_kv_nul)
}

pm_gcp_all_env_kv_nul() {
    local key value secret_key
    declare -A secret_keys=()
    while IFS= read -r secret_key; do
        [[ -n "$secret_key" ]] && secret_keys["$secret_key"]=1
    done < <(pm_gcp_secret_path_keys)
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' value || value=""
        [[ -z "${secret_keys[$key]+x}" ]] || continue
        printf '%s\0%s\0' "$key" "$value"
    done < <(env_file_to_kv_nul "${ENV_FILE}.generated")
}

pm_gcp_resolved_runtime_env_kv_nul() {
    local key value resource

    pm_gcp_all_env_kv_nul

    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "$key" && -n "$resource" ]] || continue
        pm_gcp_get_secret_value value "$key" \
            || die "Unable to resolve production runtime secret for local emulation: $key" 2
        [[ -n "$value" ]] \
            || die "Production runtime secret resolved empty for local emulation: $key" 2
        printf '%s\0%s\0' "$key" "$value"
    done < <(pm_gcp_runtime_secret_bindings_nul)
}

pm_gcp_env_args_for_role() {
    local role="${1:?service role required}"
    pm_gcp_env_args_for_service "$role" "$role"
}

pm_gcp_write_env_file_for_service() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local role="${3:?role required}"
    local pm_gcp_cipher_file pm_gcp_json

    pm_gcp_json="$(
        set -o pipefail
        pm_gcp_all_env_kv_nul |
        python3 -c '
import json, sys
parts = sys.stdin.buffer.read().split(b"\0")
if parts[-1:] == [b""]:
    parts.pop()
if len(parts) % 2:
    raise SystemExit("Invalid environment stream")
values = {}
for i in range(0, len(parts), 2):
    key = parts[i].decode("utf-8")
    values[key] = parts[i + 1].decode("utf-8")
print(json.dumps(values))
'
    )" || die "unable to collect GCP environment" 2

    pm_gcp_cipher_file="$(mktemp --suffix=.json)" || return 2
    if ! printf '%s\n' "$pm_gcp_json" |
        python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
            "$pm_gcp_cipher_file" --format json; then
        rm -f -- "$pm_gcp_cipher_file"
        die "unable to encrypt GCP environment" 2
    fi
    unset pm_gcp_json
    printf -v "$out_var" '%s' "$pm_gcp_cipher_file"
    log INFO "encrypted GCP environment prepared" \
        "service=$service" "role=$role"
}

pm_gcp_write_env_file_for_role() {
    local out_var="${1:?output variable required}"
    local role="${2:?service role required}"
    pm_gcp_write_env_file_for_service "$out_var" "$role" "$role"
}

pm_gcp_bind_service_secret_access() {
    local service_account="${1:?service account required}"
    local service role
    if (( $# >= 3 )); then
        service="${2:?service required}"
        role="${3:?service role required}"
    else
        role="${2:?service role required}"
        service="$role"
    fi

    local source target value project secret
    declare -A seen=()
    while IFS= read -r -d '' source; do
        IFS= read -r -d '' target || target="$source"
        IFS= read -r -d '' value || value=""
        [[ -z "${seen[$source]+x}" ]] || continue
        seen["$source"]=1
        pm_gcp_secret_location_for_key project secret "$source"
        log INFO "pm-gcp-secrets: ensuring runtime secret access" \
            "service_account=$service_account" "service=$service" \
            "key=$source" "project=$project" "secret=$secret"
        gcloud secrets add-iam-policy-binding "$secret" \
            --project "$project" \
            --member "serviceAccount:${service_account}" \
            --role roles/secretmanager.secretAccessor \
            --quiet >/dev/null
    done < <(
        while IFS= read -r -d '' key; do
            IFS= read -r -d '' target || target=""
            printf '%s\0%s\0%s\0' "$key" "$key" ""
        done < <(pm_gcp_runtime_secret_bindings_for_service_nul "$service")
    )
}
