#!/usr/bin/env bash


pm_setup_static_site_root() {
    local resolved="${SITE_ROOT:-${SITE_DIR:-${PROJECT_ROOT:-$PWD}}}"


    # Static runtime setup owns the document-root assignment.
    # SITE_DIR already resolves root-hosted and www-hosted
    # static projects.

    env_init_set \
        SITE_ROOT \
        "$resolved"


    log INFO \
        "Static runtime site root resolved" \
        "site_root=$SITE_ROOT"
}


pm_setup_static_site_root

pm_web_setup
