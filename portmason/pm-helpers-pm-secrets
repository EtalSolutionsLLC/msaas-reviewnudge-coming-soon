#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

# Portmason secret synchronization helpers.
# Secret values are never logged.

pm_portmason_secret_name_for_key() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local base="${STACK:?STACK required}-${key}"
    base="${base,,}"
    base="${base//_/-}"
    base="$(printf '%s' "$base" | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
    [[ -n "$base" ]] || base="portmason-secret"
    printf -v "$out_var" '%s' "${base:0:255}"
}

pm_portmason_secret_override_parts() {
    local out_project="${1:?project output required}"
    local out_secret="${2:?secret output required}"
    local key="${3:?key required}"
    local line ref path override_project="" override_secret=""

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" == *"|"* ]] || continue
        ref="${line%%|*}"
        path="${line#*|}"
        [[ "$ref" == "$key" ]] || continue

        path="${path#gcs:}"
        path="${path#gcp:}"
        case "$path" in
            projects/*/secrets/*)
                override_project="${path#projects/}"
                override_project="${override_project%%/*}"
                override_secret="${path##*/}"
                ;;
            *:*)
                override_project="${path%%:*}"
                override_secret="${path#*:}"
                ;;
            *)
                override_project="${DEPLOYMENT_ID:-}"
                override_secret="$path"
                ;;
        esac
        printf -v "$out_project" '%s' "$override_project"
        printf -v "$out_secret" '%s' "$override_secret"
        return 0
    done <<<"${SECRET_PATHS:-}"

    return 1
}

pm_portmason_secret_location_for_key() {
    local out_project="${1:?project output required}"
    local out_secret="${2:?secret output required}"
    local key="${3:?key required}"
    local result_project="" result_secret=""

    if pm_portmason_secret_override_parts result_project result_secret "$key"; then
        :
    else
        result_project="${DEPLOYMENT_ID:?DEPLOYMENT_ID required}"
        pm_portmason_secret_name_for_key result_secret "$key"
    fi

    printf -v "$out_project" '%s' "$result_project"
    printf -v "$out_secret" '%s' "$result_secret"
}

pm_portmason_secret_resource_for_key() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local project secret
    pm_portmason_secret_location_for_key project secret "$key"
    printf -v "$out_var" '%s' "projects/${project}/secrets/${secret}"
}   


pm_portmason_ensure_secret_container() {
    if [[ -f "${SOPS_FILE:-}" ]]; then
        log INFO "secret container exists" \
            "sops_file=${SOPS_FILE}"
        return 0
    else
        log ERROR "secret container not available" \
            "sops_file=${SOPS_FILE:-<unset>}"
        return 1
    fi
}


pm_portmason_sync_secret_value() {
	local key="${1:?key required}"
	local value="${2-}"

	if [[ -z "$value" ]]; then
		log INFO "using existing externally managed secret" \
		"key=$key"
		return 0
	fi

	local current
	current="$(pm_secret_get "$key")" || current=""

	if [[ "$current" == "$value" ]]; then
		log INFO "secret value is current" \
		"key=$key"
		return 0
	fi

	log INFO "updating secret value" \
	"key=$key"
	
	pm_secret_set "$key" "$value" || return 1
}


pm_portmason_get_secret_value() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local result

    result="$(pm_secret_get "$key")" || return 1
    printf -v "$out_var" '%s' "$result"
}

pm_portmason_get_or_create_internal_secret() {
    local out_var="${1:?output variable required}"
    local key="${2:?key required}"
    local value="${!key:-}"

    if [[ -z "$value" ]]; then
        value="$(pm_secret_get "$key")" || value=""

        if [[ -n "$value" ]]; then
            log INFO "loaded existing internal secret" \
                "key=$key"
        fi
    fi

    if [[ -z "$value" ]]; then
        have openssl || die "openssl is required to generate internal secret $key" 2

        value="$(openssl rand -base64 48 | tr -d '\r\n')"

        log INFO "generated internal secret" \
            "key=$key"
    fi

    pm_portmason_sync_secret_value "$key" "$value"

    printf -v "$out_var" '%s' "$value"
}

pm_portmason_operator_direct_secret_values_nul() {
    local env_file="${ENV_FILE:-}"
    [[ -r "$env_file" ]] || return 0

    (
        set -euo pipefail
        set -a
        # shellcheck disable=SC1090
        . "$env_file"
        set +a

        awk '
            function trim(s) {
                sub(/^[ \t\r\n]+/, "", s)
                sub(/[ \t\r\n]+$/, "", s)
                return s
            }
            {
                line = trim($0)
                if (line == "" || line ~ /^#/) next
                if (line ~ /^export[ \t]+/) {
                    sub(/^export[ \t]+/, "", line)
                    line = trim(line)
                }
                if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) next

                key = line
                sub(/=.*/, "", key)
                value_source = line
                sub(/^[^=]*=/, "", value_source)

                # Interpolated values are generated contracts, not independent
                # operator-authored secret values. Keep the current hydrated
                # value for those keys (for example DB_URL).
                if (index(value_source, "$") != 0) next

                printf "%s%c%s%c", key, 0, ENVIRON[key], 0
            }
        ' "$env_file"
    )
}

pm_portmason_sync_project_runtime_secrets() {
    [[ "${DEPLOY_ENV:-dev}" != "dev" ]] || {
        log DEBUG "development environment; platform secret synchronization skipped"
        return 0
    }

    local key value operator_key operator_value
    declare -A seen=()
    declare -A operator_values=()
    declare -A operator_values_present=()
    log INFO "synchronizing runtime secret contract"    

    while IFS= read -r -d '' operator_key; do
        IFS= read -r -d '' operator_value || operator_value=""
        operator_values_present["$operator_key"]=1
        operator_values["$operator_key"]="$operator_value"
    done < <(pm_portmason_operator_direct_secret_values_nul)

    while IFS= read -r key; do
        [[ -n "$key" && -z "${seen[$key]+x}" ]] || continue
        seen["$key"]=1
        if [[ -n "${operator_values_present[$key]+x}" ]]; then
            value="${operator_values[$key]}"
        else
            value="${!key:-}"
        fi
        pm_secret_value_is_sentinel "$value" && continue
        pm_portmason_sync_secret_value "$key" "$value"
    done < <(pm_portmason_secret_path_keys)

    log INFO "runtime secret synchronization complete" \
        "count=${#seen[@]}"
}

pm_portmason_secret_path_keys() {
    local line key
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" == *"|"* ]] || continue
        key="${line%%|*}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        printf '%s\n' "$key"
    done <<<"${SECRET_PATHS:-}"
}

pm_portmason_runtime_secret_bindings_nul() {
    local key project secret resource
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        pm_portmason_secret_location_for_key project secret "$key"
        resource="projects/${project}/secrets/${secret}"
        printf '%s\0%s\0' "$key" "$resource"
    done < <(pm_portmason_secret_path_keys)
}

pm_portmason_runtime_secret_bindings_for_service_nul() {
    local service="${1:?service required}"
    local component key resource allowed_key
    declare -A allowed=()

    component="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | (.observability_component // .observability_component // empty)' \
        <<<"${PROJECT_SERVICES:-[]}")"

    while IFS= read -r allowed_key; do
        [[ -n "$allowed_key" ]] && allowed["$allowed_key"]=1
    done < <(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .secret_keys[]?' \
        <<<"${PROJECT_SERVICES:-[]}")

    if ((${#allowed[@]} == 0)); then
        pm_portmason_runtime_secret_bindings_nul
        return 0
    fi

    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "${allowed[$key]+x}" ]] || continue
        printf '%s\0%s\0' "$key" "$resource"
    done < <(pm_portmason_runtime_secret_bindings_nul)
}

pm_portmason_secret_args_for_service() {
    local service="${1:?service required}"
    local role="${2:?service role required}"
    local key resource
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "$key" && -n "$resource" ]] || continue
        printf '%s\0%s\0' "--set-secrets" "${key}=${resource}:latest"
    done < <(pm_portmason_runtime_secret_bindings_for_service_nul "$service")
}

pm_portmason_secret_args_for_role() {
    local role="${1:?service role required}"
    pm_portmason_secret_args_for_service "$role" "$role"
}

pm_portmason_env_args_for_service() {
    local service="${1:?service required}"
    local role="${2:?service role required}"
    local key value
    while IFS= read -r -d '' key; do
        IFS= read -r -d '' value || value=""
        printf '%s\0%s\0' "--set-env-vars" "${key}=${value}"
    done < <(pm_portmason_all_env_kv_nul)
}

pm_portmason_all_env_kv_nul() {
    env_file_to_kv_nul "${ENV_FILE:?ENV_FILE required}.generated"
}

pm_portmason_resolved_runtime_env_kv_nul() {
    local key value resource

    pm_portmason_all_env_kv_nul

    while IFS= read -r -d '' key; do
        IFS= read -r -d '' resource || resource=""
        [[ -n "$key" && -n "$resource" ]] || continue
        pm_portmason_get_secret_value value "$key" \
            || die "Unable to resolve production runtime secret for local emulation: $key" 2
        [[ -n "$value" ]] \
            || die "Production runtime secret resolved empty for local emulation: $key" 2
        printf '%s\0%s\0' "$key" "$value"
    done < <(pm_portmason_runtime_secret_bindings_nul)
}

pm_portmason_env_args_for_role() {
    local role="${1:?service role required}"
    pm_portmason_env_args_for_service "$role" "$role"
}

pm_portmason_write_env_file_for_service() {
    local out_var="${1:?output variable required}"
    local pm_full_env_file
    pm_full_env_file="$(mktemp --suffix=.jenvson)" || return 2
    if ! (
        set -o pipefail
        pm_portmason_all_env_kv_nul |
        python3 -c '
import json, sys
parts = sys.stdin.buffer.read().split(b"\0")
if parts[-1:] == [b""]:
    parts.pop()
if not parts or len(parts) % 2:
    raise SystemExit("Invalid or empty environment stream")
print(json.dumps({
    parts[i].decode(): parts[i+1].decode()
    for i in range(0, len(parts), 2)
}))
' |
        python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
            "$pm_full_env_file" --format json
    ); then
        rm -f -- "$pm_full_env_file"
        return 2
    fi
    printf -v "$out_var" '%s' "$pm_full_env_file"
}

pm_portmason_write_env_file_for_role() {
    local out_var="${1:?output variable required}"
    local role="${2:?service role required}"
    pm_portmason_write_env_file_for_service "$out_var" "$role" "$role"
}

pm_portmason_bind_service_secret_access() {
	# NOOP for Portmason
	return 0
}
