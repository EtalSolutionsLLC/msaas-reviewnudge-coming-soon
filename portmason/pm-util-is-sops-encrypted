#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" --minimal "$@" >&2

# Exit codes: 0 = encrypted, 1 = not encrypted, 2 = error.
if [[ $# -ne 1 ]]; then
    printf 'Usage: pm-util-is-sops-encrypted FILE\n' >&2
    exit 2
fi
exec python3 "${PORTMASON_SHARE}/pm-secret.py" sops status -- "$1"
