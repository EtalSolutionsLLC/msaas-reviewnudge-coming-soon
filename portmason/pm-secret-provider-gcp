#!/usr/bin/env bash
set -euo pipefail

# Source-safe GCP Secret Manager provider. This module is intentionally narrower
# than pm-helpers-gcp so secret paths such as gcp:project:secret work even when
# the active runtime adapter is Azure, local, or a future AWS adapter.

get_gcp_project_number() {
    local project_id="${1:?GCP project ID required}"
    local project_info_json project_number
    project_info_json="$(gcloud projects describe "$project_id" --format=json)" \
        || return 1
    project_number="$(jq -r '.projectNumber // empty' <<<"$project_info_json")"
    [[ -n "$project_number" ]] \
        || die "GCP project number was not returned for ${project_id}" 2
    printf '%s' "$project_number"
}

get_gcp_secret() {
    local secret_ref="${1:?GCP secret reference required}"
    local project_id=""
    local secret_name=""
    local project_number=""
    local secret_value=""

    if [[ "$secret_ref" == *":"* ]]; then
        project_id="${secret_ref%%:*}"
        secret_name="${secret_ref#*:}"
    else
        project_id="${DEPLOYMENT_ID:-${GCP_PROJECT_ID:-${GOOGLE_CLOUD_PROJECT:-}}}"
        secret_name="$secret_ref"
    fi

    [[ -n "$project_id" ]] \
        || die "GCP project ID is missing for secret retrieval" 2
    [[ -n "$secret_name" ]] \
        || die "GCP secret name is missing" 2

    if ! project_number="$(get_gcp_project_number "$project_id")"; then
        die "Unable to resolve GCP project number for ${project_id}" 2
    fi
    [[ -n "$project_number" ]] \
        || die "Resolved GCP project number is empty for ${project_id}" 2

    if ! secret_value="$(
        gcloud secrets versions access latest \
            --project="$project_id" \
            --secret="$secret_name"
    )"; then
        die "Unable to access configured GCP secret" 2
    fi
    [[ -n "$secret_value" ]] \
        || die "Configured GCP secret is empty" 2

    printf '%s' "$secret_value"
}

get_gcs_secret() {
    get_gcp_secret "$@"
}

get_gcp_secret_name_from_path() {
    local path="${1:?GCP secret path required}"
    local secret_name="$path"
    [[ "$path" == *":"* ]] && secret_name="${path#*:}"
    printf '%s' "${secret_name}"
}

get_gcs_secret_name_from_path() {
    get_gcp_secret_name_from_path "$@"
}
