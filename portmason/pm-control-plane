#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runner="${script_dir}/control-plane/credential-runner/bin/pm-credential-runner"

usage() {
    cat <<'USAGE'
Usage:
  pm-control-plane secrets inventory --env-file <path>
  pm-control-plane secrets egress
  pm-control-plane secrets rotate --secret TURNSTILE_SECRET_KEY --env-file <path> [--apply]

Credential authority belongs in the control plane. Runtime applications only
consume the materialized environment values.
USAGE
}

main() {
    if [[ $# -lt 1 ]]; then
        usage
        return 2
    fi

    case "$1" in
        secrets)
            shift
            exec "$runner" "$@"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
