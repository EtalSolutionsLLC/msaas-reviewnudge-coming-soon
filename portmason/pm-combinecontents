#!/usr/bin/env bash
set -euo pipefail

OUTPUT_FILE="${1:-"./combined.txt"}"

: > "$OUTPUT_FILE"

find "." \
  -type f \
  ! -path "*/.git/*" \
  ! -path "*/node_modules/*" \
  ! -path "*/dist/*" \
  ! -path "*/build/*" \
  ! -path "*/coverage/*" \
  ! -path "*/capture/*" \
  | sort | while read -r file; do

    echo "================================================================================" >> "$OUTPUT_FILE"
    echo "FILE: $file" >> "$OUTPUT_FILE"
    echo "================================================================================" >> "$OUTPUT_FILE"

    cat "$file" >> "$OUTPUT_FILE" 2>/dev/null || \
        echo "[Unable to read file]" >> "$OUTPUT_FILE"

    printf "\n\n" >> "$OUTPUT_FILE"
done

pm-chunk-file "$OUTPUT_FILE"

echo "Combined contents written to: $OUTPUT_FILE"
