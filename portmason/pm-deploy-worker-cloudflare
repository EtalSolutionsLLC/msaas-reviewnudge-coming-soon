#!/usr/bin/env bash

set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" &d -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

: "${UNSUBSCRIBE_WORKER_NAME:=${STACK}-unsubscribe-worker}"
: "${UNSUBSCRIBE_WORKER_CODE_FILE:=${SITE_ROOT}/cloudflare-worker.js}"
: "${UNSUBSCRIBE_WORKER_ENDPOINT:=solutionsetal.com/api/unsubscribe*}"
: "${CLOUDFLARE_ZONE_NAME:=}"

TMP_DIR="$(mktemp -d)"

cleanup() {
    rm -rf "$TMP_DIR"
}

trap cleanup EXIT

main() {
    if [[ "${PM_WORKER_SECRETS_LOADED:-0}" != "1" ]]; then
        exec python3 "${PORTMASON_SHARE}/pm-secret.py" run-with-secrets \
            --secret-env "CLOUDFLARE_API_TOKEN|${CLOUDFLARE_API_TOKEN_SECRET}" \
            --secret-env "DATABASE_URL|${DATABASE_URL_SECRET}" \
            -- \
            env PM_WORKER_SECRETS_LOADED=1 \
            "$0" "$@"
    fi

    command -v wrangler >/dev/null 2>&1 || \
        die "wrangler not found"

    [[ -f "$UNSUBSCRIBE_WORKER_CODE_FILE" ]] || \
        die "worker file not found: $UNSUBSCRIBE_WORKER_CODE_FILE"

    log "Preparing temporary deployment package"

    mkdir -p "$TMP_DIR/src"

    cp \
        "$UNSUBSCRIBE_WORKER_CODE_FILE" \
        "$TMP_DIR/src/index.js"

    cat > "$TMP_DIR/wrangler.jsonc" <<JSON
{
  "name": "${UNSUBSCRIBE_WORKER_NAME}",
  "main": "src/index.js",
  "compatibility_date": "$(date +%F)"
}
JSON

    pushd "$TMP_DIR" >/dev/null

    log "Updating worker secrets"

    printf '%s' "$DATABASE_URL" \
        | wrangler secret put DATABASE_URL

    log "Deploying worker: $UNSUBSCRIBE_WORKER_NAME"

    wrangler deploy

    popd >/dev/null

    if [[ -n "$CLOUDFLARE_ZONE_NAME" ]]; then

        log "Looking up zone id for $CLOUDFLARE_ZONE_NAME"

        ZONE_ID="$(
            wrangler zones list \
                --json \
            | jq -r \
                ".[] | select(.name==\"${CLOUDFLARE_ZONE_NAME}\") | .id"
        )"

        if [[ -n "$ZONE_ID" ]]; then

            log "Ensuring route exists"

            if ! wrangler route create \
                "$UNSUBSCRIBE_WORKER_ENDPOINT" \
                --zone-id "$ZONE_ID" \
                "$UNSUBSCRIBE_WORKER_NAME" \
                2>/dev/null
            then
                log "Route already exists or create failed, continuing"
            fi
        else
            log "No zone id found for $CLOUDFLARE_ZONE_NAME"
        fi
    fi

    log "Deployment complete"
}

main "$@"
