pm_observability_validate_local_realization() {
  command -v docker >/dev/null 2>&1 || die "docker is required to validate local observability" 2
  pm_observability_local_compose config --quiet
  log INFO "local observability realization validated" \
    "store=${OBSERVABILITY_STORE_PROVIDER_PLATFORM_CODE}" \
    "dashboard=${OBSERVABILITY_DASHBOARD_PROVIDER:-disabled}"
}


observability_source_helper() {
  local code="${1:-}" file
  [[ -n "$code" ]] || return 0
  [[ "$code" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
    || die "observability helper selector contains unsupported characters: $code" 2
  file="${PORTMASON_SHARE}/pm-helpers-${code}"
  [[ -r "$file" ]] || return 0
  shift
  . "$file" "$@"
}

load_observability_helpers() {
  observability_source_helper "${OBSERVABILITY_STORE_PROVIDER_CODE:-}" "$@"
  observability_source_helper "${OBSERVABILITY_STORE_PLATFORM_CODE:-}" "$@"
}

