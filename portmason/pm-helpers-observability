observability_query_usage() {
  cat <<'USAGE'
Usage: pm-observability-query QUESTION.sql

Runs an observability workbench question. Portmason routes each statement according
to its portmason-target marker.
USAGE
}

observability_query_resolve_file() {
  local requested="${1:?question file required}"
  local candidate

  if [[ -r "$requested" ]]; then
    realpath "$requested"
    return 0
  fi

  candidate="${PROJECT_ROOT}/db/observability/workbench/queries/${requested}"
  [[ -r "$candidate" ]] \
    || die "observability workbench question is not readable: $requested" 2
  realpath "$candidate"
}

observability_query_validate_target() {
  case "${1:-}" in
    observability-warehouse|observability-log-store) return 0 ;;
    *)
      die "Unsupported portmason-target: ${1:-<empty>}" 2
      return $?
      ;;
  esac
}

observability_query_record_block() {
  local target="${1:?target required}"
  local block_file="${2:?block file required}"
  local manifest="${3:?manifest required}"

  awk '!/^[[:space:]]*($|--)/ { found = 1 } END { exit !found }' "$block_file" \
    || die "portmason-target has no SQL statement: $target" 2
  printf '%s\t%s\n' "$target" "$block_file" >>"$manifest"
}

observability_query_parse() {
  local question_file="${1:?question file required}"
  local work_dir="${2:?work directory required}"
  local manifest="${3:?manifest required}"
  local line target="" block_file="" index=0

  : >"$manifest"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^--[[:space:]]*portmason-target:[[:space:]]*([A-Za-z0-9-]+)[[:space:]]*$ ]]; then
      if [[ -n "$target" ]]; then
        observability_query_record_block "$target" "$block_file" "$manifest"
      fi
      target="${BASH_REMATCH[1]}"
      observability_query_validate_target "$target" || return $?
      ((index += 1))
      block_file="${work_dir}/block-$(printf '%04d' "$index").sql"
      : >"$block_file"
      continue
    fi

    if [[ -n "$target" ]]; then
      printf '%s\n' "$line" >>"$block_file"
    elif [[ ! "$line" =~ ^[[:space:]]*$ && ! "$line" =~ ^[[:space:]]*-- ]]; then
      die "SQL appears before the first portmason-target marker" 2
    fi
  done <"$question_file"

  [[ -n "$target" ]] \
    || die "No portmason-target markers found in $question_file" 2
  observability_query_record_block "$target" "$block_file" "$manifest"
}

observability_query_cleanup() {
  local work_dir="${OBSERVABILITY_QUERY_WORK_DIR:-}"

  [[ -n "$work_dir" ]] || return 0
  case "$work_dir" in
    "${TMPDIR:-/tmp}"/pm-observability-query.*) ;;
    *) die "Refusing to remove unexpected observability query path: $work_dir" 2 ;;
  esac
  rm -rf -- "$work_dir"
  OBSERVABILITY_QUERY_WORK_DIR=""
}

observability_query_run() {
  local question_file="${1:?question file required}"
  local work_dir manifest target block_file step=0

  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/pm-observability-query.XXXXXX")"
  manifest="${work_dir}/manifest"
  OBSERVABILITY_QUERY_WORK_DIR="$work_dir"
  trap observability_query_cleanup EXIT

  observability_query_parse "$question_file" "$work_dir" "$manifest" || return $?

  while IFS=$'\t' read -r target block_file; do
    ((step += 1))
    log INFO "running observability workbench statement" \
      "question=$(basename -- "$question_file")" "step=$step" "target=$target"
    case "$target" in
    #   observability-warehouse)
    #     observabilitobservabilitobservabilitobservability_db_rt --file=- <"$block_file"
    #     ;;
      observability-log-store)
        observability_log_store_run_file "$block_file"
        ;;
    esac
  done <"$manifest"

  observability_query_cleanup
  trap - EXIT
  log INFO "observability workbench question complete" \
    "question=$(basename -- "$question_file")" "statements=$step"
}

observability_query() {
  if (($# == 1)) && [[ "$1" == -h || "$1" == --help ]]; then
    observability_query_usage
    return 0
  fi
  (($# == 1)) || die "Usage: pm-observability-query QUESTION.sql" 2

  local question_file
  question_file="$(observability_query_resolve_file "$1")"
  observability_query_run "$question_file"
}

observability_resolve_configuration
