#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers"

pm_observability_init() {
  local invocation_dir requested_root requested_env_file active_dir

  invocation_dir="$(pwd -P)"
  pm_context_resolve_project_root requested_root
  pm_context_resolve_env_file requested_env_file "$requested_root"

  active_dir="$invocation_dir"
  case "$active_dir" in
    "$requested_root"|"$requested_root"/deploy/*) ;;
    "$requested_root"/*) active_dir="$requested_root" ;;
    *) die "observability context escapes repository root: $active_dir" 2 ;;
  esac

  [[ -r "$requested_env_file" ]] \
    || die "observability environment file is not readable: $requested_env_file" 2

  PROJECT_ROOT="$requested_root"
  REPO_ROOT="$requested_root"
  ORIG_PWD="$invocation_dir"
  SITE_DIR="$active_dir"
  SITE_ROOT="$active_dir"
  SCRIPT_DIR="$active_dir"
  ENV_FILE="$requested_env_file"
  LOG_DIR="${LOG_DIR:-$active_dir/logs}"
  LOG_FILE="${LOG_FILE:-$LOG_DIR/pm-setup-observability.log}"
  IN_CONTAINER="${IN_CONTAINER:-false}"
  export PROJECT_ROOT REPO_ROOT ORIG_PWD SITE_DIR SITE_ROOT SCRIPT_DIR
  export ENV_FILE LOG_DIR LOG_FILE IN_CONTAINER PORTMASON_SHARE

  mkdir -p -- "$LOG_DIR"
  setup_logging
}

observability_is_true() {
  case "${1,,}" in
    1|true|yes|on|enabled) return 0 ;;
    *) return 1 ;;
  esac
}

observability_validate_email() {
  local value="${1:?email address required}"
  [[ "$value" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] \
    || die "Invalid observability email delivery address: $value" 2
}

observability_validate_cron5() {
  local expression="${1:?cron expression required}"
  local -a fields=()
  read -r -a fields <<<"$expression"
  ((${#fields[@]} == 5)) \
    || die "OBSERVABILITY_DIGEST_DELIVERY_SCHEDULE must be a five-field cron expression" 2
}	

pm_observability_load_compose_model() {
  local compose_project_dir="${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR:?SCRIPT_DIR required}}"
  PM_COMPOSE_PROJECT_DIRECTORY="$compose_project_dir"
  PM_COMPOSE_FILE="${PM_COMPOSE_FILE:-docker-compose.observability.yml}"
  [[ "$PM_COMPOSE_FILE" == /* ]] \
    || PM_COMPOSE_FILE="${compose_project_dir}/${PM_COMPOSE_FILE}"
  PM_COMPOSE_CONTROL_FILE="$PM_COMPOSE_FILE"
  export PM_COMPOSE_FILE PM_COMPOSE_CONTROL_FILE PM_COMPOSE_PROJECT_DIRECTORY

  PM_COMPOSE_MODEL_JSON=""
  PROJECT_SERVICES=""
  PM_COMPOSE_CMD=()
  PM_COMPOSE_RAW_CMD=()

  pm_compose_init_command
  pm_compose_load_model

  PM_COMPOSE_MODEL_JSON=""
}

pm_observability_require_compose_service() {
  local component="${1:?observability component required}"
  local service_row

  pm_observability_load_compose_model
  service_row="$(pm_compose_observability_service_tsv "$component")"
  [[ -n "$service_row" ]] \
    || die "observability Compose model does not declare the ${component} capability" 2
}

pm_observability_require_compose_service() {
  local component="${1:?observability component required}"
  local service_row

  pm_observability_load_compose_model
  service_row="$(pm_compose_observability_service_tsv "$component")"
  [[ -n "$service_row" ]] \
    || die "Observability Compose model does not declare the ${component} component" 2
}

observability_resolve_configuration() {
  local master_enabled=false
  local store_selector="${OBSERVABILITY_STORE_PROVIDER_PLATFORM_CODE:-}"
  OBSERVABILITY_STORE_PROVIDER_CODE="${store_selector%%-*}"
  OBSERVABILITY_STORE_PLATFORM_CODE="${store_selector#*-}"
  local store_database="${OBSERVABILITY_STORE_NAME:-}"

  observability_is_true "${OBSERVABILITY_ENABLED:-false}" && master_enabled=true

  if [[ "$master_enabled" == true ]]; then
    [[ -n "$store_selector" ]] || die "OBSERVABILITY_STORE_PROVIDER_PLATFORM_CODE is required when observability is enabled" 2
    [[ "$store_selector" == *-* ]] || die "OBSERVABILITY_STORE_PROVIDER_PLATFORM_CODE must use provider-platform form" 2
    [[ "${OBSERVABILITY_STORE_EXTERNAL_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || die "OBSERVABILITY_STORE_EXTERNAL_URL is required and must be an HTTP or HTTPS URL" 2
    [[ "${OBSERVABILITY_STORE_INTERNAL_URL:-}" =~ ^https?://[^[:space:]]+$ ]] || die "OBSERVABILITY_STORE_INTERNAL_URL is required and must be an HTTP or HTTPS URL" 2
  fi

  OBSERVABILITY_ENABLED="$master_enabled"
  if [[ "$master_enabled" == true ]]; then
    if [[ -z "$store_database" || "$store_database" == observability ]]; then
      store_database="${STACK:?STACK required for observability store isolation}"
      store_database="${store_database//-/_}_observability"
      log INFO "derived isolated observability store database" "database=$store_database" "stack=$STACK"
      env_init_set OBSERVABILITY_STORE_NAME "$store_database"
    fi
    [[ "$store_database" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "OBSERVABILITY_STORE_NAME must be a database identifier" 2
  fi
  export OBSERVABILITY_ENABLED OBSERVABILITY_STORE_PROVIDER_CODE OBSERVABILITY_STORE_PLATFORM_CODE
}

pm_observability_local_compose() {
  local compose_project_dir="${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR:?SCRIPT_DIR required}}"
  local generated_env="${ENV_FILE:?ENV_FILE required}.generated"
  local overlay="${PM_COMPOSE_FILE:-docker-compose.observability.yml}"
  [[ "$overlay" == /* ]] || overlay="${compose_project_dir}/${overlay}"
  [[ -r "$generated_env" && -r "$overlay" ]] || die "observability Compose inputs are not readable" 2
  python3 "${PORTMASON_SHARE}/pm-compose-encrypted.py" \
    --project-directory "$compose_project_dir" --env-file "$generated_env" \
    -f "$overlay" "$@"
}

pm_observability_ensure_external_volumes() {
  local compose_json="" volume=""
  compose_json="$(pm_observability_local_compose config --format json)"
  while IFS= read -r volume; do
    [[ -n "$volume" ]] || continue
    if docker volume inspect "$volume" >/dev/null 2>&1; then
      log DEBUG "external observability volume exists" "volume=$volume"
      continue
    fi
    docker volume create "$volume" >/dev/null
    log INFO "external observability volume created" "volume=$volume"
  done < <(jq -r '.volumes // {} | to_entries[] | select(.value.external == true) | (.value.name // .key)' <<<"$compose_json")
}

pm_observability_prepare_local_paths() {
  local compose_project_dir="${PM_COMPOSE_PROJECT_DIRECTORY:-${SCRIPT_DIR:?SCRIPT_DIR required}}"
  local alert_target="${compose_project_dir}/.portmason/observability-alerting"
  mkdir -p "$alert_target"
  [[ -w "$alert_target" ]] \
    || die "Generated observability alert directory is not writable: $alert_target" 2
}

