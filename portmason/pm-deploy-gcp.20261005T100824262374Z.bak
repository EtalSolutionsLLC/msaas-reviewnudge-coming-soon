#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

write_env_file_for_service_compat() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local role="${3:?role required}"

    if declare -F pm_gcp_write_env_file_for_service >/dev/null 2>&1; then
        pm_gcp_write_env_file_for_service "$out_var" "$service" "$role"
    elif declare -F write_env_file_for_service >/dev/null 2>&1; then
        write_env_file_for_service "$out_var" "$service" "$role"
    elif declare -F pm_gcp_write_env_file_for_role >/dev/null 2>&1; then
        pm_gcp_write_env_file_for_role "$out_var" "$role"
    else
        write_env_file_for_role "$out_var" "$role"
    fi

    pm_gcp_filter_reserved_env_file "${!out_var}"
    pm_gcp_append_queue_env "${!out_var}"
    pm_gcp_append_scheduled_work_env "${!out_var}" "$service"
}

pm_gcp_queue_worker_service() {
    local out_var="${1:?output variable required}"
    local value
    value="$(jq -r '.[] | select(.role == "worker" and .queue_consume != "") | .service' \
        <<<"${PROJECT_SERVICES:-[]}" | head -n1)"
    [[ "$value" != "null" ]] || value=""
    printf -v "$out_var" '%s' "$value"
}

pm_gcp_service_queue_consumer() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local value

    value="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .queue_consume // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"

    [[ "$value" != "null" ]] || value=""
    printf -v "$out_var" '%s' "$value"
}

pm_gcp_queue_push_path() {
    local out_var="${1:?output variable required}"
    local worker="${2:?worker service required}"
    local value
    value="$(jq -r --arg service "$worker" \
        '.[] | select(.service == $service) | .queue_path // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    [[ -n "$value" ]] || value="/api/inbound-events"
    printf -v "$out_var" '%s' "$value"
}

pm_gcp_append_queue_env() {
    local file="${1:?environment file required}"
    local worker topic push_path plaintext
    pm_gcp_queue_worker_service worker
    [[ -n "$worker" ]] || return 0
    resource_name topic "$worker"
    pm_gcp_queue_push_path push_path "$worker"
    pm_decrypt_file "$file" plaintext || return 2
    printf '%s\n' "$plaintext" |
        jq --arg project "$DEPLOYMENT_ID" \
           --arg topic "$topic" --arg path "$push_path" \
           '. + {
               PM_QUEUE_PROVIDER: "pubsub",
               PM_QUEUE_PROJECT: $project,
               PM_QUEUE_TOPIC: $topic,
               PM_QUEUE_PUSH_PATH: $path
           }' |
        python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
            "$file" --format json
}

pm_gcp_append_scheduled_work_env() {
    local file="${1:?environment file required}"
    local service="${2:?service required}"
    local worker logical_queue worker_account tasks_queue role publish tmp

    pm_gcp_scheduled_delivery_requested || return 0
    pm_gcp_queue_worker_service worker
    [[ -n "$worker" ]] || return 0
    pm_gcp_service_queue_consumer logical_queue "$worker"
    [[ -n "$logical_queue" ]] || return 0

    role="$(jq -r --arg service "$service" '.[] | select(.service == $service) | .role // empty' <<<"${PROJECT_SERVICES:-[]}")"
    publish="$(jq -r --arg service "$service" '.[] | select(.service == $service) | .queue_publish // empty' <<<"${PROJECT_SERVICES:-[]}")"

    if [[ "$service" != "$worker" ]]; then
        [[ "$role" != "scheduler" && "$publish" == "$logical_queue" ]] || return 0
    fi

    runtime_service_account worker_account "$worker"
    resource_name tasks_queue "${worker}-scheduled"

    local plaintext
    pm_decrypt_file "$file" plaintext || return 2
    printf '%s\n' "$plaintext" |
        jq --arg project "$DEPLOYMENT_ID" --arg region "$REGION" \
           --arg queue "$tasks_queue" --arg account "$worker_account" \
           '. + {
               PM_SCHEDULED_WORK_PROVIDER: "cloud-tasks",
               PM_SCHEDULED_WORK_PROJECT: $project,
               PM_SCHEDULED_WORK_LOCATION: $region,
               PM_SCHEDULED_WORK_QUEUE: $queue,
               PM_SCHEDULED_WORK_SERVICE_ACCOUNT: $account
           }' |
        python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
            "$file" --format json
}

pm_gcp_filter_reserved_env_file() {
    local file="${1:?environment file required}"
    local plaintext
    pm_decrypt_file "$file" plaintext || return 2
    printf '%s\n' "$plaintext" |
        jq 'del(.PORT, .K_SERVICE, .K_REVISION, .K_CONFIGURATION)' |
        python3 "${PORTMASON_SHARE}/pm-secret.py" encrypt-file \
            "$file" --format json
}

secret_args_for_service_compat() {
    local service="${1:?service required}"
    local role="${2:?role required}"

    if declare -F pm_gcp_secret_args_for_service >/dev/null 2>&1; then
        pm_gcp_secret_args_for_service "$service" "$role"
    elif declare -F secret_args_for_service >/dev/null 2>&1; then
        secret_args_for_service "$service" "$role"
    elif declare -F pm_gcp_secret_args_for_role >/dev/null 2>&1; then
        pm_gcp_secret_args_for_role "$role"
    else
        secret_args_for_role "$role"
    fi
}

bind_service_secret_access_compat() {
    local service_account="${1:?service account required}"
    local service="${2:?service required}"
    local role="${3:?role required}"

    # Build 087 helpers expose service-scoped configuration functions. Older
    # test/project shims expose only role-scoped functions and the historical
    # two-argument IAM helper; preserve that boundary for one transition cycle.
    if declare -F pm_gcp_bind_service_secret_access >/dev/null 2>&1; then
        pm_gcp_bind_service_secret_access "$service_account" "$service" "$role"
    elif declare -F write_env_file_for_service >/dev/null 2>&1; then
        bind_service_secret_access "$service_account" "$service" "$role"
    else
        bind_service_secret_access "$service_account" "$role"
    fi
}

resource_name() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local value="${STACK:?STACK required}-${service}"
    value="${value,,}"
    value="$(printf '%s' "$value" | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//')"
    [[ "$value" =~ ^[a-z] ]] || value="p-${value}"
    printf -v "$out_var" '%s' "${value:0:63}"
}

compose_image_for_service() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local configured_image="${3:-}"
    local image="$configured_image"
    [[ -n "$image" ]] || image="${STACK}-${service}:latest"
    printf -v "$out_var" '%s' "$image"
}

build_service_image() {
    local service="${1:?service required}"
    local has_build="${2:-false}"
    if [[ "$has_build" == "true" ]]; then
        if declare -F pm_runtime_verify_build_inputs >/dev/null 2>&1; then
            log INFO "verifying runtime build inputs" "service=$service"
            pm_runtime_verify_build_inputs
        fi
        log INFO "building Compose service image" "service=$service"

		BUILDX_NO_DEFAULT_ATTESTATIONS=1 
        BUILDX_NO_DEFAULT_ATTESTATIONS=1 "${PM_COMPOSE_CMD[@]}" build "$service"

#        "${PM_COMPOSE_CMD[@]}" build "$service"
        log INFO "Compose image build complete" "service=$service"
    else
        log DEBUG "service has no build section" "service=$service"
    fi
}

push_service_image() {
    local service="${1:?service required}"
    local source_image="${2:?source image required}"
    local out_var="${3:?output variable required}"
    local resource tag resolved_target_image

    resource_name resource "$service"
    tag="${PM_IMAGE_TAG:-$(date -u +%Y%m%d-%H%M%S)}"
    resolved_target_image="${REGION}-docker.pkg.dev/${DEPLOYMENT_ID}/${AR_REPO}/${resource}:${tag}"

    log INFO "tagging service image" \
        "service=$service" "source=$source_image" "target=$resolved_target_image"
    if ! docker image inspect "$source_image" >/dev/null 2>&1; then
        die "Compose service image is not available locally: $source_image" 2
        return 2
    fi
    if ! docker tag "$source_image" "$resolved_target_image"; then
        die "docker tag failed for $resolved_target_image" 2
        return 2
    fi

    log INFO "pushing service image" \
        "service=$service" "target=$resolved_target_image"
    if ! docker push --quiet "$resolved_target_image" >/dev/null; then
        die "docker push failed for $resolved_target_image" 2
        return 2
    fi
    log INFO "service image pushed" \
        "service=$service" "target=$resolved_target_image"

    printf -v "$out_var" '%s' "$resolved_target_image"
}

service_command_args() {
    local service="${1:?service required}"
    local -n out_ref="${2:?output array variable required}"
    local command_json entrypoint_json first rest

    command_json="$(jq -c --arg service "$service" \
        '.[] | select(.service == $service) | .command' \
        <<<"${PROJECT_SERVICES:-[]}")"
    entrypoint_json="$(jq -c --arg service "$service" \
        '.[] | select(.service == $service) | .entrypoint' \
        <<<"${PROJECT_SERVICES:-[]}")"

    if [[ "$entrypoint_json" != "null" && "$entrypoint_json" != "[]" && -n "$entrypoint_json" ]]; then
        first="$(jq -r 'if type == "array" then .[0] // empty else . end' <<<"$entrypoint_json")"
        if [[ -n "$first" ]]; then
            out_ref+=(--command "$first")
        fi
    fi

    if [[ "$command_json" != "null" && "$command_json" != "[]" && -n "$command_json" ]]; then
        first="$(jq -r 'if type == "array" then .[0] // empty else empty end' <<<"$command_json")"
        rest="$(jq -r 'if type == "array" then .[1:] | join(",") else . end' <<<"$command_json")"
        if [[ -n "$first" && ${#out_ref[@]} -eq 0 ]]; then
            out_ref+=(--command "$first")
        fi
        if [[ -n "$rest" ]]; then
            out_ref+=(--args "$rest")
        fi
    fi
}

service_run_once_args() {
    local service="${1:?service required}"
    local out_name="${2:?output array variable required}"
    local -n out_ref="$out_name"
    local run_command run_args

    run_command="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .run_command // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    run_args="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .run_args // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"

    if [[ -n "$run_command" ]]; then
        out_ref=(--command "$run_command")
        if [[ -n "$run_args" ]]; then
            out_ref+=(--args "$run_args")
        fi
    else
        service_command_args "$service" "$out_name"
    fi
}

runtime_service_account() {
    local out_var="${1:?output variable required}"
    local service="${2:?service required}"
    local email
    email="$(format_sa_email "$service")"
    printf -v "$out_var" '%s' "$email"
}

ensure_pubsub_push_queue() {
    local service="${1:?worker service required}"
    local service_account="${2:?worker service account required}"
    local service_url="${3:?worker service URL required}"
    local topic dead_letter subscription project_number pubsub_agent publisher_service publisher_account queue_name push_path

    resource_name topic "$service"
    queue_name="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .queue_consume // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    [[ -n "$queue_name" ]] || die "Worker service $service has no queue consumer declaration" 2
    pm_gcp_queue_push_path push_path "$service"
    dead_letter="${topic}-dead-letter"
    subscription="${topic}-push"

    for candidate in "$topic" "$dead_letter"; do
        if ! gcloud pubsub topics describe "$candidate" --project "$DEPLOYMENT_ID" >/dev/null 2>&1; then
            gcloud pubsub topics create "$candidate" --project "$DEPLOYMENT_ID" >/dev/null
        fi
    done

    while IFS= read -r publisher_service; do
        [[ -n "$publisher_service" ]] || continue
        runtime_service_account publisher_account "$publisher_service"
        gcloud pubsub topics add-iam-policy-binding "$topic" \
            --project "$DEPLOYMENT_ID" \
            --member "serviceAccount:${publisher_account}" \
            --role roles/pubsub.publisher --quiet >/dev/null
    done < <(jq -r --arg queue "$queue_name" \
        '.[] | select(.queue_publish == $queue) | .service' \
        <<<"${PROJECT_SERVICES:-[]}")

    gcloud run services add-iam-policy-binding "$topic" \
        --project "$DEPLOYMENT_ID" --region "$REGION" \
        --member "serviceAccount:${service_account}" \
        --role roles/run.invoker --quiet >/dev/null

    project_number="$(gcloud projects describe "$DEPLOYMENT_ID" --format='value(projectNumber)')"
    pubsub_agent="service-${project_number}@gcp-sa-pubsub.iam.gserviceaccount.com"
    gcloud iam service-accounts add-iam-policy-binding "$service_account" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${pubsub_agent}" \
        --role roles/iam.serviceAccountTokenCreator --quiet >/dev/null
    gcloud pubsub topics add-iam-policy-binding "$dead_letter" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${pubsub_agent}" \
        --role roles/pubsub.publisher --quiet >/dev/null

    local -a subscription_args=(
        --project "$DEPLOYMENT_ID"
        --ack-deadline 60
        --push-endpoint "${service_url}${push_path}"
        --push-auth-service-account "$service_account"
        --push-auth-token-audience "$service_url"
        --dead-letter-topic "$dead_letter"
        --max-delivery-attempts 5
    )
    if gcloud pubsub subscriptions describe "$subscription" --project "$DEPLOYMENT_ID" >/dev/null 2>&1; then
        gcloud pubsub subscriptions update "$subscription" "${subscription_args[@]}" >/dev/null
    else
        gcloud pubsub subscriptions create "$subscription" \
            --topic "$topic" "${subscription_args[@]}" >/dev/null
    fi
    gcloud pubsub subscriptions add-iam-policy-binding "$subscription" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${pubsub_agent}" \
        --role roles/pubsub.subscriber --quiet >/dev/null

    log INFO "Pub/Sub push queue ready" \
        "topic=$topic" "subscription=$subscription" "dead_letter_topic=$dead_letter"
}

pm_gcp_scheduled_delivery_requested() {
    jq -e 'any(.[]?; .role == "queue" and ((.queue_delivery // "") | test("(^|,)scheduled(,|$)")))' \
        >/dev/null 2>&1 <<<"${PROJECT_SERVICES:-[]}"
}

ensure_cloud_tasks_scheduled_queue() {
    pm_gcp_scheduled_delivery_requested || return 0

    local worker logical_queue worker_account topic tasks_queue
    local project_number tasks_agent service service_account
    pm_gcp_queue_worker_service worker
    [[ -n "$worker" ]] || die "Scheduled queue delivery requires a queue-consuming worker" 2
    pm_gcp_service_queue_consumer logical_queue "$worker"
    [[ -n "$logical_queue" ]] || die "Scheduled queue delivery requires a logical queue" 2
    runtime_service_account worker_account "$worker"
    resource_name topic "$worker"
    resource_name tasks_queue "${worker}-scheduled"

    if gcloud tasks queues describe "$tasks_queue" \
        --project "$DEPLOYMENT_ID" --location "$REGION" >/dev/null 2>&1; then
        gcloud tasks queues update "$tasks_queue" \
            --project "$DEPLOYMENT_ID" --location "$REGION" \
            --max-attempts 5 --min-backoff 10s --max-backoff 300s --max-doublings 5 >/dev/null
    else
        gcloud tasks queues create "$tasks_queue" \
            --project "$DEPLOYMENT_ID" --location "$REGION" \
            --max-attempts 5 --min-backoff 10s --max-backoff 300s --max-doublings 5 >/dev/null
    fi

    project_number="$(gcloud projects describe "$DEPLOYMENT_ID" --format='value(projectNumber)')"
    tasks_agent="service-${project_number}@gcp-sa-cloudtasks.iam.gserviceaccount.com"
    gcloud iam service-accounts add-iam-policy-binding "$worker_account" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${tasks_agent}" \
        --role roles/iam.serviceAccountTokenCreator --quiet >/dev/null
    gcloud pubsub topics add-iam-policy-binding "$topic" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${worker_account}" \
        --role roles/pubsub.publisher --quiet >/dev/null

    while IFS= read -r service; do
        [[ -n "$service" ]] || continue
        runtime_service_account service_account "$service"
        gcloud projects add-iam-policy-binding "$DEPLOYMENT_ID" \
            --member "serviceAccount:${service_account}" \
            --role roles/cloudtasks.enqueuer --condition=None --quiet >/dev/null
        gcloud iam service-accounts add-iam-policy-binding "$worker_account" \
            --project "$DEPLOYMENT_ID" \
            --member "serviceAccount:${service_account}" \
            --role roles/iam.serviceAccountUser --quiet >/dev/null
    done < <(jq -r --arg worker "$worker" --arg queue "$logical_queue" '
        .[]
        | select(.service == $worker or (.queue_publish == $queue and .role != "scheduler"))
        | .service
    ' <<<"${PROJECT_SERVICES:-[]}")

    log INFO "Cloud Tasks scheduled queue ready" \
        "queue=$tasks_queue" "target=pubsub://${DEPLOYMENT_ID}/${topic}"
}

ensure_compose_schedules() {
    jq -e 'any(.[]?; .role == "scheduler" and ((.schedules // []) | length) > 0)' \
        >/dev/null 2>&1 <<<"${PROJECT_SERVICES:-[]}" || return 0

    local worker topic project_number scheduler_agent service schedule_name schedule timezone scheduler message
    local scheduler_prefix existing_scheduler existing_schedulers managed desired
    local -a desired_schedulers=()
    local -a managed_schedule_prefixes=()
    pm_gcp_queue_worker_service worker
    [[ -n "$worker" ]] || die "Compose scheduler requires a queue-consuming worker" 2
    resource_name topic "$worker"

    project_number="$(gcloud projects describe "$DEPLOYMENT_ID" --format='value(projectNumber)')"
    scheduler_agent="service-${project_number}@gcp-sa-cloudscheduler.iam.gserviceaccount.com"
    gcloud pubsub topics add-iam-policy-binding "$topic" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${scheduler_agent}" \
        --role roles/pubsub.publisher --quiet >/dev/null

    while IFS= read -r service; do
        [[ -n "$service" ]] || continue
        resource_name scheduler_prefix "$service"
        managed_schedule_prefixes+=("${scheduler_prefix}-")
    done < <(jq -r '
        [.[] | select(.role == "scheduler" and ((.schedules // []) | length) > 0) | .service]
        | unique[]
    ' <<<"${PROJECT_SERVICES:-[]}")

    while IFS=$'\t' read -r service schedule_name schedule timezone; do
        [[ -n "$service" && -n "$schedule_name" && -n "$schedule" ]] || continue
        resource_name scheduler "${service}-${schedule_name}"
        desired_schedulers+=("$scheduler")
        message="$(jq -cn --arg task "$schedule_name" '{kind:"scheduled",task:$task}')"
        local -a scheduler_args=(
            --project "$DEPLOYMENT_ID"
            --location "$REGION"
            --schedule "$schedule"
            --time-zone "${timezone:-Etc/UTC}"
            --topic "$topic"
            --message-body "$message"
        )
        if gcloud scheduler jobs describe "$scheduler" \
            --project "$DEPLOYMENT_ID" --location "$REGION" >/dev/null 2>&1; then
            gcloud scheduler jobs update pubsub "$scheduler" "${scheduler_args[@]}" >/dev/null
        else
            gcloud scheduler jobs create pubsub "$scheduler" "${scheduler_args[@]}" >/dev/null
        fi
        log INFO "Cloud Scheduler queue trigger ready" \
            "scheduler=$scheduler" "topic=$topic" "schedule=$schedule"
    done < <(jq -r '
        .[]
        | select(.role == "scheduler")
        | . as $service
        | (.schedules // [])[]
        | [$service.service, .name, .cron, ($service.schedule_timezone // "Etc/UTC")]
        | @tsv
    ' <<<"${PROJECT_SERVICES:-[]}")

    existing_schedulers="$(gcloud scheduler jobs list \
        --project "$DEPLOYMENT_ID" --location "$REGION" \
        --format='value(name.basename())')" \
        || die "Unable to list Cloud Scheduler jobs for Compose schedule reconciliation" 2

    while IFS= read -r existing_scheduler; do
        [[ -n "$existing_scheduler" ]] || continue
        managed=false
        for scheduler_prefix in "${managed_schedule_prefixes[@]}"; do
            if [[ "$existing_scheduler" == "$scheduler_prefix"* ]]; then
                managed=true
                break
            fi
        done
        [[ "$managed" == "true" ]] || continue

        desired=false
        for scheduler in "${desired_schedulers[@]}"; do
            if [[ "$existing_scheduler" == "$scheduler" ]]; then
                desired=true
                break
            fi
        done
        [[ "$desired" == "false" ]] || continue

        log INFO "deleting obsolete Compose Cloud Scheduler queue trigger" \
            "scheduler=$existing_scheduler"
        gcloud scheduler jobs delete "$existing_scheduler" \
            --project "$DEPLOYMENT_ID" --location "$REGION" --quiet >/dev/null
    done <<<"$existing_schedulers"
}

ensure_cloud_run_job_schedule() {
    local service="${1:?service required}"
    local resource="${2:?Cloud Run job resource required}"
    local service_account="${3:?service account required}"
    local schedule timezone scheduler project_number scheduler_agent run_url
    schedule="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .schedule_cron // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    [[ -n "$schedule" ]] || return 0
    timezone="$(jq -r --arg service "$service" \
        '.[] | select(.service == $service) | .schedule_timezone // empty' \
        <<<"${PROJECT_SERVICES:-[]}")"
    [[ -n "$timezone" ]] || timezone="Etc/UTC"
    scheduler="${resource}-schedule"
    run_url="https://run.googleapis.com/v2/projects/${DEPLOYMENT_ID}/locations/${REGION}/jobs/${resource}:run"

    gcloud run jobs add-iam-policy-binding "$resource" \
        --project "$DEPLOYMENT_ID" --region "$REGION" \
        --member "serviceAccount:${service_account}" \
        --role roles/run.invoker --quiet >/dev/null

    project_number="$(gcloud projects describe "$DEPLOYMENT_ID" --format='value(projectNumber)')"
    scheduler_agent="service-${project_number}@gcp-sa-cloudscheduler.iam.gserviceaccount.com"
    gcloud iam service-accounts add-iam-policy-binding "$service_account" \
        --project "$DEPLOYMENT_ID" \
        --member "serviceAccount:${scheduler_agent}" \
        --role roles/iam.serviceAccountTokenCreator --quiet >/dev/null

    local -a scheduler_args=(
        --project "$DEPLOYMENT_ID"
        --location "$REGION"
        --schedule "$schedule"
        --time-zone "$timezone"
        --uri "$run_url"
        --http-method POST
        --oauth-service-account-email "$service_account"
        --oauth-token-scope "https://www.googleapis.com/auth/cloud-platform"
        --message-body '{}'
    )
    if gcloud scheduler jobs describe "$scheduler" \
        --project "$DEPLOYMENT_ID" --location "$REGION" >/dev/null 2>&1; then
        gcloud scheduler jobs update http "$scheduler" \
            "${scheduler_args[@]}" \
            --update-headers "Content-Type=application/json" >/dev/null
    else
        gcloud scheduler jobs create http "$scheduler" \
            "${scheduler_args[@]}" \
            --headers "Content-Type=application/json" >/dev/null
    fi
    log INFO "Cloud Run job schedule ready" \
        "resource=$resource" "scheduler=$scheduler" "schedule=$schedule" "timezone=$timezone"
}

pm_gcp_cloud_sql_connections_csv() {
    local out_var="${1:?output variable required}"
    local result=""
    local candidate

    for candidate in \
        "${CLOUD_SQL_CONNECTION_NAME:-}" \
        "${OBSERVABILITY_CLOUD_SQL_CONNECTION_NAME:-}"
    do
        [[ -n "$candidate" ]] || continue
        if [[ ",$result," != *",$candidate,"* ]]; then
            [[ -z "$result" ]] || result+=','
            result+="$candidate"
        fi
    done

    printf -v "$out_var" '%s' "$result"
}

pm_gcp_cloud_run_service_pinned_traffic() {
    local out_var="${1:?output variable required}"
    local resource="${2:?Cloud Run service resource required}"
    local pinned_revisions

    pinned_revisions="$(gcloud run services describe "$resource" \
        --project "$DEPLOYMENT_ID" --region "$REGION" \
        --format='value(spec.traffic.revisionName)' 2>/dev/null || true)"
    printf -v "$out_var" '%s' "$pinned_revisions"
}

pm_gcp_wait_for_staged_revision() {
    local out_var="${1:?output variable required}"
    local resource="${2:?Cloud Run service resource required}"
    local previous_revision="${3:-}"
    local candidate="" readiness="" attempt
    local attempts=150

    for ((attempt = 1; attempt <= attempts; attempt++)); do
        candidate="$(gcloud run services describe "$resource" \
            --project "$DEPLOYMENT_ID" --region "$REGION" \
            --format='value(status.latestCreatedRevisionName)' 2>/dev/null || true)"
        if [[ -n "$candidate" && "$candidate" != "$previous_revision" ]]; then
            readiness="$(gcloud run revisions describe "$candidate" \
                --project "$DEPLOYMENT_ID" --region "$REGION" \
                --format='value(status.conditions[0].status)' 2>/dev/null || true)"
            case "$readiness" in
                True)
                    printf -v "$out_var" '%s' "$candidate"
                    return 0
                    ;;
                False)
                    die "Staged Cloud Run revision is not Ready: $candidate" 2
                    return 2
                    ;;
            esac
        fi
        sleep 2
    done

    die "Timed out waiting for staged Cloud Run revision readiness: $resource" 2
    return 2
}

deploy_cloud_run_service() {
    local service="${1:?service required}"
    local role="${2:?role required}"
    local image="${3:?image required}"
    local resource service_account env_file="" cloudsql_connections="" pinned_traffic="" previous_revision="" staged_revision=""
    local -a env_flags=() secret_flags=() command_flags=() cloudsql_flags=() traffic_flags=() deploy_flags=()
    local -a secret_cleanup_flags=(--clear-secrets)
    local -a access_flags=(--allow-unauthenticated)

    resource_name resource "$service"
    pm_gcp_cloud_run_service_pinned_traffic pinned_traffic "$resource"
    if [[ "$pinned_traffic" =~ [^[:space:]] ]]; then
        previous_revision="$(gcloud run services describe "$resource" \
            --project "$DEPLOYMENT_ID" --region "$REGION" \
            --format='value(status.latestCreatedRevisionName)' 2>/dev/null || true)"
        traffic_flags=(--no-traffic)
        deploy_flags=(--async)
        log INFO "staging Cloud Run revision without changing pinned traffic" \
            "resource=$resource" "action=stage-without-traffic"
    fi
    runtime_service_account service_account "$service"
	write_env_file_for_service_compat env_file "$service" "$role"

	log INFO "Generated environment file"

    env_flags=(--env-vars-file "$env_file")
	secret_flags=()
    service_run_once_args "$service" command_flags
    pm_gcp_cloud_sql_connections_csv cloudsql_connections
    [[ -z "$cloudsql_connections" ]] \
        || cloudsql_flags=(--add-cloudsql-instances "$cloudsql_connections")

    if [[ "$role" == "worker" ]]; then
        access_flags=(--no-allow-unauthenticated --ingress internal)
    fi

    local -a cmd=(
        gcloud run deploy "$resource"
        --project "$DEPLOYMENT_ID"
        --region "$REGION"
        --platform managed
        --image "$image"
        --service-account "$service_account"
        "${access_flags[@]}"
        "${traffic_flags[@]}"
        "${deploy_flags[@]}"
        --port "${PORT:-8080}"
        --startup-probe "httpGet.path=${PM_HEALTH_PATH:-/livez},initialDelaySeconds=15,periodSeconds=10,timeoutSeconds=10,failureThreshold=30"
        "${cloudsql_flags[@]}"
        "${env_flags[@]}"
        "${secret_cleanup_flags[@]}"
        "${secret_flags[@]}"
        "${command_flags[@]}"
    )


    pm_gcp_remove_legacy_secret_bindings "$resource"

    log INFO "deploying Cloud Run service" \
        "compose_service=$service" "resource=$resource" "role=$role" \
        "service_account=$service_account"
    log_cmd "${cmd[@]}"
    if ! python3 "${PORTMASON_SHARE}/pm-gcp-encrypted-env.py" \
        -- "${cmd[@]}" >/dev/null; then
        rm -f "$env_file"
        die "Cloud Run service deployment failed: $resource" 2
        return 2
    fi
    if [[ -n "$pinned_traffic" ]]; then
        if ! pm_gcp_wait_for_staged_revision staged_revision "$resource" "$previous_revision"; then
            rm -f "$env_file"
            return 2
        fi
        log INFO "staged Cloud Run revision is Ready; traffic remains pinned" \
            "resource=$resource" "revision=$staged_revision"
    fi
    rm -f "$env_file"

    local url
    url="$(gcloud run services describe "$resource" \
        --project "$DEPLOYMENT_ID" --region "$REGION" \
        --format='value(status.url)')"
    log INFO "Cloud Run service deployment complete" \
        "resource=$resource" "url=$url"

    if [[ "$role" == "worker" ]]; then
        local queue_consume
        pm_gcp_service_queue_consumer queue_consume "$service"

        if [[ -n "$queue_consume" ]]; then
            ensure_pubsub_push_queue "$service" "$service_account" "$url"
        else
            log INFO "worker has no queue consumer declaration; skipping Pub/Sub push subscription" \
                "service=$service"
        fi
    fi

    if [[ "$role" == "worker" ]] && gcloud run jobs describe "$resource" \
        --project "$DEPLOYMENT_ID" --region "$REGION" >/dev/null 2>&1; then
        log INFO "removing obsolete Cloud Run job after worker service migration" \
            "resource=$resource"
        gcloud run jobs delete "$resource" \
            --project "$DEPLOYMENT_ID" --region "$REGION" --quiet >/dev/null
    fi

    if [[ "$role" == "web" || "$role" == "app" ]]; then
        env_init_set ALTERNATE_APP_URL "$url"
    fi
}

deploy_cloud_run_job() {
    local service="${1:?service required}"
    local role="${2:?role required}"
    local image="${3:?image required}"
    local resource service_account action env_file="" cloudsql_connections=""
    local -a env_flags=() secret_flags=() command_flags=() cloudsql_flags=()

    resource_name resource "$service"
    runtime_service_account service_account "$service"
    write_env_file_for_service_compat env_file "$service" "$role"


	log INFO "Generated environment file"

    env_flags=(--env-vars-file "$env_file")
	secret_flags=()
#    secret_flags=()
    service_command_args "$service" command_flags
    pm_gcp_cloud_sql_connections_csv cloudsql_connections
    [[ -z "$cloudsql_connections" ]] \
        || cloudsql_flags=(--set-cloudsql-instances "$cloudsql_connections")

    action="update"
    if ! gcloud run jobs describe "$resource" \
        --project "$DEPLOYMENT_ID" --region "$REGION" >/dev/null 2>&1; then
        action="create"
    fi

    local -a cmd=(
        gcloud run jobs "$action" "$resource"
        --project "$DEPLOYMENT_ID"
        --region "$REGION"
        --image "$image"
        --service-account "$service_account"
        "${cloudsql_flags[@]}"
        "${env_flags[@]}"
        "${secret_flags[@]}"
        "${command_flags[@]}"
    )

    log INFO "ensuring Cloud Run job" \
        "compose_service=$service" "resource=$resource" "role=$role" \
        "action=$action" "service_account=$service_account"
    log_cmd "${cmd[@]}"
    if ! python3 "${PORTMASON_SHARE}/pm-gcp-encrypted-env.py" \
        -- "${cmd[@]}" >/dev/null; then
        rm -f "$env_file"
        die "Cloud Run job deployment failed: $resource" 2
        return 2
    fi
    rm -f "$env_file"
    log INFO "Cloud Run job ready" "resource=$resource"
    ensure_cloud_run_job_schedule "$service" "$resource" "$service_account"
}

deploy_compose_service() {
    local service="${1:?service required}"
    local role="${2:?role required}"
    local configured_image="${3:-}"
    local has_build="${4:-false}"
    local source_image target_image

    compose_image_for_service source_image "$service" "$configured_image"
    build_service_image "$service" "$has_build"
    push_service_image "$service" "$source_image" target_image

    case "$role" in
        jobs)
            deploy_cloud_run_job "$service" "$role" "$target_image"
            ;;
        worker)
            deploy_cloud_run_service "$service" "$role" "$target_image"
            ;;
        *)
            deploy_cloud_run_service "$service" "$role" "$target_image"
            ;;
    esac
}

bind_cloudsql_client() {
    local service_account="${1:?service account required}"
    log INFO "ensuring Cloud SQL client role" \
        "service_account=$service_account" "project=$DEPLOYMENT_ID"
    gcloud projects add-iam-policy-binding "$DEPLOYMENT_ID" \
        --member "serviceAccount:${service_account}" \
        --role roles/cloudsql.client \
        --quiet >/dev/null
}

pm_deploobservabilitobservabilitobservability_db_platform() {
    [[ "${DB_PLATFORM_CODE:-}" == "gcp" ]] \
        || die "pm-deploy-gcp database entrypoint requires DB_PLATFORM_CODE=gcp" 2
    : "${CLOUD_SQL_CONNECTION_NAME:?CLOUD_SQL_CONNECTION_NAME required}"

    log INFO "starting database platform deployment" \
        "connection=$CLOUD_SQL_CONNECTION_NAME"

    pm_compose_load_model

    local service role image has_build service_account
    while IFS=$'\t' read -r service role image has_build; do
        [[ -n "$service" ]] || continue
        [[ "$role" != "scheduler" ]] || continue
        runtime_service_account service_account "$service"
        bind_cloudsql_client "$service_account"
    done < <(pm_compose_deployable_services_tsv)

    log INFO "database platform deployment complete" \
        "connection=$CLOUD_SQL_CONNECTION_NAME"
}

pm_deploy_runtime_platform() {
    [[ "${ADAPTER_CODE:-}" == "gcp" ]] \
        || die "pm-deploy-gcp runtime entrypoint requires ADAPTER_CODE=gcp" 2

    local compose_file
    pm_compose_control_file compose_file
    if [[ ! -f "$compose_file" ]]; then
        log INFO "GCP runtime deployment skipped; no Compose file found" "compose_file=$compose_file"
        return 0
    fi

    have gcloud || die "Missing required command: gcloud" 2
    have docker || die "Missing required command: docker" 2
    have jq || die "Missing required command: jq" 2

    pm_compose_load_model
    [[ ${#PM_COMPOSE_CMD[@]} -gt 0 ]] || pm_compose_init_command
    [[ "$(jq -r 'length' <<<"${PROJECT_SERVICES:-[]}")" -gt 0 ]] \
        || die "GCP deployment discovered zero Compose services; refusing false-success deployment" 2

    log INFO "starting runtime platform deployment" \
        "stack=$STACK" "project=$DEPLOYMENT_ID" "region=$REGION"

	gcloud_project_id=$(gcloud config get-value project 2>/dev/null)

	if [[ "$gcloud_project_id" != "$DEPLOYMENT_ID" ]]; then
		gcloud config set project "$DEPLOYMENT_ID" >/dev/null
	else
	    log INFO "Google Project ID is already correctly aligned with DEPLOYMENT_ID"
	fi
	
	registry="${REGION}-docker.pkg.dev"

	# 1. Ensure docker config.json is configured
	if ! grep -q "\"$registry\"" "${DOCKER_CONFIG:-$HOME/.docker}/config.json" 2>/dev/null; then
		gcloud auth configure-docker "$registry" --quiet >/dev/null
	else
	    log INFO "Docker authoriztion is already persisted locally"
	fi

	# 2. Ensure auth is active and not expired
	if ! gcloud auth print-access-token >/dev/null 2>&1; then
		log INFO "Unable to find an existing valid authorization tokedn in this session. Attempting authorization..."
		
		gcloud auth login --no-launch-browser

	else
	    log INFO "Using the valid authorization token that already exists in this session."	fi
	fi

    # Sourced lifecycle modules can reload the operator-authored environment,
    # including sentinel values embedded in derived database URLs. Re-run the
    # provider/platform bridge immediately before secret synchronization so
    # runtime connection URLs are built from the hydrated managed credentials.
    if pm_db_has_configuration; then
        pm_db_call_required pm_db_bridge_deploy
    fi

    # Runtime configuration belongs to the runtime platform regardless of where
    # the database is hosted. Synchronize secrets and grant service-level access
    # before any Cloud Run revision is created.
#    log INFO "Using Portmason SOPS runtime secrets"

    local service role image has_build service_account
    while IFS=$'\t' read -r service role image has_build; do
        [[ -n "$service" ]] || continue
        [[ "$role" != "scheduler" ]] || continue
        runtime_service_account service_account "$service"
        bind_service_secret_access_compat "$service_account" "$service" "$role"
        if [[ -n "${CLOUD_SQL_CONNECTION_NAME:-}" ]]; then
            bind_cloudsql_client "$service_account"
        fi
        deploy_compose_service "$service" "$role" "$image" "$has_build"
    done < <(pm_compose_deployable_services_tsv)

    ensure_compose_schedules
    ensure_cloud_tasks_scheduled_queue

    log INFO "runtime platform deployment complete" \
        "alternate_app_url=${ALTERNATE_APP_URL:-<not-applicable>}"
}


pm_gcp_remove_legacy_secret_bindings() {
    local resource="${1:?resource required}"

    local secret_keys=(
        ABUSE_IDENTIFIER_SALT
        BULKEMAILER_API_KEY
        CHECKOUT_TOKEN_KEY
        PAYMENTS_SECRET_KEY
        PAYMENTS_WEBHOOK_SECRET
        DB_API_KEY
        DB_ADMIN_PASSWORD
        DB_USER_PASSWORD
        DB_PASSWORD
        DB_DIRECT_URL
        DB_URL
        MONITORING_HEARTBEAT_OUTBOUND_COMMUNICATIONS_TOKEN_SECURED_URL
        MONITORING_HEARTBEAT_EXTERNAL_SYNC_TOKEN_SECURED_URL
        MONITORING_HEARTBEAT_HOUSEKEEPING_TOKEN_SECURED_URL
        MONITORING_FAILURE_EVENT_HTTP_BEARER_TOKEN
        REVIEW_PROVIDER_EVENT_SECRET
        SUPPORT_CHANNEL_BOT_TOKEN
        PM_SUPPORT_CHANNEL_BOT_TOKEN
        SUPPORT_CHANNEL_SIGNING_SECRET
        PM_SUPPORT_CHANNEL_SIGNING_SECRET
        OBSERVABILITY_DASHBOARD_API_TOKEN
        OBSERVABILITY_UPTIME_API_TOKEN
        OBSERVABILITY_STORE_PASSWORD
        OBSERVABILITY_SOURCE_CONTROL_TOKEN
        OBSERVABILITY_SOURCE_CONTROL_WEBHOOK_SECRET
        TURNSTILE_SECRET_KEY
        TURNSTILE_SITE_KEY
        OBSERVABILITY_OTLP_AUTH_TOKEN
        TELEMETRY_OTLP_AUTH_TOKEN
    )

    local args=()

    local key
    for key in "${secret_keys[@]}"; do
        args+=(--remove-secrets "$key")
    done

    log INFO "Removing legacy Cloud Run Secret Manager bindings" \
        "resource=$resource"

    gcloud run services update "$resource" \
        --project "$DEPLOYMENT_ID" \
        --region "$REGION" \
        "${args[@]}" \
        >/dev/null 2>&1 || true
}

main() {
    pm_deploy_runtime_platform "$@"
}

main "$@"
