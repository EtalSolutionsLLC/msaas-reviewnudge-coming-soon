#!/usr/bin/env bash


pm_setup_node_site_root() {
    local resolved="${SITE_ROOT:-${SITE_DIR:-${PROJECT_ROOT:-$PWD}}}"
    local runtime_root="${PROJECT_ROOT:-$PWD}"


    if [[ -n "${MGT_SCRIPTS:-}" ]]; then
        runtime_root="$(
            dirname -- "$MGT_SCRIPTS"
        )"
    fi


    # Resolve against the current project/snapshot so cached
    # development paths cannot leak into another environment.

    if [[ -d "${runtime_root}/public" ]]; then
        resolved="${runtime_root}/public"
    fi


    env_init_set \
        SITE_ROOT \
        "$resolved"


    log INFO \
        "Node runtime site root resolved" \
        "site_root=$SITE_ROOT"
}


pm_setup_node_site_root

pm_web_setup
