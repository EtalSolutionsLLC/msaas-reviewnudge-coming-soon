#!/usr/bin/env bash
set -euo pipefail

# Compile Portmason's standard container labels from a resolved dotenv file
# and a Compose model. Explicit labels already present on a service win.

declare -a PM_LABEL_COMPOSE_FILES=()
declare -a PM_LABEL_ERRORS=()
PM_LABEL_ENV_FILE=""
PM_LABEL_OUTPUT_FILE=""
PM_LABEL_PROJECT_DIRECTORY=""
PM_LABEL_TEMP_FILE=""

usage() {
    cat <<'USAGE'
pm-compose-labels

Usage:
  pm-compose-labels --env-file <.env.generated> \
    --project-directory <active-environment-directory> \
    --compose-file <docker-compose.yml> [--compose-file <override.yml> ...] \
    --output <generated-override.yml>

The resolved dotenv file supplies project-wide metadata. Labels explicitly
declared on a Compose service override automated values. The command validates
the fully merged model, including every profile, before writing the override.
USAGE
}

fail() {
    printf 'ERROR: pm-compose-labels: %s\n' "$*" >&2
    exit 2
}

cleanup() {
    if [[ -n "$PM_LABEL_TEMP_FILE" && -f "$PM_LABEL_TEMP_FILE" ]]; then
        rm -f -- "$PM_LABEL_TEMP_FILE"
    fi
    return 0
}

trim() {
    local value="${1:-}"
    value="${value#${value%%[![:space:]]*}}"
    value="${value%${value##*[![:space:]]}}"
    printf '%s' "$value"
}

dotenv_get() {
    local wanted="${1:?key required}"
    local output_var="${2:?output variable required}"
    local line key parsed_value found=1

    printf -v "$output_var" '%s' ""
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        line="$(trim "$line")"
        [[ -n "$line" && "$line" != \#* ]] || continue
        [[ "$line" == export[[:space:]]* ]] && line="${line#export}"
        line="$(trim "$line")"
        [[ "$line" == *=* ]] || continue
        key="$(trim "${line%%=*}")"
        [[ "$key" == "$wanted" ]] || continue

        parsed_value="$(trim "${line#*=}")"
        if [[ ${#parsed_value} -ge 2 ]]; then
            if [[ "${parsed_value:0:1}" == '"' && "${parsed_value: -1}" == '"' ]] \
                || [[ "${parsed_value:0:1}" == "'" && "${parsed_value: -1}" == "'" ]]; then
                parsed_value="${parsed_value:1:${#parsed_value}-2}"
            fi
        fi
        printf -v "$output_var" '%s' "$parsed_value"
        found=0
    done <<<"$PM_LABEL_ENV_PLAINTEXT"
    return "$found"
}

record_error() {
    PM_LABEL_ERRORS+=("$1")
}

validate_resolved_value() {
    local key="${1:?key required}"
    local value="${2:-}"
    if [[ -z "$value" ]]; then
        record_error "$key is missing or empty in $PM_LABEL_ENV_FILE"
        return 0
    fi
    if [[ "$value" == *'${'* || "$value" =~ \$[A-Za-z_][A-Za-z0-9_]* ]]; then
        record_error "$key is unresolved in $PM_LABEL_ENV_FILE"
    fi
}

validate_environment_contract() {
    local key value
    local -a required=(
        MANAGED_BY
        LIFECYCLE
        DATA_CLASS
        DATA_LIFECYCLE
        PROJECT_ID
        DEPLOYMENT_ID
        STACK
    )

    for key in "${required[@]}"; do
        value=""
        dotenv_get "$key" value || true
        validate_resolved_value "$key" "$value"
        printf -v "PM_LABEL_${key}" '%s' "$value"
    done

    case "${PM_LABEL_MANAGED_BY:-}" in
        compose|github|k8s|terraform|manual|other) : ;;
        "") : ;;
        *) record_error "MANAGED_BY must be compose, github, k8s, terraform, manual, or other" ;;
    esac
    case "${PM_LABEL_LIFECYCLE:-}" in
        ephemeral|long-lived|job) : ;;
        "") : ;;
        *) record_error "LIFECYCLE must be ephemeral, long-lived, or job" ;;
    esac
    case "${PM_LABEL_DATA_CLASS:-}" in
        public|internal|confidential|regulated) : ;;
        "") : ;;
        *) record_error "DATA_CLASS must be public, internal, confidential, or regulated" ;;
    esac
    case "${PM_LABEL_DATA_LIFECYCLE:-}" in
        transient|persistent|archival) : ;;
        "") : ;;
        *) record_error "DATA_LIFECYCLE must be transient, persistent, or archival" ;;
    esac
}

print_errors_and_exit() {
    local error
    printf 'ERROR: pm-compose-labels: input contract failed with %s finding(s)\n' \
        "${#PM_LABEL_ERRORS[@]}" >&2
    for error in "${PM_LABEL_ERRORS[@]}"; do
        printf '  - %s\n' "$error" >&2
    done
    exit 2
}

compose_command() {
    local -n output_ref="${1:?output array required}"
    local compose_file
    output_ref=(
        python3 "${PORTMASON_SHARE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}/pm-compose-encrypted.py"
        --env-file "$PM_LABEL_ENV_FILE"
    )
    [[ -n "$PM_LABEL_PROJECT_DIRECTORY" ]] \
        && output_ref+=(--project-directory "$PM_LABEL_PROJECT_DIRECTORY")
    for compose_file in "${PM_LABEL_COMPOSE_FILES[@]}"; do
        output_ref+=(-f "$compose_file")
    done
}

render_override() {
    local model="${1:?Compose model required}"
    local labels_json

    labels_json="$(jq -c \
        --arg managed_by "$PM_LABEL_MANAGED_BY" \
        --arg lifecycle "$PM_LABEL_LIFECYCLE" \
        --arg project_id "$PM_LABEL_PROJECT_ID" \
        --arg deployment_id "$PM_LABEL_DEPLOYMENT_ID" \
        --arg stack "$PM_LABEL_STACK" \
        --arg data_class "$PM_LABEL_DATA_CLASS" \
        --arg data_lifecycle "$PM_LABEL_DATA_LIFECYCLE" '
        def labels($svc): ($svc.labels // {});
        def choose($labels; $key; $automated):
            if ($labels | has($key)) then $labels[$key] else $automated end;
        def inferred_tier($name; $service; $image):
            if (($service | ascii_downcase) | test("^(db|database|postgres|mysql|mariadb|mongo|redis|cache|queue|storage)$"))
                or (($image | ascii_downcase) | test("(^|/)(postgres|mysql|mariadb|mongo|redis|rabbitmq|nats)(:|@|$)"))
            then "persistence"
            elif (($service | ascii_downcase) | test("^(proxy|gateway|edge|traefik)$"))
            then "edge"
            elif (($service | ascii_downcase) | test("^(web|frontend|ui)$"))
            then "frontend"
            else "internal"
            end;
        .services
        | to_entries
        | map(
            .key as $name
            | .value as $svc
            | labels($svc) as $labels
            | choose($labels; "solutions.etal.service"; $name) as $service
            | {
                key: $name,
                value: {
                    labels: {
                        "solutions.etal.service": $service,
                        "solutions.etal.service_tier": choose(
                            $labels;
                            "solutions.etal.service_tier";
                            inferred_tier($name; ($service | tostring); ($svc.image // ""))
                        ),
                        "solutions.etal.managed_by": choose($labels; "solutions.etal.managed_by"; $managed_by),
                        "solutions.etal.service_lifecycle": choose($labels; "solutions.etal.service_lifecycle"; $lifecycle),
                        "solutions.etal.project_id": choose($labels; "solutions.etal.project_id"; $project_id),
                        "solutions.etal.deployment_id": choose($labels; "solutions.etal.deployment_id"; $deployment_id),
                        "solutions.etal.stack": choose($labels; "solutions.etal.stack"; $stack),
                        "solutions.etal.data_class": choose($labels; "solutions.etal.data_class"; $data_class),
                        "solutions.etal.data_lifecycle": choose($labels; "solutions.etal.data_lifecycle"; $data_lifecycle)
                    }
                }
              }
          )
        | from_entries
        | {services: .}
    ' <<<"$model")"

    jq -r '
        "services:",
        (.services | to_entries[]
          | "  \(.key | @json):",
            "    labels:",
            (.value.labels | to_entries[]
              | (.value // "") as $value
              | "      \(.key | @json): \(($value | tostring) | @json)"))
    ' <<<"$labels_json" >"$PM_LABEL_TEMP_FILE"
}

validate_final_model() {
    local model="${1:?final Compose model required}"
    local service key value volume owners classes lifecycles
    local -a required_labels=(
        solutions.etal.service
        solutions.etal.service_tier
        solutions.etal.managed_by
        solutions.etal.service_lifecycle
        solutions.etal.project_id
        solutions.etal.deployment_id
        solutions.etal.stack
        solutions.etal.data_class
        solutions.etal.data_lifecycle
    )
    local required_json
    required_json="$(printf '%s\n' "${required_labels[@]}" | jq -R . | jq -s .)"

    while IFS=$'\t' read -r service key value; do
        value="$(trim "$value")"
        if [[ -z "$value" ]]; then
            record_error "service $service label $key is missing or empty"
            continue
        fi
        if [[ "$value" == *'${'* || "$value" =~ \$[A-Za-z_][A-Za-z0-9_]* ]]; then
            record_error "service $service label $key is unresolved"
            continue
        fi
        case "$key" in
            solutions.etal.service_tier)
                [[ "$value" =~ ^[a-z][a-z0-9-]*$ ]] \
                    || record_error "service $service label $key must be a lowercase tier identifier"
                ;;
            solutions.etal.managed_by)
                case "$value" in
                    compose|github|k8s|terraform|manual|other) : ;;
                    *) record_error "service $service label $key has invalid value $value" ;;
                esac
                ;;
            solutions.etal.service_lifecycle)
                case "$value" in
                    ephemeral|long-lived|job) : ;;
                    *) record_error "service $service label $key has invalid value $value" ;;
                esac
                ;;
            solutions.etal.stack)
                [[ "$value" == "$PM_LABEL_STACK" ]] \
                    || record_error "service $service label $key must match active STACK $PM_LABEL_STACK"
                ;;
            solutions.etal.data_class)
                case "$value" in
                    public|internal|confidential|regulated) : ;;
                    *) record_error "service $service label $key has invalid value $value" ;;
                esac
                ;;
            solutions.etal.data_lifecycle)
                case "$value" in
                    transient|persistent|archival) : ;;
                    *) record_error "service $service label $key has invalid value $value" ;;
                esac
                ;;
        esac
    done < <(
        jq -r --argjson required "$required_json" '
            .services
            | to_entries[]
            | .key as $service
            | (.value.labels // {}) as $labels
            | $required[]
            | [$service, ., (($labels[.] // "") | tostring)]
            | @tsv
        ' <<<"$model"
    )

    while IFS=$'\t' read -r volume owners classes lifecycles; do
        record_error "named volume $volume is shared by $owners with conflicting data_class=$classes data_lifecycle=$lifecycles"
    done < <(
        jq -r '
            [
              .services
              | to_entries[]
              | .key as $service
              | (.value.labels // {}) as $labels
              | (.value.volumes // [])[]
              | select(type == "object" and .type == "volume" and (.source // "") != "")
              | {
                  volume: .source,
                  service: $service,
                  data_class: ($labels["solutions.etal.data_class"] // ""),
                  data_lifecycle: ($labels["solutions.etal.data_lifecycle"] // "")
                }
            ]
            | group_by(.volume)[]
            | select(length > 1)
            | {
                volume: .[0].volume,
                owners: (map(.service) | sort | join(",")),
                classes: (map(.data_class) | unique | sort),
                lifecycles: (map(.data_lifecycle) | unique | sort)
              }
            | select((.classes | length) > 1 or (.lifecycles | length) > 1)
            | [.volume, .owners, (.classes | join(",")), (.lifecycles | join(","))]
            | @tsv
        ' <<<"$model"
    )
}

main() {
    local arg compose_file output_dir initial_model final_model
    local -a base_command=() final_command=()

    while (($#)); do
        arg="$1"
        shift
        case "$arg" in
            --env-file)
                (($#)) || fail "--env-file requires a path"
                PM_LABEL_ENV_FILE="$1"
                shift
                ;;
            --compose-file)
                (($#)) || fail "--compose-file requires a path"
                PM_LABEL_COMPOSE_FILES+=("$1")
                shift
                ;;
            --project-directory)
                (($#)) || fail "--project-directory requires a path"
                PM_LABEL_PROJECT_DIRECTORY="$1"
                shift
                ;;
            --output)
                (($#)) || fail "--output requires a path"
                PM_LABEL_OUTPUT_FILE="$1"
                shift
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *) fail "unknown argument: $arg" ;;
        esac
    done

    [[ -r "$PM_LABEL_ENV_FILE" ]] \
        || fail "resolved env file is not readable: ${PM_LABEL_ENV_FILE:-<unset>}"
    if [[ -n "$PM_LABEL_PROJECT_DIRECTORY" && ! -d "$PM_LABEL_PROJECT_DIRECTORY" ]]; then
        fail "project directory is not readable: $PM_LABEL_PROJECT_DIRECTORY"
    fi
    ((${#PM_LABEL_COMPOSE_FILES[@]} > 0)) \
        || fail "at least one --compose-file is required"
    for compose_file in "${PM_LABEL_COMPOSE_FILES[@]}"; do
        [[ -r "$compose_file" ]] || fail "Compose file is not readable: $compose_file"
    done
    [[ -n "$PM_LABEL_OUTPUT_FILE" ]] || fail "--output is required"
    command -v docker >/dev/null 2>&1 || fail "docker is required"
    docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required"
    command -v jq >/dev/null 2>&1 || fail "jq is required"

    PM_LABEL_ENV_PLAINTEXT="$(
        sops --decrypt --input-type dotenv --output-type dotenv "$PM_LABEL_ENV_FILE"
    )" || fail "could not decrypt the supplied environment"
    validate_environment_contract
    ((${#PM_LABEL_ERRORS[@]} == 0)) || print_errors_and_exit

    compose_command base_command
    initial_model="$("${base_command[@]}" --profile '*' config --format json)" \
        || fail "could not render the supplied Compose model"
    jq -e '.services and (.services | type == "object") and ((.services | length) > 0)' \
        >/dev/null 2>&1 <<<"$initial_model" \
        || fail "supplied Compose files did not render a nonempty service model"

    output_dir="$(dirname -- "$PM_LABEL_OUTPUT_FILE")"
    [[ -d "$output_dir" ]] || fail "output directory does not exist: $output_dir"
    PM_LABEL_TEMP_FILE="$(mktemp "${PM_LABEL_OUTPUT_FILE}.tmp.XXXXXX")"
    trap cleanup EXIT INT TERM
    render_override "$initial_model"

    final_command=("${base_command[@]}" -f "$PM_LABEL_TEMP_FILE")
    final_model="$("${final_command[@]}" --profile '*' config --format json)" \
        || fail "generated label override did not produce a valid Compose model"
    validate_final_model "$final_model"
    ((${#PM_LABEL_ERRORS[@]} == 0)) || print_errors_and_exit

    mv -f -- "$PM_LABEL_TEMP_FILE" "$PM_LABEL_OUTPUT_FILE"
    PM_LABEL_TEMP_FILE=""
    printf 'Portmason labels compiled for %s service(s): %s\n' \
        "$(jq '.services | length' <<<"$final_model")" "$PM_LABEL_OUTPUT_FILE"
}

main "$@"
