#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"

pm_azure_register_provider() {
    local namespace="${1:?provider namespace required}"
    pm_azure_cli provider register \
        --namespace "$namespace" \
        --wait \
        --only-show-errors >/dev/null
}

pm_azure_platform_parameter_file() {
    local out_var="${1:?output variable required}"
    local deployment_principal_id="${2:?deployment principal id required}"
    local deployment_principal_type="${3:?deployment principal type required}"
    local queues_json="${4:-[]}"
    local include_service_bus=false
    local work_dir file

    [[ "$(jq -r 'length' <<<"$queues_json")" -gt 0 ]] && include_service_bus=true
    work_dir="${SCRIPT_DIR}/.portmason/azure"
    mkdir --parents -- "$work_dir"
    file="${work_dir}/platform.parameters.json"

    jq -n \
        --arg location "$AZURE_LOCATION" \
        --arg resourceGroupName "$AZURE_RESOURCE_GROUP" \
        --arg containerEnvironmentName "$AZURE_CONTAINER_ENV" \
        --arg logAnalyticsName "$AZURE_LOG_ANALYTICS_NAME" \
        --arg acrName "$AZURE_ACR_NAME" \
        --arg acrSku "$AZURE_ACR_SKU" \
        --arg keyVaultName "$AZURE_KEYVAULT_NAME" \
        --arg identityName "$AZURE_IDENTITY_NAME" \
        --arg serviceBusNamespaceName "$AZURE_SERVICE_BUS_NAMESPACE" \
        --arg serviceBusSku "$AZURE_SERVICE_BUS_SKU" \
        --arg deploymentPrincipalId "$deployment_principal_id" \
        --arg deploymentPrincipalType "$deployment_principal_type" \
        --argjson includeServiceBus "$include_service_bus" \
        --argjson serviceBusQueues "$queues_json" \
        '{
          "$schema":"https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
          contentVersion:"1.0.0.0",
          parameters:{
            location:{value:$location},
            resourceGroupName:{value:$resourceGroupName},
            containerEnvironmentName:{value:$containerEnvironmentName},
            logAnalyticsName:{value:$logAnalyticsName},
            acrName:{value:$acrName},
            acrSku:{value:$acrSku},
            keyVaultName:{value:$keyVaultName},
            identityName:{value:$identityName},
            includeServiceBus:{value:$includeServiceBus},
            serviceBusNamespaceName:{value:$serviceBusNamespaceName},
            serviceBusSku:{value:$serviceBusSku},
            serviceBusQueues:{value:$serviceBusQueues},
            deploymentPrincipalId:{value:$deploymentPrincipalId},
            deploymentPrincipalType:{value:$deploymentPrincipalType}
          }
        }' > "$file"

    printf -v "$out_var" '%s' "$file"
}

pm_azure_persist_platform_outputs() {
    local deployment_name="${1:?deployment name required}"
    local output

    output="$(pm_azure_cli deployment sub show \
        --name "$deployment_name" \
        --query properties.outputs \
        -o json \
        --only-show-errors)"

    env_init_set AZURE_RESOURCE_GROUP "$(jq -r '.resourceGroupName.value' <<<"$output")"
    env_init_set AZURE_CONTAINER_ENV "$(jq -r '.containerEnvironmentName.value' <<<"$output")"
    env_init_set AZURE_CONTAINER_ENV_ID "$(jq -r '.containerEnvironmentId.value' <<<"$output")"
    env_init_set AZURE_ACR_NAME "$(jq -r '.acrName.value' <<<"$output")"
    env_init_set AZURE_ACR_ID "$(jq -r '.acrId.value' <<<"$output")"
    env_init_set AZURE_ACR_LOGIN_SERVER "$(jq -r '.acrLoginServer.value' <<<"$output")"
    env_init_set AZURE_KEYVAULT_NAME "$(jq -r '.keyVaultName.value' <<<"$output")"
    env_init_set AZURE_KEYVAULT_ID "$(jq -r '.keyVaultId.value' <<<"$output")"
    env_init_set AZURE_IDENTITY_NAME "$(jq -r '.identityName.value' <<<"$output")"
    env_init_set AZURE_IDENTITY_ID "$(jq -r '.identityId.value' <<<"$output")"
    env_init_set AZURE_IDENTITY_PRINCIPAL_ID "$(jq -r '.identityPrincipalId.value' <<<"$output")"
    env_init_set AZURE_IDENTITY_CLIENT_ID "$(jq -r '.identityClientId.value' <<<"$output")"

    local service_bus_namespace
    service_bus_namespace="$(jq -r '.serviceBusNamespaceName.value // empty' <<<"$output")"
    [[ -z "$service_bus_namespace" ]] \
        || env_init_set AZURE_SERVICE_BUS_NAMESPACE "$service_bus_namespace"
}

pm_provision_runtime_platform() {
    have jq || die "Missing required command: jq" 2
    pm_azure_cli_require_account
    pm_azure_defaults
    pm_compose_load_model

    local bicep_root template parameter_file deployment_name
    local azure_principal_object_id azure_principal_type queues_json
    pm_azure_bicep_root bicep_root
    template="${bicep_root}/platform.bicep"
    [[ -r "$template" ]] || die "Azure platform Bicep template is unavailable: $template" 2

    pm_azure_current_principal azure_principal_object_id azure_principal_type
    [[ -n "$azure_principal_object_id" ]] \
        || die "Azure deployment principal ID resolution returned an empty value" 2
    [[ -n "$azure_principal_type" ]] \
        || die "Azure deployment principal type resolution returned an empty value" 2

    queues_json="$(jq -c '[
        .[]?
        | if (.queue_consume // "") != "" then .queue_consume
          elif (.queue_publish // "") != "" then .queue_publish
          else empty
          end
      ] | unique' \
        <<<"${PROJECT_SERVICES:-[]}")"
    pm_azure_platform_parameter_file parameter_file \
        "$azure_principal_object_id" "$azure_principal_type" "$queues_json"
    pm_azure_slug deployment_name \
        "${STACK:-portmason}-platform-${BUILD_NUMBER:-0}"
    deployment_name="${deployment_name:0:64}"

    log INFO "starting declarative Azure platform provisioning" \
        "resource_group=$AZURE_RESOURCE_GROUP" \
        "location=$AZURE_LOCATION" \
        "deployment=$deployment_name" \
        "deployment_principal_type=$azure_principal_type"

    pm_azure_register_provider Microsoft.App
    pm_azure_register_provider Microsoft.ContainerRegistry
    pm_azure_register_provider Microsoft.KeyVault
    pm_azure_register_provider Microsoft.ManagedIdentity
    pm_azure_register_provider Microsoft.OperationalInsights
    if [[ "$(jq -r 'length' <<<"$queues_json")" -gt 0 ]]; then
        pm_azure_register_provider Microsoft.ServiceBus
    fi

    pm_azure_cli bicep build \
        --file "$template" \
        --only-show-errors >/dev/null

    pm_azure_cli deployment sub validate \
        --name "$deployment_name" \
        --location "$AZURE_LOCATION" \
        --template-file "$template" \
        --parameters "@$parameter_file" \
        --only-show-errors >/dev/null

    if pm_azure_bool_enabled "${AZURE_BICEP_WHAT_IF:-true}"; then
        pm_azure_cli deployment sub what-if \
            --name "$deployment_name" \
            --location "$AZURE_LOCATION" \
            --template-file "$template" \
            --parameters "@$parameter_file" \
            --only-show-errors
    fi

    pm_azure_cli deployment sub create \
        --name "$deployment_name" \
        --location "$AZURE_LOCATION" \
        --template-file "$template" \
        --parameters "@$parameter_file" \
        --only-show-errors >/dev/null

    pm_azure_persist_platform_outputs "$deployment_name"

    log INFO "declarative Azure platform provisioning complete" \
        "acr=$AZURE_ACR_NAME" \
        "key_vault=$AZURE_KEYVAULT_NAME" \
        "identity=$AZURE_IDENTITY_NAME" \
        "container_environment=$AZURE_CONTAINER_ENV"
}

main() {
    pm_provision_runtime_platform "$@"
}

main "$@"
