#!/usr/bin/env bash
set -euo pipefail

: "${PORTMASON_SHARE:=$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-${0:-}}")" && pwd -P)}"
. "${PORTMASON_SHARE}/pm-helpers" "$@"
. "${PORTMASON_SHARE}/pm-helpers-observability" "$@"

pm_observabilitobservabilitobservabilitobservability_db_rt() {
    PM_DB_SERVICE=observability \
    PM_DB_RT_HOST="${PM_DB_RT_HOST:-${OBSERVABILITY_DB_HOST:-}}" \
    PM_DB_RT_PORT="${PM_DB_RT_PORT:-${OBSERVABILITY_DB_PORT:-5432}}" \
    PM_DB_RT_USER="${PM_DB_RT_USER:-${OBSERVABILITY_DB_USER:-}}" \
    PM_DB_RT_PASSWORD="${PM_DB_RT_PASSWORD:-${OBSERVABILITY_DB_PASSWORD:-}}" \
    PM_DB_RT_DATABASE="${PM_DB_RT_DATABASE:-${OBSERVABILITY_DB_NAME:-}}" \
        db_rt "$@"
}

pm_observability_postgres_migration_table() {
    log DEBUG "ensuring migration ledger"
    pm_observabilitobservabilitobservabilitobservability_db_rt --command='
        CREATE SCHEMA IF NOT EXISTS observability;
        CREATE TABLE IF NOT EXISTS observability.schema_migrations (
            migration_name text PRIMARY KEY,
            checksum_sha256 text NOT NULL,
            applied_at timestamptz NOT NULL DEFAULT now()
        );'
}

pm_observability_postgres_migration_status() {
    local version="${1:?version required}"
    pm_observabilitobservabilitobservabilitobservability_db_rt --tuples-only --no-align \
        --set=migration_name="$version" \
        --file=- <<'SQL'
SELECT checksum_sha256
FROM observability.schema_migrations
WHERE migration_name = :'migration_name';
SQL
}

pm_observability_postgres_migration_ledger() {
    pm_observabilitobservabilitobservabilitobservability_db_rt --tuples-only --no-align --field-separator=$'\t' --command='
SELECT migration_name, checksum_sha256
FROM observability.schema_migrations
ORDER BY migration_name;'
}

pm_observability_postgres_record_migration() {
    local version="${1:?version required}"
    local checksum="${2:?checksum required}"
    pm_observabilitobservabilitobservabilitobservability_db_rt \
        --set=migration_name="$version" \
        --set=checksum="$checksum" \
        --file=- <<'SQL'
INSERT INTO observability.schema_migrations(migration_name, checksum_sha256)
VALUES (:'migration_name', :'checksum');
SQL
}

pm_observability_postgres_apply_migration() {
    local file="${1:?migration file required}"
    local version checksum existing transaction_flag
    version="$(basename "$file")"
    checksum="$(sha256sum "$file" | awk '{print $1}')"
    if (($# >= 2)); then
        existing="$2"
    else
        existing="$(pm_observability_postgres_migration_status "$version" | tr -d '[:space:]')"
    fi

    if [[ -n "$existing" ]]; then
        [[ "$existing" == "$checksum" ]] \
            || die "Migration checksum mismatch: $version (recorded=$existing current=$checksum)" 2
        log INFO "migration already applied" \
            "version=$version" "checksum=$checksum"
        return 0
    fi

    transaction_flag="--single-transaction"
    [[ "$version" == *.notx.sql ]] && transaction_flag=""

    log INFO "applying migration" \
        "version=$version" "checksum=$checksum" \
        "transaction=$([[ -n "$transaction_flag" ]] && printf yes || printf no)"

    if [[ -n "$transaction_flag" ]]; then
        pm_observabilitobservabilitobservabilitobservability_db_rt "$transaction_flag" --file=- <"$file"
    else
        pm_observabilitobservabilitobservabilitobservability_db_rt --file=- <"$file"
    fi

    pm_observability_postgres_record_migration "$version" "$checksum"

    log INFO "migration applied" "version=$version"
}

pm_observability_postgres_apply_migrations() {
    local migration_dir="${SCRIPT_DIR}/db/observability"
    local file version ledger_output ledger_version ledger_checksum count=0
    local -A applied_checksums=()

    if [[ ! -d "$migration_dir" ]]; then
        log INFO "no migration directory; skipping" \
            "directory=$migration_dir"
        return 0
    fi

    pm_observability_postgres_migration_table
    if ! ledger_output="$(pm_observability_postgres_migration_ledger)"; then
        die "Unable to read PostgreSQL migration ledger" 2
    fi
    while IFS=$'\t' read -r ledger_version ledger_checksum; do
        [[ -n "$ledger_version" ]] || continue
        applied_checksums["$ledger_version"]="$ledger_checksum"
    done <<<"$ledger_output"

    while IFS= read -r -d '' file; do
        version="$(basename "$file")"
        pm_observability_postgres_apply_migration "$file" "${applied_checksums[$version]-}"
        ((count+=1))
    done < <(find "$migration_dir" -maxdepth 1 -type f -name '*.sql' -print0 | sort -z)

    log INFO "migration phase complete" \
        "directory=$migration_dir" "files=$count"
}

pm_observability_postgres_apply_seed_file() {
    local file="${1:?seed file required}"
    [[ -r "$file" ]] || return 0
    log INFO "applying seed" "file=$file"
    pm_observabilitobservabilitobservabilitobservability_db_rt --single-transaction --file=- <"$file"
    log INFO "seed applied" "file=$file"
}

pm_observability_postgres_apply_seeds() {
    local seed_dir="${SCRIPT_DIR}/db/observability/seeds"
    [[ -d "$seed_dir" ]] || return 0

    pm_observability_postgres_apply_seed_file "$seed_dir/common.sql"
    if [[ -n "${DEPLOY_ENV:-}" ]]; then
        pm_observability_postgres_apply_seed_file "$seed_dir/${DEPLOY_ENV}.sql"
    fi
}

pm_observability_postgres_verify() {
    local result
    result="$(pm_observabilitobservabilitobservabilitobservability_db_rt --tuples-only --no-align --command='SELECT current_database() || chr(124) || current_user;')"
    log INFO "provider verification passed" \
        "database=${result%%|*}" "user=${result#*|}"
}

pm_deploy_observabilitobservabilitobservabilitobservability_db_provider() {

    [[ "${PM_OBSERVABILITY_DB_PROVIDER_CODE:-}" == "postgres" ]] \
        || die "pm-deploy-observability-db-postgres requires OBSERVABILITY_DB_PROVIDER_PLATFORM_CODE=postgres-<platform>" 2

    log INFO "starting database-code deployment" \
        "platform=${PM_OBSERVABILITY_DB_PLATFORM_CODE:-}" "database=${OBSERVABILITY_DB_NAME:-}"

    pm_observability_postgres_apply_migrations
    pm_observability_postgres_apply_seeds
    pm_observability_postgres_verify

    log INFO "database-code deployment complete" \
        "database=${OBSERVABILITY_DB_NAME:-}"
}

main() {
    pm_deploy_observabilitobservabilitobservabilitobservability_db_provider "$@"
}

main "$@"
